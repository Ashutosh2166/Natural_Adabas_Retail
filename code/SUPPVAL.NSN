* >Natural Source Code: SUPPVAL
* SUBPROGRAM: SUPPVAL - SUPPLIER VALIDATION
* DESCRIPTION: VALIDATES SUPPLIER DATA FOR CREATE/UPDATE
* LIBRARY: RETAILCORE
* ADABAS FILE: 130 (SUPPLIER)
* CREATED: 2001-06-20  A. GARCIA
* MODIFIED: 2012-04-15 - ADDED EMAIL VALIDATION
* MODIFIED: 2019-08-22 - ADDED DUPLICATE CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SUPP-ID             (N8)
  1 P-SUPP-NAME           (A60)
  1 P-SUPP-TYPE           (A2)
  1 P-SUPP-EMAIL          (A60)
  1 P-SUPP-PHONE          (A15)
  1 P-PAY-TERMS           (A10)
  1 P-PAY-DAYS            (N3)
  1 P-LEAD-DAYS           (N3)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #FOUND                (A1)
  1 #VAL-RESULT           (A1)
  1 #VAL-MSG              (A60)
*
  1 SVL-VIEW VIEW OF SUPPLIER-FILE
    2 SVL-ID               (N8)
    2 SVL-NAME             (A60)
    2 SVL-EMAIL            (A60)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
* VALIDATE NAME
IF P-SUPP-NAME = ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'SUPPLIER NAME IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE TYPE
IF P-SUPP-TYPE NE 'MF' AND P-SUPP-TYPE NE 'DS'
    AND P-SUPP-TYPE NE 'WH' AND P-SUPP-TYPE NE 'IM'
    AND P-SUPP-TYPE NE 'LO'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'INVALID SUPPLIER TYPE (MF/DS/WH/IM/LO)' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE EMAIL
IF P-SUPP-EMAIL NE ' '
  CALLNAT 'VALU' 'EMAL' P-SUPP-EMAIL ' ' 0 0
    #VAL-RESULT #VAL-MSG
  IF #VAL-RESULT NE 'Y'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'INVALID SUPPLIER EMAIL' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
END-IF
*
* VALIDATE PHONE
IF P-SUPP-PHONE NE ' '
  CALLNAT 'VALU' 'PHON' P-SUPP-PHONE ' ' 0 0
    #VAL-RESULT #VAL-MSG
  IF #VAL-RESULT NE 'Y'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'INVALID SUPPLIER PHONE' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
END-IF
*
* VALIDATE PAYMENT TERMS
IF P-PAY-TERMS NE ' '
  IF P-PAY-TERMS NE 'NET30' AND P-PAY-TERMS NE 'NET45'
      AND P-PAY-TERMS NE 'NET60' AND P-PAY-TERMS NE 'NET90'
      AND P-PAY-TERMS NE '2/10NET30' AND P-PAY-TERMS NE 'COD'
      AND P-PAY-TERMS NE 'PREPAID'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'INVALID PAYMENT TERMS' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
END-IF
*
* VALIDATE LEAD TIME
IF P-LEAD-DAYS > 365
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'LEAD TIME CANNOT EXCEED 365 DAYS' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK DUPLICATE NAME (FOR NEW SUPPLIERS)
IF P-SUPP-ID = 0
  FIND SVL-VIEW WITH SVL-NAME = P-SUPP-NAME
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'SUPPLIER WITH SAME NAME ALREADY EXISTS' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-FIND
END-IF
*
* CHECK DUPLICATE EMAIL
IF P-SUPP-EMAIL NE ' '
  FIND SVL-VIEW WITH SVL-EMAIL = P-SUPP-EMAIL
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    IF SVL-ID NE P-SUPP-ID
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'SUPPLIER EMAIL ALREADY IN USE' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-IF
*
END
