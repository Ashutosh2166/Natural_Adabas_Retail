* >Natural Source Code: CPNVAL
* SUBPROGRAM: CPNVAL - COUPON VALIDATION AND REDEMPTION
* DESCRIPTION: VALIDATES COUPON CODES, CHECKS ELIGIBILITY,
*              CALCULATES DISCOUNT, RECORDS REDEMPTION
* LIBRARY: RETAILCORE
* ADABAS FILE: 123 (COUPON)
* CREATED: 2010-08-15  S. MARTINEZ
* MODIFIED: 2015-02-10 - ADDED SINGLE-USE VALIDATION
* MODIFIED: 2019-06-22 - ADDED CUSTOMER-SPECIFIC COUPONS
* MODIFIED: 2023-03-10 - ADDED COUPON STACKING RULES
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-OPERATION           (A4)    /* VALD REDM CREA */
  1 P-COUPON-CODE         (A20)
  1 P-ORDER-ID            (N10)
  1 P-CUST-ID             (N8)
  1 P-ORDER-AMT           (N11.2)
  1 P-DISCOUNT-AMT        (N9.2)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #TODAY                (D)
  1 #USER-ID              (A8)
  1 #COUPON-ID            (N8)
*
  1 CPN-VIEW VIEW OF COUPON-FILE
    2 CPN-ID               (N8)
    2 CPN-CODE             (A20)
    2 CPN-TYPE             (A2)     /* PC=PCT AM=AMT FX=FIXED FS=FREE-SHIP */
    2 CPN-VALUE            (N9.2)
    2 CPN-MIN-ORDER        (N9.2)
    2 CPN-MAX-DISCOUNT     (N9.2)
    2 CPN-START-DATE       (D)
    2 CPN-END-DATE         (D)
    2 CPN-STATUS           (A1)     /* A=ACTIVE I=INACTIVE X=EXHAUSTED */
    2 CPN-SINGLE-USE       (A1)
    2 CPN-MAX-USES         (N6)
    2 CPN-CURRENT-USES     (N6)
    2 CPN-CUST-ID          (N8)     /* 0=ANY CUSTOMER */
    2 CPN-PROMO-ID         (N8)     /* LINKED PROMOTION */
    2 CPN-CREATED-BY       (A8)
    2 CPN-CREATED-DATE     (D)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE *USER TO #USER-ID
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
RESET P-DISCOUNT-AMT
*
DECIDE ON FIRST VALUE OF P-OPERATION
  VALUE 'VALD'
    PERFORM VALIDATE-COUPON
  VALUE 'REDM'
    PERFORM VALIDATE-COUPON
    IF P-VALID-FLAG = 'Y'
      PERFORM REDEEM-COUPON
    END-IF
  VALUE 'CREA'
    PERFORM CREATE-COUPON
  NONE VALUE
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'INVALID COUPON OPERATION' TO P-ERROR-MSG
END-DECIDE
*
* -------------------------------------------------------
DEFINE SUBROUTINE VALIDATE-COUPON
*
  IF P-COUPON-CODE = ' '
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'COUPON CODE IS REQUIRED' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
*
  * FIND COUPON
  FIND CPN-VIEW WITH CPN-CODE = P-COUPON-CODE
    IF NO RECORDS FOUND
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'INVALID COUPON CODE' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-NOREC
*
    MOVE CPN-ID TO #COUPON-ID
*
    * CHECK STATUS
    IF CPN-STATUS NE 'A'
      MOVE 'N' TO P-VALID-FLAG
      IF CPN-STATUS = 'X'
        MOVE 'COUPON HAS BEEN EXHAUSTED' TO P-ERROR-MSG
      ELSE
        MOVE 'COUPON IS NOT ACTIVE' TO P-ERROR-MSG
      END-IF
      ESCAPE ROUTINE
    END-IF
*
    * CHECK DATES
    IF CPN-START-DATE > #TODAY
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'COUPON IS NOT YET VALID' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
    IF CPN-END-DATE < #TODAY
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'COUPON HAS EXPIRED' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
*
    * CHECK USES
    IF CPN-MAX-USES > 0 AND CPN-CURRENT-USES >= CPN-MAX-USES
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'COUPON MAXIMUM USES REACHED' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
*
    * CHECK CUSTOMER RESTRICTION
    IF CPN-CUST-ID > 0 AND CPN-CUST-ID NE P-CUST-ID
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'COUPON NOT VALID FOR THIS CUSTOMER' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
*
    * CHECK MINIMUM ORDER
    IF CPN-MIN-ORDER > 0 AND P-ORDER-AMT < CPN-MIN-ORDER
      MOVE 'N' TO P-VALID-FLAG
      COMPRESS 'MINIMUM ORDER AMOUNT:' CPN-MIN-ORDER INTO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
*
    * CALCULATE DISCOUNT
    DECIDE ON FIRST VALUE OF CPN-TYPE
      VALUE 'PC'
        COMPUTE P-DISCOUNT-AMT = P-ORDER-AMT * (CPN-VALUE / 100)
      VALUE 'AM'
        MOVE CPN-VALUE TO P-DISCOUNT-AMT
      VALUE 'FX'
        IF CPN-VALUE < P-ORDER-AMT
          COMPUTE P-DISCOUNT-AMT = P-ORDER-AMT - CPN-VALUE
        END-IF
      VALUE 'FS'
        * FREE SHIPPING - HANDLED BY FULFILLMENT
        MOVE 0 TO P-DISCOUNT-AMT
      NONE VALUE
        MOVE 'N' TO P-VALID-FLAG
        MOVE 'UNKNOWN COUPON TYPE' TO P-ERROR-MSG
        ESCAPE ROUTINE
    END-DECIDE
*
    * APPLY MAX DISCOUNT CAP
    IF CPN-MAX-DISCOUNT > 0 AND P-DISCOUNT-AMT > CPN-MAX-DISCOUNT
      MOVE CPN-MAX-DISCOUNT TO P-DISCOUNT-AMT
    END-IF
*
    * DON'T EXCEED ORDER AMOUNT
    IF P-DISCOUNT-AMT > P-ORDER-AMT
      MOVE P-ORDER-AMT TO P-DISCOUNT-AMT
    END-IF
*
    ESCAPE BOTTOM
  END-FIND
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE REDEEM-COUPON
*
  FIND CPN-VIEW WITH CPN-CODE = P-COUPON-CODE
    IF NO RECORDS FOUND
      ESCAPE ROUTINE
    END-NOREC
    GET CPN-VIEW *ISN (HOLD)
    ADD 1 TO CPN-CURRENT-USES
    * AUTO-EXHAUST SINGLE-USE COUPONS
    IF CPN-SINGLE-USE = 'Y'
      MOVE 'X' TO CPN-STATUS
    END-IF
    * AUTO-EXHAUST IF MAX USES REACHED
    IF CPN-MAX-USES > 0 AND CPN-CURRENT-USES >= CPN-MAX-USES
      MOVE 'X' TO CPN-STATUS
    END-IF
    UPDATE CPN-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
*
  * AUDIT
  1 #CPN-STR (A15)
  MOVE #COUPON-ID TO #CPN-STR
  CALLNAT 'AUDITN' 'PROM' #CPN-STR 'U' 'CPNRD'
    P-COUPON-CODE ' ' 'COUPON REDEEMED'
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE CREATE-COUPON
*
  1 #NEW-ID (N10)
  CALLNAT 'SEQNON' 'CPN' #NEW-ID
*
  IF P-COUPON-CODE = ' '
    * AUTO-GENERATE CODE
    COMPRESS 'CPN-' #NEW-ID INTO P-COUPON-CODE LEAVING NO SPACE
  END-IF
*
  STORE CPN-VIEW
    CPN-ID           := #NEW-ID
    CPN-CODE         := P-COUPON-CODE
    CPN-TYPE         := 'PC'
    CPN-VALUE        := P-DISCOUNT-AMT
    CPN-MIN-ORDER    := P-ORDER-AMT
    CPN-START-DATE   := #TODAY
    CPN-END-DATE     := #TODAY
    CPN-STATUS       := 'A'
    CPN-SINGLE-USE   := 'Y'
    CPN-MAX-USES     := 1
    CPN-CURRENT-USES := 0
    CPN-CUST-ID      := P-CUST-ID
    CPN-CREATED-BY   := #USER-ID
    CPN-CREATED-DATE := #TODAY
  END-STORE
  END OF TRANSACTION
*
END-SUBROUTINE
*
END
