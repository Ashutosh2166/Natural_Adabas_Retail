* >Natural Source Code: PROMPERF
* PROGRAM: PROMPERF - PROMOTION PERFORMANCE REPORT
* DESCRIPTION: ANALYZES PROMOTION AND COUPON EFFECTIVENESS
*              TRACKS USAGE, REVENUE IMPACT, DISCOUNT COST
*              IDENTIFIES BEST/WORST PERFORMING PROMOTIONS
* LIBRARY: RETAILCORE
* ADABAS FILES: 121 (PROMOTION), 122 (PROMO-ITEM),
*               123 (COUPON), 111 (ORDER), 112 (ORDER-LINE)
* CREATED: 2010-08-15  S. MARTINEZ
* MODIFIED: 2016-02-22 - ADDED COUPON ANALYSIS
* MODIFIED: 2022-06-10 - ADDED ROI CALCULATION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #START-DATE           (D)
  1 #END-DATE             (D)
*
* PROMOTION ARRAY - MAX 100
  1 #MAX-PROMOS           (N4)   INIT <100>
  1 #PROMO-COUNT          (N4)
  1 #PROMO-DATA (1:100)
    2 #PP-ID              (N8)
    2 #PP-NAME            (A40)
    2 #PP-TYPE            (A2)
    2 #PP-STATUS          (A1)
    2 #PP-START-DATE      (D)
    2 #PP-END-DATE        (D)
    2 #PP-MAX-USES        (N6)
    2 #PP-CURRENT-USES    (N6)
    2 #PP-DISC-VALUE      (N9.2)
    2 #PP-STACKABLE       (A1)
    2 #PP-TOTAL-DISCOUNT  (N11.2)
    2 #PP-TOTAL-REVENUE   (N13.2)
    2 #PP-ORDER-COUNT     (N8)
    2 #PP-UTILIZATION     (N5.1)
    2 #PP-AVG-DISC        (N9.2)
    2 #PP-DISC-TO-REV     (N5.2)
*
* COUPON ARRAY - MAX 100
  1 #MAX-COUPONS          (N4)   INIT <100>
  1 #COUPON-COUNT         (N4)
  1 #COUPON-DATA (1:100)
    2 #CP-ID              (N10)
    2 #CP-CODE            (A20)
    2 #CP-TYPE            (A2)
    2 #CP-STATUS          (A1)
    2 #CP-VALUE           (N9.2)
    2 #CP-MAX-USES        (N6)
    2 #CP-CURRENT-USES    (N6)
    2 #CP-TOTAL-DISC      (N11.2)
    2 #CP-UTILIZATION     (N5.1)
*
* PROMO TYPE SUMMARY
  1 #TYPE-PC-COUNT        (N6)
  1 #TYPE-PC-DISC         (N11.2)
  1 #TYPE-AM-COUNT        (N6)
  1 #TYPE-AM-DISC         (N11.2)
  1 #TYPE-BG-COUNT        (N6)
  1 #TYPE-BG-DISC         (N11.2)
  1 #TYPE-FX-COUNT        (N6)
  1 #TYPE-FX-DISC         (N11.2)
  1 #TYPE-QD-COUNT        (N6)
  1 #TYPE-QD-DISC         (N11.2)
*
* OVERALL SUMMARY
  1 #TOTAL-DISC-AMT       (N13.2)
  1 #TOTAL-PROMO-ORDERS   (N8)
  1 #TOTAL-COUPON-USES    (N8)
  1 #TOTAL-COUPON-DISC    (N11.2)
  1 #ACTIVE-PROMO-COUNT   (N6)
  1 #INACTIVE-PROMO-COUNT (N6)
  1 #EXHAUSTED-PROMO-COUNT (N6)
*
  1 #IDX                  (N4)
*
  1 PPV-VIEW VIEW OF PROMOTION-FILE
    2 PPV-ID              (N8)
    2 PPV-NAME            (A40)
    2 PPV-TYPE            (A2)
    2 PPV-STATUS          (A1)
    2 PPV-START-DATE      (D)
    2 PPV-END-DATE        (D)
    2 PPV-DISC-TYPE       (A2)
    2 PPV-DISC-VALUE      (N9.2)
    2 PPV-MAX-USES        (N6)
    2 PPV-CURRENT-USES    (N6)
    2 PPV-STACKABLE       (A1)
*
  1 PCV-VIEW VIEW OF COUPON-FILE
    2 PCV-ID              (N10)
    2 PCV-CODE            (A20)
    2 PCV-DISC-TYPE       (A2)
    2 PCV-STATUS          (A1)
    2 PCV-DISC-VALUE      (N9.2)
    2 PCV-MAX-USES        (N6)
    2 PCV-CURRENT-USES    (N6)
    2 PCV-TOTAL-DISC-AMT  (N11.2)
END-DEFINE
*
* -------------------------------------------------------
* SETUP REPORT PERIOD
* -------------------------------------------------------
MOVE *DATX TO #END-DATE
MOVE #END-DATE TO #START-DATE
SUBTRACT 90 FROM #START-DATE (D)
*
* -------------------------------------------------------
* STEP 1: LOAD PROMOTIONS
* -------------------------------------------------------
READ PPV-VIEW BY PPV-ID
  IF #PROMO-COUNT >= #MAX-PROMOS
    ESCAPE BOTTOM
  END-IF
*
  * ONLY INCLUDE IF ACTIVE DURING PERIOD
  IF PPV-END-DATE < #START-DATE AND PPV-STATUS NE 'A'
    ESCAPE TOP
  END-IF
*
  ADD 1 TO #PROMO-COUNT
  MOVE PPV-ID           TO #PP-ID(#PROMO-COUNT)
  MOVE PPV-NAME         TO #PP-NAME(#PROMO-COUNT)
  MOVE PPV-DISC-TYPE    TO #PP-TYPE(#PROMO-COUNT)
  MOVE PPV-STATUS       TO #PP-STATUS(#PROMO-COUNT)
  MOVE PPV-START-DATE   TO #PP-START-DATE(#PROMO-COUNT)
  MOVE PPV-END-DATE     TO #PP-END-DATE(#PROMO-COUNT)
  MOVE PPV-MAX-USES     TO #PP-MAX-USES(#PROMO-COUNT)
  MOVE PPV-CURRENT-USES TO #PP-CURRENT-USES(#PROMO-COUNT)
  MOVE PPV-DISC-VALUE   TO #PP-DISC-VALUE(#PROMO-COUNT)
  MOVE PPV-STACKABLE    TO #PP-STACKABLE(#PROMO-COUNT)
*
  * STATUS COUNTS
  DECIDE ON FIRST VALUE OF PPV-STATUS
    VALUE 'A'
      ADD 1 TO #ACTIVE-PROMO-COUNT
    VALUE 'I'
      ADD 1 TO #INACTIVE-PROMO-COUNT
    VALUE 'X'
      ADD 1 TO #EXHAUSTED-PROMO-COUNT
    NONE VALUE
      ADD 1 TO #INACTIVE-PROMO-COUNT
  END-DECIDE
*
  * CALCULATE UTILIZATION
  IF #PP-MAX-USES(#PROMO-COUNT) > 0
    COMPUTE #PP-UTILIZATION(#PROMO-COUNT) =
      #PP-CURRENT-USES(#PROMO-COUNT)
      / #PP-MAX-USES(#PROMO-COUNT) * 100
  END-IF
*
  * TYPE BREAKDOWN
  * NOTE: USING DISC-TYPE NOT PROMO-TYPE
  * THIS IS A KNOWN INCONSISTENCY IN THE DATA MODEL
  DECIDE ON FIRST VALUE OF PPV-DISC-TYPE
    VALUE 'PC'
      ADD 1 TO #TYPE-PC-COUNT
    VALUE 'AM'
      ADD 1 TO #TYPE-AM-COUNT
    VALUE 'BG'
      ADD 1 TO #TYPE-BG-COUNT
    VALUE 'FX'
      ADD 1 TO #TYPE-FX-COUNT
    VALUE 'QD'
      ADD 1 TO #TYPE-QD-COUNT
    NONE VALUE
      IGNORE
  END-DECIDE
*
  * ESTIMATE TOTAL DISCOUNT
  * NOTE: THIS IS APPROXIMATE - ACTUAL DISCOUNT DEPENDS ON
  * ORDER DETAILS WHICH WE DON'T CROSS-REFERENCE HERE
  * TODO: LINK TO ORDER-LINE DISCOUNT TRACKING
  DECIDE ON FIRST VALUE OF PPV-DISC-TYPE
    VALUE 'PC'
      * ASSUME AVG ORDER LINE OF $50
      COMPUTE #PP-TOTAL-DISCOUNT(#PROMO-COUNT) =
        PPV-CURRENT-USES * 50 * PPV-DISC-VALUE / 100
    VALUE 'AM'
      COMPUTE #PP-TOTAL-DISCOUNT(#PROMO-COUNT) =
        PPV-CURRENT-USES * PPV-DISC-VALUE
    VALUE 'BG'
      * ASSUME AVG ITEM PRICE $25
      COMPUTE #PP-TOTAL-DISCOUNT(#PROMO-COUNT) =
        PPV-CURRENT-USES * 25
    VALUE 'FX'
      * CANNOT ESTIMATE WITHOUT KNOWING ORIGINAL PRICE
      MOVE 0 TO #PP-TOTAL-DISCOUNT(#PROMO-COUNT)
    VALUE 'QD'
      COMPUTE #PP-TOTAL-DISCOUNT(#PROMO-COUNT) =
        PPV-CURRENT-USES * PPV-DISC-VALUE
    NONE VALUE
      IGNORE
  END-DECIDE
*
  ADD #PP-TOTAL-DISCOUNT(#PROMO-COUNT) TO #TOTAL-DISC-AMT
  ADD PPV-CURRENT-USES TO #TOTAL-PROMO-ORDERS
END-READ
*
* -------------------------------------------------------
* STEP 2: LOAD COUPONS
* -------------------------------------------------------
READ PCV-VIEW BY PCV-ID
  IF #COUPON-COUNT >= #MAX-COUPONS
    ESCAPE BOTTOM
  END-IF
  ADD 1 TO #COUPON-COUNT
  MOVE PCV-ID              TO #CP-ID(#COUPON-COUNT)
  MOVE PCV-CODE            TO #CP-CODE(#COUPON-COUNT)
  MOVE PCV-DISC-TYPE       TO #CP-TYPE(#COUPON-COUNT)
  MOVE PCV-STATUS          TO #CP-STATUS(#COUPON-COUNT)
  MOVE PCV-DISC-VALUE      TO #CP-VALUE(#COUPON-COUNT)
  MOVE PCV-MAX-USES        TO #CP-MAX-USES(#COUPON-COUNT)
  MOVE PCV-CURRENT-USES    TO #CP-CURRENT-USES(#COUPON-COUNT)
  MOVE PCV-TOTAL-DISC-AMT  TO #CP-TOTAL-DISC(#COUPON-COUNT)
*
  IF #CP-MAX-USES(#COUPON-COUNT) > 0
    COMPUTE #CP-UTILIZATION(#COUPON-COUNT) =
      #CP-CURRENT-USES(#COUPON-COUNT)
      / #CP-MAX-USES(#COUPON-COUNT) * 100
  END-IF
*
  ADD PCV-CURRENT-USES    TO #TOTAL-COUPON-USES
  ADD PCV-TOTAL-DISC-AMT  TO #TOTAL-COUPON-DISC
END-READ
*
* -------------------------------------------------------
* OUTPUT REPORT
* -------------------------------------------------------
WRITE 'RETAILCORE - PROMOTION PERFORMANCE REPORT'
WRITE '=========================================='
WRITE 'PERIOD:' #START-DATE 'TO' #END-DATE
WRITE 'RUN DATE:' *DATX
WRITE ' '
*
* PROMOTION DETAIL
WRITE 'PROMOTION DETAIL'
WRITE '================'
WRITE 'PROMO-ID NAME                                     TY ST'
  '  USES   MAX   UTIL% EST DISCOUNT  STK'
WRITE '-------- ---------------------------------------- -- --'
  '  ----- -----  ----- -----------  ---'
*
FOR #IDX = 1 TO #PROMO-COUNT
  WRITE #PP-ID(#IDX)
    #PP-NAME(#IDX) (EM=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
    #PP-TYPE(#IDX) #PP-STATUS(#IDX)
    #PP-CURRENT-USES(#IDX) #PP-MAX-USES(#IDX)
    #PP-UTILIZATION(#IDX) '%'
    #PP-TOTAL-DISCOUNT(#IDX)
    #PP-STACKABLE(#IDX)
END-FOR
*
* TYPE BREAKDOWN
WRITE ' '
WRITE 'PROMOTION TYPE BREAKDOWN'
WRITE '========================'
WRITE 'PERCENTAGE (PC)  :' #TYPE-PC-COUNT 'PROMOTIONS'
WRITE 'FIXED AMOUNT (AM):' #TYPE-AM-COUNT 'PROMOTIONS'
WRITE 'BUY-GET (BG)     :' #TYPE-BG-COUNT 'PROMOTIONS'
WRITE 'FIXED PRICE (FX) :' #TYPE-FX-COUNT 'PROMOTIONS'
WRITE 'QTY DISCOUNT (QD):' #TYPE-QD-COUNT 'PROMOTIONS'
*
* COUPON SUMMARY
WRITE ' '
WRITE 'COUPON PERFORMANCE'
WRITE '=================='
WRITE 'COUPON-ID  CODE                 TY ST  VALUE  USES'
  '   MAX   UTIL% TOTAL DISC'
WRITE '----------  -------------------- -- --  -----  ----'
  '  -----  ----- ----------'
*
FOR #IDX = 1 TO #COUPON-COUNT
  IF #CP-CURRENT-USES(#IDX) > 0
    WRITE #CP-ID(#IDX)
      #CP-CODE(#IDX) (EM=XXXXXXXXXXXXXXXXXXXX)
      #CP-TYPE(#IDX) #CP-STATUS(#IDX)
      #CP-VALUE(#IDX) #CP-CURRENT-USES(#IDX)
      #CP-MAX-USES(#IDX) #CP-UTILIZATION(#IDX) '%'
      #CP-TOTAL-DISC(#IDX)
  END-IF
END-FOR
*
* TOP PERFORMERS (BY USAGE)
WRITE ' '
WRITE 'TOP 10 PROMOTIONS BY USAGE'
WRITE '=========================='
1 #TOP-COUNT (N4)
RESET #TOP-COUNT
FOR #IDX = 1 TO #PROMO-COUNT
  IF #PP-CURRENT-USES(#IDX) > 0
    ADD 1 TO #TOP-COUNT
    IF #TOP-COUNT <= 10
      WRITE #TOP-COUNT '.' #PP-ID(#IDX)
        #PP-NAME(#IDX) (EM=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
        'USES:' #PP-CURRENT-USES(#IDX)
        'EST DISC:' #PP-TOTAL-DISCOUNT(#IDX)
    END-IF
  END-IF
END-FOR
*
* WARNING: LOW UTILIZATION PROMOTIONS
WRITE ' '
WRITE 'LOW UTILIZATION WARNINGS (<10%)'
WRITE '================================'
FOR #IDX = 1 TO #PROMO-COUNT
  IF #PP-STATUS(#IDX) = 'A' AND #PP-MAX-USES(#IDX) > 0
    IF #PP-UTILIZATION(#IDX) < 10
      WRITE '  ** PROMO' #PP-ID(#IDX) #PP-NAME(#IDX)
        'UTIL:' #PP-UTILIZATION(#IDX) '%'
    END-IF
  END-IF
END-FOR
*
* OVERALL SUMMARY
WRITE ' '
WRITE 'SUMMARY'
WRITE '======='
WRITE 'TOTAL PROMOTIONS     :' #PROMO-COUNT
WRITE 'ACTIVE               :' #ACTIVE-PROMO-COUNT
WRITE 'INACTIVE             :' #INACTIVE-PROMO-COUNT
WRITE 'EXHAUSTED            :' #EXHAUSTED-PROMO-COUNT
WRITE 'TOTAL PROMO USES     :' #TOTAL-PROMO-ORDERS
WRITE 'EST PROMO DISCOUNT   :' #TOTAL-DISC-AMT
WRITE 'TOTAL COUPONS        :' #COUPON-COUNT
WRITE 'TOTAL COUPON USES    :' #TOTAL-COUPON-USES
WRITE 'TOTAL COUPON DISCOUNT:' #TOTAL-COUPON-DISC
*
WRITE ' '
WRITE '** NOTE: PROMOTION DISCOUNT AMOUNTS ARE ESTIMATED.'
WRITE '   ACTUAL VALUES REQUIRE ORDER-LEVEL DISCOUNT TRACKING.'
WRITE ' '
WRITE 'END OF REPORT'
*
END
