* >Natural Source Code: RET-COPY
* RETAILCORE - RETURNS AND REFUNDS DATA DEFINITIONS
* SHARED BY ALL RETURN-RELATED PROGRAMS
* CREATED: 2001-05-20
* MODIFIED: 2012-09-14 - ADDED INSPECTION FIELDS
* MODIFIED: 2018-03-22 - ADDED PARTIAL RETURN SUPPORT
* MODIFIED: 2023-07-05 - ADDED RETURN SHIPPING LABEL
* -------------------------------------------------------
*
* RETURN HEADER
*
1 RETURN-HEADER
  2 RET-ID                (N10)   /* RETURN IDENTIFIER */
  2 RET-NUMBER            (A12)   /* DISPLAY RETURN NUMBER */
  2 RET-ORDER-ID          (N10)   /* ORIGINAL ORDER */
  2 RET-CUST-ID           (N8)    /* CUSTOMER */
  2 RET-STORE-ID          (N4)    /* RETURN STORE - 0=MAIL */
  2 RET-STATUS            (A3)    /* REQ APR REJ RCV INS RST DMG REF CLS */
  2 RET-TYPE              (A2)    /* FU=FULL PA=PARTIAL EX=EXCHANGE */
  2 RET-REASON            (A4)    /* DEFN WRNG SIZE CHNM DMGD LATE OTHR */
  2 RET-REASON-TEXT       (A100)
  2 RET-REQUEST-DATE      (D)     /* DATE REQUESTED */
  2 RET-APPROVED-DATE     (D)     /* DATE APPROVED */
  2 RET-RECEIVED-DATE     (D)     /* DATE RECEIVED */
  2 RET-CLOSED-DATE       (D)     /* DATE CLOSED */
  2 RET-NUM-LINES         (N3)    /* NUMBER OF RETURN LINES */
*
* RETURN FINANCIAL
*
1 RETURN-FINANCIAL
  2 RET-ORIG-ORDER-AMT    (N11.2) /* ORIGINAL ORDER AMOUNT */
  2 RET-RETURN-AMT        (N11.2) /* RETURN AMOUNT */
  2 RET-RESTOCK-FEE       (N7.2)  /* RESTOCKING FEE */
  2 RET-SHIP-CHARGE       (N7.2)  /* RETURN SHIPPING CHARGE */
  2 RET-REFUND-AMT        (N11.2) /* NET REFUND AMOUNT */
  2 RET-TAX-REFUND        (N9.2)  /* TAX REFUND */
  2 RET-REFUND-METHOD     (A3)    /* ORIG=ORIGINAL METHOD SC=STORE CREDIT */
  2 RET-REFUND-STATUS     (A2)    /* PE=PENDING PR=PROCESSED FL=FAILED */
  2 RET-STORE-CREDIT-AMT  (N9.2)  /* STORE CREDIT ISSUED */
*
* RETURN LINE RECORD
*
1 RETURN-LINE-DATA
  2 RL-RETURN-ID          (N10)   /* RETURN REFERENCE */
  2 RL-LINE-NO            (N3)    /* LINE NUMBER */
  2 RL-ORDER-LINE-NO      (N3)    /* ORIGINAL ORDER LINE */
  2 RL-PROD-ID            (N8)    /* PRODUCT */
  2 RL-SKU                (A15)   /* SKU */
  2 RL-QTY-RETURNED       (N6)    /* QUANTITY RETURNED */
  2 RL-QTY-INSPECTED      (N6)    /* QUANTITY INSPECTED */
  2 RL-QTY-RESTOCKED      (N6)    /* QUANTITY PUT BACK IN STOCK */
  2 RL-QTY-DAMAGED        (N6)    /* QUANTITY DAMAGED */
  2 RL-UNIT-PRICE         (N9.2)  /* UNIT PRICE AT TIME OF SALE */
  2 RL-LINE-REFUND        (N11.2) /* LINE REFUND AMOUNT */
  2 RL-CONDITION          (A2)    /* NW=NEW OP=OPENED US=USED DM=DAMAGED DF=DEFECTIVE */
  2 RL-DISPOSITION        (A2)    /* RS=RESTOCK RT=RETURN-TO-VENDOR DS=DISPOSE DN=DONATE */
  2 RL-STATUS             (A3)    /* REQ RCV INS RST DMG REF */
  2 RL-REASON             (A4)    /* LINE-LEVEL REASON */
*
* RETURN INSPECTION
*
1 RETURN-INSPECTION
  2 RI-RETURN-ID          (N10)
  2 RI-LINE-NO            (N3)
  2 RI-INSPECTOR          (A8)    /* INSPECTOR USER ID */
  2 RI-DATE               (D)     /* INSPECTION DATE */
  2 RI-RESULT             (A2)    /* PA=PASS FL=FAIL PR=PARTIAL */
  2 RI-CONDITION          (A2)    /* ITEM CONDITION */
  2 RI-NOTES              (A200)
  2 RI-RESTOCKABLE        (A1)    /* Y N */
  2 RI-RESTOCK-VALUE      (N5.2)  /* PERCENTAGE OF VALUE */
*
* RETURN ELIGIBILITY WORK AREA
*
1 RETURN-ELIGIBILITY
  2 RE-ORDER-ID           (N10)
  2 RE-ORDER-DATE         (D)
  2 RE-SHIP-DATE          (D)
  2 RE-DELIVERY-DATE      (D)
  2 RE-RETURN-WINDOW      (N3)    /* DAYS ALLOWED */
  2 RE-WINDOW-EXPIRY      (D)     /* RETURN WINDOW EXPIRY DATE */
  2 RE-DAYS-REMAINING     (N3)
  2 RE-ELIGIBLE           (A1)    /* Y N */
  2 RE-REASON             (A60)   /* REASON IF NOT ELIGIBLE */
  2 RE-PROD-RETURNABLE    (A1)    /* Y N - PRODUCT LEVEL */
  2 RE-CLEARANCE-FLAG     (A1)    /* Y=CLEARANCE ITEM */
  2 RE-FINAL-SALE-FLAG    (A1)    /* Y=FINAL SALE */
*
* RETURN SHIPPING LABEL - ADDED 2023
*
1 RETURN-LABEL
  2 RLB-RETURN-ID         (N10)
  2 RLB-CARRIER           (A4)
  2 RLB-TRACKING-NO       (A30)
  2 RLB-LABEL-URL         (A100)
  2 RLB-GENERATED-DATE    (D)
  2 RLB-EXPIRY-DATE       (D)
*
* RETURN AUDIT
*
1 RETURN-AUDIT-DATA
  2 RET-CREATED-BY        (A8)
  2 RET-CREATED-DATE      (D)
  2 RET-MODIFIED-BY       (A8)
  2 RET-MODIFIED-DATE     (D)
  2 RET-APPROVED-BY       (A8)
*
END-DEFINE
