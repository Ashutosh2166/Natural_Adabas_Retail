* >Natural Source Code: CUSTSTAT
* SUBPROGRAM: CUSTSTAT - CUSTOMER STATUS MANAGEMENT
* DESCRIPTION: MANAGES CUSTOMER STATUS TRANSITIONS
*              ENFORCES VALID STATUS CHANGES
* LIBRARY: RETAILCORE
* ADABAS FILE: 100 (CUSTOMER)
* CREATED: 2001-08-15  M. JOHNSON
* MODIFIED: 2009-03-20 - ADDED CREDIT HOLD LOGIC
* MODIFIED: 2017-11-10 - ADDED SUSPENSION REASONS
* MODIFIED: 2022-06-30 - ADDED REACTIVATION RULES
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-CUST-ID             (N8)
  1 P-NEW-STATUS          (A1)    /* A I S D */
  1 P-REASON              (A60)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #CURRENT-STATUS       (A1)
  1 #VALID-TRANSITION     (A1)
  1 #USER-ID              (A8)
  1 #CUST-ID-STR          (A15)
  1 #OLD-STATUS-TEXT      (A15)
  1 #NEW-STATUS-TEXT      (A15)
  1 #HAS-OPEN-ORDERS      (A1)
  1 #ORDER-COUNT          (N4)
*
* CUSTOMER STATUS VIEW
  1 CUST-STAT-VIEW VIEW OF CUSTOMER-FILE
    2 CU-ID                (N8)
    2 CU-STATUS            (A1)
    2 CU-CREDIT-HOLD       (A1)
    2 CU-MODIFIED-DATE     (D)
    2 CU-MODIFIED-BY       (A8)
*
* ORDER CHECK VIEW
  1 ORD-CHECK-VIEW VIEW OF ORDER-FILE
    2 OC-CUST-ID           (N8)
    2 OC-STATUS            (A3)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
* -------------------------------------------------------
* VALIDATE NEW STATUS CODE
* -------------------------------------------------------
IF P-NEW-STATUS NE 'A' AND P-NEW-STATUS NE 'I'
    AND P-NEW-STATUS NE 'S' AND P-NEW-STATUS NE 'D'
  MOVE 5 TO P-RC
  MOVE 'INVALID STATUS CODE' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* GET CURRENT STATUS
* -------------------------------------------------------
FIND CUST-STAT-VIEW WITH CU-ID = P-CUST-ID
  IF NO RECORDS FOUND
    MOVE 1 TO P-RC
    MOVE 'CUSTOMER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  MOVE CU-STATUS TO #CURRENT-STATUS
  ESCAPE BOTTOM
END-FIND
*
* -------------------------------------------------------
* VALIDATE STATUS TRANSITION
* STATUS TRANSITION MATRIX:
*   FROM A -> I, S, D (NOT DIRECT TO D IF OPEN ORDERS)
*   FROM I -> A
*   FROM S -> A, I
*   FROM D -> (NONE - DELETED IS FINAL)
* -------------------------------------------------------
MOVE 'N' TO #VALID-TRANSITION
*
IF #CURRENT-STATUS = P-NEW-STATUS
  MOVE 8 TO P-RC
  MOVE 'STATUS UNCHANGED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST VALUE OF #CURRENT-STATUS
  VALUE 'A'
    IF P-NEW-STATUS = 'I' OR P-NEW-STATUS = 'S'
        OR P-NEW-STATUS = 'D'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'I'
    IF P-NEW-STATUS = 'A'
      * REACTIVATION RULES - MODIFIED 2022-06-30
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'S'
    IF P-NEW-STATUS = 'A' OR P-NEW-STATUS = 'I'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'D'
    * DELETED IS FINAL
    MOVE 'N' TO #VALID-TRANSITION
  NONE VALUE
    MOVE 'N' TO #VALID-TRANSITION
END-DECIDE
*
IF #VALID-TRANSITION NE 'Y'
  MOVE 406 TO P-RC
  COMPRESS 'INVALID STATUS TRANSITION FROM' #CURRENT-STATUS
    'TO' P-NEW-STATUS INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* CHECK FOR OPEN ORDERS BEFORE DELETE/SUSPEND
* -------------------------------------------------------
IF P-NEW-STATUS = 'D' OR P-NEW-STATUS = 'S'
  MOVE 'N' TO #HAS-OPEN-ORDERS
  RESET #ORDER-COUNT
  FIND ORD-CHECK-VIEW WITH OC-CUST-ID = P-CUST-ID
    IF OC-STATUS NE 'CMP' AND OC-STATUS NE 'CAN'
      ADD 1 TO #ORDER-COUNT
      MOVE 'Y' TO #HAS-OPEN-ORDERS
    END-IF
  END-FIND
*
  IF #HAS-OPEN-ORDERS = 'Y' AND P-NEW-STATUS = 'D'
    MOVE 403 TO P-RC
    COMPRESS 'CANNOT DELETE - HAS' #ORDER-COUNT
      'OPEN ORDERS' INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
END-IF
*
* -------------------------------------------------------
* APPLY STATUS CHANGE
* -------------------------------------------------------
FIND CUST-STAT-VIEW WITH CU-ID = P-CUST-ID
  GET CUST-STAT-VIEW *ISN (HOLD)
*
  ON ERROR
    IF *ERROR-NR = 145
      MOVE 305 TO P-RC
      MOVE 'CUSTOMER RECORD LOCKED BY ANOTHER USER' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
  END-ERROR
*
  MOVE P-NEW-STATUS TO CU-STATUS
  * SET CREDIT HOLD IF SUSPENDED
  IF P-NEW-STATUS = 'S'
    MOVE 'Y' TO CU-CREDIT-HOLD
  END-IF
  * CLEAR CREDIT HOLD ON REACTIVATION
  IF P-NEW-STATUS = 'A' AND #CURRENT-STATUS = 'S'
    MOVE 'N' TO CU-CREDIT-HOLD
  END-IF
  MOVE *DATX    TO CU-MODIFIED-DATE
  MOVE #USER-ID TO CU-MODIFIED-BY
  UPDATE CUST-STAT-VIEW
  ESCAPE BOTTOM
END-FIND
*
END OF TRANSACTION
*
* AUDIT TRAIL
MOVE P-CUST-ID TO #CUST-ID-STR
PERFORM GET-STATUS-TEXT
CALLNAT 'AUDITN' 'CUST' #CUST-ID-STR 'U' 'STATUS'
  #OLD-STATUS-TEXT #NEW-STATUS-TEXT P-REASON
*
* -------------------------------------------------------
DEFINE SUBROUTINE GET-STATUS-TEXT
  DECIDE ON FIRST VALUE OF #CURRENT-STATUS
    VALUE 'A'  MOVE 'ACTIVE'    TO #OLD-STATUS-TEXT
    VALUE 'I'  MOVE 'INACTIVE'  TO #OLD-STATUS-TEXT
    VALUE 'S'  MOVE 'SUSPENDED' TO #OLD-STATUS-TEXT
    VALUE 'D'  MOVE 'DELETED'   TO #OLD-STATUS-TEXT
    NONE VALUE MOVE 'UNKNOWN'   TO #OLD-STATUS-TEXT
  END-DECIDE
  DECIDE ON FIRST VALUE OF P-NEW-STATUS
    VALUE 'A'  MOVE 'ACTIVE'    TO #NEW-STATUS-TEXT
    VALUE 'I'  MOVE 'INACTIVE'  TO #NEW-STATUS-TEXT
    VALUE 'S'  MOVE 'SUSPENDED' TO #NEW-STATUS-TEXT
    VALUE 'D'  MOVE 'DELETED'   TO #NEW-STATUS-TEXT
    NONE VALUE MOVE 'UNKNOWN'   TO #NEW-STATUS-TEXT
  END-DECIDE
END-SUBROUTINE
*
END
