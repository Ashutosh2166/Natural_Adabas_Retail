* >Natural Source Code: PAYREC
* SUBPROGRAM: PAYREC - PAYMENT RECONCILIATION
* DESCRIPTION: RECONCILES PAYMENTS WITH SETTLEMENT RECORDS
*              MATCHES GATEWAY TRANSACTIONS TO ORDERS
*              IDENTIFIES DISCREPANCIES
* LIBRARY: RETAILCORE
* ADABAS FILES: 140 (PAYMENT), 143 (SETTLEMENT)
* CREATED: 2008-06-15  S. MARTINEZ
* MODIFIED: 2014-02-22 - ADDED BATCH SETTLEMENT
* MODIFIED: 2021-08-10 - ADDED AUTO-MATCH
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-RECON-DATE          (D)
  1 P-GATEWAY-ID          (A10)
  1 P-SUMMARY
    2 P-SM-TOTAL-PAYMENTS (N6)
    2 P-SM-TOTAL-CAPTURES (N6)
    2 P-SM-TOTAL-REFUNDS  (N6)
    2 P-SM-CAPTURE-AMT    (N11.2)
    2 P-SM-REFUND-AMT     (N11.2)
    2 P-SM-NET-AMT        (N11.2)
    2 P-SM-UNMATCHED      (N6)
    2 P-SM-DISCREPANCIES  (N6)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #SETTLE-AMT           (N11.2)
  1 #PAY-AMT              (N11.2)
  1 #DIFF                 (N11.2)
  1 #TOLERANCE            (N9.2)   INIT <0.01>
*
  1 PRC-VIEW VIEW OF PAYMENT-FILE
    2 PRC-ID               (N10)
    2 PRC-ORDER-ID         (N10)
    2 PRC-METHOD           (A2)
    2 PRC-STATUS           (A2)
    2 PRC-AMOUNT           (N11.2)
    2 PRC-CAPTURED-AMT     (N11.2)
    2 PRC-REFUNDED-AMT     (N11.2)
    2 PRC-AUTH-DATE        (D)
    2 PRC-GATEWAY-ID       (A10)
*
  1 SRC-VIEW VIEW OF SETTLEMENT-FILE
    2 SRC-PAY-ID           (N10)
    2 SRC-ORDER-ID         (N10)
    2 SRC-AMOUNT           (N11.2)
    2 SRC-TYPE             (A2)
    2 SRC-STATUS           (A2)
    2 SRC-DATE             (D)
    2 SRC-BATCH-ID         (A20)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
RESET P-SUMMARY
*
IF P-RECON-DATE = 0
  MOVE *DATX TO P-RECON-DATE
END-IF
*
* COUNT AND SUM PAYMENTS FOR THE DATE
FIND PRC-VIEW WITH PRC-AUTH-DATE = P-RECON-DATE
  IF P-GATEWAY-ID NE ' '
    IF PRC-GATEWAY-ID NE P-GATEWAY-ID
      ESCAPE TOP
    END-IF
  END-IF
*
  ADD 1 TO P-SM-TOTAL-PAYMENTS
*
  IF PRC-STATUS = 'CA' OR PRC-STATUS = 'FL'
    ADD 1 TO P-SM-TOTAL-CAPTURES
    ADD PRC-CAPTURED-AMT TO P-SM-CAPTURE-AMT
  END-IF
  IF PRC-REFUNDED-AMT > 0
    ADD 1 TO P-SM-TOTAL-REFUNDS
    ADD PRC-REFUNDED-AMT TO P-SM-REFUND-AMT
  END-IF
*
  * CHECK SETTLEMENT MATCH
  MOVE 'N' TO #SETTLE-FOUND
  REDEFINE #SETTLE-FOUND (A1)
  FIND SRC-VIEW WITH SRC-PAY-ID = PRC-ID
    IF NO RECORDS FOUND
      ADD 1 TO P-SM-UNMATCHED
      ESCAPE TOP
    END-NOREC
    MOVE SRC-AMOUNT TO #SETTLE-AMT
    * COMPARE AMOUNTS
    IF PRC-STATUS = 'CA' OR PRC-STATUS = 'FL'
      MOVE PRC-CAPTURED-AMT TO #PAY-AMT
    ELSE
      MOVE PRC-AMOUNT TO #PAY-AMT
    END-IF
    COMPUTE #DIFF = #PAY-AMT - #SETTLE-AMT
    IF #DIFF < 0
      MULTIPLY #DIFF BY -1
    END-IF
    IF #DIFF > #TOLERANCE
      ADD 1 TO P-SM-DISCREPANCIES
    END-IF
    ESCAPE BOTTOM
  END-FIND
*
END-FIND
*
COMPUTE P-SM-NET-AMT = P-SM-CAPTURE-AMT - P-SM-REFUND-AMT
*
IF P-SM-DISCREPANCIES > 0 OR P-SM-UNMATCHED > 0
  MOVE 750 TO P-RC
  COMPRESS P-SM-DISCREPANCIES 'DISCREPANCIES'
    P-SM-UNMATCHED 'UNMATCHED' INTO P-RC-TEXT
END-IF
*
END
