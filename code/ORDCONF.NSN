* >Natural Source Code: ORDCONF
* SUBPROGRAM: ORDCONF - ORDER CONFIRMATION
* DESCRIPTION: CONFIRMS ORDER AFTER ALL VALIDATIONS PASS
*              SENDS CONFIRMATION, TRIGGERS ALLOCATION
*              HANDLES FRAUD CHECK RESULT
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER)
* CREATED: 2006-02-15  S. MARTINEZ
* MODIFIED: 2017-08-22 - ADDED FRAUD CHECK INTEGRATION
* MODIFIED: 2020-11-10 - ADDED EMAIL CONFIRMATION
* MODIFIED: 2023-06-15 - ADDED PRIORITY ROUTING
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-SKIP-FRAUD          (A1)     /* Y=SKIP FRAUD CHECK */
  1 P-CONF-NUMBER         (A20)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #ORDER-STATUS         (A3)
  1 #ORDER-TOTAL          (N11.2)
  1 #CUST-ID              (N8)
  1 #ORDER-TYPE           (A2)
  1 #PRIORITY             (N1)
  1 #ORDER-NUMBER         (A12)
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A60)
  1 #FRAUD-SCORE          (N3)
  1 #FRAUD-FLAG           (A1)
  1 #FRAUD-MSG            (A60)
  1 #FRAUD-THRESHOLD      (N3)     INIT <70>
  1 #INV-LINES-OK         (N3)
  1 #INV-LINES-SHORT      (N3)
  1 #INV-ALL-AVAIL        (A1)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #CONF-SEQ             (N10)
  1 #ORD-STR              (A15)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 #INV-RESULTS (20)
    2 #IR-LINE-NO         (N3)
    2 #IR-SKU             (A15)
    2 #IR-QTY-REQ         (N6)
    2 #IR-QTY-AVAIL       (N8)
    2 #IR-STATUS          (A1)
    2 #IR-LOC-ID          (N6)
*
  1 OFC-VIEW VIEW OF ORDER-FILE
    2 OFC-ID               (N10)
    2 OFC-NUMBER           (A12)
    2 OFC-STATUS           (A3)
    2 OFC-CUST-ID          (N8)
    2 OFC-STORE-ID         (N4)
    2 OFC-TYPE             (A2)
    2 OFC-PRIORITY         (N1)
    2 OFC-TOTAL-AMT        (N11.2)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
RESET P-CONF-NUMBER
*
* GET ORDER DETAILS
FIND OFC-VIEW WITH OFC-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 404 TO P-RC
    MOVE 'ORDER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE OFC-STATUS    TO #ORDER-STATUS
  MOVE OFC-TOTAL-AMT TO #ORDER-TOTAL
  MOVE OFC-CUST-ID   TO #CUST-ID
  MOVE OFC-TYPE      TO #ORDER-TYPE
  MOVE OFC-PRIORITY  TO #PRIORITY
  MOVE OFC-NUMBER    TO #ORDER-NUMBER
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE ORDER IS IN CONFIRMABLE STATE
IF #ORDER-STATUS NE 'RES' AND #ORDER-STATUS NE 'VAL'
  MOVE 410 TO P-RC
  COMPRESS 'ORDER IN STATUS' #ORDER-STATUS
    'CANNOT BE CONFIRMED' INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* STEP 1: FRAUD CHECK (IF NOT SKIPPED)
* MODIFIED 2017-08-22
* -------------------------------------------------------
IF P-SKIP-FRAUD NE 'Y'
  PERFORM FRAUD-CHECK
  IF #FRAUD-FLAG = 'F'
    * FRAUD DETECTED - HOLD ORDER
    MOVE 450 TO P-RC
    MOVE #FRAUD-MSG TO P-RC-TEXT
    * POST TO HOLD STATUS
    CALLNAT 'ORDPOST' P-ORDER-ID 'VAL' #POST-FLAG #POST-MSG
    * LOG FRAUD EVENT
    MOVE P-ORDER-ID TO #ORD-STR
    CALLNAT 'AUDITN' 'ORD' #ORD-STR 'U' 'FRAUD'
      ' ' ' ' #FRAUD-MSG
    ESCAPE ROUTINE
  END-IF
END-IF
*
* -------------------------------------------------------
* STEP 2: VERIFY INVENTORY STILL AVAILABLE
* -------------------------------------------------------
FIND OFC-VIEW WITH OFC-ID = P-ORDER-ID
  CALLNAT 'ORDINV'
    P-ORDER-ID OFC-STORE-ID 'A'
    #INV-LINES-OK #INV-LINES-SHORT
    #INV-RESULTS #INV-ALL-AVAIL
    #INV-RC #INV-MSG
  ESCAPE BOTTOM
END-FIND
*
IF #INV-LINES-OK = 0
  MOVE 301 TO P-RC
  MOVE 'NO INVENTORY AVAILABLE FOR ORDER LINES' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* STEP 3: TRANSITION TO CONFIRMED
* -------------------------------------------------------
CALLNAT 'ORDPOST' P-ORDER-ID 'CON' #POST-FLAG #POST-MSG
IF #POST-FLAG NE 'Y'
  MOVE 420 TO P-RC
  MOVE #POST-MSG TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* STEP 4: GENERATE CONFIRMATION NUMBER
* -------------------------------------------------------
CALLNAT 'SEQNON' 'CONF' #CONF-SEQ
COMPRESS 'CONF-' #ORDER-NUMBER '-' #CONF-SEQ
  INTO P-CONF-NUMBER LEAVING NO SPACE
*
* -------------------------------------------------------
* STEP 5: PRIORITY ROUTING
* MODIFIED 2023-06-15
* -------------------------------------------------------
IF #PRIORITY = 1
  * RUSH ORDER - TRIGGER IMMEDIATE ALLOCATION
  CALLNAT 'ORDPOST' P-ORDER-ID 'PAD' #POST-FLAG #POST-MSG
  IF #POST-FLAG = 'Y'
    * AUTO-ALLOCATE
    PERFORM AUTO-ALLOCATE
  END-IF
END-IF
*
* AUDIT
MOVE P-ORDER-ID TO #ORD-STR
CALLNAT 'AUDITN' 'ORD' #ORD-STR 'U' 'CONF'
  #ORDER-STATUS 'CON' P-CONF-NUMBER
*
* -------------------------------------------------------
DEFINE SUBROUTINE FRAUD-CHECK
* SIMPLE FRAUD SCORING (MODIFIED 2017-08-22)
*
  RESET #FRAUD-SCORE
  MOVE 'P' TO #FRAUD-FLAG
*
  * GET FRAUD THRESHOLD FROM CONFIG
  CALLNAT 'CONFIGN' 'FRAUD.SCORE.THRESHOLD'
    #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
  IF #CONFIG-FOUND = 'Y'
    MOVE #CONFIG-NUM TO #FRAUD-THRESHOLD
  END-IF
*
  * RULE 1: HIGH VALUE ORDER (>5000)
  IF #ORDER-TOTAL > 5000
    ADD 20 TO #FRAUD-SCORE
  END-IF
  * RULE 2: VERY HIGH VALUE (>10000)
  IF #ORDER-TOTAL > 10000
    ADD 30 TO #FRAUD-SCORE
  END-IF
*
  * RULE 3: NEW CUSTOMER WITH HIGH VALUE
  * (SIMPLIFIED - SHOULD CHECK ACCOUNT AGE)
  * TODO: IMPLEMENT PROPER CUSTOMER AGE CHECK
  IF #ORDER-TOTAL > 2000
    ADD 10 TO #FRAUD-SCORE
  END-IF
*
  * RULE 4: WEB ORDER (HIGHER RISK)
  IF #ORDER-TYPE = 'WB'
    ADD 15 TO #FRAUD-SCORE
  END-IF
*
  * EVALUATE SCORE
  IF #FRAUD-SCORE >= #FRAUD-THRESHOLD
    MOVE 'F' TO #FRAUD-FLAG
    COMPRESS 'FRAUD SCORE' #FRAUD-SCORE '>=' #FRAUD-THRESHOLD
      INTO #FRAUD-MSG
  END-IF
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE AUTO-ALLOCATE
* RUSH ORDER AUTO-ALLOCATION
*
  1 #AA-RC (N4)
  1 #AA-MSG (A80)
*
  * TRIGGER ALLOCATION VIA FULFILLMENT
  CALLNAT 'ALLOCATE' P-ORDER-ID 'AUTO' 0
    #AA-RC #AA-MSG
  IF #AA-RC = 0
    CALLNAT 'ORDPOST' P-ORDER-ID 'ALC' #POST-FLAG #POST-MSG
  ELSE
    * LOG BUT DON'T FAIL
    CALLNAT 'LOGERR' 800 #AA-MSG 'W' 'ORDCONF' #USER-ID
  END-IF
*
END-SUBROUTINE
*
END
