* >Natural Source Code: RETPOST
* SUBPROGRAM: RETPOST - RETURN STATUS UPDATE
* DESCRIPTION: MANAGES RETURN STATUS TRANSITIONS
*              REQ -> APR -> RCV -> INS -> RST/DMG -> REF -> CLS
*              OR REJ AT APPROVAL
* LIBRARY: RETAILCORE
* ADABAS FILE: 150 (RETURN)
* CREATED: 2003-05-15  A. GARCIA
* MODIFIED: 2011-07-22 - ADDED INSPECTION WORKFLOW
* MODIFIED: 2018-01-10 - ADDED AUTO-APPROVE
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-RETURN-ID           (N10)
  1 P-NEW-STATUS          (A3)
  1 P-NOTES               (A80)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #CURRENT-STATUS       (A3)
  1 #VALID                (A1)
  1 #ORD-STR              (A15)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #PAY-RC               (N4)
  1 #PAY-MSG              (A80)
*
  1 RPS-VIEW VIEW OF RETURN-FILE
    2 RPS-ID               (N10)
    2 RPS-ORDER-ID         (N10)
    2 RPS-CUST-ID          (N8)
    2 RPS-STATUS           (A3)
    2 RPS-TOTAL-AMT        (N11.2)
    2 RPS-REFUND-METHOD    (A2)
*
  1 RLS-VIEW VIEW OF RETURN-LINE-FILE
    2 RLS-RETURN-ID        (N10)
    2 RLS-PROD-ID          (N8)
    2 RLS-SKU              (A15)
    2 RLS-QTY-RETURNED     (N6)
    2 RLS-CONDITION        (A1)
    2 RLS-STATUS           (A3)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
* GET CURRENT STATUS
FIND RPS-VIEW WITH RPS-ID = P-RETURN-ID
  IF NO RECORDS FOUND
    MOVE 904 TO P-RC
    MOVE 'RETURN NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE RPS-STATUS TO #CURRENT-STATUS
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE TRANSITION
MOVE 'N' TO #VALID
DECIDE ON FIRST VALUE OF #CURRENT-STATUS
  VALUE 'REQ'
    IF P-NEW-STATUS = 'APR' OR P-NEW-STATUS = 'REJ'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'APR'
    IF P-NEW-STATUS = 'RCV'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'RCV'
    IF P-NEW-STATUS = 'INS'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'INS'
    IF P-NEW-STATUS = 'RST' OR P-NEW-STATUS = 'DMG'
        OR P-NEW-STATUS = 'REF'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'RST'
    IF P-NEW-STATUS = 'REF'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'DMG'
    IF P-NEW-STATUS = 'REF'
      MOVE 'Y' TO #VALID
    END-IF
  VALUE 'REF'
    IF P-NEW-STATUS = 'CLS'
      MOVE 'Y' TO #VALID
    END-IF
  NONE VALUE
    IGNORE
END-DECIDE
*
IF #VALID NE 'Y'
  MOVE 910 TO P-RC
  COMPRESS 'INVALID RETURN TRANSITION:' #CURRENT-STATUS
    '->' P-NEW-STATUS INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* APPLY STATUS CHANGE
FIND RPS-VIEW WITH RPS-ID = P-RETURN-ID
  GET RPS-VIEW *ISN (HOLD)
  MOVE P-NEW-STATUS TO RPS-STATUS
  UPDATE RPS-VIEW
  ESCAPE BOTTOM
END-FIND
*
* UPDATE LINE STATUSES
FIND RLS-VIEW WITH RLS-RETURN-ID = P-RETURN-ID
  GET RLS-VIEW *ISN (HOLD)
  MOVE P-NEW-STATUS TO RLS-STATUS
  UPDATE RLS-VIEW
END-FIND
*
END OF TRANSACTION
*
* POST-STATUS ACTIONS
DECIDE ON FIRST VALUE OF P-NEW-STATUS
  VALUE 'RST'
    * RESTOCK: ADD BACK TO INVENTORY
    PERFORM RESTOCK-INVENTORY
  VALUE 'DMG'
    * DAMAGED: ADD AS DAMAGED INVENTORY
    PERFORM DAMAGE-INVENTORY
  VALUE 'REF'
    * REFUND: INITIATE PAYMENT REFUND
    PERFORM INITIATE-REFUND
  NONE VALUE
    IGNORE
END-DECIDE
*
* AUDIT
MOVE P-RETURN-ID TO #ORD-STR
CALLNAT 'AUDITN' 'RET' #ORD-STR 'U' 'RETST'
  #CURRENT-STATUS P-NEW-STATUS P-NOTES
*
* -------------------------------------------------------
DEFINE SUBROUTINE RESTOCK-INVENTORY
  FIND RLS-VIEW WITH RLS-RETURN-ID = P-RETURN-ID
    IF RLS-CONDITION = 'N' OR RLS-CONDITION = 'O'
      * NEW OR OPENED - RESTOCK
      CALLNAT 'INVUPD'
        RLS-PROD-ID RLS-SKU 0 ' ' RLS-QTY-RETURNED
        'RETN' 'RETURN RESTOCK' P-RETURN-ID 0
        #INV-RC #INV-MSG
      IF #INV-RC NE 0
        CALLNAT 'LOGERR' 301 #INV-MSG 'W' 'RETPOST' #USER-ID
      END-IF
    END-IF
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE DAMAGE-INVENTORY
  FIND RLS-VIEW WITH RLS-RETURN-ID = P-RETURN-ID
    CALLNAT 'INVUPD'
      RLS-PROD-ID RLS-SKU 0 ' ' RLS-QTY-RETURNED
      'DMGD' 'RETURN DAMAGED' P-RETURN-ID 0
      #INV-RC #INV-MSG
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE INITIATE-REFUND
  FIND RPS-VIEW WITH RPS-ID = P-RETURN-ID
    CALLNAT 'PAYREV'
      RPS-ORDER-ID RPS-TOTAL-AMT 'RETN' 'RET'
      #PAY-RC #PAY-MSG
    IF #PAY-RC NE 0
      CALLNAT 'LOGERR' 720 #PAY-MSG 'W' 'RETPOST' #USER-ID
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
END
