* >Natural Source Code: TAXCALC
* SUBPROGRAM: TAXCALC - TAX CALCULATION ENGINE
* DESCRIPTION: CALCULATES SALES TAX BY JURISDICTION
*              SUPPORTS STATE, COUNTY, CITY TAX RATES
*              HANDLES TAX-EXEMPT ITEMS AND CUSTOMERS
* LIBRARY: RETAILCORE
* ADABAS FILE: 124 (TAX-RATE)
* CREATED: 2003-02-15  A. GARCIA
* MODIFIED: 2010-08-22 - ADDED MULTI-JURISDICTION
* MODIFIED: 2017-04-10 - ADDED TAX-EXEMPT HANDLING
* MODIFIED: 2023-01-15 - ADDED TAX HOLIDAY
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-TAX-CODE            (A4)
  1 P-STATE-CODE          (A2)
  1 P-AMOUNT              (N11.2)
  1 P-TAX-EXEMPT          (A1)
  1 P-TAX-RATE            (N5.4)
  1 P-TAX-AMT             (N9.2)
  1 P-TAX-DETAIL
    2 P-TD-STATE-RATE     (N5.4)
    2 P-TD-COUNTY-RATE    (N5.4)
    2 P-TD-CITY-RATE      (N5.4)
    2 P-TD-SPECIAL-RATE   (N5.4)
    2 P-TD-TOTAL-RATE     (N5.4)
    2 P-TD-STATE-AMT      (N9.2)
    2 P-TD-COUNTY-AMT     (N9.2)
    2 P-TD-CITY-AMT       (N9.2)
    2 P-TD-TOTAL-AMT      (N9.2)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #TODAY                (D)
  1 #DEFAULT-RATE         (N5.4) INIT <0.0825>
  1 #FOUND                (A1)
  1 #HOLIDAY-ACTIVE       (A1)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 TX-VIEW VIEW OF TAX-RATE-FILE
    2 TX-CODE              (A4)
    2 TX-RATE              (N5.4)
    2 TX-STATE-CODE        (A2)
    2 TX-JURISDICTION      (A1)    /* S=STATE C=COUNTY T=CITY X=SPECIAL */
    2 TX-DESCRIPTION       (A40)
    2 TX-EFF-FROM          (D)
    2 TX-EFF-TO            (D)
    2 TX-STATUS            (A1)
*
* STATE TAX RATE TABLE (HARDCODED - LEGACY)
  1 #STATE-RATES (10)
    2 #SR-STATE            (A2)
    2 #SR-RATE             (N5.4)
END-DEFINE
*
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
RESET P-TAX-DETAIL
RESET P-TAX-AMT
RESET P-TAX-RATE
*
* CHECK TAX EXEMPT
IF P-TAX-EXEMPT = 'Y'
  MOVE 0 TO P-TAX-RATE
  MOVE 0 TO P-TAX-AMT
  ESCAPE ROUTINE
END-IF
*
* CHECK TAX HOLIDAY
CALLNAT 'CONFIGN' 'TAX.HOLIDAY.ACTIVE'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y' AND #CONFIG-FLAG = 'Y'
  * TAX HOLIDAY - NO TAX
  MOVE 0 TO P-TAX-RATE
  MOVE 0 TO P-TAX-AMT
  ESCAPE ROUTINE
END-IF
*
* TRY TAX CODE LOOKUP FIRST
IF P-TAX-CODE NE ' '
  MOVE 'N' TO #FOUND
  FIND TX-VIEW WITH TX-CODE = P-TAX-CODE
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    IF TX-STATUS = 'A'
      IF TX-EFF-FROM <= #TODAY AND TX-EFF-TO >= #TODAY
        DECIDE ON FIRST VALUE OF TX-JURISDICTION
          VALUE 'S'
            MOVE TX-RATE TO P-TD-STATE-RATE
          VALUE 'C'
            MOVE TX-RATE TO P-TD-COUNTY-RATE
          VALUE 'T'
            MOVE TX-RATE TO P-TD-CITY-RATE
          VALUE 'X'
            MOVE TX-RATE TO P-TD-SPECIAL-RATE
          NONE VALUE
            MOVE TX-RATE TO P-TD-STATE-RATE
        END-DECIDE
        MOVE 'Y' TO #FOUND
      END-IF
    END-IF
  END-FIND
  IF #FOUND = 'Y'
    COMPUTE P-TD-TOTAL-RATE = P-TD-STATE-RATE + P-TD-COUNTY-RATE
      + P-TD-CITY-RATE + P-TD-SPECIAL-RATE
    MOVE P-TD-TOTAL-RATE TO P-TAX-RATE
    * CALCULATE AMOUNTS
    COMPUTE P-TD-STATE-AMT = P-AMOUNT * P-TD-STATE-RATE
    COMPUTE P-TD-COUNTY-AMT = P-AMOUNT * P-TD-COUNTY-RATE
    COMPUTE P-TD-CITY-AMT = P-AMOUNT * P-TD-CITY-RATE
    COMPUTE P-TAX-AMT = P-AMOUNT * P-TAX-RATE
    MOVE P-TAX-AMT TO P-TD-TOTAL-AMT
    ESCAPE ROUTINE
  END-IF
END-IF
*
* FALLBACK: STATE-BASED LOOKUP
IF P-STATE-CODE NE ' '
  * HARDCODED STATE RATES (LEGACY - SHOULD USE TABLE)
  MOVE 'CA' TO #STATE-RATES.#SR-STATE(1)
  MOVE 0.0725 TO #STATE-RATES.#SR-RATE(1)
  MOVE 'NY' TO #STATE-RATES.#SR-STATE(2)
  MOVE 0.0800 TO #STATE-RATES.#SR-RATE(2)
  MOVE 'TX' TO #STATE-RATES.#SR-STATE(3)
  MOVE 0.0625 TO #STATE-RATES.#SR-RATE(3)
  MOVE 'FL' TO #STATE-RATES.#SR-STATE(4)
  MOVE 0.0600 TO #STATE-RATES.#SR-RATE(4)
  MOVE 'WA' TO #STATE-RATES.#SR-STATE(5)
  MOVE 0.0650 TO #STATE-RATES.#SR-RATE(5)
  MOVE 'IL' TO #STATE-RATES.#SR-STATE(6)
  MOVE 0.0625 TO #STATE-RATES.#SR-RATE(6)
  MOVE 'PA' TO #STATE-RATES.#SR-STATE(7)
  MOVE 0.0600 TO #STATE-RATES.#SR-RATE(7)
  MOVE 'OH' TO #STATE-RATES.#SR-STATE(8)
  MOVE 0.0575 TO #STATE-RATES.#SR-RATE(8)
  MOVE 'GA' TO #STATE-RATES.#SR-STATE(9)
  MOVE 0.0400 TO #STATE-RATES.#SR-RATE(9)
  MOVE 'NJ' TO #STATE-RATES.#SR-STATE(10)
  MOVE 0.0663 TO #STATE-RATES.#SR-RATE(10)
*
  1 #TI (N3)
  FOR #TI = 1 TO 10
    IF P-STATE-CODE = #STATE-RATES.#SR-STATE(#TI)
      MOVE #STATE-RATES.#SR-RATE(#TI) TO P-TAX-RATE
      MOVE P-TAX-RATE TO P-TD-STATE-RATE
      MOVE P-TAX-RATE TO P-TD-TOTAL-RATE
      COMPUTE P-TAX-AMT = P-AMOUNT * P-TAX-RATE
      MOVE P-TAX-AMT TO P-TD-STATE-AMT
      MOVE P-TAX-AMT TO P-TD-TOTAL-AMT
      ESCAPE ROUTINE
    END-IF
  END-FOR
END-IF
*
* FINAL FALLBACK: DEFAULT RATE
CALLNAT 'CONFIGN' 'TAX.DEFAULT.RATE'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  COMPUTE #DEFAULT-RATE = #CONFIG-NUM / 100
END-IF
MOVE #DEFAULT-RATE TO P-TAX-RATE
MOVE P-TAX-RATE TO P-TD-STATE-RATE
MOVE P-TAX-RATE TO P-TD-TOTAL-RATE
COMPUTE P-TAX-AMT = P-AMOUNT * P-TAX-RATE
MOVE P-TAX-AMT TO P-TD-TOTAL-AMT
*
END
