* >Natural Source Code: EODSALE
* PROGRAM: EODSALE - END OF DAY SALES SUMMARY
* DESCRIPTION: GENERATES DAILY SALES REPORT
*              BY STORE, PRODUCT CATEGORY, PAYMENT METHOD
*              UPDATES RUNNING TOTALS
* LIBRARY: RETAILCORE
* ADABAS FILES: 111 (ORDER), 112 (ORDER-LINE)
* CREATED: 2000-01-15  A. GARCIA
* MODIFIED: 2008-07-22 - ADDED CATEGORY BREAKDOWN
* MODIFIED: 2016-03-10 - ADDED PAYMENT METHOD SUMMARY
* MODIFIED: 2023-05-15 - ADDED CHANNEL ANALYSIS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
  1 #YESTERDAY            (D)
*
* OVERALL COUNTERS
  1 #TOTAL-ORDERS         (N8)
  1 #TOTAL-LINES          (N8)
  1 #TOTAL-QTY            (N8)
  1 #TOTAL-REVENUE        (N13.2)
  1 #TOTAL-COST           (N13.2)
  1 #TOTAL-DISCOUNT       (N11.2)
  1 #TOTAL-TAX            (N11.2)
  1 #TOTAL-RETURNS        (N8)
  1 #RETURN-AMT           (N11.2)
  1 #NET-REVENUE          (N13.2)
  1 #AVG-ORDER            (N11.2)
*
* STORE BREAKDOWN (UP TO 50 STORES)
  1 #STORE-DATA (50)
    2 #SD-STORE-ID        (N4)
    2 #SD-ORDERS          (N6)
    2 #SD-REVENUE         (N11.2)
    2 #SD-QTY             (N6)
  1 #STORE-COUNT          (N4)
*
* CHANNEL BREAKDOWN
  1 #CHANNEL-STORE-ORDERS (N8)
  1 #CHANNEL-STORE-REV    (N13.2)
  1 #CHANNEL-WEB-ORDERS   (N8)
  1 #CHANNEL-WEB-REV      (N13.2)
  1 #CHANNEL-PHONE-ORDERS (N8)
  1 #CHANNEL-PHONE-REV    (N13.2)
  1 #CHANNEL-MAIL-ORDERS  (N8)
  1 #CHANNEL-MAIL-REV     (N13.2)
*
  1 ESO-VIEW VIEW OF ORDER-FILE
    2 ESO-ID               (N10)
    2 ESO-STATUS           (A3)
    2 ESO-TYPE             (A2)
    2 ESO-STORE-ID         (N4)
    2 ESO-DATE             (D)
    2 ESO-NUM-LINES        (N3)
    2 ESO-TOTAL-QTY        (N6)
    2 ESO-SUBTOTAL         (N11.2)
    2 ESO-DISCOUNT-AMT     (N9.2)
    2 ESO-TAX-AMT          (N9.2)
    2 ESO-TOTAL-AMT        (N11.2)
*
  1 ERT-VIEW VIEW OF RETURN-FILE
    2 ERT-DATE             (D)
    2 ERT-STATUS           (A3)
    2 ERT-TOTAL-AMT        (N11.2)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE #TODAY TO #YESTERDAY
SUBTRACT 1 FROM #YESTERDAY (D)
*
WRITE 'RETAILCORE - DAILY SALES REPORT'
WRITE '================================'
WRITE 'REPORT DATE:' #TODAY
WRITE 'SALES DATE :' #YESTERDAY
WRITE ' '
*
RESET #STORE-COUNT
*
* PROCESS ORDERS FOR YESTERDAY
FIND ESO-VIEW WITH ESO-DATE = #YESTERDAY
  * SKIP CANCELLED
  IF ESO-STATUS = 'CAN'
    ESCAPE TOP
  END-IF
*
  ADD 1 TO #TOTAL-ORDERS
  ADD ESO-NUM-LINES   TO #TOTAL-LINES
  ADD ESO-TOTAL-QTY   TO #TOTAL-QTY
  ADD ESO-TOTAL-AMT   TO #TOTAL-REVENUE
  ADD ESO-DISCOUNT-AMT TO #TOTAL-DISCOUNT
  ADD ESO-TAX-AMT     TO #TOTAL-TAX
*
  * CHANNEL BREAKDOWN
  DECIDE ON FIRST VALUE OF ESO-TYPE
    VALUE 'ST'
      ADD 1 TO #CHANNEL-STORE-ORDERS
      ADD ESO-TOTAL-AMT TO #CHANNEL-STORE-REV
    VALUE 'WB'
      ADD 1 TO #CHANNEL-WEB-ORDERS
      ADD ESO-TOTAL-AMT TO #CHANNEL-WEB-REV
    VALUE 'PH'
      ADD 1 TO #CHANNEL-PHONE-ORDERS
      ADD ESO-TOTAL-AMT TO #CHANNEL-PHONE-REV
    VALUE 'MO'
      ADD 1 TO #CHANNEL-MAIL-ORDERS
      ADD ESO-TOTAL-AMT TO #CHANNEL-MAIL-REV
    NONE VALUE
      IGNORE
  END-DECIDE
*
  * STORE ACCUMULATION
  IF ESO-STORE-ID > 0
    1 #SI (N4)
    1 #STORE-FOUND (A1)
    MOVE 'N' TO #STORE-FOUND
    FOR #SI = 1 TO #STORE-COUNT
      IF #STORE-DATA.#SD-STORE-ID(#SI) = ESO-STORE-ID
        ADD 1 TO #STORE-DATA.#SD-ORDERS(#SI)
        ADD ESO-TOTAL-AMT TO #STORE-DATA.#SD-REVENUE(#SI)
        ADD ESO-TOTAL-QTY TO #STORE-DATA.#SD-QTY(#SI)
        MOVE 'Y' TO #STORE-FOUND
      END-IF
    END-FOR
    IF #STORE-FOUND NE 'Y' AND #STORE-COUNT < 50
      ADD 1 TO #STORE-COUNT
      MOVE ESO-STORE-ID TO #STORE-DATA.#SD-STORE-ID(#STORE-COUNT)
      MOVE 1 TO #STORE-DATA.#SD-ORDERS(#STORE-COUNT)
      MOVE ESO-TOTAL-AMT TO #STORE-DATA.#SD-REVENUE(#STORE-COUNT)
      MOVE ESO-TOTAL-QTY TO #STORE-DATA.#SD-QTY(#STORE-COUNT)
    END-IF
  END-IF
END-FIND
*
* COUNT RETURNS
FIND ERT-VIEW WITH ERT-DATE = #YESTERDAY
  IF ERT-STATUS NE 'REJ'
    ADD 1 TO #TOTAL-RETURNS
    ADD ERT-TOTAL-AMT TO #RETURN-AMT
  END-IF
END-FIND
*
* CALCULATE
COMPUTE #NET-REVENUE = #TOTAL-REVENUE - #RETURN-AMT
IF #TOTAL-ORDERS > 0
  COMPUTE #AVG-ORDER = #TOTAL-REVENUE / #TOTAL-ORDERS
END-IF
*
* PRINT OVERALL SUMMARY
WRITE 'OVERALL SUMMARY'
WRITE '==============='
WRITE 'TOTAL ORDERS     :' #TOTAL-ORDERS
WRITE 'TOTAL LINES      :' #TOTAL-LINES
WRITE 'TOTAL ITEMS SOLD :' #TOTAL-QTY
WRITE 'GROSS REVENUE    :' #TOTAL-REVENUE
WRITE 'DISCOUNTS        :' #TOTAL-DISCOUNT
WRITE 'TAX COLLECTED    :' #TOTAL-TAX
WRITE 'RETURNS          :' #TOTAL-RETURNS
WRITE 'RETURN AMOUNT    :' #RETURN-AMT
WRITE 'NET REVENUE      :' #NET-REVENUE
WRITE 'AVG ORDER VALUE  :' #AVG-ORDER
WRITE ' '
*
* PRINT CHANNEL BREAKDOWN
WRITE 'CHANNEL BREAKDOWN'
WRITE '================='
WRITE 'STORE  - ORDERS:' #CHANNEL-STORE-ORDERS
  'REVENUE:' #CHANNEL-STORE-REV
WRITE 'WEB    - ORDERS:' #CHANNEL-WEB-ORDERS
  'REVENUE:' #CHANNEL-WEB-REV
WRITE 'PHONE  - ORDERS:' #CHANNEL-PHONE-ORDERS
  'REVENUE:' #CHANNEL-PHONE-REV
WRITE 'MAIL   - ORDERS:' #CHANNEL-MAIL-ORDERS
  'REVENUE:' #CHANNEL-MAIL-REV
WRITE ' '
*
* PRINT STORE BREAKDOWN
IF #STORE-COUNT > 0
  WRITE 'STORE BREAKDOWN'
  WRITE '==============='
  1 #SJ (N4)
  FOR #SJ = 1 TO #STORE-COUNT
    WRITE 'STORE' #STORE-DATA.#SD-STORE-ID(#SJ)
      'ORDERS:' #STORE-DATA.#SD-ORDERS(#SJ)
      'REVENUE:' #STORE-DATA.#SD-REVENUE(#SJ)
      'QTY:' #STORE-DATA.#SD-QTY(#SJ)
  END-FOR
  WRITE ' '
END-IF
*
WRITE 'DAILY SALES REPORT COMPLETE'
*
CALLNAT 'AUDITN' 'ORD' 'EODSALE' 'U' 'BATCH'
  ' ' ' ' 'DAILY SALES REPORT GENERATED'
*
END
