* >Natural Source Code: ORDENTR
* PROGRAM: ORDENTR - ORDER ENTRY (ONLINE)
* DESCRIPTION: INTERACTIVE ORDER CREATION SCREEN
*              FULL END-TO-END ORDER PROCESSING
*              CUSTOMER->SKU->PRICE->INVENTORY->PAYMENT
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER)
* CREATED: 1998-10-01  A. GARCIA
* MODIFIED: 2004-05-20 - ADDED WEB ORDER SUPPORT
* MODIFIED: 2011-03-15 - ADDED PROMOTION HANDLING
* MODIFIED: 2017-08-22 - ADDED FRAUD CHECK
* MODIFIED: 2023-04-10 - ADDED PRIORITY ORDERS
* -------------------------------------------------------
DEFINE DATA
LOCAL USING ORD-COPY
LOCAL USING CUS-COPY
LOCAL USING PROD-COPY
LOCAL USING COMMON-COPY
LOCAL USING ERROR-COPY
*
LOCAL
  1 #SCREEN-MSG           (A78)
  1 #USER-ID              (A8)
  1 #NEW-ORDER-ID         (N10)
  1 #ORDER-NUMBER         (A12)
  1 #CUST-FOUND           (A1)
  1 #CUST-MSG             (A60)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #LINE-IDX             (N3)
  1 #MAX-LINES            (N2)    INIT <20>
  1 #PROD-ID              (N8)
  1 #PROD-NAME            (A60)
  1 #PROD-STATUS          (A1)
  1 #UNIT-PRICE           (N9.2)
  1 #TAX-CODE             (A4)
  1 #LINE-TOTAL           (N11.2)
  1 #ORDER-SUBTOTAL       (N11.2)
  1 #ORDER-TAX            (N9.2)
  1 #ORDER-TOTAL          (N11.2)
  1 #ORDER-DISCOUNT       (N9.2)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #PAY-RC               (N4)
  1 #PAY-MSG              (A80)
  1 #ORD-STR              (A15)
*
* ORDER LINE ARRAY
  1 #ORDER-LINES (20)
    2 #OL-SKU             (A15)
    2 #OL-QTY             (N6)
    2 #OL-UNIT-PRICE      (N9.2)
    2 #OL-DISCOUNT        (N9.2)
    2 #OL-TAX             (N9.2)
    2 #OL-TOTAL           (N11.2)
    2 #OL-PROD-ID         (N8)
    2 #OL-PROD-NAME       (A60)
    2 #OL-PROMO-ID        (N8)
*
* PRICING WORK AREA
  1 #PRICE-WORK
    2 #PW-PROD-ID         (N8)
    2 #PW-SKU             (A15)
    2 #PW-STORE-ID        (N4)
    2 #PW-CUST-ID         (N8)
    2 #PW-CUST-TYPE       (A2)
    2 #PW-QTY             (N6)
    2 #PW-BASE-PRICE      (N9.2)
    2 #PW-STORE-PRICE     (N9.2)
    2 #PW-CUST-PRICE      (N9.2)
    2 #PW-SEASONAL-PRICE  (N9.2)
    2 #PW-PROMO-PRICE     (N9.2)
    2 #PW-COUPON-DISCOUNT (N9.2)
    2 #PW-QTY-DISCOUNT    (N9.2)
    2 #PW-MEMBER-DISCOUNT (N9.2)
    2 #PW-CLEARANCE-PRICE (N9.2)
    2 #PW-FINAL-UNIT-PRICE (N9.2)
    2 #PW-TAX-RATE        (N5.4)
    2 #PW-TAX-AMT         (N9.2)
    2 #PW-FINAL-PRICE     (N9.2)
    2 #PW-DISCOUNT-TOTAL  (N9.2)
    2 #PW-MARGIN          (N9.2)
    2 #PW-MARGIN-PCT      (N5.2)
    2 #PW-PRICE-SOURCE    (A2)
    2 #PW-PROMO-APPLIED   (A1)
    2 #PW-COUPON-APPLIED  (A1)
*
* INVENTORY CHECK
  1 #INV-RESULT
    2 #IR-ON-HAND         (N8)
    2 #IR-RESERVED        (N8)
    2 #IR-ALLOCATED       (N8)
    2 #IR-DAMAGED         (N8)
    2 #IR-IN-TRANSIT      (N8)
    2 #IR-AVAILABLE       (N8)
    2 #IR-SAFETY-STOCK    (N8)
    2 #IR-REORDER-LEVEL   (N8)
    2 #IR-BELOW-SAFETY    (A1)
    2 #IR-BELOW-REORDER   (A1)
    2 #IR-SUFFICIENT      (A1)
*
  1 ORD-VIEW VIEW OF ORDER-FILE
    2 OV-ID                (N10)
    2 OV-NUMBER            (A12)
    2 OV-CUST-ID           (N8)
    2 OV-STORE-ID          (N4)
    2 OV-STATUS            (A3)
    2 OV-TYPE              (A2)
    2 OV-SOURCE            (A4)
    2 OV-PRIORITY          (N1)
    2 OV-DATE              (D)
    2 OV-TIME              (T)
    2 OV-NUM-LINES         (N3)
    2 OV-TOTAL-QTY         (N6)
    2 OV-SUBTOTAL          (N11.2)
    2 OV-DISCOUNT-AMT      (N9.2)
    2 OV-TAX-AMT           (N9.2)
    2 OV-TOTAL-AMT         (N11.2)
    2 OV-CURRENCY          (A3)
    2 OV-CREATED-DATE      (D)
    2 OV-CREATED-BY        (A8)
*
  1 OL-VIEW VIEW OF ORDER-LINE-FILE
    2 LV-ORDER-ID          (N10)
    2 LV-LINE-NO           (N3)
    2 LV-PROD-ID           (N8)
    2 LV-SKU               (A15)
    2 LV-DESCRIPTION       (A60)
    2 LV-QTY-ORDERED       (N6)
    2 LV-UNIT-PRICE        (N9.2)
    2 LV-ORIG-PRICE        (N9.2)
    2 LV-DISCOUNT-AMT      (N9.2)
    2 LV-TAX-AMT           (N9.2)
    2 LV-LINE-TOTAL        (N11.2)
    2 LV-STATUS            (A3)
    2 LV-PROMO-ID          (N8)
END-DEFINE
*
* -------------------------------------------------------
* MAIN PROCESSING
* -------------------------------------------------------
MOVE *USER TO #USER-ID
*
* STEP 1: CUSTOMER ENTRY
INPUT (IP=ON) WITH TEXT #SCREEN-MSG
  / 'RETAILCORE - NEW ORDER' (I)
  / '======================' (I)
  /
  / 'CUSTOMER ID:' ORD-CUST-ID (AD=MI)
  / 'STORE ID   :' ORD-STORE-ID (AD=MI)
  / 'ORDER TYPE :' ORD-TYPE (AD=MI) '(ST=STORE WB=WEB PH=PHONE)'
  / 'PRIORITY   :' ORD-PRIORITY (AD=MI) '(1=RUSH 2=HIGH 3=NORMAL)'
  /
  / 'PF3=CANCEL ENTER=CONTINUE'
*
IF *PF-KEY = 'PF3'
  ESCAPE ROUTINE
END-IF
*
* VALIDATE CUSTOMER
CALLNAT 'CUSTVAL-BRIEF'
  ORD-CUST-ID #CUST-FOUND #CUST-MSG
IF #CUST-FOUND NE 'Y'
  MOVE #CUST-MSG TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK FOR DUPLICATE ORDER
* MODIFIED 2017-08-22
CALLNAT 'ORDDUP' ORD-CUST-ID #VALID-FLAG #ERROR-MSG
IF #VALID-FLAG NE 'Y'
  MOVE #ERROR-MSG TO #SCREEN-MSG
  * CONTINUE ANYWAY - JUST WARN
END-IF
*
* STEP 2: ORDER LINE ENTRY
RESET #ORDER-SUBTOTAL
RESET #ORDER-TAX
RESET #ORDER-DISCOUNT
RESET #LINE-IDX
*
REPEAT
  ADD 1 TO #LINE-IDX
  IF #LINE-IDX > #MAX-LINES
    ESCAPE BOTTOM
  END-IF
*
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'ORDER LINE' #LINE-IDX (AD=OI)
    / 'SKU     :' #ORDER-LINES.#OL-SKU(#LINE-IDX) (AD=MI)
    / 'QUANTITY :' #ORDER-LINES.#OL-QTY(#LINE-IDX) (AD=MI)
    / 'PF3=DONE ADDING LINES  ENTER=ADD LINE'
*
  IF *PF-KEY = 'PF3'
    SUBTRACT 1 FROM #LINE-IDX
    ESCAPE BOTTOM
  END-IF
*
  IF #ORDER-LINES.#OL-SKU(#LINE-IDX) = ' '
    SUBTRACT 1 FROM #LINE-IDX
    ESCAPE BOTTOM
  END-IF
*
  * VALIDATE SKU
  CALLNAT 'SKUVAL'
    #ORDER-LINES.#OL-SKU(#LINE-IDX) ' '
    #PROD-ID #PROD-NAME #PROD-STATUS #UNIT-PRICE #TAX-CODE
    #VALID-FLAG #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    MOVE #ERROR-MSG TO #SCREEN-MSG
    SUBTRACT 1 FROM #LINE-IDX
    ESCAPE TOP
  END-IF
*
  MOVE #PROD-ID   TO #ORDER-LINES.#OL-PROD-ID(#LINE-IDX)
  MOVE #PROD-NAME TO #ORDER-LINES.#OL-PROD-NAME(#LINE-IDX)
*
  * CALCULATE PRICE VIA PRICING ENGINE
  * CALLS ORDPRICE2 (NEW VERSION) - MODIFIED 2011-03-15
  MOVE #PROD-ID      TO #PW-PROD-ID
  MOVE #ORDER-LINES.#OL-SKU(#LINE-IDX) TO #PW-SKU
  MOVE ORD-STORE-ID  TO #PW-STORE-ID
  MOVE ORD-CUST-ID   TO #PW-CUST-ID
  MOVE #ORDER-LINES.#OL-QTY(#LINE-IDX) TO #PW-QTY
*
  CALLNAT 'ORDPRICE2'
    #PRICE-WORK
    #VALID-FLAG
    #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    * FALLBACK TO OLD PRICING - LEGACY COMPATIBILITY LOGIC
    CALLNAT 'ORDPRICE'
      #PROD-ID ORD-STORE-ID ORD-CUST-ID
      #ORDER-LINES.#OL-QTY(#LINE-IDX)
      #UNIT-PRICE #ORDER-LINES.#OL-DISCOUNT(#LINE-IDX)
      #ORDER-LINES.#OL-TAX(#LINE-IDX)
      #VALID-FLAG #ERROR-MSG
    IF #VALID-FLAG NE 'Y'
      MOVE #ERROR-MSG TO #SCREEN-MSG
      SUBTRACT 1 FROM #LINE-IDX
      ESCAPE TOP
    END-IF
    MOVE #UNIT-PRICE TO #ORDER-LINES.#OL-UNIT-PRICE(#LINE-IDX)
  ELSE
    MOVE #PW-FINAL-UNIT-PRICE TO #ORDER-LINES.#OL-UNIT-PRICE(#LINE-IDX)
    MOVE #PW-DISCOUNT-TOTAL   TO #ORDER-LINES.#OL-DISCOUNT(#LINE-IDX)
    MOVE #PW-TAX-AMT          TO #ORDER-LINES.#OL-TAX(#LINE-IDX)
  END-IF
*
  * CALCULATE LINE TOTAL
  COMPUTE #ORDER-LINES.#OL-TOTAL(#LINE-IDX) =
    (#ORDER-LINES.#OL-UNIT-PRICE(#LINE-IDX)
    * #ORDER-LINES.#OL-QTY(#LINE-IDX))
    - #ORDER-LINES.#OL-DISCOUNT(#LINE-IDX)
    + #ORDER-LINES.#OL-TAX(#LINE-IDX)
*
  ADD #ORDER-LINES.#OL-TOTAL(#LINE-IDX) TO #ORDER-SUBTOTAL
  ADD #ORDER-LINES.#OL-TAX(#LINE-IDX) TO #ORDER-TAX
  ADD #ORDER-LINES.#OL-DISCOUNT(#LINE-IDX) TO #ORDER-DISCOUNT
*
  COMPRESS 'LINE' #LINE-IDX ':' #PROD-NAME 'ADDED' INTO #SCREEN-MSG
*
END-REPEAT
*
IF #LINE-IDX = 0
  MOVE 'NO ORDER LINES ENTERED' TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* COMPUTE ORDER TOTAL
COMPUTE #ORDER-TOTAL = #ORDER-SUBTOTAL
*
* STEP 3: CONFIRM ORDER
INPUT (IP=ON)
  / 'ORDER CONFIRMATION' (I)
  / '==================' (I)
  / 'CUSTOMER :' ORD-CUST-ID (AD=OI)
  / 'LINES    :' #LINE-IDX (AD=OI)
  / 'SUBTOTAL :' #ORDER-SUBTOTAL (AD=OI)
  / 'DISCOUNT :' #ORDER-DISCOUNT (AD=OI)
  / 'TAX      :' #ORDER-TAX (AD=OI)
  / 'TOTAL    :' #ORDER-TOTAL (AD=OI)
  /
  / 'PF3=CANCEL  ENTER=PLACE ORDER'
*
IF *PF-KEY = 'PF3'
  MOVE 'ORDER CANCELLED' TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* STEP 4: VALIDATE COMPLETE ORDER
CALLNAT 'ORDVAL'
  ORD-CUST-ID ORD-STORE-ID ORD-TYPE #LINE-IDX
  #VALID-FLAG #ERROR-MSG
IF #VALID-FLAG NE 'Y'
  MOVE #ERROR-MSG TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* STEP 5: CREATE ORDER
CALLNAT 'SEQNON' 'ORD' #NEW-ORDER-ID
COMPRESS 'ORD-' #NEW-ORDER-ID INTO #ORDER-NUMBER LEAVING NO SPACE
*
STORE ORD-VIEW
  OV-ID           := #NEW-ORDER-ID
  OV-NUMBER       := #ORDER-NUMBER
  OV-CUST-ID      := ORD-CUST-ID
  OV-STORE-ID     := ORD-STORE-ID
  OV-STATUS       := 'NEW'
  OV-TYPE         := ORD-TYPE
  OV-SOURCE       := 'POS'
  OV-PRIORITY     := ORD-PRIORITY
  OV-DATE         := *DATX
  OV-TIME         := *TIMESTMP
  OV-NUM-LINES    := #LINE-IDX
  OV-SUBTOTAL     := #ORDER-SUBTOTAL
  OV-DISCOUNT-AMT := #ORDER-DISCOUNT
  OV-TAX-AMT      := #ORDER-TAX
  OV-TOTAL-AMT    := #ORDER-TOTAL
  OV-CURRENCY     := 'USD'
  OV-CREATED-DATE := *DATX
  OV-CREATED-BY   := #USER-ID
END-STORE
*
ON ERROR
  COMPRESS 'ORDER CREATE FAILED:' *ERROR-NR INTO #SCREEN-MSG
  CALLNAT 'LOGERR' 400 #SCREEN-MSG 'E' 'ORDENTR' #USER-ID
  BACKOUT TRANSACTION
  ESCAPE ROUTINE
END-ERROR
*
* STORE ORDER LINES
PERFORM STORE-ORDER-LINES
*
END OF TRANSACTION
*
* STEP 6: RESERVE INVENTORY FOR EACH LINE
PERFORM RESERVE-INVENTORY
*
* STEP 7: POST ORDER (STATUS->RESERVED)
CALLNAT 'ORDPOST' #NEW-ORDER-ID 'RES' #VALID-FLAG #ERROR-MSG
*
* UPDATE CUSTOMER LAST ORDER
CALLNAT 'CUSTUPD' ORD-CUST-ID 'ORDR' ' ' 0 ' ' 0
  *DATX 0 ' '
*
MOVE #NEW-ORDER-ID TO #ORD-STR
CALLNAT 'AUDITN' 'ORD' #ORD-STR 'C' 'ORDER'
  ' ' #ORDER-NUMBER 'NEW ORDER CREATED'
*
COMPRESS 'ORDER' #ORDER-NUMBER 'CREATED SUCCESSFULLY'
  INTO #SCREEN-MSG
*
* -------------------------------------------------------
* STORE ORDER LINES
* -------------------------------------------------------
DEFINE SUBROUTINE STORE-ORDER-LINES
  1 #LN (N3)
  FOR #LN = 1 TO #LINE-IDX
    STORE OL-VIEW
      LV-ORDER-ID    := #NEW-ORDER-ID
      LV-LINE-NO     := #LN
      LV-PROD-ID     := #ORDER-LINES.#OL-PROD-ID(#LN)
      LV-SKU         := #ORDER-LINES.#OL-SKU(#LN)
      LV-DESCRIPTION := #ORDER-LINES.#OL-PROD-NAME(#LN)
      LV-QTY-ORDERED := #ORDER-LINES.#OL-QTY(#LN)
      LV-UNIT-PRICE  := #ORDER-LINES.#OL-UNIT-PRICE(#LN)
      LV-DISCOUNT-AMT := #ORDER-LINES.#OL-DISCOUNT(#LN)
      LV-TAX-AMT     := #ORDER-LINES.#OL-TAX(#LN)
      LV-LINE-TOTAL  := #ORDER-LINES.#OL-TOTAL(#LN)
      LV-STATUS      := 'NEW'
      LV-PROMO-ID    := #ORDER-LINES.#OL-PROMO-ID(#LN)
    END-STORE
  END-FOR
END-SUBROUTINE
*
* -------------------------------------------------------
* RESERVE INVENTORY FOR ALL LINES
* -------------------------------------------------------
DEFINE SUBROUTINE RESERVE-INVENTORY
  1 #RI (N3)
  FOR #RI = 1 TO #LINE-IDX
    CALLNAT 'INVRES'
      #NEW-ORDER-ID #RI
      #ORDER-LINES.#OL-PROD-ID(#RI)
      #ORDER-LINES.#OL-SKU(#RI)
      'A' 0
      #ORDER-LINES.#OL-QTY(#RI)
      ' ' ' ' ' ' ' '
      #INV-RC #INV-MSG
    IF #INV-RC NE 0
      * LOG BUT DON'T FAIL THE ORDER
      CALLNAT 'LOGERR' 301 #INV-MSG 'W' 'ORDENTR' #USER-ID
    END-IF
  END-FOR
END-SUBROUTINE
*
* -------------------------------------------------------
* BRIEF CUSTOMER VALIDATION (INLINE)
* -------------------------------------------------------
DEFINE SUBROUTINE CUSTVAL-BRIEF
  PARAMETER
    1 PB-CUST-ID          (N8)
    1 PB-FOUND            (A1)
    1 PB-MSG              (A60)
*
  1 CV-VIEW VIEW OF CUSTOMER-FILE
    2 CV-ID                (N8)
    2 CV-STATUS            (A1)
    2 CV-CREDIT-HOLD       (A1)
*
  MOVE 'N' TO PB-FOUND
  FIND CV-VIEW WITH CV-ID = PB-CUST-ID
    IF NO RECORDS FOUND
      MOVE 'CUSTOMER NOT FOUND' TO PB-MSG
      ESCAPE ROUTINE
    END-NOREC
    IF CV-STATUS NE 'A'
      MOVE 'CUSTOMER NOT ACTIVE' TO PB-MSG
      ESCAPE ROUTINE
    END-IF
    IF CV-CREDIT-HOLD = 'Y'
      MOVE 'CUSTOMER ON CREDIT HOLD' TO PB-MSG
      ESCAPE ROUTINE
    END-IF
    MOVE 'Y' TO PB-FOUND
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
END
