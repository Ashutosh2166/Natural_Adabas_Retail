* >Natural Source Code: EODPROM
* PROGRAM: EODPROM - END OF DAY PROMOTION PROCESSING
* DESCRIPTION: BATCH PROGRAM FOR DAILY PROMOTION MAINTENANCE
*              ACTIVATES/DEACTIVATES PROMOTIONS BY DATE
*              UPDATES USAGE COUNTS, GENERATES PERFORMANCE REPORT
* LIBRARY: RETAILCORE
* ADABAS FILE: 121 (PROMOTION)
* CREATED: 2008-02-15  S. MARTINEZ
* MODIFIED: 2014-08-22 - ADDED AUTO-DEACTIVATION
* MODIFIED: 2021-03-10 - ADDED PERFORMANCE METRICS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
  1 #TOTAL-PROMOS         (N6)
  1 #ACTIVATED            (N6)
  1 #DEACTIVATED          (N6)
  1 #EXHAUSTED            (N6)
  1 #EXPIRING-SOON        (N6)
  1 #EXPIRE-WARN-DAYS     (N4)    INIT <7>
  1 #EXPIRE-WARN-DATE     (D)
*
  1 EPM-VIEW VIEW OF PROMOTION-FILE
    2 EPM-ID               (N8)
    2 EPM-NAME             (A40)
    2 EPM-STATUS           (A1)
    2 EPM-START-DATE       (D)
    2 EPM-END-DATE         (D)
    2 EPM-MAX-USES         (N6)
    2 EPM-CURRENT-USES     (N6)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE #TODAY TO #EXPIRE-WARN-DATE
ADD #EXPIRE-WARN-DAYS TO #EXPIRE-WARN-DATE (D)
*
WRITE 'RETAILCORE - END OF DAY PROMOTION PROCESSING'
WRITE '=============================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
READ EPM-VIEW BY EPM-ID
  ADD 1 TO #TOTAL-PROMOS
*
  * AUTO-ACTIVATE SCHEDULED PROMOTIONS
  IF EPM-STATUS = 'I'
    IF EPM-START-DATE <= #TODAY AND EPM-END-DATE >= #TODAY
      GET EPM-VIEW *ISN (HOLD)
      MOVE 'A' TO EPM-STATUS
      UPDATE EPM-VIEW
      ADD 1 TO #ACTIVATED
      WRITE '  ACTIVATED:' EPM-NAME
    END-IF
  END-IF
*
  * AUTO-DEACTIVATE EXPIRED PROMOTIONS
  IF EPM-STATUS = 'A'
    IF EPM-END-DATE < #TODAY
      GET EPM-VIEW *ISN (HOLD)
      MOVE 'I' TO EPM-STATUS
      UPDATE EPM-VIEW
      ADD 1 TO #DEACTIVATED
      WRITE '  DEACTIVATED (EXPIRED):' EPM-NAME
    END-IF
  END-IF
*
  * AUTO-EXHAUST MAXED OUT PROMOTIONS
  IF EPM-STATUS = 'A' AND EPM-MAX-USES > 0
    IF EPM-CURRENT-USES >= EPM-MAX-USES
      GET EPM-VIEW *ISN (HOLD)
      MOVE 'X' TO EPM-STATUS
      UPDATE EPM-VIEW
      ADD 1 TO #EXHAUSTED
      WRITE '  EXHAUSTED:' EPM-NAME
    END-IF
  END-IF
*
  * WARN ABOUT EXPIRING SOON
  IF EPM-STATUS = 'A'
    IF EPM-END-DATE <= #EXPIRE-WARN-DATE
      ADD 1 TO #EXPIRING-SOON
    END-IF
  END-IF
*
  IF *COUNTER = 100
    END OF TRANSACTION
  END-IF
END-READ
*
END OF TRANSACTION
*
WRITE ' '
WRITE 'PROMOTION SUMMARY'
WRITE '================='
WRITE 'TOTAL PROMOTIONS    :' #TOTAL-PROMOS
WRITE 'AUTO-ACTIVATED      :' #ACTIVATED
WRITE 'AUTO-DEACTIVATED    :' #DEACTIVATED
WRITE 'AUTO-EXHAUSTED      :' #EXHAUSTED
WRITE 'EXPIRING IN' #EXPIRE-WARN-DAYS 'DAYS:' #EXPIRING-SOON
WRITE ' '
WRITE 'EOD PROMOTION PROCESSING COMPLETE'
*
CALLNAT 'AUDITN' 'PROM' 'EODPROM' 'U' 'BATCH'
  ' ' ' ' 'EOD PROMOTION PROCESSING COMPLETE'
*
END
