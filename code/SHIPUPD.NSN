* >Natural Source Code: SHIPUPD
* SUBPROGRAM: SHIPUPD - SHIPMENT STATUS UPDATE
* DESCRIPTION: UPDATES SHIPMENT THROUGH FULFILLMENT STAGES
*              PICKED -> PACKED -> SHIPPED -> DELIVERED
* LIBRARY: RETAILCORE
* ADABAS FILE: 141 (SHIPMENT)
* CREATED: 2006-04-15  S. MARTINEZ
* MODIFIED: 2013-09-22 - ADDED DELIVERY CONFIRMATION
* MODIFIED: 2020-02-10 - ADDED TRACKING EVENTS
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SHIP-ID             (N10)
  1 P-NEW-STATUS          (A2)    /* PK PD SH DL */
  1 P-NOTES               (A80)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #CURRENT-STATUS       (A2)
  1 #ORDER-ID             (N10)
  1 #VALID                (A1)
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A60)
  1 #ORD-STR              (A15)
*
  1 SUP-VIEW VIEW OF SHIPMENT-FILE
    2 SUP-ID               (N10)
    2 SUP-ORDER-ID         (N10)
    2 SUP-STATUS           (A2)
    2 SUP-SHIP-DATE        (D)
    2 SUP-DELIVERED-DATE   (D)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
FIND SUP-VIEW WITH SUP-ID = P-SHIP-ID
  IF NO RECORDS FOUND
    MOVE 804 TO P-RC
    MOVE 'SHIPMENT NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE SUP-STATUS   TO #CURRENT-STATUS
  MOVE SUP-ORDER-ID TO #ORDER-ID
*
  * VALIDATE TRANSITION
  MOVE 'N' TO #VALID
  DECIDE ON FIRST VALUE OF #CURRENT-STATUS
    VALUE 'CR'
      IF P-NEW-STATUS = 'PK' OR P-NEW-STATUS = 'SH'
        MOVE 'Y' TO #VALID
      END-IF
    VALUE 'PK'
      IF P-NEW-STATUS = 'PD' OR P-NEW-STATUS = 'SH'
        MOVE 'Y' TO #VALID
      END-IF
    VALUE 'PD'
      IF P-NEW-STATUS = 'SH'
        MOVE 'Y' TO #VALID
      END-IF
    VALUE 'SH'
      IF P-NEW-STATUS = 'DL'
        MOVE 'Y' TO #VALID
      END-IF
    NONE VALUE
      IGNORE
  END-DECIDE
*
  IF #VALID NE 'Y'
    MOVE 811 TO P-RC
    COMPRESS 'INVALID SHIPMENT TRANSITION:' #CURRENT-STATUS
      '->' P-NEW-STATUS INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * APPLY UPDATE
  GET SUP-VIEW *ISN (HOLD)
  MOVE P-NEW-STATUS TO SUP-STATUS
  IF P-NEW-STATUS = 'SH'
    MOVE *DATX TO SUP-SHIP-DATE
  END-IF
  IF P-NEW-STATUS = 'DL'
    MOVE *DATX TO SUP-DELIVERED-DATE
  END-IF
  UPDATE SUP-VIEW
  END OF TRANSACTION
  ESCAPE BOTTOM
END-FIND
*
* ON DELIVERY: COMPLETE ORDER
IF P-NEW-STATUS = 'DL'
  * CHECK IF ALL SHIPMENTS DELIVERED
  1 #ALL-DELIVERED (A1)
  MOVE 'Y' TO #ALL-DELIVERED
  FIND SUP-VIEW WITH SUP-ORDER-ID = #ORDER-ID
    IF SUP-STATUS NE 'DL'
      MOVE 'N' TO #ALL-DELIVERED
    END-IF
  END-FIND
  IF #ALL-DELIVERED = 'Y'
    CALLNAT 'ORDPOST' #ORDER-ID 'CMP' #POST-FLAG #POST-MSG
    IF #POST-FLAG NE 'Y'
      CALLNAT 'LOGERR' 802 #POST-MSG 'W' 'SHIPUPD' #USER-ID
    END-IF
  END-IF
END-IF
*
* ON SHIP: DEDUCT INVENTORY (SOLD)
IF P-NEW-STATUS = 'SH'
  PERFORM DEDUCT-INVENTORY
END-IF
*
* AUDIT
MOVE #ORDER-ID TO #ORD-STR
CALLNAT 'AUDITN' 'SHIP' #ORD-STR 'U' 'SHPST'
  #CURRENT-STATUS P-NEW-STATUS P-NOTES
*
* -------------------------------------------------------
DEFINE SUBROUTINE DEDUCT-INVENTORY
  1 SHL-VIEW VIEW OF SHIPMENT-LINE-FILE
    2 SHL-SHIP-ID  (N10)
    2 SHL-PROD-ID  (N8)
    2 SHL-SKU      (A15)
    2 SHL-QTY      (N6)
  1 #DI-RC (N4)
  1 #DI-MSG (A80)
*
  1 DSH-VIEW VIEW OF SHIPMENT-FILE
    2 DSH-ID           (N10)
    2 DSH-SHIP-FROM-ID (N6)
    2 DSH-SHIP-FROM-TYPE (A1)
*
  1 #FROM-LOC (N6)
  1 #FROM-TYPE (A1)
  FIND DSH-VIEW WITH DSH-ID = P-SHIP-ID
    MOVE DSH-SHIP-FROM-ID TO #FROM-LOC
    MOVE DSH-SHIP-FROM-TYPE TO #FROM-TYPE
    ESCAPE BOTTOM
  END-FIND
*
  READ SHL-VIEW BY SHL-SHIP-ID = P-SHIP-ID
    IF SHL-SHIP-ID NE P-SHIP-ID
      ESCAPE BOTTOM
    END-IF
    CALLNAT 'INVUPD'
      SHL-PROD-ID SHL-SKU #FROM-LOC #FROM-TYPE
      SHL-QTY
      'SELD' 'SHIPPED' #ORDER-ID 0
      #DI-RC #DI-MSG
    IF #DI-RC NE 0
      CALLNAT 'LOGERR' 301 #DI-MSG 'W' 'SHIPUPD' #USER-ID
    END-IF
  END-READ
END-SUBROUTINE
*
END
