* >Natural Source Code: CUS-COPY
* RETAILCORE - CUSTOMER DATA DEFINITIONS
* SHARED BY ALL CUSTOMER-RELATED PROGRAMS
* CREATED: 1998-03-20
* MODIFIED: 2007-04-10 - ADDED MEMBERSHIP FIELDS
* MODIFIED: 2014-09-15 - ADDED EMAIL AND PHONE TYPES
* MODIFIED: 2019-11-20 - ADDED LOYALTY TIER
* MODIFIED: 2023-05-18 - ADDED GDPR CONSENT FIELDS
* -------------------------------------------------------
*
* CUSTOMER MASTER RECORD
*
1 CUSTOMER-DATA
  2 CUST-ID               (N8)    /* PRIMARY IDENTIFIER */
  2 CUST-NO               (A10)   /* LEGACY CUSTOMER NUMBER - STILL USED BY BATCH */
  2 CUST-TYPE              (A2)    /* RE=RETAIL WH=WHOLESALE EM=EMPLOYEE CO=CORPORATE */
  2 CUST-STATUS            (A1)    /* A=ACTIVE I=INACTIVE S=SUSPENDED D=DELETED */
  2 CUST-TITLE             (A5)    /* MR MRS MS DR */
  2 CUST-FIRST-NAME        (A30)
  2 CUST-LAST-NAME         (A40)
  2 CUST-FULL-NAME         (A72)   /* COMPUTED - LAST, FIRST */
  2 CUST-DOB               (D)     /* DATE OF BIRTH */
  2 CUST-GENDER            (A1)    /* M F U */
  2 CUST-LANGUAGE          (A2)    /* EN FR DE ES */
*
* CONTACT INFORMATION
*
1 CUSTOMER-CONTACT
  2 CUST-EMAIL             (A80)
  2 CUST-EMAIL-VALID       (A1)    /* Y N */
  2 CUST-PHONE-HOME        (A20)
  2 CUST-PHONE-MOBILE      (A20)
  2 CUST-PHONE-WORK        (A20)
  2 CUST-PREFERRED-CONTACT (A1)    /* E=EMAIL P=PHONE M=MAIL */
*
* ADDRESS INFORMATION - PRIMARY
*
1 CUSTOMER-ADDRESS
  2 CUST-ADDR-LINE1        (A40)
  2 CUST-ADDR-LINE2        (A40)
  2 CUST-CITY              (A30)
  2 CUST-STATE             (A2)
  2 CUST-ZIP               (A10)
  2 CUST-COUNTRY           (A3)    /* ISO COUNTRY CODE */
  2 CUST-ADDR-TYPE         (A1)    /* H=HOME B=BILLING S=SHIPPING */
*
* SHIPPING ADDRESS
*
1 CUSTOMER-SHIP-ADDR
  2 SHIP-ADDR-LINE1        (A40)
  2 SHIP-ADDR-LINE2        (A40)
  2 SHIP-CITY              (A30)
  2 SHIP-STATE             (A2)
  2 SHIP-ZIP               (A10)
  2 SHIP-COUNTRY           (A3)
*
* MEMBERSHIP / LOYALTY
*
1 CUSTOMER-MEMBERSHIP
  2 CUST-MEMBER-FLAG       (A1)    /* Y=MEMBER N=NON-MEMBER */
  2 CUST-MEMBER-ID         (A12)   /* MEMBERSHIP CARD NUMBER */
  2 CUST-MEMBER-SINCE      (D)
  2 CUST-MEMBER-EXPIRY     (D)
  2 CUST-LOYALTY-TIER      (A1)    /* B=BRONZE S=SILVER G=GOLD P=PLATINUM */
  2 CUST-LOYALTY-POINTS    (N10)
  2 CUST-LIFETIME-SPEND    (N11.2)
  2 CUST-YTD-SPEND         (N9.2)
*
* CREDIT / PAYMENT PREFERENCES
*
1 CUSTOMER-CREDIT
  2 CUST-CREDIT-LIMIT      (N9.2)
  2 CUST-CREDIT-BALANCE    (N9.2)
  2 CUST-CREDIT-HOLD       (A1)    /* Y=ON HOLD N=OK */
  2 CUST-PAYMENT-TERMS     (A3)    /* NET30 NET60 COD */
  2 CUST-TAX-EXEMPT        (A1)    /* Y N */
  2 CUST-TAX-ID            (A15)
*
* GDPR/CONSENT FIELDS
*
1 CUSTOMER-CONSENT
  2 CUST-MARKETING-OPT     (A1)    /* Y N */
  2 CUST-EMAIL-OPT         (A1)    /* Y N */
  2 CUST-SMS-OPT           (A1)    /* Y N */
  2 CUST-DATA-CONSENT      (A1)    /* Y N */
  2 CUST-CONSENT-DATE      (D)
*
* AUDIT FIELDS
*
1 CUSTOMER-AUDIT
  2 CUST-CREATED-DATE      (D)
  2 CUST-CREATED-BY        (A8)
  2 CUST-MODIFIED-DATE     (D)
  2 CUST-MODIFIED-BY       (A8)
  2 CUST-LAST-ORDER-DATE   (D)
  2 CUST-TOTAL-ORDERS      (N6)
*
* SEARCH / PARAMETER FIELDS
*
1 CUSTOMER-SEARCH
  2 CS-SEARCH-ID           (N8)
  2 CS-SEARCH-NO           (A10)
  2 CS-SEARCH-NAME         (A40)
  2 CS-SEARCH-EMAIL        (A80)
  2 CS-SEARCH-PHONE        (A20)
  2 CS-SEARCH-ZIP          (A10)
  2 CS-SEARCH-TYPE         (A2)
  2 CS-SEARCH-STATUS       (A1)
  2 CS-FOUND-FLAG          (A1)     /* Y N */
  2 CS-RECORD-COUNT        (N5)
*
END-DEFINE
