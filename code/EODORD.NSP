* >Natural Source Code: EODORD
* PROGRAM: EODORD - END OF DAY ORDER PROCESSING
* DESCRIPTION: BATCH PROGRAM FOR DAILY ORDER PROCESSING
*              AGES PENDING ORDERS, AUTO-CANCELS STALE,
*              GENERATES DAILY ORDER SUMMARY
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER)
* CREATED: 1999-03-15  A. GARCIA
* MODIFIED: 2005-08-22 - ADDED AUTO-CANCEL
* MODIFIED: 2013-06-10 - ADDED PRIORITY ESCALATION
* MODIFIED: 2020-11-15 - ADDED FRAUD REVIEW CLEANUP
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #CUTOFF-DATE          (D)
  1 #STALE-DAYS           (N4)    INIT <7>
  1 #FRAUD-STALE-DAYS     (N4)    INIT <3>
*
* COUNTERS
  1 #TOTAL-ORDERS         (N8)
  1 #NEW-ORDERS           (N8)
  1 #PENDING-ORDERS       (N8)
  1 #SHIPPED-ORDERS       (N8)
  1 #CANCELLED-ORDERS     (N8)
  1 #COMPLETED-ORDERS     (N8)
  1 #STALE-CANCELLED      (N8)
  1 #ESCALATED            (N8)
*
* FINANCIALS
  1 #TOTAL-REVENUE        (N13.2)
  1 #TOTAL-TAX            (N11.2)
  1 #TOTAL-DISCOUNT       (N11.2)
  1 #AVG-ORDER-VALUE      (N11.2)
*
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A60)
  1 #CANC-RC              (N4)
  1 #CANC-MSG             (A80)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 EOD-VIEW VIEW OF ORDER-FILE
    2 EOD-ID               (N10)
    2 EOD-STATUS           (A3)
    2 EOD-DATE             (D)
    2 EOD-PRIORITY         (N1)
    2 EOD-TOTAL-AMT        (N11.2)
    2 EOD-TAX-AMT          (N9.2)
    2 EOD-DISCOUNT-AMT     (N9.2)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
*
WRITE 'RETAILCORE - END OF DAY ORDER PROCESSING'
WRITE '========================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* GET CONFIGURATION
CALLNAT 'CONFIGN' 'ORDER.STALE.DAYS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #STALE-DAYS
END-IF
*
MOVE #TODAY TO #CUTOFF-DATE
SUBTRACT #STALE-DAYS FROM #CUTOFF-DATE (D)
*
* PROCESS ALL ORDERS FOR TODAY
READ EOD-VIEW BY EOD-DATE FROM #CUTOFF-DATE
  ADD 1 TO #TOTAL-ORDERS
*
  * COUNT BY STATUS
  DECIDE ON FIRST VALUE OF EOD-STATUS
    VALUE 'NEW'
      ADD 1 TO #NEW-ORDERS
      * CHECK FOR STALE NEW ORDERS
      IF EOD-DATE < #CUTOFF-DATE
        * AUTO-CANCEL STALE ORDERS
        CALLNAT 'ORDCANC' EOD-ID 'F' 0 'ADMN'
          'AUTO-CANCELLED: STALE ORDER'
          #CANC-RC #CANC-MSG
        IF #CANC-RC = 0
          ADD 1 TO #STALE-CANCELLED
        END-IF
      END-IF
    VALUE 'VAL' VALUE 'RES' VALUE 'CON' VALUE 'PAD'
      ADD 1 TO #PENDING-ORDERS
      * ESCALATE OLD PENDING ORDERS
      IF EOD-DATE < #CUTOFF-DATE AND EOD-PRIORITY > 1
        * ESCALATE PRIORITY
        CALLNAT 'ORDUPD' EOD-ID 'PRIO' ' '
          1 ' ' *DATX 0 'EOD PRIORITY ESCALATION'
        ADD 1 TO #ESCALATED
      END-IF
    VALUE 'ALC' VALUE 'SHP'
      ADD 1 TO #SHIPPED-ORDERS
    VALUE 'CMP'
      ADD 1 TO #COMPLETED-ORDERS
    VALUE 'CAN'
      ADD 1 TO #CANCELLED-ORDERS
    NONE VALUE
      IGNORE
  END-DECIDE
*
  * ACCUMULATE FINANCIALS (NON-CANCELLED)
  IF EOD-STATUS NE 'CAN'
    ADD EOD-TOTAL-AMT    TO #TOTAL-REVENUE
    ADD EOD-TAX-AMT      TO #TOTAL-TAX
    ADD EOD-DISCOUNT-AMT TO #TOTAL-DISCOUNT
  END-IF
*
  * COMMIT EVERY 100 RECORDS
  IF *COUNTER = 100
    END OF TRANSACTION
  END-IF
END-READ
*
END OF TRANSACTION
*
* CALCULATE AVERAGES
IF #TOTAL-ORDERS - #CANCELLED-ORDERS > 0
  COMPUTE #AVG-ORDER-VALUE = #TOTAL-REVENUE /
    (#TOTAL-ORDERS - #CANCELLED-ORDERS)
END-IF
*
* PRINT SUMMARY
WRITE ' '
WRITE 'ORDER SUMMARY'
WRITE '============='
WRITE 'TOTAL ORDERS PROCESSED:' #TOTAL-ORDERS
WRITE 'NEW ORDERS           :' #NEW-ORDERS
WRITE 'PENDING ORDERS       :' #PENDING-ORDERS
WRITE 'SHIPPED ORDERS       :' #SHIPPED-ORDERS
WRITE 'COMPLETED ORDERS     :' #COMPLETED-ORDERS
WRITE 'CANCELLED ORDERS     :' #CANCELLED-ORDERS
WRITE ' '
WRITE 'ACTIONS TAKEN'
WRITE 'STALE AUTO-CANCELLED :' #STALE-CANCELLED
WRITE 'PRIORITY ESCALATED   :' #ESCALATED
WRITE ' '
WRITE 'FINANCIAL SUMMARY'
WRITE 'TOTAL REVENUE        :' #TOTAL-REVENUE
WRITE 'TOTAL TAX            :' #TOTAL-TAX
WRITE 'TOTAL DISCOUNTS      :' #TOTAL-DISCOUNT
WRITE 'AVG ORDER VALUE      :' #AVG-ORDER-VALUE
WRITE ' '
WRITE 'EOD ORDER PROCESSING COMPLETE'
*
* LOG COMPLETION
CALLNAT 'AUDITN' 'ORD' 'EODORD' 'U' 'BATCH'
  ' ' ' ' 'EOD ORDER PROCESSING COMPLETE'
*
END
