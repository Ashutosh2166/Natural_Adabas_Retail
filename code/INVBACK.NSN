* >Natural Source Code: INVBACK
* SUBPROGRAM: INVBACK - BACKORDER MANAGEMENT
* DESCRIPTION: MANAGES BACKORDER PROCESSING AND
*              FULFILLMENT WHEN STOCK BECOMES AVAILABLE
* LIBRARY: RETAILCORE
* ADABAS FILES: 105 (INVENTORY), BACKORDER-FILE
* CREATED: 2003-08-15  K. PATEL
* MODIFIED: 2010-04-22 - ADDED AUTO-FILL LOGIC
* MODIFIED: 2019-07-10 - ADDED NOTIFICATION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-OPERATION           (A4)    /* CHCK FILL CANC LIST */
  1 P-PROD-ID             (N8)
  1 P-BO-ID               (N10)
  1 P-FILLED-COUNT        (N6)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #AVAILABLE-QTY        (N8)
  1 #FILL-QTY             (N8)
  1 #FILLED-TOTAL         (N6)
  1 #INV-RESULT
    2 #IR-ON-HAND         (N8)
    2 #IR-RESERVED        (N8)
    2 #IR-ALLOCATED       (N8)
    2 #IR-DAMAGED         (N8)
    2 #IR-IN-TRANSIT      (N8)
    2 #IR-AVAILABLE       (N8)
    2 #IR-SAFETY-STOCK    (N8)
    2 #IR-REORDER-LEVEL   (N8)
    2 #IR-BELOW-SAFETY    (A1)
    2 #IR-BELOW-REORDER   (A1)
    2 #IR-SUFFICIENT      (A1)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #RES-QTY              (N8)
  1 #RES-ID               (N10)
  1 #BO-FLAG              (A1)
  1 #BO-QTY               (N8)
*
  1 BO-VIEW VIEW OF BACKORDER-FILE
    2 BV-ID                (N10)
    2 BV-ORDER-ID          (N10)
    2 BV-LINE-NO           (N3)
    2 BV-PROD-ID           (N8)
    2 BV-SKU               (A15)
    2 BV-QTY               (N8)
    2 BV-STATUS            (A1)
    2 BV-CREATED-DATE      (D)
    2 BV-FILLED-DATE       (D)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET #FILLED-TOTAL
*
DECIDE ON FIRST VALUE OF P-OPERATION
  VALUE 'CHCK'
    * CHECK AND AUTO-FILL BACKORDERS FOR PRODUCT
    PERFORM CHECK-BACKORDERS
  VALUE 'FILL'
    * FILL SPECIFIC BACKORDER
    PERFORM FILL-BACKORDER
  VALUE 'CANC'
    * CANCEL BACKORDER
    PERFORM CANCEL-BACKORDER
  NONE VALUE
    MOVE 308 TO P-RC
    MOVE 'INVALID BACKORDER OPERATION' TO P-RC-TEXT
END-DECIDE
*
MOVE #FILLED-TOTAL TO P-FILLED-COUNT
*
* -------------------------------------------------------
* CHECK AND AUTO-FILL PENDING BACKORDERS
* MODIFIED 2010-04-22
* -------------------------------------------------------
DEFINE SUBROUTINE CHECK-BACKORDERS
  * GET CURRENT AVAILABILITY
  CALLNAT 'INVCHK'
    P-PROD-ID ' ' 'A' 0 0
    #INV-RESULT #INV-RC #INV-MSG
*
  MOVE #IR-AVAILABLE TO #AVAILABLE-QTY
  IF #AVAILABLE-QTY <= 0
    ESCAPE ROUTINE  /* NO STOCK TO FILL */
  END-IF
*
  * PROCESS BACKORDERS BY DATE (FIFO)
  READ BO-VIEW BY BV-PROD-ID = P-PROD-ID
    IF BV-PROD-ID NE P-PROD-ID
      ESCAPE BOTTOM
    END-IF
    IF BV-STATUS NE 'P'
      ESCAPE TOP
    END-IF
*
    IF #AVAILABLE-QTY <= 0
      ESCAPE BOTTOM  /* NO MORE STOCK */
    END-IF
*
    * DETERMINE FILL QUANTITY
    IF BV-QTY <= #AVAILABLE-QTY
      MOVE BV-QTY TO #FILL-QTY
    ELSE
      MOVE #AVAILABLE-QTY TO #FILL-QTY
    END-IF
*
    * RESERVE INVENTORY FOR BACKORDER
    CALLNAT 'INVRES'
      BV-ORDER-ID BV-LINE-NO P-PROD-ID BV-SKU
      'A' 0 #FILL-QTY
      #RES-QTY #RES-ID #BO-FLAG #BO-QTY
      #INV-RC #INV-MSG
*
    IF #RES-QTY > 0
      * UPDATE BACKORDER
      GET BO-VIEW *ISN (HOLD)
      IF #RES-QTY >= BV-QTY
        MOVE 'F' TO BV-STATUS   /* FILLED */
        MOVE *DATX TO BV-FILLED-DATE
      ELSE
        SUBTRACT #RES-QTY FROM BV-QTY
      END-IF
      UPDATE BO-VIEW
      END OF TRANSACTION
      ADD 1 TO #FILLED-TOTAL
      SUBTRACT #RES-QTY FROM #AVAILABLE-QTY
    END-IF
  END-READ
END-SUBROUTINE
*
* -------------------------------------------------------
* FILL SPECIFIC BACKORDER
* -------------------------------------------------------
DEFINE SUBROUTINE FILL-BACKORDER
  FIND BO-VIEW WITH BV-ID = P-BO-ID
    IF NO RECORDS FOUND
      MOVE 308 TO P-RC
      MOVE 'BACKORDER NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    IF BV-STATUS NE 'P'
      MOVE 308 TO P-RC
      MOVE 'BACKORDER NOT PENDING' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
*
    CALLNAT 'INVRES'
      BV-ORDER-ID BV-LINE-NO BV-PROD-ID BV-SKU
      'A' 0 BV-QTY
      #RES-QTY #RES-ID #BO-FLAG #BO-QTY
      #INV-RC #INV-MSG
*
    IF #RES-QTY > 0
      GET BO-VIEW *ISN (HOLD)
      MOVE 'F' TO BV-STATUS
      MOVE *DATX TO BV-FILLED-DATE
      UPDATE BO-VIEW
      END OF TRANSACTION
      ADD 1 TO #FILLED-TOTAL
    ELSE
      MOVE 301 TO P-RC
      MOVE 'INSUFFICIENT INVENTORY TO FILL BACKORDER' TO P-RC-TEXT
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
* CANCEL BACKORDER
* -------------------------------------------------------
DEFINE SUBROUTINE CANCEL-BACKORDER
  FIND BO-VIEW WITH BV-ID = P-BO-ID
    IF NO RECORDS FOUND
      MOVE 308 TO P-RC
      MOVE 'BACKORDER NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    GET BO-VIEW *ISN (HOLD)
    MOVE 'C' TO BV-STATUS
    UPDATE BO-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
END
