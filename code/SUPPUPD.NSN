* >Natural Source Code: SUPPUPD
* SUBPROGRAM: SUPPUPD - SUPPLIER UPDATE
* DESCRIPTION: NON-INTERACTIVE SUPPLIER UPDATES
*              STATUS, TERMS, PERFORMANCE METRICS
* LIBRARY: RETAILCORE
* ADABAS FILE: 130 (SUPPLIER)
* CREATED: 2001-07-10  A. GARCIA
* MODIFIED: 2010-05-22 - ADDED PERFORMANCE UPDATE
* MODIFIED: 2018-11-15 - ADDED AUTO-RATING
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SUPP-ID             (N8)
  1 P-UPD-TYPE            (A4)    /* STAT TERM PERF RATE PO */
  1 P-STATUS              (A1)
  1 P-AMT                 (N11.2)
  1 P-PCT                 (N5.2)
  1 P-DAYS                (N3)
  1 P-DATE                (D)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #OLD-VALUE            (A20)
  1 #NEW-VALUE            (A20)
  1 #ORD-STR              (A15)
  1 #NEW-RATING           (N3)
*
  1 SU-VIEW VIEW OF SUPPLIER-FILE
    2 SU-ID                (N8)
    2 SU-NAME              (A60)
    2 SU-STATUS            (A1)
    2 SU-PAY-TERMS         (A10)
    2 SU-PAY-DAYS          (N3)
    2 SU-DISCOUNT-PCT      (N5.2)
    2 SU-DISCOUNT-DAYS     (N3)
    2 SU-LEAD-TIME-DAYS    (N3)
    2 SU-MIN-ORDER-AMT     (N9.2)
    2 SU-RATING            (N3)
    2 SU-ON-TIME-PCT       (N5.2)
    2 SU-QUALITY-PCT       (N5.2)
    2 SU-FILL-RATE         (N5.2)
    2 SU-TOTAL-POS         (N6)
    2 SU-TOTAL-AMT         (N11.2)
    2 SU-LAST-PO-DATE      (D)
    2 SU-MODIFIED-BY       (A8)
    2 SU-MODIFIED-DATE     (D)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
*
FIND SU-VIEW WITH SU-ID = P-SUPP-ID
  IF NO RECORDS FOUND
    MOVE 604 TO P-RC
    MOVE 'SUPPLIER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  GET SU-VIEW *ISN (HOLD)
*
  DECIDE ON FIRST VALUE OF P-UPD-TYPE
    VALUE 'STAT'
      * STATUS CHANGE
      IF P-STATUS NE 'A' AND P-STATUS NE 'I'
          AND P-STATUS NE 'S' AND P-STATUS NE 'B'
        MOVE 605 TO P-RC
        MOVE 'INVALID SUPPLIER STATUS' TO P-RC-TEXT
        BACKOUT TRANSACTION
        ESCAPE BOTTOM
      END-IF
      MOVE SU-STATUS TO #OLD-VALUE
      MOVE P-STATUS TO SU-STATUS
      MOVE P-STATUS TO #NEW-VALUE
*
    VALUE 'TERM'
      * UPDATE PAYMENT TERMS
      MOVE SU-PAY-DAYS TO #OLD-VALUE
      IF P-DAYS > 0
        MOVE P-DAYS TO SU-PAY-DAYS
      END-IF
      IF P-PCT > 0
        MOVE P-PCT TO SU-DISCOUNT-PCT
      END-IF
      MOVE SU-PAY-DAYS TO #NEW-VALUE
*
    VALUE 'PERF'
      * UPDATE PERFORMANCE METRICS
      IF P-PCT > 0
        MOVE P-PCT TO SU-ON-TIME-PCT
      END-IF
      MOVE SU-ON-TIME-PCT TO #NEW-VALUE
*
    VALUE 'RATE'
      * AUTO-CALCULATE RATING
      * FORMULA: 40% ON-TIME + 30% QUALITY + 30% FILL-RATE
      COMPUTE #NEW-RATING =
        (SU-ON-TIME-PCT * 0.40) +
        (SU-QUALITY-PCT * 0.30) +
        (SU-FILL-RATE * 0.30)
      MOVE SU-RATING TO #OLD-VALUE
      MOVE #NEW-RATING TO SU-RATING
      MOVE SU-RATING TO #NEW-VALUE
*
    VALUE 'PO'
      * PO ACCUMULATION
      ADD 1 TO SU-TOTAL-POS
      ADD P-AMT TO SU-TOTAL-AMT
      IF P-DATE > 0
        MOVE P-DATE TO SU-LAST-PO-DATE
      END-IF
*
    NONE VALUE
      MOVE 605 TO P-RC
      COMPRESS 'INVALID UPDATE TYPE:' P-UPD-TYPE INTO P-RC-TEXT
      BACKOUT TRANSACTION
      ESCAPE BOTTOM
  END-DECIDE
*
  MOVE #USER-ID TO SU-MODIFIED-BY
  MOVE #TODAY TO SU-MODIFIED-DATE
  UPDATE SU-VIEW
  END OF TRANSACTION
*
  * AUDIT
  MOVE P-SUPP-ID TO #ORD-STR
  CALLNAT 'AUDITN' 'SUPP' #ORD-STR 'U' P-UPD-TYPE
    #OLD-VALUE #NEW-VALUE 'SUPPLIER UPDATED'
*
  ESCAPE BOTTOM
END-FIND
*
END
