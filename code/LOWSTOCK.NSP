* >Natural Source Code: LOWSTOCK
* PROGRAM: LOWSTOCK - LOW STOCK ALERT REPORT
* DESCRIPTION: IDENTIFIES PRODUCTS BELOW REORDER LEVEL
*              GENERATES RECOMMENDED PURCHASE QUANTITIES
*              LINKS TO PREFERRED SUPPLIERS
* LIBRARY: RETAILCORE
* ADABAS FILES: 105 (INVENTORY), 101 (PRODUCT), 130 (SUPPLIER)
* CREATED: 2003-07-15  A. GARCIA
* MODIFIED: 2010-11-22 - ADDED SUPPLIER INFO
* MODIFIED: 2019-04-10 - ADDED REORDER RECOMMENDATION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TOTAL-LOW            (N8)
  1 #CRITICAL-COUNT       (N8)
  1 #AVAILABLE            (N8)
  1 #REORDER-QTY          (N8)
  1 #PRIORITY             (A8)
*
  1 LSR-VIEW VIEW OF INVENTORY-FILE
    2 LSR-PROD-ID          (N8)
    2 LSR-SKU              (A15)
    2 LSR-LOCATION-ID      (N6)
    2 LSR-LOCATION-TYPE    (A1)
    2 LSR-ON-HAND          (N8)
    2 LSR-RESERVED         (N8)
    2 LSR-ALLOCATED        (N8)
    2 LSR-DAMAGED          (N8)
    2 LSR-SAFETY-STOCK     (N8)
    2 LSR-REORDER-LEVEL    (N8)
    2 LSR-REORDER-QTY      (N8)
    2 LSR-STATUS           (A1)
*
  1 LPR-VIEW VIEW OF PRODUCT-FILE
    2 LPR-ID               (N8)
    2 LPR-NAME             (A60)
    2 LPR-SUPP-ID          (N8)
    2 LPR-COST-PRICE       (N9.2)
*
  1 LSP-VIEW VIEW OF SUPPLIER-FILE
    2 LSP-ID               (N8)
    2 LSP-NAME             (A60)
    2 LSP-LEAD-TIME-DAYS   (N3)
    2 LSP-STATUS           (A1)
END-DEFINE
*
WRITE 'RETAILCORE - LOW STOCK ALERT REPORT'
WRITE '===================================='
WRITE 'RUN DATE:' *DATX
WRITE ' '
WRITE 'PRIORITY PRODUCT  SKU             LOC   AVAIL  SAFETY REORDER'
  ' REC-QTY SUPPLIER                      LEAD'
WRITE '-------- -------- --------------- ----- ------ ------ -------'
  ' ------- ----------------------------- ----'
*
READ LSR-VIEW BY LSR-PROD-ID
  IF LSR-STATUS NE 'A'
    ESCAPE TOP
  END-IF
*
  COMPUTE #AVAILABLE = LSR-ON-HAND - LSR-RESERVED
    - LSR-ALLOCATED - LSR-DAMAGED
  IF #AVAILABLE < 0
    MOVE 0 TO #AVAILABLE
  END-IF
*
  * CHECK IF BELOW REORDER
  IF LSR-REORDER-LEVEL > 0 AND #AVAILABLE < LSR-REORDER-LEVEL
    ADD 1 TO #TOTAL-LOW
*
    * DETERMINE PRIORITY
    IF #AVAILABLE = 0
      MOVE 'CRITICAL' TO #PRIORITY
      ADD 1 TO #CRITICAL-COUNT
    ELSE IF #AVAILABLE < LSR-SAFETY-STOCK
      MOVE 'URGENT  ' TO #PRIORITY
    ELSE
      MOVE 'NORMAL  ' TO #PRIORITY
    END-IF
    END-IF
*
    * CALCULATE RECOMMENDED REORDER QTY
    IF LSR-REORDER-QTY > 0
      MOVE LSR-REORDER-QTY TO #REORDER-QTY
    ELSE
      COMPUTE #REORDER-QTY = LSR-REORDER-LEVEL * 2 - #AVAILABLE
    END-IF
*
    * GET PRODUCT AND SUPPLIER INFO
    1 #PROD-NAME (A60)
    1 #SUPP-ID (N8)
    1 #SUPP-NAME (A60)
    1 #LEAD-DAYS (N3)
    RESET #PROD-NAME
    RESET #SUPP-NAME
    RESET #LEAD-DAYS
*
    FIND LPR-VIEW WITH LPR-ID = LSR-PROD-ID
      IF NO RECORDS FOUND
        IGNORE
      END-NOREC
      MOVE LPR-NAME    TO #PROD-NAME
      MOVE LPR-SUPP-ID TO #SUPP-ID
      ESCAPE BOTTOM
    END-FIND
*
    IF #SUPP-ID > 0
      FIND LSP-VIEW WITH LSP-ID = #SUPP-ID
        IF NO RECORDS FOUND
          IGNORE
        END-NOREC
        MOVE LSP-NAME           TO #SUPP-NAME
        MOVE LSP-LEAD-TIME-DAYS TO #LEAD-DAYS
        ESCAPE BOTTOM
      END-FIND
    END-IF
*
    WRITE #PRIORITY LSR-PROD-ID LSR-SKU LSR-LOCATION-ID
      #AVAILABLE LSR-SAFETY-STOCK LSR-REORDER-LEVEL
      #REORDER-QTY #SUPP-NAME (EM=XXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
      #LEAD-DAYS
  END-IF
*
END-READ
*
WRITE ' '
WRITE 'SUMMARY'
WRITE '======='
WRITE 'TOTAL LOW STOCK ITEMS:' #TOTAL-LOW
WRITE 'CRITICAL (ZERO STOCK):' #CRITICAL-COUNT
WRITE ' '
WRITE 'END OF REPORT'
*
END
