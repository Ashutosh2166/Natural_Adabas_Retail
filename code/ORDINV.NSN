* >Natural Source Code: ORDINV
* SUBPROGRAM: ORDINV - ORDER INVENTORY CHECK
* DESCRIPTION: CHECKS INVENTORY AVAILABILITY FOR ALL ORDER LINES
*              BEFORE ORDER CONFIRMATION
*              REPORTS WHICH LINES HAVE STOCK ISSUES
* LIBRARY: RETAILCORE
* ADABAS FILES: 112 (ORDER-LINE), 105 (INVENTORY)
* CREATED: 2003-05-15  A. GARCIA
* MODIFIED: 2010-09-22 - ADDED MULTI-LOCATION SEARCH
* MODIFIED: 2019-07-10 - ADDED BACKORDER OPTION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-STORE-ID            (N4)
  1 P-CHECK-MODE          (A1)    /* S=STRICT A=ALLOW-PARTIAL B=BACKORDER */
  1 P-LINES-OK            (N3)
  1 P-LINES-SHORT         (N3)
  1 P-RESULTS (20)
    2 P-RES-LINE-NO       (N3)
    2 P-RES-SKU           (A15)
    2 P-RES-QTY-REQUESTED (N6)
    2 P-RES-QTY-AVAILABLE (N8)
    2 P-RES-STATUS        (A1)    /* Y=OK P=PARTIAL N=NONE */
    2 P-RES-LOCATION-ID   (N6)
  1 P-ALL-AVAILABLE       (A1)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #IDX                  (N3)
  1 #LOC-TYPE             (A1)
  1 #INV-AVAIL           (N8)
  1 #INV-ON-HAND         (N8)
  1 #INV-RESERVED        (N8)
  1 #INV-ALLOCATED       (N8)
  1 #INV-DAMAGED         (N8)
  1 #INV-TRANSIT         (N8)
  1 #INV-SAFETY          (N8)
  1 #INV-REORDER         (N8)
  1 #INV-BELOW-SAFETY    (A1)
  1 #INV-BELOW-REORDER   (A1)
  1 #INV-SUFFICIENT      (A1)
  1 #BEST-LOC            (N6)
  1 #BEST-QTY            (N8)
  1 #CHK-RC              (N4)
  1 #CHK-MSG             (A80)
*
  1 OI-VIEW VIEW OF ORDER-LINE-FILE
    2 OI-ORDER-ID          (N10)
    2 OI-LINE-NO           (N3)
    2 OI-PROD-ID           (N8)
    2 OI-SKU               (A15)
    2 OI-QTY-ORDERED       (N6)
    2 OI-STATUS            (A3)
END-DEFINE
*
RESET P-RC
RESET P-RC-TEXT
RESET P-LINES-OK
RESET P-LINES-SHORT
MOVE 'Y' TO P-ALL-AVAILABLE
RESET #IDX
*
IF P-CHECK-MODE = ' '
  MOVE 'S' TO P-CHECK-MODE
END-IF
*
* CHECK EACH ORDER LINE
FIND OI-VIEW WITH OI-ORDER-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 404 TO P-RC
    MOVE 'NO ORDER LINES FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  IF OI-STATUS = 'CAN'
    ESCAPE TOP
  END-IF
*
  ADD 1 TO #IDX
  IF #IDX > 20
    ESCAPE BOTTOM
  END-IF
*
  MOVE OI-LINE-NO     TO P-RESULTS.P-RES-LINE-NO(#IDX)
  MOVE OI-SKU         TO P-RESULTS.P-RES-SKU(#IDX)
  MOVE OI-QTY-ORDERED TO P-RESULTS.P-RES-QTY-REQUESTED(#IDX)
*
  * CHECK INVENTORY AT STORE FIRST, THEN ALL LOCATIONS
  IF P-STORE-ID > 0
    MOVE 'S' TO #LOC-TYPE
  ELSE
    MOVE ' ' TO #LOC-TYPE
  END-IF
*
  CALLNAT 'INVCHK'
    OI-PROD-ID OI-SKU P-STORE-ID #LOC-TYPE
    OI-QTY-ORDERED
    #INV-ON-HAND #INV-RESERVED #INV-ALLOCATED
    #INV-DAMAGED #INV-TRANSIT #INV-AVAIL
    #INV-SAFETY #INV-REORDER #INV-BELOW-SAFETY
    #INV-BELOW-REORDER #INV-SUFFICIENT
    #CHK-RC #CHK-MSG
*
  MOVE #INV-AVAIL TO P-RESULTS.P-RES-QTY-AVAILABLE(#IDX)
  MOVE P-STORE-ID TO P-RESULTS.P-RES-LOCATION-ID(#IDX)
*
  IF #INV-SUFFICIENT = 'Y'
    MOVE 'Y' TO P-RESULTS.P-RES-STATUS(#IDX)
    ADD 1 TO P-LINES-OK
  ELSE IF #INV-AVAIL > 0
    MOVE 'P' TO P-RESULTS.P-RES-STATUS(#IDX)
    ADD 1 TO P-LINES-SHORT
    MOVE 'N' TO P-ALL-AVAILABLE
  ELSE
    * TRY OTHER LOCATIONS IF STORE HAD NO STOCK
    IF P-STORE-ID > 0
      CALLNAT 'INVCHK'
        OI-PROD-ID OI-SKU 0 ' '
        OI-QTY-ORDERED
        #INV-ON-HAND #INV-RESERVED #INV-ALLOCATED
        #INV-DAMAGED #INV-TRANSIT #INV-AVAIL
        #INV-SAFETY #INV-REORDER #INV-BELOW-SAFETY
        #INV-BELOW-REORDER #INV-SUFFICIENT
        #CHK-RC #CHK-MSG
      IF #INV-SUFFICIENT = 'Y'
        MOVE 'Y' TO P-RESULTS.P-RES-STATUS(#IDX)
        MOVE #INV-AVAIL TO P-RESULTS.P-RES-QTY-AVAILABLE(#IDX)
        ADD 1 TO P-LINES-OK
        ESCAPE TOP
      END-IF
    END-IF
    MOVE 'N' TO P-RESULTS.P-RES-STATUS(#IDX)
    ADD 1 TO P-LINES-SHORT
    MOVE 'N' TO P-ALL-AVAILABLE
  END-IF
  END-IF
*
END-FIND
*
* DETERMINE OVERALL RESULT
IF P-CHECK-MODE = 'S' AND P-ALL-AVAILABLE NE 'Y'
  MOVE 301 TO P-RC
  COMPRESS 'INSUFFICIENT STOCK FOR' P-LINES-SHORT 'LINES'
    INTO P-RC-TEXT
ELSE IF P-CHECK-MODE = 'A' AND P-LINES-OK = 0
  MOVE 302 TO P-RC
  MOVE 'NO LINES HAVE AVAILABLE STOCK' TO P-RC-TEXT
END-IF
END-IF
*
END
