* >Natural Source Code: CUSTENTR
* PROGRAM: CUSTENTR - CUSTOMER ENTRY (ONLINE)
* DESCRIPTION: INTERACTIVE CUSTOMER CREATION AND
*              MAINTENANCE SCREEN
* LIBRARY: RETAILCORE
* ADABAS FILE: 100 (CUSTOMER)
* CREATED: 1998-06-01  M. JOHNSON
* MODIFIED: 2003-04-15 - ADDED MEMBERSHIP ENTRY
* MODIFIED: 2010-08-20 - ADDED EMAIL VALIDATION
* MODIFIED: 2016-02-14 - ADDED GDPR CONSENT FIELDS
* MODIFIED: 2021-09-30 - ADDED LOYALTY TIER DISPLAY
* -------------------------------------------------------
DEFINE DATA
LOCAL USING CUS-COPY
LOCAL USING COMMON-COPY
LOCAL USING ERROR-COPY
*
LOCAL
  1 #ACTION               (A1)    /* A=ADD U=UPDATE D=DISPLAY */
  1 #CONFIRM              (A1)
  1 #SCREEN-MSG           (A78)
  1 #SCREEN-MSG-ATTR      (C)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #NEW-CUST-ID          (N8)
  1 #SEARCH-CUST-ID       (N8)
  1 #SEARCH-NAME          (A40)
  1 #MODIFIED             (A1)
  1 #USER-ID              (A8)
  1 #FUNC-KEY             (A2)
  1 #CUST-ID-DISPLAY      (A10)
*
* ADABAS FILE 100 - CUSTOMER
  1 CUST-VIEW VIEW OF CUSTOMER-FILE
    2 CU-ID                (N8)
    2 CU-NUMBER            (A10)
    2 CU-TYPE              (A2)
    2 CU-STATUS            (A1)
    2 CU-TITLE             (A5)
    2 CU-FIRST-NAME        (A30)
    2 CU-LAST-NAME         (A40)
    2 CU-EMAIL             (A80)
    2 CU-PHONE-HOME        (A20)
    2 CU-PHONE-MOBILE      (A20)
    2 CU-ADDR-LINE1        (A40)
    2 CU-ADDR-LINE2        (A40)
    2 CU-CITY              (A30)
    2 CU-STATE             (A2)
    2 CU-ZIP               (A10)
    2 CU-COUNTRY           (A3)
    2 CU-DOB               (D)
    2 CU-MEMBER-FLAG       (A1)
    2 CU-MEMBER-ID         (A12)
    2 CU-MEMBER-SINCE      (D)
    2 CU-LOYALTY-TIER      (A1)
    2 CU-LOYALTY-POINTS    (N10)
    2 CU-CREDIT-LIMIT      (N9.2)
    2 CU-TAX-EXEMPT        (A1)
    2 CU-MARKETING-OPT     (A1)
    2 CU-EMAIL-OPT         (A1)
    2 CU-DATA-CONSENT      (A1)
    2 CU-CREATED-DATE      (D)
    2 CU-CREATED-BY        (A8)
    2 CU-MODIFIED-DATE     (D)
    2 CU-MODIFIED-BY       (A8)
END-DEFINE
*
* -------------------------------------------------------
* MAIN PROCESSING LOOP
* -------------------------------------------------------
MOVE *USER TO #USER-ID
*
REPEAT
  * DISPLAY INITIAL SEARCH/ACTION SCREEN
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'RETAILCORE - CUSTOMER MAINTENANCE' (I)
    / '=================================' (I)
    /
    / 'ACTION     :' #ACTION (AD=MI)
    '  (A=ADD U=UPDATE D=DISPLAY)'
    / 'CUSTOMER ID:' #SEARCH-CUST-ID (AD=MI)
    / 'SEARCH NAME:' #SEARCH-NAME (AD=MI)
    /
    / 'PF3=EXIT  PF5=SEARCH  ENTER=PROCESS'
  *
  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF
*
  RESET #SCREEN-MSG
  MOVE (AD=I) TO #SCREEN-MSG-ATTR
*
  * VALIDATE ACTION CODE
  IF #ACTION NE 'A' AND #ACTION NE 'U' AND #ACTION NE 'D'
    MOVE 'INVALID ACTION - USE A, U, OR D' TO #SCREEN-MSG
    MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
    ESCAPE TOP
  END-IF
*
  * -------------------------------------------------------
  * PROCESS BASED ON ACTION
  * -------------------------------------------------------
  DECIDE ON FIRST VALUE OF #ACTION
    VALUE 'A'
      PERFORM ADD-CUSTOMER
    VALUE 'U'
      IF #SEARCH-CUST-ID = 0
        MOVE 'ENTER CUSTOMER ID FOR UPDATE' TO #SCREEN-MSG
        MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
        ESCAPE TOP
      END-IF
      PERFORM UPDATE-CUSTOMER
    VALUE 'D'
      IF #SEARCH-CUST-ID = 0
        MOVE 'ENTER CUSTOMER ID FOR DISPLAY' TO #SCREEN-MSG
        MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
        ESCAPE TOP
      END-IF
      PERFORM DISPLAY-CUSTOMER
    NONE VALUE
      IGNORE
  END-DECIDE
*
END-REPEAT
*
* =======================================
* ADD CUSTOMER SUBROUTINE
* =======================================
DEFINE SUBROUTINE ADD-CUSTOMER
*
  * CLEAR CUSTOMER DATA
  RESET CUSTOMER-DATA
  RESET CUSTOMER-CONTACT
  RESET CUSTOMER-ADDRESS
  RESET CUSTOMER-MEMBERSHIP
*
  * DISPLAY ENTRY SCREEN
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'RETAILCORE - ADD NEW CUSTOMER' (I)
    / '=============================' (I)
    /
    / 'TITLE      :' CUST-TITLE (AD=MI)
    / 'FIRST NAME :' CUST-FIRST-NAME (AD=MI)
    / 'LAST NAME  :' CUST-LAST-NAME (AD=MI)
    / 'TYPE       :' CUST-TYPE (AD=MI)
    '  (RE=RETAIL WH=WHOLESALE EM=EMPLOYEE CO=CORPORATE)'
    / 'EMAIL      :' CUST-EMAIL (AD=MI)
    / 'HOME PHONE :' CUST-PHONE-HOME (AD=MI)
    / 'MOBILE     :' CUST-PHONE-MOBILE (AD=MI)
    /
    / 'ADDRESS 1  :' CUST-ADDR-LINE1 (AD=MI)
    / 'ADDRESS 2  :' CUST-ADDR-LINE2 (AD=MI)
    / 'CITY       :' CUST-CITY (AD=MI)
    / 'STATE      :' CUST-STATE (AD=MI)
    / 'ZIP        :' CUST-ZIP (AD=MI)
    / 'COUNTRY    :' CUST-COUNTRY (AD=MI)
    /
    / 'MEMBER     :' CUST-MEMBER-FLAG (AD=MI) '  (Y/N)'
    / 'TAX EXEMPT :' CUST-TAX-EXEMPT (AD=MI) '  (Y/N)'
    /
    / '--- GDPR CONSENT ---'
    / 'MARKETING  :' CUSTOMER-CONSENT.CUST-MARKETING-OPT (AD=MI) '  (Y/N)'
    / 'EMAIL OPT  :' CUSTOMER-CONSENT.CUST-EMAIL-OPT (AD=MI) '  (Y/N)'
    / 'DATA CONSENT:' CUSTOMER-CONSENT.CUST-DATA-CONSENT (AD=MI) '  (Y/N)'
    /
    / 'PF3=CANCEL  ENTER=SAVE'
*
  IF *PF-KEY = 'PF3'
    MOVE 'ADD CANCELLED' TO #SCREEN-MSG
    ESCAPE ROUTINE
  END-IF
*
  * VALIDATE CUSTOMER DATA
  CALLNAT 'CUSTVAL'
    CUSTOMER-DATA
    CUSTOMER-CONTACT
    CUSTOMER-ADDRESS
    #VALID-FLAG
    #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    MOVE #ERROR-MSG TO #SCREEN-MSG
    MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
    ESCAPE ROUTINE
  END-IF
*
  * GENERATE CUSTOMER ID
  CALLNAT 'SEQNON' 'CUST' #NEW-CUST-ID
*
  MOVE #NEW-CUST-ID  TO CUST-ID
  MOVE 'A'           TO CUST-STATUS
  COMPRESS 'C' #NEW-CUST-ID INTO CUST-NO LEAVING NO SPACE
*
  * STORE TO DATABASE
  STORE CUST-VIEW
    CU-ID           := CUST-ID
    CU-NUMBER       := CUST-NO
    CU-TYPE         := CUST-TYPE
    CU-STATUS       := CUST-STATUS
    CU-TITLE        := CUST-TITLE
    CU-FIRST-NAME   := CUST-FIRST-NAME
    CU-LAST-NAME    := CUST-LAST-NAME
    CU-EMAIL        := CUST-EMAIL
    CU-PHONE-HOME   := CUST-PHONE-HOME
    CU-PHONE-MOBILE := CUST-PHONE-MOBILE
    CU-ADDR-LINE1   := CUST-ADDR-LINE1
    CU-ADDR-LINE2   := CUST-ADDR-LINE2
    CU-CITY         := CUST-CITY
    CU-STATE        := CUST-STATE
    CU-ZIP          := CUST-ZIP
    CU-COUNTRY      := CUST-COUNTRY
    CU-MEMBER-FLAG  := CUST-MEMBER-FLAG
    CU-TAX-EXEMPT   := CUST-TAX-EXEMPT
    CU-MARKETING-OPT := CUSTOMER-CONSENT.CUST-MARKETING-OPT
    CU-EMAIL-OPT    := CUSTOMER-CONSENT.CUST-EMAIL-OPT
    CU-DATA-CONSENT := CUSTOMER-CONSENT.CUST-DATA-CONSENT
    CU-CREATED-DATE := *DATX
    CU-CREATED-BY   := #USER-ID
    CU-MODIFIED-DATE := *DATX
    CU-MODIFIED-BY  := #USER-ID
  END-STORE
*
  ON ERROR
    COMPRESS 'DATABASE ERROR ON CUSTOMER ADD:' *ERROR-NR
      INTO #SCREEN-MSG
    MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
    CALLNAT 'LOGERR' ERR-CUST-DUPLICATE
      'CUSTOMER ADD FAILED' 'E' 'CUSTENTR' #USER-ID
    ESCAPE ROUTINE
  END-ERROR
*
  END OF TRANSACTION
*
  * AUDIT TRAIL
  MOVE #NEW-CUST-ID TO #CUST-ID-DISPLAY
  CALLNAT 'AUDITN' 'CUST' #CUST-ID-DISPLAY 'C' 'CUSTOMER'
    ' ' CUST-LAST-NAME 'NEW CUSTOMER CREATED'
*
  COMPRESS 'CUSTOMER' #NEW-CUST-ID 'CREATED SUCCESSFULLY'
    INTO #SCREEN-MSG
*
END-SUBROUTINE
*
* =======================================
* UPDATE CUSTOMER SUBROUTINE
* =======================================
DEFINE SUBROUTINE UPDATE-CUSTOMER
*
  * RETRIEVE EXISTING CUSTOMER
  CALLNAT 'CUSTGET'
    #SEARCH-CUST-ID
    CUSTOMER-DATA
    CUSTOMER-CONTACT
    CUSTOMER-ADDRESS
    CUSTOMER-MEMBERSHIP
    #VALID-FLAG
    #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    MOVE #ERROR-MSG TO #SCREEN-MSG
    MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
    ESCAPE ROUTINE
  END-IF
*
  * LOCK RECORD
  CALLNAT 'LOCKN' 'L' 'CUST' #SEARCH-CUST-ID
    #VALID-FLAG #ERROR-MSG #ERROR-MSG
*
  * DISPLAY FOR UPDATE
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'RETAILCORE - UPDATE CUSTOMER' (I)
    / '============================' (I)
    / 'CUSTOMER ID:' CUST-ID (AD=OI)
    /
    / 'TITLE      :' CUST-TITLE (AD=MI)
    / 'FIRST NAME :' CUST-FIRST-NAME (AD=MI)
    / 'LAST NAME  :' CUST-LAST-NAME (AD=MI)
    / 'STATUS     :' CUST-STATUS (AD=MI)
    '  (A=ACTIVE I=INACTIVE S=SUSPENDED)'
    / 'EMAIL      :' CUST-EMAIL (AD=MI)
    / 'HOME PHONE :' CUST-PHONE-HOME (AD=MI)
    / 'MOBILE     :' CUST-PHONE-MOBILE (AD=MI)
    /
    / 'ADDRESS 1  :' CUST-ADDR-LINE1 (AD=MI)
    / 'ADDRESS 2  :' CUST-ADDR-LINE2 (AD=MI)
    / 'CITY       :' CUST-CITY (AD=MI)
    / 'STATE      :' CUST-STATE (AD=MI)
    / 'ZIP        :' CUST-ZIP (AD=MI)
    /
    / 'MEMBER     :' CUST-MEMBER-FLAG (AD=MI)
    / 'LOYALTY    :' CUST-LOYALTY-TIER (AD=OI)
    / 'POINTS     :' CUST-LOYALTY-POINTS (AD=OI)
    /
    / 'PF3=CANCEL  ENTER=SAVE'
*
  IF *PF-KEY = 'PF3'
    * RELEASE LOCK
    CALLNAT 'LOCKN' 'U' 'CUST' #SEARCH-CUST-ID
      #VALID-FLAG #ERROR-MSG #ERROR-MSG
    MOVE 'UPDATE CANCELLED' TO #SCREEN-MSG
    ESCAPE ROUTINE
  END-IF
*
  * VALIDATE
  CALLNAT 'CUSTVAL'
    CUSTOMER-DATA
    CUSTOMER-CONTACT
    CUSTOMER-ADDRESS
    #VALID-FLAG
    #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    * RELEASE LOCK ON ERROR
    CALLNAT 'LOCKN' 'U' 'CUST' #SEARCH-CUST-ID
      #VALID-FLAG #ERROR-MSG #ERROR-MSG
    MOVE #ERROR-MSG TO #SCREEN-MSG
    ESCAPE ROUTINE
  END-IF
*
  * UPDATE DATABASE
  FIND CUST-VIEW WITH CU-ID = #SEARCH-CUST-ID
    IF NO RECORDS FOUND
      MOVE 'CUSTOMER NOT FOUND FOR UPDATE' TO #SCREEN-MSG
      ESCAPE BOTTOM
    END-NOREC
*
    GET CUST-VIEW *ISN (HOLD)
    MOVE CUST-TITLE        TO CU-TITLE
    MOVE CUST-FIRST-NAME   TO CU-FIRST-NAME
    MOVE CUST-LAST-NAME    TO CU-LAST-NAME
    MOVE CUST-STATUS       TO CU-STATUS
    MOVE CUST-EMAIL        TO CU-EMAIL
    MOVE CUST-PHONE-HOME   TO CU-PHONE-HOME
    MOVE CUST-PHONE-MOBILE TO CU-PHONE-MOBILE
    MOVE CUST-ADDR-LINE1   TO CU-ADDR-LINE1
    MOVE CUST-ADDR-LINE2   TO CU-ADDR-LINE2
    MOVE CUST-CITY         TO CU-CITY
    MOVE CUST-STATE        TO CU-STATE
    MOVE CUST-ZIP          TO CU-ZIP
    MOVE CUST-MEMBER-FLAG  TO CU-MEMBER-FLAG
    MOVE *DATX             TO CU-MODIFIED-DATE
    MOVE #USER-ID          TO CU-MODIFIED-BY
    UPDATE CUST-VIEW
    ESCAPE BOTTOM
  END-FIND
*
  ON ERROR
    COMPRESS 'DATABASE ERROR ON UPDATE:' *ERROR-NR INTO #SCREEN-MSG
    CALLNAT 'LOGERR' 5 'CUSTOMER UPDATE FAILED'
      'E' 'CUSTENTR' #USER-ID
    BACKOUT TRANSACTION
    ESCAPE ROUTINE
  END-ERROR
*
  END OF TRANSACTION
*
  * RELEASE LOCK
  CALLNAT 'LOCKN' 'U' 'CUST' #SEARCH-CUST-ID
    #VALID-FLAG #ERROR-MSG #ERROR-MSG
*
  * AUDIT
  MOVE #SEARCH-CUST-ID TO #CUST-ID-DISPLAY
  CALLNAT 'AUDITN' 'CUST' #CUST-ID-DISPLAY 'U' 'CUSTOMER'
    ' ' ' ' 'CUSTOMER UPDATED'
*
  COMPRESS 'CUSTOMER' #SEARCH-CUST-ID 'UPDATED SUCCESSFULLY'
    INTO #SCREEN-MSG
*
END-SUBROUTINE
*
* =======================================
* DISPLAY CUSTOMER SUBROUTINE
* =======================================
DEFINE SUBROUTINE DISPLAY-CUSTOMER
*
  CALLNAT 'CUSTGET'
    #SEARCH-CUST-ID
    CUSTOMER-DATA
    CUSTOMER-CONTACT
    CUSTOMER-ADDRESS
    CUSTOMER-MEMBERSHIP
    #VALID-FLAG
    #ERROR-MSG
*
  IF #VALID-FLAG NE 'Y'
    MOVE #ERROR-MSG TO #SCREEN-MSG
    MOVE (AD=I CD=RE) TO #SCREEN-MSG-ATTR
    ESCAPE ROUTINE
  END-IF
*
  INPUT (IP=ON)
    / 'RETAILCORE - CUSTOMER DISPLAY' (I)
    / '=============================' (I)
    / 'CUSTOMER ID:' CUST-ID (AD=OI)
    / 'NUMBER     :' CUST-NO (AD=OI)
    / 'TYPE       :' CUST-TYPE (AD=OI)
    / 'STATUS     :' CUST-STATUS (AD=OI)
    /
    / 'NAME       :' CUST-TITLE (AD=OI) CUST-FIRST-NAME (AD=OI)
      CUST-LAST-NAME (AD=OI)
    / 'EMAIL      :' CUST-EMAIL (AD=OI)
    / 'PHONE HOME :' CUST-PHONE-HOME (AD=OI)
    / 'PHONE MOB  :' CUST-PHONE-MOBILE (AD=OI)
    /
    / 'ADDRESS    :' CUST-ADDR-LINE1 (AD=OI)
    /               CUST-ADDR-LINE2 (AD=OI)
    / 'CITY/ST/ZIP:' CUST-CITY (AD=OI) CUST-STATE (AD=OI)
      CUST-ZIP (AD=OI)
    /
    / 'MEMBER     :' CUST-MEMBER-FLAG (AD=OI)
    / 'LOYALTY    :' CUST-LOYALTY-TIER (AD=OI)
    / 'POINTS     :' CUST-LOYALTY-POINTS (AD=OI)
    / 'LIFETIME $ :' CUST-LIFETIME-SPEND (AD=OI)
    / 'YTD SPEND  :' CUST-YTD-SPEND (AD=OI)
    /
    / 'PF3=RETURN  PF7=HISTORY'
*
  IF *PF-KEY = 'PF7'
    CALLNAT 'CUSTHIST' #SEARCH-CUST-ID
  END-IF
*
END-SUBROUTINE
*
END
