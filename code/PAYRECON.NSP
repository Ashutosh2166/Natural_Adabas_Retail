* >Natural Source Code: PAYRECON
* PROGRAM: PAYRECON - PAYMENT RECONCILIATION REPORT
* DESCRIPTION: COMPREHENSIVE PAYMENT RECONCILIATION
*              MATCHES PAYMENTS TO ORDERS AND SETTLEMENTS
*              IDENTIFIES DISCREPANCIES AND AGING AUTH
*              SUPPORTS GL POSTING VERIFICATION
* LIBRARY: RETAILCORE
* ADABAS FILES: 140 (PAYMENT), 143 (SETTLEMENT),
*               111 (ORDER)
* CREATED: 2006-09-15  J. THOMPSON
* MODIFIED: 2013-03-22 - ADDED SETTLEMENT MATCHING
* MODIFIED: 2019-11-10 - ADDED METHOD BREAKDOWN
* MODIFIED: 2024-01-15 - ADDED GATEWAY RECONCILIATION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #START-DATE           (D)
  1 #END-DATE             (D)
*
* PAYMENT METHOD BREAKDOWN
  1 #PM-METHODS (1:7)
    2 #PM-CODE            (A2)
    2 #PM-DESC            (A15)
    2 #PM-AUTH-COUNT      (N8)
    2 #PM-AUTH-AMT        (N13.2)
    2 #PM-CAP-COUNT       (N8)
    2 #PM-CAP-AMT         (N13.2)
    2 #PM-REF-COUNT       (N8)
    2 #PM-REF-AMT         (N13.2)
    2 #PM-NET-AMT         (N13.2)
*
* STATUS COUNTERS
  1 #STAT-AUTH            (N8)
  1 #STAT-AUTH-AMT        (N13.2)
  1 #STAT-CAPTURED        (N8)
  1 #STAT-CAP-AMT         (N13.2)
  1 #STAT-REFUNDED        (N8)
  1 #STAT-REF-AMT         (N13.2)
  1 #STAT-REVERSED        (N8)
  1 #STAT-REV-AMT         (N13.2)
  1 #STAT-EXPIRED         (N8)
  1 #STAT-EXP-AMT         (N13.2)
  1 #STAT-FAILED          (N8)
  1 #STAT-FAIL-AMT        (N13.2)
*
* DISCREPANCY TRACKING
  1 #DISC-COUNT           (N8)
  1 #DISC-DATA (1:100)
    2 #DD-ORDER-ID        (N10)
    2 #DD-PAY-ID          (N10)
    2 #DD-TYPE            (A15)
    2 #DD-EXPECTED        (N11.2)
    2 #DD-ACTUAL          (N11.2)
    2 #DD-DIFF            (N11.2)
*
* SETTLEMENT SUMMARY
  1 #SETTLE-COUNT         (N8)
  1 #SETTLE-AMT           (N13.2)
  1 #SETTLE-UNMATCHED     (N8)
  1 #SETTLE-UNMATCHED-AMT (N11.2)
*
* AGING AUTHORIZATIONS (NOT YET CAPTURED)
  1 #AUTH-AGE-0-1         (N8)
  1 #AUTH-AGE-2-3         (N8)
  1 #AUTH-AGE-4-7         (N8)
  1 #AUTH-AGE-OVER-7      (N8)
  1 #AUTH-AGE-0-1-AMT     (N13.2)
  1 #AUTH-AGE-2-3-AMT     (N13.2)
  1 #AUTH-AGE-4-7-AMT     (N13.2)
  1 #AUTH-AGE-OVER-7-AMT  (N13.2)
*
* GATEWAY BREAKDOWN - MAX 10
  1 #MAX-GATEWAYS         (N4)   INIT <10>
  1 #GW-COUNT             (N4)
  1 #GW-DATA (1:10)
    2 #GW-NAME            (A10)
    2 #GW-TRANS-COUNT     (N8)
    2 #GW-TRANS-AMT       (N13.2)
    2 #GW-FAIL-COUNT      (N8)
    2 #GW-FAIL-RATE       (N5.2)
*
* TOTALS
  1 #TOTAL-PAYMENTS       (N10)
  1 #TOTAL-PAY-AMT        (N13.2)
  1 #NET-REVENUE          (N13.2)
*
  1 #IDX                  (N4)
  1 #FOUND                (L)
  1 #PAY-AGE              (N6)
  1 #TOLERANCE            (N5.2)    INIT <0.01>
*
  1 PRV-VIEW VIEW OF PAYMENT-FILE
    2 PRV-ID              (N10)
    2 PRV-ORDER-ID        (N10)
    2 PRV-METHOD          (A2)
    2 PRV-STATUS          (A2)
    2 PRV-AMOUNT          (N11.2)
    2 PRV-CAPTURED-AMT    (N11.2)
    2 PRV-REFUND-AMT      (N11.2)
    2 PRV-AUTH-DATE        (D)
    2 PRV-GATEWAY         (A10)
*
  1 PSV-VIEW VIEW OF SETTLEMENT-FILE
    2 PSV-ID              (N10)
    2 PSV-PAY-ID          (N10)
    2 PSV-TYPE            (A2)
    2 PSV-AMOUNT          (N11.2)
    2 PSV-SETTLE-DATE     (D)
    2 PSV-STATUS          (A2)
    2 PSV-BATCH-ID        (A12)
*
  1 POV-VIEW VIEW OF ORDER-FILE
    2 POV-ID              (N10)
    2 POV-TOTAL-AMT       (N11.2)
    2 POV-PAID-AMT        (N11.2)
    2 POV-STATUS          (A3)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE *DATX TO #END-DATE
MOVE #END-DATE TO #START-DATE
SUBTRACT 30 FROM #START-DATE (D)
*
* INITIALIZE PAYMENT METHODS
MOVE 'CC' TO #PM-CODE(1)
MOVE 'CREDIT CARD'    TO #PM-DESC(1)
MOVE 'DC' TO #PM-CODE(2)
MOVE 'DEBIT CARD'     TO #PM-DESC(2)
MOVE 'GC' TO #PM-CODE(3)
MOVE 'GIFT CARD'      TO #PM-DESC(3)
MOVE 'CH' TO #PM-CODE(4)
MOVE 'CHECK'          TO #PM-DESC(4)
MOVE 'CA' TO #PM-CODE(5)
MOVE 'CASH'           TO #PM-DESC(5)
MOVE 'WL' TO #PM-CODE(6)
MOVE 'DIGITAL WALLET' TO #PM-DESC(6)
MOVE 'PP' TO #PM-CODE(7)
MOVE 'PAYPAL'         TO #PM-DESC(7)
*
* -------------------------------------------------------
* STEP 1: PROCESS PAYMENTS
* -------------------------------------------------------
FIND PRV-VIEW WITH PRV-AUTH-DATE GE #START-DATE
    AND PRV-AUTH-DATE LE #END-DATE
  ADD 1 TO #TOTAL-PAYMENTS
  ADD PRV-AMOUNT TO #TOTAL-PAY-AMT
*
  * FIND METHOD INDEX
  1 #MI (N4)
  MOVE 7 TO #MI
  FOR #IDX = 1 TO 7
    IF #PM-CODE(#IDX) = PRV-METHOD
      MOVE #IDX TO #MI
      ESCAPE BOTTOM
    END-IF
  END-FOR
*
  * STATUS TRACKING
  DECIDE ON FIRST VALUE OF PRV-STATUS
    VALUE 'AU'
      ADD 1 TO #STAT-AUTH
      ADD PRV-AMOUNT TO #STAT-AUTH-AMT
      ADD 1 TO #PM-AUTH-COUNT(#MI)
      ADD PRV-AMOUNT TO #PM-AUTH-AMT(#MI)
*
      * AGING FOR UNCAPTURED AUTHS
      COMPUTE #PAY-AGE = #END-DATE - PRV-AUTH-DATE
      IF #PAY-AGE <= 1
        ADD 1 TO #AUTH-AGE-0-1
        ADD PRV-AMOUNT TO #AUTH-AGE-0-1-AMT
      ELSE IF #PAY-AGE <= 3
        ADD 1 TO #AUTH-AGE-2-3
        ADD PRV-AMOUNT TO #AUTH-AGE-2-3-AMT
      ELSE IF #PAY-AGE <= 7
        ADD 1 TO #AUTH-AGE-4-7
        ADD PRV-AMOUNT TO #AUTH-AGE-4-7-AMT
      ELSE
        ADD 1 TO #AUTH-AGE-OVER-7
        ADD PRV-AMOUNT TO #AUTH-AGE-OVER-7-AMT
      END-IF
      END-IF
      END-IF
*
    VALUE 'CP'
      ADD 1 TO #STAT-CAPTURED
      ADD PRV-CAPTURED-AMT TO #STAT-CAP-AMT
      ADD 1 TO #PM-CAP-COUNT(#MI)
      ADD PRV-CAPTURED-AMT TO #PM-CAP-AMT(#MI)
*
    VALUE 'RF'
      ADD 1 TO #STAT-REFUNDED
      ADD PRV-REFUND-AMT TO #STAT-REF-AMT
      ADD 1 TO #PM-REF-COUNT(#MI)
      ADD PRV-REFUND-AMT TO #PM-REF-AMT(#MI)
*
    VALUE 'RV'
      ADD 1 TO #STAT-REVERSED
      ADD PRV-AMOUNT TO #STAT-REV-AMT
*
    VALUE 'EX'
      ADD 1 TO #STAT-EXPIRED
      ADD PRV-AMOUNT TO #STAT-EXP-AMT
*
    VALUE 'FL'
      ADD 1 TO #STAT-FAILED
      ADD PRV-AMOUNT TO #STAT-FAIL-AMT
*
    NONE VALUE
      IGNORE
  END-DECIDE
*
  * GATEWAY TRACKING
  IF PRV-GATEWAY NE ' '
    MOVE FALSE TO #FOUND
    FOR #IDX = 1 TO #GW-COUNT
      IF #GW-NAME(#IDX) = PRV-GATEWAY
        MOVE TRUE TO #FOUND
        ESCAPE BOTTOM
      END-IF
    END-FOR
    IF NOT #FOUND AND #GW-COUNT < #MAX-GATEWAYS
      ADD 1 TO #GW-COUNT
      MOVE PRV-GATEWAY TO #GW-NAME(#GW-COUNT)
      MOVE #GW-COUNT TO #IDX
    END-IF
    IF #FOUND OR #GW-COUNT <= #MAX-GATEWAYS
      ADD 1 TO #GW-TRANS-COUNT(#IDX)
      ADD PRV-AMOUNT TO #GW-TRANS-AMT(#IDX)
      IF PRV-STATUS = 'FL'
        ADD 1 TO #GW-FAIL-COUNT(#IDX)
      END-IF
    END-IF
  END-IF
*
  * ORDER-PAYMENT CROSS-CHECK
  IF PRV-STATUS = 'CP' AND #DISC-COUNT < 100
    * VERIFY CAPTURED AMOUNT MATCHES ORDER
    FIND POV-VIEW WITH POV-ID = PRV-ORDER-ID
      IF NO RECORDS FOUND
        IGNORE
      END-NOREC
*
      * CHECK FOR ORPHAN PAYMENT (ORDER NOT FOUND)
      IF *NUMBER = 0
        ADD 1 TO #DISC-COUNT
        MOVE PRV-ORDER-ID TO #DD-ORDER-ID(#DISC-COUNT)
        MOVE PRV-ID       TO #DD-PAY-ID(#DISC-COUNT)
        MOVE 'ORPHAN PAYMENT' TO #DD-TYPE(#DISC-COUNT)
        MOVE PRV-CAPTURED-AMT TO #DD-ACTUAL(#DISC-COUNT)
      ELSE
        * CHECK AMOUNT MISMATCH
        IF POV-TOTAL-AMT > 0
          1 #DIFF (N11.2)
          COMPUTE #DIFF = POV-TOTAL-AMT - POV-PAID-AMT
          IF #DIFF > #TOLERANCE OR #DIFF < (0 - #TOLERANCE)
            * ONLY FLAG IF ORDER IS IN PAID+ STATUS
            IF POV-STATUS = 'PAD' OR POV-STATUS = 'ALC'
                OR POV-STATUS = 'SHP' OR POV-STATUS = 'CMP'
              ADD 1 TO #DISC-COUNT
              MOVE PRV-ORDER-ID    TO #DD-ORDER-ID(#DISC-COUNT)
              MOVE PRV-ID          TO #DD-PAY-ID(#DISC-COUNT)
              MOVE 'AMT MISMATCH'  TO #DD-TYPE(#DISC-COUNT)
              MOVE POV-TOTAL-AMT   TO #DD-EXPECTED(#DISC-COUNT)
              MOVE POV-PAID-AMT    TO #DD-ACTUAL(#DISC-COUNT)
              COMPUTE #DD-DIFF(#DISC-COUNT) =
                POV-TOTAL-AMT - POV-PAID-AMT
            END-IF
          END-IF
        END-IF
      END-IF
      ESCAPE BOTTOM
    END-FIND
  END-IF
*
  IF *COUNTER > 200000
    ESCAPE BOTTOM
  END-IF
END-FIND
*
* -------------------------------------------------------
* STEP 2: SETTLEMENT RECONCILIATION
* -------------------------------------------------------
FIND PSV-VIEW WITH PSV-SETTLE-DATE GE #START-DATE
    AND PSV-SETTLE-DATE LE #END-DATE
  IF PSV-STATUS = 'AC'
    ADD 1 TO #SETTLE-COUNT
    ADD PSV-AMOUNT TO #SETTLE-AMT
  END-IF
*
  * CHECK FOR UNMATCHED SETTLEMENTS
  IF PSV-PAY-ID > 0
    1 #PAY-EXISTS (L)
    MOVE FALSE TO #PAY-EXISTS
    FIND PRV-VIEW WITH PRV-ID = PSV-PAY-ID
      IF NO RECORDS FOUND
        IGNORE
      END-NOREC
      IF *NUMBER > 0
        MOVE TRUE TO #PAY-EXISTS
      END-IF
      ESCAPE BOTTOM
    END-FIND
    IF NOT #PAY-EXISTS
      ADD 1 TO #SETTLE-UNMATCHED
      ADD PSV-AMOUNT TO #SETTLE-UNMATCHED-AMT
    END-IF
  END-IF
*
  IF *COUNTER > 100000
    ESCAPE BOTTOM
  END-IF
END-FIND
*
* CALCULATE NET AMOUNTS AND GATEWAY FAIL RATES
FOR #IDX = 1 TO 7
  COMPUTE #PM-NET-AMT(#IDX) = #PM-CAP-AMT(#IDX)
    - #PM-REF-AMT(#IDX)
END-FOR
*
FOR #IDX = 1 TO #GW-COUNT
  IF #GW-TRANS-COUNT(#IDX) > 0
    COMPUTE #GW-FAIL-RATE(#IDX) =
      #GW-FAIL-COUNT(#IDX) / #GW-TRANS-COUNT(#IDX) * 100
  END-IF
END-FOR
*
COMPUTE #NET-REVENUE = #STAT-CAP-AMT - #STAT-REF-AMT
*
* -------------------------------------------------------
* OUTPUT REPORT
* -------------------------------------------------------
WRITE 'RETAILCORE - PAYMENT RECONCILIATION REPORT'
WRITE '==========================================='
WRITE 'PERIOD:' #START-DATE 'TO' #END-DATE
WRITE 'RUN DATE:' *DATX
WRITE ' '
*
* PAYMENT STATUS SUMMARY
WRITE 'PAYMENT STATUS SUMMARY'
WRITE '======================'
WRITE 'STATUS       COUNT      AMOUNT'
WRITE '-----------  --------  -------------'
WRITE 'AUTHORIZED   ' #STAT-AUTH     #STAT-AUTH-AMT
WRITE 'CAPTURED     ' #STAT-CAPTURED #STAT-CAP-AMT
WRITE 'REFUNDED     ' #STAT-REFUNDED #STAT-REF-AMT
WRITE 'REVERSED     ' #STAT-REVERSED #STAT-REV-AMT
WRITE 'EXPIRED      ' #STAT-EXPIRED  #STAT-EXP-AMT
WRITE 'FAILED       ' #STAT-FAILED   #STAT-FAIL-AMT
WRITE '-----------  --------  -------------'
WRITE 'NET REVENUE                ' #NET-REVENUE
*
* PAYMENT METHOD BREAKDOWN
WRITE ' '
WRITE 'PAYMENT METHOD BREAKDOWN'
WRITE '========================'
WRITE 'METHOD          AUTH CNT  AUTH AMT      CAP CNT'
  '  CAP AMT       REF CNT  REF AMT       NET AMT'
WRITE '---------------  -------  -----------  -------'
  '  -----------  -------  -----------  -----------'
FOR #IDX = 1 TO 7
  IF #PM-AUTH-COUNT(#IDX) > 0 OR #PM-CAP-COUNT(#IDX) > 0
    WRITE #PM-DESC(#IDX) (EM=XXXXXXXXXXXXXXX)
      #PM-AUTH-COUNT(#IDX) #PM-AUTH-AMT(#IDX)
      #PM-CAP-COUNT(#IDX) #PM-CAP-AMT(#IDX)
      #PM-REF-COUNT(#IDX) #PM-REF-AMT(#IDX)
      #PM-NET-AMT(#IDX)
  END-IF
END-FOR
*
* AUTHORIZATION AGING
WRITE ' '
WRITE 'UNCAPTURED AUTHORIZATION AGING'
WRITE '=============================='
WRITE 'AGE          COUNT     AMOUNT'
WRITE '-----------  --------  -----------'
WRITE '0-1 DAYS     ' #AUTH-AGE-0-1     #AUTH-AGE-0-1-AMT
WRITE '2-3 DAYS     ' #AUTH-AGE-2-3     #AUTH-AGE-2-3-AMT
WRITE '4-7 DAYS     ' #AUTH-AGE-4-7     #AUTH-AGE-4-7-AMT
WRITE '>7 DAYS      ' #AUTH-AGE-OVER-7  #AUTH-AGE-OVER-7-AMT
IF #AUTH-AGE-OVER-7 > 0
  WRITE '  *** WARNING:' #AUTH-AGE-OVER-7
    'AUTHORIZATIONS OVER 7 DAYS - AT RISK OF EXPIRY ***'
END-IF
*
* GATEWAY PERFORMANCE
WRITE ' '
WRITE 'GATEWAY PERFORMANCE'
WRITE '==================='
WRITE 'GATEWAY     TRANS CNT  TRANS AMT      FAIL CNT  FAIL %'
WRITE '----------  ---------  -----------    --------  ------'
FOR #IDX = 1 TO #GW-COUNT
  WRITE #GW-NAME(#IDX) (EM=XXXXXXXXXX)
    #GW-TRANS-COUNT(#IDX) #GW-TRANS-AMT(#IDX)
    #GW-FAIL-COUNT(#IDX) #GW-FAIL-RATE(#IDX) '%'
END-FOR
*
* SETTLEMENT RECONCILIATION
WRITE ' '
WRITE 'SETTLEMENT RECONCILIATION'
WRITE '========================='
WRITE 'TOTAL SETTLEMENTS     :' #SETTLE-COUNT
WRITE 'TOTAL SETTLED AMOUNT  :' #SETTLE-AMT
WRITE 'UNMATCHED SETTLEMENTS :' #SETTLE-UNMATCHED
WRITE 'UNMATCHED AMOUNT      :' #SETTLE-UNMATCHED-AMT
*
* DISCREPANCIES
IF #DISC-COUNT > 0
  WRITE ' '
  WRITE '*** DISCREPANCIES FOUND ***'
  WRITE '==========================='
  WRITE 'ORDER-ID    PAY-ID     TYPE             EXPECTED'
    '     ACTUAL       DIFF'
  WRITE '----------  ---------- ---------------  ----------'
    '  ----------  ----------'
  FOR #IDX = 1 TO #DISC-COUNT
    WRITE #DD-ORDER-ID(#IDX) #DD-PAY-ID(#IDX)
      #DD-TYPE(#IDX) (EM=XXXXXXXXXXXXXXX)
      #DD-EXPECTED(#IDX) #DD-ACTUAL(#IDX) #DD-DIFF(#IDX)
  END-FOR
  WRITE ' '
  WRITE '  TOTAL DISCREPANCIES:' #DISC-COUNT
ELSE
  WRITE ' '
  WRITE 'NO DISCREPANCIES FOUND'
END-IF
*
* OVERALL SUMMARY
WRITE ' '
WRITE 'OVERALL SUMMARY'
WRITE '==============='
WRITE 'TOTAL PAYMENTS        :' #TOTAL-PAYMENTS
WRITE 'TOTAL PAYMENT AMOUNT  :' #TOTAL-PAY-AMT
WRITE 'NET CAPTURED REVENUE  :' #NET-REVENUE
WRITE 'DISCREPANCY COUNT     :' #DISC-COUNT
*
WRITE ' '
WRITE 'END OF REPORT'
*
END
