* >Natural Source Code: ORDERSTAT
* PROGRAM: ORDERSTAT - ORDER STATUS REPORT
* DESCRIPTION: COMPREHENSIVE ORDER STATUS AND PIPELINE REPORT
*              ORDERS BY STATUS, AGE, CHANNEL, STORE
*              IDENTIFIES BOTTLENECKS AND AGING ORDERS
* LIBRARY: RETAILCORE
* ADABAS FILES: 111 (ORDER), 112 (ORDER-LINE), 140 (PAYMENT)
* CREATED: 2003-05-15  A. GARCIA
* MODIFIED: 2010-08-22 - ADDED AGING ANALYSIS
* MODIFIED: 2017-12-10 - ADDED CHANNEL BREAKDOWN
* MODIFIED: 2023-02-15 - ADDED PIPELINE ANALYSIS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
*
* STATUS PIPELINE
  1 #STAT-NEW             (N8)
  1 #STAT-VAL             (N8)
  1 #STAT-RES             (N8)
  1 #STAT-CON             (N8)
  1 #STAT-PAD             (N8)
  1 #STAT-ALC             (N8)
  1 #STAT-SHP             (N8)
  1 #STAT-CMP             (N8)
  1 #STAT-CAN             (N8)
  1 #STAT-RET             (N8)
  1 #STAT-OTHER           (N8)
*
* STATUS AMOUNTS
  1 #AMT-NEW              (N13.2)
  1 #AMT-VAL              (N13.2)
  1 #AMT-RES              (N13.2)
  1 #AMT-CON              (N13.2)
  1 #AMT-PAD              (N13.2)
  1 #AMT-ALC              (N13.2)
  1 #AMT-SHP              (N13.2)
  1 #AMT-CMP              (N13.2)
  1 #AMT-CAN              (N13.2)
*
* AGING BUCKETS (FOR OPEN ORDERS)
  1 #AGE-0-1              (N8)
  1 #AGE-2-3              (N8)
  1 #AGE-4-7              (N8)
  1 #AGE-8-14             (N8)
  1 #AGE-15-30            (N8)
  1 #AGE-OVER-30          (N8)
*
* CHANNEL BREAKDOWN
  1 #CH-STORE-COUNT       (N8)
  1 #CH-STORE-AMT         (N13.2)
  1 #CH-WEB-COUNT         (N8)
  1 #CH-WEB-AMT           (N13.2)
  1 #CH-PHONE-COUNT       (N8)
  1 #CH-PHONE-AMT         (N13.2)
  1 #CH-MAIL-COUNT        (N8)
  1 #CH-MAIL-AMT          (N13.2)
*
* STORE BREAKDOWN - MAX 50
  1 #MAX-STORES           (N4)   INIT <50>
  1 #STORE-COUNT          (N4)
  1 #STORE-ORD (1:50)
    2 #SO-STORE-ID        (N4)
    2 #SO-TOTAL-ORDERS    (N8)
    2 #SO-TOTAL-AMT       (N13.2)
    2 #SO-OPEN-ORDERS     (N8)
    2 #SO-OPEN-AMT        (N13.2)
    2 #SO-AVG-ORDER       (N9.2)
*
* PRIORITY BREAKDOWN
  1 #PRIO-1-COUNT         (N8)
  1 #PRIO-2-COUNT         (N8)
  1 #PRIO-3-COUNT         (N8)
  1 #PRIO-NONE-COUNT      (N8)
*
* PAYMENT STATUS
  1 #PAY-FULLY-PAID       (N8)
  1 #PAY-PARTIAL          (N8)
  1 #PAY-UNPAID           (N8)
*
* OVERALL
  1 #TOTAL-ORDERS         (N10)
  1 #TOTAL-AMT            (N13.2)
  1 #TOTAL-OPEN           (N8)
  1 #TOTAL-OPEN-AMT       (N13.2)
  1 #AVG-ORDER-VALUE      (N9.2)
*
  1 #IDX                  (N4)
  1 #FOUND                (L)
  1 #ORDER-AGE            (N6)
*
  1 OSV-VIEW VIEW OF ORDER-FILE
    2 OSV-ID              (N10)
    2 OSV-STATUS          (A3)
    2 OSV-STORE-ID        (N4)
    2 OSV-CHANNEL         (A2)
    2 OSV-DATE            (D)
    2 OSV-TOTAL-AMT       (N11.2)
    2 OSV-PAID-AMT        (N11.2)
    2 OSV-PRIORITY        (N1)
    2 OSV-CUST-ID         (N8)
END-DEFINE
*
MOVE *DATX TO #TODAY
*
* -------------------------------------------------------
* PROCESS ALL ORDERS (LAST 90 DAYS FOR PERFORMANCE)
* -------------------------------------------------------
1 #SCAN-START (D)
MOVE #TODAY TO #SCAN-START
SUBTRACT 90 FROM #SCAN-START (D)
*
FIND OSV-VIEW WITH OSV-DATE GE #SCAN-START
  ADD 1 TO #TOTAL-ORDERS
  ADD OSV-TOTAL-AMT TO #TOTAL-AMT
*
  * STATUS PIPELINE
  DECIDE ON FIRST VALUE OF OSV-STATUS
    VALUE 'NEW'
      ADD 1 TO #STAT-NEW
      ADD OSV-TOTAL-AMT TO #AMT-NEW
    VALUE 'VAL'
      ADD 1 TO #STAT-VAL
      ADD OSV-TOTAL-AMT TO #AMT-VAL
    VALUE 'RES'
      ADD 1 TO #STAT-RES
      ADD OSV-TOTAL-AMT TO #AMT-RES
    VALUE 'CON'
      ADD 1 TO #STAT-CON
      ADD OSV-TOTAL-AMT TO #AMT-CON
    VALUE 'PAD'
      ADD 1 TO #STAT-PAD
      ADD OSV-TOTAL-AMT TO #AMT-PAD
    VALUE 'ALC'
      ADD 1 TO #STAT-ALC
      ADD OSV-TOTAL-AMT TO #AMT-ALC
    VALUE 'SHP'
      ADD 1 TO #STAT-SHP
      ADD OSV-TOTAL-AMT TO #AMT-SHP
    VALUE 'CMP'
      ADD 1 TO #STAT-CMP
      ADD OSV-TOTAL-AMT TO #AMT-CMP
    VALUE 'CAN'
      ADD 1 TO #STAT-CAN
      ADD OSV-TOTAL-AMT TO #AMT-CAN
    VALUE 'RET'
      ADD 1 TO #STAT-RET
    NONE VALUE
      ADD 1 TO #STAT-OTHER
  END-DECIDE
*
  * OPEN ORDER CHECK (NOT COMPLETED/CANCELLED/RETURNED)
  IF OSV-STATUS NE 'CMP' AND OSV-STATUS NE 'CAN'
      AND OSV-STATUS NE 'RET'
    ADD 1 TO #TOTAL-OPEN
    ADD OSV-TOTAL-AMT TO #TOTAL-OPEN-AMT
*
    * AGING ANALYSIS
    COMPUTE #ORDER-AGE = #TODAY - OSV-DATE
    IF #ORDER-AGE <= 1
      ADD 1 TO #AGE-0-1
    ELSE IF #ORDER-AGE <= 3
      ADD 1 TO #AGE-2-3
    ELSE IF #ORDER-AGE <= 7
      ADD 1 TO #AGE-4-7
    ELSE IF #ORDER-AGE <= 14
      ADD 1 TO #AGE-8-14
    ELSE IF #ORDER-AGE <= 30
      ADD 1 TO #AGE-15-30
    ELSE
      ADD 1 TO #AGE-OVER-30
    END-IF
    END-IF
    END-IF
    END-IF
    END-IF
  END-IF
*
  * CHANNEL BREAKDOWN
  DECIDE ON FIRST VALUE OF OSV-CHANNEL
    VALUE 'ST'
      ADD 1 TO #CH-STORE-COUNT
      ADD OSV-TOTAL-AMT TO #CH-STORE-AMT
    VALUE 'WB'
      ADD 1 TO #CH-WEB-COUNT
      ADD OSV-TOTAL-AMT TO #CH-WEB-AMT
    VALUE 'PH'
      ADD 1 TO #CH-PHONE-COUNT
      ADD OSV-TOTAL-AMT TO #CH-PHONE-AMT
    VALUE 'MO'
      ADD 1 TO #CH-MAIL-COUNT
      ADD OSV-TOTAL-AMT TO #CH-MAIL-AMT
    NONE VALUE
      ADD 1 TO #CH-STORE-COUNT
      ADD OSV-TOTAL-AMT TO #CH-STORE-AMT
  END-DECIDE
*
  * STORE BREAKDOWN
  IF OSV-STORE-ID > 0
    MOVE FALSE TO #FOUND
    FOR #IDX = 1 TO #STORE-COUNT
      IF #SO-STORE-ID(#IDX) = OSV-STORE-ID
        MOVE TRUE TO #FOUND
        ESCAPE BOTTOM
      END-IF
    END-FOR
    IF NOT #FOUND AND #STORE-COUNT < #MAX-STORES
      ADD 1 TO #STORE-COUNT
      MOVE OSV-STORE-ID TO #SO-STORE-ID(#STORE-COUNT)
      MOVE #STORE-COUNT TO #IDX
    END-IF
    IF #FOUND OR #STORE-COUNT <= #MAX-STORES
      ADD 1 TO #SO-TOTAL-ORDERS(#IDX)
      ADD OSV-TOTAL-AMT TO #SO-TOTAL-AMT(#IDX)
      IF OSV-STATUS NE 'CMP' AND OSV-STATUS NE 'CAN'
          AND OSV-STATUS NE 'RET'
        ADD 1 TO #SO-OPEN-ORDERS(#IDX)
        ADD OSV-TOTAL-AMT TO #SO-OPEN-AMT(#IDX)
      END-IF
    END-IF
  END-IF
*
  * PRIORITY
  DECIDE ON FIRST VALUE OF OSV-PRIORITY
    VALUE 1
      ADD 1 TO #PRIO-1-COUNT
    VALUE 2
      ADD 1 TO #PRIO-2-COUNT
    VALUE 3
      ADD 1 TO #PRIO-3-COUNT
    NONE VALUE
      ADD 1 TO #PRIO-NONE-COUNT
  END-DECIDE
*
  * PAYMENT STATUS
  IF OSV-STATUS NE 'NEW' AND OSV-STATUS NE 'CAN'
    IF OSV-PAID-AMT >= OSV-TOTAL-AMT AND OSV-TOTAL-AMT > 0
      ADD 1 TO #PAY-FULLY-PAID
    ELSE IF OSV-PAID-AMT > 0
      ADD 1 TO #PAY-PARTIAL
    ELSE
      ADD 1 TO #PAY-UNPAID
    END-IF
    END-IF
  END-IF
*
  IF *COUNTER > 200000
    ESCAPE BOTTOM
  END-IF
END-FIND
*
* CALCULATE STORE AVERAGES
FOR #IDX = 1 TO #STORE-COUNT
  IF #SO-TOTAL-ORDERS(#IDX) > 0
    COMPUTE #SO-AVG-ORDER(#IDX) =
      #SO-TOTAL-AMT(#IDX) / #SO-TOTAL-ORDERS(#IDX)
  END-IF
END-FOR
*
IF #TOTAL-ORDERS > 0
  COMPUTE #AVG-ORDER-VALUE = #TOTAL-AMT / #TOTAL-ORDERS
END-IF
*
* -------------------------------------------------------
* OUTPUT REPORT
* -------------------------------------------------------
WRITE 'RETAILCORE - ORDER STATUS REPORT'
WRITE '================================='
WRITE 'PERIOD: LAST 90 DAYS (SINCE' #SCAN-START ')'
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* STATUS PIPELINE
WRITE 'ORDER STATUS PIPELINE'
WRITE '====================='
WRITE 'STATUS      COUNT     AMOUNT'
WRITE '----------  --------  -------------'
WRITE 'NEW         ' #STAT-NEW     #AMT-NEW
WRITE 'VALIDATED   ' #STAT-VAL     #AMT-VAL
WRITE 'RESERVED    ' #STAT-RES     #AMT-RES
WRITE 'CONFIRMED   ' #STAT-CON     #AMT-CON
WRITE 'PAID        ' #STAT-PAD     #AMT-PAD
WRITE 'ALLOCATED   ' #STAT-ALC     #AMT-ALC
WRITE 'SHIPPED     ' #STAT-SHP     #AMT-SHP
WRITE 'COMPLETED   ' #STAT-CMP     #AMT-CMP
WRITE 'CANCELLED   ' #STAT-CAN     #AMT-CAN
WRITE 'RETURNED    ' #STAT-RET
WRITE 'OTHER       ' #STAT-OTHER
WRITE '----------  --------  -------------'
WRITE 'TOTAL       ' #TOTAL-ORDERS #TOTAL-AMT
*
* OPEN ORDER AGING
WRITE ' '
WRITE 'OPEN ORDER AGING'
WRITE '================'
WRITE 'TOTAL OPEN ORDERS:' #TOTAL-OPEN 'VALUE:' #TOTAL-OPEN-AMT
WRITE ' '
WRITE '0-1 DAYS     :' #AGE-0-1
WRITE '2-3 DAYS     :' #AGE-2-3
WRITE '4-7 DAYS     :' #AGE-4-7
WRITE '8-14 DAYS    :' #AGE-8-14
WRITE '15-30 DAYS   :' #AGE-15-30
WRITE '>30 DAYS     :' #AGE-OVER-30
IF #AGE-OVER-30 > 0
  WRITE '  *** WARNING:' #AGE-OVER-30 'ORDERS ARE OVER 30 DAYS OLD ***'
END-IF
*
* CHANNEL BREAKDOWN
WRITE ' '
WRITE 'ORDERS BY CHANNEL'
WRITE '=================='
WRITE 'CHANNEL     COUNT      AMOUNT         AVG ORDER'
WRITE '----------  --------  -------------  ---------'
1 #CH-AVG (N9.2)
IF #CH-STORE-COUNT > 0
  COMPUTE #CH-AVG = #CH-STORE-AMT / #CH-STORE-COUNT
END-IF
WRITE 'IN-STORE    ' #CH-STORE-COUNT #CH-STORE-AMT #CH-AVG
RESET #CH-AVG
IF #CH-WEB-COUNT > 0
  COMPUTE #CH-AVG = #CH-WEB-AMT / #CH-WEB-COUNT
END-IF
WRITE 'WEB         ' #CH-WEB-COUNT #CH-WEB-AMT #CH-AVG
RESET #CH-AVG
IF #CH-PHONE-COUNT > 0
  COMPUTE #CH-AVG = #CH-PHONE-AMT / #CH-PHONE-COUNT
END-IF
WRITE 'PHONE       ' #CH-PHONE-COUNT #CH-PHONE-AMT #CH-AVG
RESET #CH-AVG
IF #CH-MAIL-COUNT > 0
  COMPUTE #CH-AVG = #CH-MAIL-AMT / #CH-MAIL-COUNT
END-IF
WRITE 'MAIL ORDER  ' #CH-MAIL-COUNT #CH-MAIL-AMT #CH-AVG
*
* STORE BREAKDOWN
WRITE ' '
WRITE 'ORDERS BY STORE'
WRITE '==============='
WRITE 'STORE  TOTAL ORD  TOTAL AMT     OPEN ORD  OPEN AMT      AVG ORD'
WRITE '-----  ---------  -----------   --------  -----------  ---------'
FOR #IDX = 1 TO #STORE-COUNT
  WRITE #SO-STORE-ID(#IDX)
    #SO-TOTAL-ORDERS(#IDX) #SO-TOTAL-AMT(#IDX)
    #SO-OPEN-ORDERS(#IDX) #SO-OPEN-AMT(#IDX)
    #SO-AVG-ORDER(#IDX)
END-FOR
*
* PRIORITY BREAKDOWN
WRITE ' '
WRITE 'ORDERS BY PRIORITY'
WRITE '==================='
WRITE 'PRIORITY 1 (URGENT)  :' #PRIO-1-COUNT
WRITE 'PRIORITY 2 (HIGH)    :' #PRIO-2-COUNT
WRITE 'PRIORITY 3 (NORMAL)  :' #PRIO-3-COUNT
WRITE 'NO PRIORITY          :' #PRIO-NONE-COUNT
*
* PAYMENT STATUS
WRITE ' '
WRITE 'PAYMENT STATUS'
WRITE '=============='
WRITE 'FULLY PAID    :' #PAY-FULLY-PAID
WRITE 'PARTIAL PAID  :' #PAY-PARTIAL
WRITE 'UNPAID        :' #PAY-UNPAID
*
* OVERALL SUMMARY
WRITE ' '
WRITE 'OVERALL SUMMARY'
WRITE '==============='
WRITE 'TOTAL ORDERS (90 DAYS) :' #TOTAL-ORDERS
WRITE 'TOTAL VALUE            :' #TOTAL-AMT
WRITE 'AVG ORDER VALUE        :' #AVG-ORDER-VALUE
WRITE 'OPEN ORDERS            :' #TOTAL-OPEN
WRITE 'OPEN ORDER VALUE       :' #TOTAL-OPEN-AMT
*
WRITE ' '
WRITE 'END OF REPORT'
*
END
