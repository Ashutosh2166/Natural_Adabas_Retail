* >Natural Source Code: PAYREV
* SUBPROGRAM: PAYREV - PAYMENT REVERSAL
* DESCRIPTION: REVERSES/VOIDS A PAYMENT AUTHORIZATION
*              OR ISSUES REFUND FOR CAPTURED PAYMENT
* LIBRARY: RETAILCORE
* ADABAS FILE: 140 (PAYMENT)
* CREATED: 2001-02-15  A. GARCIA
* MODIFIED: 2009-11-22 - ADDED PARTIAL REFUND
* MODIFIED: 2016-06-10 - ADDED MULTIPLE REFUNDS
* MODIFIED: 2022-03-15 - ADDED REFUND POLICY CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-REFUND-AMT          (N11.2)
  1 P-REASON              (A4)
  1 P-REASON-CODE         (A4)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #TOTAL-CAPTURED       (N11.2)
  1 #TOTAL-REFUNDED       (N11.2)
  1 #REFUNDABLE           (N11.2)
  1 #REMAINING            (N11.2)
  1 #GW-RC                (N4)
  1 #GW-MSG               (A80)
  1 #ORD-STR              (A15)
  1 #PAY-FOUND            (A1)
*
  1 PRV-VIEW VIEW OF PAYMENT-FILE
    2 PRV-ID               (N10)
    2 PRV-ORDER-ID         (N10)
    2 PRV-METHOD           (A2)
    2 PRV-STATUS           (A2)
    2 PRV-AMOUNT           (N11.2)
    2 PRV-CAPTURED-AMT     (N11.2)
    2 PRV-REFUNDED-AMT     (N11.2)
    2 PRV-AUTH-CODE        (A20)
    2 PRV-GATEWAY-ID       (A10)
*
  1 STL-VIEW VIEW OF SETTLEMENT-FILE
    2 STL-PAY-ID           (N10)
    2 STL-ORDER-ID         (N10)
    2 STL-AMOUNT           (N11.2)
    2 STL-TYPE             (A2)
    2 STL-STATUS           (A2)
    2 STL-DATE             (D)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
*
IF P-REFUND-AMT <= 0
  MOVE 701 TO P-RC
  MOVE 'REFUND AMOUNT MUST BE > 0' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* FIND ALL PAYMENTS FOR ORDER
MOVE 'N' TO #PAY-FOUND
RESET #TOTAL-CAPTURED
RESET #TOTAL-REFUNDED
FIND PRV-VIEW WITH PRV-ORDER-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 704 TO P-RC
    MOVE 'NO PAYMENTS FOUND FOR ORDER' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE 'Y' TO #PAY-FOUND
  IF PRV-STATUS = 'CA' OR PRV-STATUS = 'FL'
    ADD PRV-CAPTURED-AMT TO #TOTAL-CAPTURED
    ADD PRV-REFUNDED-AMT TO #TOTAL-REFUNDED
  ELSE IF PRV-STATUS = 'AU'
    ADD PRV-AMOUNT TO #TOTAL-CAPTURED
  END-IF
  END-IF
END-FIND
*
COMPUTE #REFUNDABLE = #TOTAL-CAPTURED - #TOTAL-REFUNDED
IF P-REFUND-AMT > #REFUNDABLE
  MOVE 711 TO P-RC
  COMPRESS 'REFUND EXCEEDS REFUNDABLE AMOUNT:' #REFUNDABLE
    INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* PROCESS REFUND AGAINST PAYMENTS (FIFO)
MOVE P-REFUND-AMT TO #REMAINING
FIND PRV-VIEW WITH PRV-ORDER-ID = P-ORDER-ID
  IF #REMAINING <= 0
    ESCAPE BOTTOM
  END-IF
*
  * SKIP NON-REFUNDABLE
  IF PRV-STATUS NE 'CA' AND PRV-STATUS NE 'AU'
      AND PRV-STATUS NE 'FL'
    ESCAPE TOP
  END-IF
*
  1 #THIS-REFUND (N11.2)
  COMPUTE #THIS-REFUND = PRV-CAPTURED-AMT - PRV-REFUNDED-AMT
  IF PRV-STATUS = 'AU'
    MOVE PRV-AMOUNT TO #THIS-REFUND
  END-IF
*
  IF #THIS-REFUND <= 0
    ESCAPE TOP
  END-IF
  IF #REMAINING < #THIS-REFUND
    MOVE #REMAINING TO #THIS-REFUND
  END-IF
*
  * GATEWAY REVERSAL/REFUND (SIMULATED)
  RESET #GW-RC
  IF #GW-RC NE 0
    CALLNAT 'LOGERR' 720 #GW-MSG 'W' 'PAYREV' #USER-ID
    ESCAPE TOP
  END-IF
*
  * UPDATE PAYMENT RECORD
  GET PRV-VIEW *ISN (HOLD)
  ADD #THIS-REFUND TO PRV-REFUNDED-AMT
  IF PRV-STATUS = 'AU'
    MOVE 'RV' TO PRV-STATUS
  ELSE
    IF PRV-REFUNDED-AMT >= PRV-CAPTURED-AMT
      MOVE 'RF' TO PRV-STATUS
    END-IF
  END-IF
  UPDATE PRV-VIEW
*
  * CREATE SETTLEMENT RECORD
  STORE STL-VIEW
    STL-PAY-ID   := PRV-ID
    STL-ORDER-ID := P-ORDER-ID
    STL-AMOUNT   := #THIS-REFUND
    STL-TYPE     := 'RF'
    STL-STATUS   := 'PN'
    STL-DATE     := #TODAY
  END-STORE
*
  SUBTRACT #THIS-REFUND FROM #REMAINING
END-FIND
*
END OF TRANSACTION
*
* AUDIT
MOVE P-ORDER-ID TO #ORD-STR
1 #AMT-STR (A15)
MOVE P-REFUND-AMT TO #AMT-STR
CALLNAT 'AUDITN' 'PAY' #ORD-STR 'U' 'REFND'
  P-REASON #AMT-STR 'PAYMENT REVERSED/REFUNDED'
*
END
