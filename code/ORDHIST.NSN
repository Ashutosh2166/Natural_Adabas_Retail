* >Natural Source Code: ORDHIST
* SUBPROGRAM: ORDHIST - ORDER STATUS HISTORY
* DESCRIPTION: RETRIEVES ORDER STATUS CHANGE HISTORY
*              WITH OPTIONAL DATE RANGE FILTER
* LIBRARY: RETAILCORE
* ADABAS FILE: 113 (ORDER-HISTORY)
* CREATED: 2005-03-20  S. MARTINEZ
* MODIFIED: 2014-06-15 - ADDED PAGINATION
* MODIFIED: 2020-09-10 - ADDED SUMMARY STATS
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-FROM-DATE           (D)
  1 P-TO-DATE             (D)
  1 P-PAGE-NO             (N4)
  1 P-TOTAL-RECORDS       (N6)
  1 P-HISTORY (20)
    2 P-HI-SEQ            (N4)
    2 P-HI-OLD-STATUS     (A3)
    2 P-HI-NEW-STATUS     (A3)
    2 P-HI-DATE           (D)
    2 P-HI-TIME           (T)
    2 P-HI-USER           (A8)
    2 P-HI-PROGRAM        (A8)
  1 P-HIST-COUNT          (N4)
  1 P-SUMMARY
    2 P-SUM-TOTAL-CHANGES (N6)
    2 P-SUM-FIRST-DATE    (D)
    2 P-SUM-LAST-DATE     (D)
    2 P-SUM-DAYS-TO-SHIP  (N4)
    2 P-SUM-DAYS-TO-COMP  (N4)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #IDX                  (N4)
  1 #SKIP-COUNT           (N6)
  1 #PAGE-SIZE            (N4)    INIT <20>
  1 #NEW-DATE             (D)
  1 #RES-DATE             (D)
  1 #SHP-DATE             (D)
  1 #CMP-DATE             (D)
  1 #DAYS-DIFF            (N6)
  1 #FIRST-REC            (A1)
*
  1 HI-VIEW VIEW OF ORDER-HIST-FILE
    2 HI-ORDER-ID          (N10)
    2 HI-SEQ-NO            (N4)
    2 HI-OLD-STATUS        (A3)
    2 HI-NEW-STATUS        (A3)
    2 HI-CHANGE-DATE       (D)
    2 HI-CHANGE-TIME       (T)
    2 HI-CHANGE-USER       (A8)
    2 HI-CHANGE-PROGRAM    (A8)
END-DEFINE
*
RESET P-RC
RESET P-RC-TEXT
RESET P-HIST-COUNT
RESET P-TOTAL-RECORDS
RESET P-SUMMARY
MOVE 'Y' TO #FIRST-REC
*
IF P-ORDER-ID = 0
  MOVE 405 TO P-RC
  MOVE 'ORDER ID REQUIRED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* COUNT TOTAL RECORDS
FIND NUMBER HI-VIEW WITH HI-ORDER-ID = P-ORDER-ID
  MOVE *NUMBER TO P-TOTAL-RECORDS
END-FIND
*
IF P-TOTAL-RECORDS = 0
  MOVE 404 TO P-RC
  MOVE 'NO HISTORY FOUND FOR ORDER' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* CALCULATE SKIP FOR PAGINATION
IF P-PAGE-NO > 1
  COMPUTE #SKIP-COUNT = (P-PAGE-NO - 1) * #PAGE-SIZE
ELSE
  RESET #SKIP-COUNT
END-IF
*
* RETRIEVE HISTORY RECORDS
RESET #IDX
RESET P-SUM-TOTAL-CHANGES
FIND HI-VIEW WITH HI-ORDER-ID = P-ORDER-ID
    SORTED BY HI-SEQ-NO
*
  ADD 1 TO P-SUM-TOTAL-CHANGES
*
  * TRACK SUMMARY DATES
  IF #FIRST-REC = 'Y'
    MOVE HI-CHANGE-DATE TO P-SUM-FIRST-DATE
    MOVE 'N' TO #FIRST-REC
  END-IF
  MOVE HI-CHANGE-DATE TO P-SUM-LAST-DATE
*
  * TRACK KEY STATUS DATES FOR METRICS
  IF HI-NEW-STATUS = 'RES'
    MOVE HI-CHANGE-DATE TO #RES-DATE
  END-IF
  IF HI-NEW-STATUS = 'SHP'
    MOVE HI-CHANGE-DATE TO #SHP-DATE
  END-IF
  IF HI-NEW-STATUS = 'CMP'
    MOVE HI-CHANGE-DATE TO #CMP-DATE
  END-IF
*
  * DATE RANGE FILTER
  IF P-FROM-DATE > 0
    IF HI-CHANGE-DATE < P-FROM-DATE
      ESCAPE TOP
    END-IF
  END-IF
  IF P-TO-DATE > 0
    IF HI-CHANGE-DATE > P-TO-DATE
      ESCAPE TOP
    END-IF
  END-IF
*
  * PAGINATION - SKIP
  IF #SKIP-COUNT > 0
    SUBTRACT 1 FROM #SKIP-COUNT
    ESCAPE TOP
  END-IF
*
  * PAGINATION - LIMIT
  ADD 1 TO #IDX
  IF #IDX > #PAGE-SIZE
    ESCAPE BOTTOM
  END-IF
*
  MOVE HI-SEQ-NO        TO P-HISTORY.P-HI-SEQ(#IDX)
  MOVE HI-OLD-STATUS    TO P-HISTORY.P-HI-OLD-STATUS(#IDX)
  MOVE HI-NEW-STATUS    TO P-HISTORY.P-HI-NEW-STATUS(#IDX)
  MOVE HI-CHANGE-DATE   TO P-HISTORY.P-HI-DATE(#IDX)
  MOVE HI-CHANGE-TIME   TO P-HISTORY.P-HI-TIME(#IDX)
  MOVE HI-CHANGE-USER   TO P-HISTORY.P-HI-USER(#IDX)
  MOVE HI-CHANGE-PROGRAM TO P-HISTORY.P-HI-PROGRAM(#IDX)
*
END-FIND
*
MOVE #IDX TO P-HIST-COUNT
*
* CALCULATE SUMMARY METRICS
IF #RES-DATE > 0 AND #SHP-DATE > 0
  CALLNAT 'DATEU' 'DIFF' #RES-DATE #SHP-DATE
    0 ' ' ' ' 0 0 ' ' P-SUM-DAYS-TO-SHIP ' '
END-IF
IF #RES-DATE > 0 AND #CMP-DATE > 0
  CALLNAT 'DATEU' 'DIFF' #RES-DATE #CMP-DATE
    0 ' ' ' ' 0 0 ' ' P-SUM-DAYS-TO-COMP ' '
END-IF
*
END
