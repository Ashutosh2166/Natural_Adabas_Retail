* >Natural Source Code: RETCHK
* SUBPROGRAM: RETCHK - RETURN ELIGIBILITY CHECK
* DESCRIPTION: CHECKS IF ORDER IS ELIGIBLE FOR RETURN
*              VALIDATES RETURN WINDOW, PRODUCT TYPE,
*              CUSTOMER HISTORY
* LIBRARY: RETAILCORE
* CREATED: 2009-08-15  S. MARTINEZ
* MODIFIED: 2015-04-22 - ADDED PRODUCT CATEGORY CHECK
* MODIFIED: 2021-09-10 - ADDED ABUSE DETECTION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-ORDER-DATE          (D)
  1 P-CURRENT-DATE        (D)
  1 P-ELIGIBLE-FLAG       (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #RETURN-WINDOW        (N4)    INIT <30>
  1 #DAYS-SINCE-ORDER     (N6)
  1 #CUST-ID              (N8)
  1 #RECENT-RETURNS       (N4)
  1 #MAX-RETURNS          (N4)    INIT <5>
  1 #ABUSE-THRESHOLD      (N4)    INIT <3>
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 ECK-VIEW VIEW OF ORDER-FILE
    2 ECK-ID               (N10)
    2 ECK-CUST-ID          (N8)
    2 ECK-STATUS           (A3)
    2 ECK-DATE             (D)
*
  1 ERT-VIEW VIEW OF RETURN-FILE
    2 ERT-ORDER-ID         (N10)
    2 ERT-CUST-ID          (N8)
    2 ERT-STATUS           (A3)
    2 ERT-DATE             (D)
END-DEFINE
*
MOVE 'Y' TO P-ELIGIBLE-FLAG
RESET P-ERROR-MSG
*
* GET RETURN WINDOW FROM CONFIG
CALLNAT 'CONFIGN' 'RETURN.WINDOW.DAYS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #RETURN-WINDOW
END-IF
*
* CHECK RETURN WINDOW
CALLNAT 'DATEU' 'DIFF' P-ORDER-DATE P-CURRENT-DATE
  0 ' ' ' ' 0 0 ' ' #DAYS-SINCE-ORDER ' '
*
IF #DAYS-SINCE-ORDER > #RETURN-WINDOW
  MOVE 'N' TO P-ELIGIBLE-FLAG
  COMPRESS 'RETURN WINDOW EXPIRED (' #RETURN-WINDOW 'DAYS)'
    INTO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK ORDER STATUS
FIND ECK-VIEW WITH ECK-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 'N' TO P-ELIGIBLE-FLAG
    MOVE 'ORDER NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
  IF ECK-STATUS NE 'SHP' AND ECK-STATUS NE 'CMP'
      AND ECK-STATUS NE 'RET'
    MOVE 'N' TO P-ELIGIBLE-FLAG
    COMPRESS 'ORDER STATUS' ECK-STATUS 'NOT RETURNABLE'
      INTO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  MOVE ECK-CUST-ID TO #CUST-ID
  ESCAPE BOTTOM
END-FIND
*
* CHECK FOR EXISTING RETURN ON THIS ORDER
FIND ERT-VIEW WITH ERT-ORDER-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    IGNORE
  END-NOREC
  IF ERT-STATUS NE 'REJ' AND ERT-STATUS NE 'CLS'
    MOVE 'W' TO P-ELIGIBLE-FLAG
    MOVE 'WARNING: EXISTING RETURN ON THIS ORDER' TO P-ERROR-MSG
    * DON'T BLOCK - PARTIAL RETURN MAY BE VALID
  END-IF
  ESCAPE BOTTOM
END-FIND
*
* ABUSE DETECTION: CHECK RECENT RETURN FREQUENCY
CALLNAT 'CONFIGN' 'RETURN.ABUSE.THRESHOLD'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #ABUSE-THRESHOLD
END-IF
*
RESET #RECENT-RETURNS
1 #CUTOFF-DATE (D)
MOVE P-CURRENT-DATE TO #CUTOFF-DATE
SUBTRACT 90 FROM #CUTOFF-DATE (D)
*
FIND ERT-VIEW WITH ERT-CUST-ID = #CUST-ID
  IF ERT-DATE >= #CUTOFF-DATE
    IF ERT-STATUS NE 'REJ'
      ADD 1 TO #RECENT-RETURNS
    END-IF
  END-IF
END-FIND
*
IF #RECENT-RETURNS >= #ABUSE-THRESHOLD
  IF P-ELIGIBLE-FLAG = 'Y'
    MOVE 'W' TO P-ELIGIBLE-FLAG
  END-IF
  COMPRESS 'WARNING: CUSTOMER HAS' #RECENT-RETURNS
    'RETURNS IN 90 DAYS' INTO P-ERROR-MSG
END-IF
*
END
