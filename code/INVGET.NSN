* >Natural Source Code: INVGET
* SUBPROGRAM: INVGET - INVENTORY RETRIEVAL
* DESCRIPTION: RETRIEVES FULL INVENTORY RECORD FOR
*              A PRODUCT AT A SPECIFIC LOCATION
* LIBRARY: RETAILCORE
* ADABAS FILE: 105 (INVENTORY)
* CREATED: 1998-09-05  K. PATEL
* MODIFIED: 2006-02-18 - ADDED THRESHOLD DATA
* MODIFIED: 2015-10-22 - ADDED LAST COUNT DATE
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-LOC-TYPE            (A1)
  1 P-LOC-ID              (N4)
  1 P-INV-DATA
    2 P-ON-HAND           (N8)
    2 P-RESERVED          (N8)
    2 P-ALLOCATED         (N8)
    2 P-DAMAGED           (N8)
    2 P-IN-TRANSIT        (N8)
    2 P-AVAILABLE         (N8)
    2 P-SAFETY-STOCK      (N8)
    2 P-REORDER-LEVEL     (N8)
    2 P-REORDER-QTY       (N8)
    2 P-MAX-STOCK         (N8)
    2 P-LAST-COUNT-DATE   (D)
    2 P-LAST-RECEIPT-DATE (D)
    2 P-LAST-SOLD-DATE    (D)
  1 P-FOUND-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 INV-GET-VIEW VIEW OF INVENTORY-FILE
    2 IG-PROD-ID           (N8)
    2 IG-LOC-TYPE          (A1)
    2 IG-LOC-ID            (N4)
    2 IG-ON-HAND           (N8)
    2 IG-RESERVED          (N8)
    2 IG-ALLOCATED         (N8)
    2 IG-DAMAGED           (N8)
    2 IG-IN-TRANSIT        (N8)
    2 IG-SAFETY-STOCK      (N8)
    2 IG-REORDER-LEVEL     (N8)
    2 IG-REORDER-QTY       (N8)
    2 IG-MAX-STOCK         (N8)
    2 IG-LAST-COUNT-DATE   (D)
    2 IG-LAST-RECEIPT-DATE (D)
    2 IG-LAST-SOLD-DATE    (D)
END-DEFINE
*
MOVE 'N' TO P-FOUND-FLAG
RESET P-ERROR-MSG
RESET P-INV-DATA
*
IF P-PROD-ID = 0
  MOVE 'PRODUCT ID REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
FIND INV-GET-VIEW WITH IG-PROD-ID = P-PROD-ID
    AND IG-LOC-TYPE = P-LOC-TYPE
    AND IG-LOC-ID = P-LOC-ID
  IF NO RECORDS FOUND
    MOVE 'INVENTORY RECORD NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
*
  MOVE IG-ON-HAND          TO P-ON-HAND
  MOVE IG-RESERVED         TO P-RESERVED
  MOVE IG-ALLOCATED        TO P-ALLOCATED
  MOVE IG-DAMAGED          TO P-DAMAGED
  MOVE IG-IN-TRANSIT       TO P-IN-TRANSIT
  MOVE IG-SAFETY-STOCK     TO P-SAFETY-STOCK
  MOVE IG-REORDER-LEVEL    TO P-REORDER-LEVEL
  MOVE IG-REORDER-QTY      TO P-REORDER-QTY
  MOVE IG-MAX-STOCK        TO P-MAX-STOCK
  MOVE IG-LAST-COUNT-DATE  TO P-LAST-COUNT-DATE
  MOVE IG-LAST-RECEIPT-DATE TO P-LAST-RECEIPT-DATE
  MOVE IG-LAST-SOLD-DATE   TO P-LAST-SOLD-DATE
*
  * CALCULATE AVAILABLE
  COMPUTE P-AVAILABLE = P-ON-HAND - P-RESERVED
    - P-ALLOCATED - P-DAMAGED
  IF P-AVAILABLE < 0
    MOVE 0 TO P-AVAILABLE
  END-IF
*
  MOVE 'Y' TO P-FOUND-FLAG
  ESCAPE BOTTOM
END-FIND
*
ON ERROR
  COMPRESS 'DB ERROR:' *ERROR-NR INTO P-ERROR-MSG
  CALLNAT 'LOGERR' 300 P-ERROR-MSG 'E' 'INVGET' *USER
END-ERROR
*
END
