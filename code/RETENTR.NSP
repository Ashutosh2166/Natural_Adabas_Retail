* >Natural Source Code: RETENTR
* PROGRAM: RETENTR - RETURN ENTRY (ONLINE)
* DESCRIPTION: INTERACTIVE RETURN CREATION SCREEN
*              ORDER LOOKUP -> LINE SELECTION -> ELIGIBILITY
*              -> RETURN CREATION -> REFUND INITIATION
* LIBRARY: RETAILCORE
* ADABAS FILES: 150 (RETURN), 151 (RETURN-LINE)
* CREATED: 2003-04-15  A. GARCIA
* MODIFIED: 2009-08-22 - ADDED ELIGIBILITY CHECK
* MODIFIED: 2015-03-10 - ADDED RETURN LABEL GENERATION
* MODIFIED: 2021-06-15 - ADDED WEB RETURN SUPPORT
* MODIFIED: 2024-02-10 - ADDED EXCHANGE OPTION
* -------------------------------------------------------
DEFINE DATA
LOCAL USING RET-COPY
LOCAL USING ORD-COPY
LOCAL USING COMMON-COPY
*
LOCAL
  1 #SCREEN-MSG           (A78)
  1 #USER-ID              (A8)
  1 #ORDER-ID             (N10)
  1 #NEW-RET-ID           (N10)
  1 #RET-NUMBER           (A15)
  1 #LINE-IDX             (N3)
  1 #ELIGIBLE-FLAG        (A1)
  1 #ELIG-MSG             (A60)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #ORD-STR              (A15)
  1 #RETURN-TOTAL         (N11.2)
  1 #RETURN-TAX           (N9.2)
*
* ORDER HEADER (FROM ORDGET)
  1 #OH
    2 #OH-ID              (N10)
    2 #OH-NUMBER          (A12)
    2 #OH-CUST-ID         (N8)
    2 #OH-STORE-ID        (N4)
    2 #OH-STATUS          (A3)
    2 #OH-TYPE            (A2)
    2 #OH-DATE            (D)
    2 #OH-NUM-LINES       (N3)
    2 #OH-SUBTOTAL        (N11.2)
    2 #OH-DISCOUNT        (N9.2)
    2 #OH-TAX             (N9.2)
    2 #OH-TOTAL           (N11.2)
    2 #OH-PAID            (N11.2)
    2 #OH-CURRENCY        (A3)
  1 #OL-COUNT             (N3)
  1 #OL-LINES (20)
    2 #OL-NO              (N3)
    2 #OL-PROD-ID         (N8)
    2 #OL-SKU             (A15)
    2 #OL-DESC            (A60)
    2 #OL-QTY             (N6)
    2 #OL-PRICE           (N9.2)
    2 #OL-DISC            (N9.2)
    2 #OL-TAX             (N9.2)
    2 #OL-TOTAL           (N11.2)
    2 #OL-STATUS          (A3)
  1 #FOUND-FLAG           (A1)
  1 #ERR-MSG              (A60)
*
* RETURN LINES
  1 #RET-LINES (20)
    2 #RL-LINE-NO         (N3)
    2 #RL-QTY             (N6)
    2 #RL-REASON          (A4)
    2 #RL-CONDITION       (A1)    /* N=NEW O=OPENED D=DAMAGED */
    2 #RL-REFUND-AMT      (N11.2)
*
  1 RET-VIEW VIEW OF RETURN-FILE
    2 RV-ID                (N10)
    2 RV-NUMBER            (A15)
    2 RV-ORDER-ID          (N10)
    2 RV-CUST-ID           (N8)
    2 RV-STORE-ID          (N4)
    2 RV-STATUS            (A3)
    2 RV-TYPE              (A2)
    2 RV-REASON-CODE       (A4)
    2 RV-NUM-LINES         (N3)
    2 RV-SUBTOTAL          (N11.2)
    2 RV-TAX-AMT           (N9.2)
    2 RV-TOTAL-AMT         (N11.2)
    2 RV-REFUND-METHOD     (A2)
    2 RV-DATE              (D)
    2 RV-CREATED-BY        (A8)
*
  1 RTL-VIEW VIEW OF RETURN-LINE-FILE
    2 RTL-RETURN-ID        (N10)
    2 RTL-LINE-NO          (N3)
    2 RTL-ORDER-LINE-NO    (N3)
    2 RTL-PROD-ID          (N8)
    2 RTL-SKU              (A15)
    2 RTL-QTY-RETURNED     (N6)
    2 RTL-REASON-CODE      (A4)
    2 RTL-CONDITION        (A1)
    2 RTL-UNIT-PRICE       (N9.2)
    2 RTL-REFUND-AMT       (N11.2)
    2 RTL-STATUS           (A3)
END-DEFINE
*
MOVE *USER TO #USER-ID
*
* STEP 1: ORDER LOOKUP
INPUT (IP=ON) WITH TEXT #SCREEN-MSG
  / 'RETAILCORE - RETURN ENTRY' (I)
  / '=========================' (I)
  /
  / 'ORDER ID:' #ORDER-ID (AD=MI)
  /
  / 'PF3=CANCEL  ENTER=LOOK UP ORDER'
*
IF *PF-KEY = 'PF3'
  ESCAPE ROUTINE
END-IF
*
* GET ORDER
CALLNAT 'ORDGET' #ORDER-ID #OH #OL-COUNT #OL-LINES
  #FOUND-FLAG #ERR-MSG
IF #FOUND-FLAG NE 'Y'
  MOVE #ERR-MSG TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK ORDER IS RETURNABLE
IF #OH-STATUS NE 'SHP' AND #OH-STATUS NE 'CMP'
  COMPRESS 'ORDER IN STATUS' #OH-STATUS 'NOT RETURNABLE'
    INTO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK RETURN ELIGIBILITY
CALLNAT 'RETCHK' #ORDER-ID #OH-DATE *DATX
  #ELIGIBLE-FLAG #ELIG-MSG
IF #ELIGIBLE-FLAG NE 'Y'
  MOVE #ELIG-MSG TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* STEP 2: SELECT LINES TO RETURN
RESET #LINE-IDX
RESET #RETURN-TOTAL
RESET #RETURN-TAX
*
1 #LI (N3)
FOR #LI = 1 TO #OL-COUNT
  IF #OL-LINES.#OL-STATUS(#LI) = 'CAN'
    ESCAPE TOP
  END-IF
*
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'RETURN LINE SELECTION'
    / 'ORDER:' #OH-NUMBER (AD=OI)
    /
    / 'LINE :' #OL-LINES.#OL-NO(#LI) (AD=OI)
    / 'SKU  :' #OL-LINES.#OL-SKU(#LI) (AD=OI)
    / 'DESC :' #OL-LINES.#OL-DESC(#LI) (AD=OI)
    / 'QTY  :' #OL-LINES.#OL-QTY(#LI) (AD=OI)
    / 'PRICE:' #OL-LINES.#OL-TOTAL(#LI) (AD=OI)
    /
    / 'RETURN QTY  :' #RET-LINES.#RL-QTY(#LI) (AD=MI)
    / 'REASON CODE :' #RET-LINES.#RL-REASON(#LI) (AD=MI)
    /   '(DEFN=DEFECTIVE WRNG=WRONG DMGD=DAMAGED NOFI=NO FIT'
    /   ' CHGD=CHANGED MIND OTHR=OTHER)'
    / 'CONDITION   :' #RET-LINES.#RL-CONDITION(#LI) (AD=MI)
    /   '(N=NEW/SEALED O=OPENED D=DAMAGED)'
    /
    / 'PF3=DONE  ENTER=NEXT LINE'
*
  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF
*
  IF #RET-LINES.#RL-QTY(#LI) > 0
    * VALIDATE RETURN QTY
    IF #RET-LINES.#RL-QTY(#LI) > #OL-LINES.#OL-QTY(#LI)
      MOVE 'RETURN QTY EXCEEDS ORDER QTY' TO #SCREEN-MSG
      ESCAPE TOP
    END-IF
    ADD 1 TO #LINE-IDX
    MOVE #OL-LINES.#OL-NO(#LI) TO #RET-LINES.#RL-LINE-NO(#LI)
    * CALCULATE REFUND (PROPORTIONAL)
    COMPUTE #RET-LINES.#RL-REFUND-AMT(#LI) =
      (#OL-LINES.#OL-TOTAL(#LI) / #OL-LINES.#OL-QTY(#LI))
      * #RET-LINES.#RL-QTY(#LI)
    ADD #RET-LINES.#RL-REFUND-AMT(#LI) TO #RETURN-TOTAL
  END-IF
END-FOR
*
IF #LINE-IDX = 0
  MOVE 'NO RETURN LINES SELECTED' TO #SCREEN-MSG
  ESCAPE ROUTINE
END-IF
*
* STEP 3: CONFIRMATION
INPUT (IP=ON)
  / 'RETURN CONFIRMATION' (I)
  / '===================' (I)
  / 'ORDER    :' #OH-NUMBER (AD=OI)
  / 'CUSTOMER :' #OH-CUST-ID (AD=OI)
  / 'LINES    :' #LINE-IDX (AD=OI)
  / 'REFUND   :' #RETURN-TOTAL (AD=OI)
  /
  / 'PF3=CANCEL  ENTER=CREATE RETURN'
*
IF *PF-KEY = 'PF3'
  ESCAPE ROUTINE
END-IF
*
* STEP 4: CREATE RETURN
CALLNAT 'SEQNON' 'RET' #NEW-RET-ID
COMPRESS 'RET-' #NEW-RET-ID INTO #RET-NUMBER LEAVING NO SPACE
*
STORE RET-VIEW
  RV-ID            := #NEW-RET-ID
  RV-NUMBER        := #RET-NUMBER
  RV-ORDER-ID      := #ORDER-ID
  RV-CUST-ID       := #OH-CUST-ID
  RV-STORE-ID      := #OH-STORE-ID
  RV-STATUS        := 'REQ'
  RV-TYPE          := 'RT'
  RV-REASON-CODE   := #RET-LINES.#RL-REASON(1)
  RV-NUM-LINES     := #LINE-IDX
  RV-TOTAL-AMT     := #RETURN-TOTAL
  RV-REFUND-METHOD := 'OR'
  RV-DATE          := *DATX
  RV-CREATED-BY    := #USER-ID
END-STORE
*
* STORE RETURN LINES
1 #RI (N3)
1 #RL-SEQ (N3)
RESET #RL-SEQ
FOR #RI = 1 TO #OL-COUNT
  IF #RET-LINES.#RL-QTY(#RI) > 0
    ADD 1 TO #RL-SEQ
    STORE RTL-VIEW
      RTL-RETURN-ID      := #NEW-RET-ID
      RTL-LINE-NO        := #RL-SEQ
      RTL-ORDER-LINE-NO  := #OL-LINES.#OL-NO(#RI)
      RTL-PROD-ID        := #OL-LINES.#OL-PROD-ID(#RI)
      RTL-SKU            := #OL-LINES.#OL-SKU(#RI)
      RTL-QTY-RETURNED   := #RET-LINES.#RL-QTY(#RI)
      RTL-REASON-CODE    := #RET-LINES.#RL-REASON(#RI)
      RTL-CONDITION      := #RET-LINES.#RL-CONDITION(#RI)
      RTL-UNIT-PRICE     := #OL-LINES.#OL-PRICE(#RI)
      RTL-REFUND-AMT     := #RET-LINES.#RL-REFUND-AMT(#RI)
      RTL-STATUS         := 'REQ'
    END-STORE
  END-IF
END-FOR
*
END OF TRANSACTION
*
* UPDATE ORDER STATUS
CALLNAT 'ORDPOST' #ORDER-ID 'RET' #VALID-FLAG #ERROR-MSG
*
* AUDIT
MOVE #NEW-RET-ID TO #ORD-STR
CALLNAT 'AUDITN' 'RET' #ORD-STR 'C' 'RETRN'
  ' ' #RET-NUMBER 'RETURN CREATED'
*
COMPRESS 'RETURN' #RET-NUMBER 'CREATED SUCCESSFULLY' INTO #SCREEN-MSG
*
END
