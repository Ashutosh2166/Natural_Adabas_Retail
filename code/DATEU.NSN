* >Natural Source Code: DATEU
* SUBPROGRAM: DATEU - DATE UTILITY SUBPROGRAM
* DESCRIPTION: PROVIDES COMMON DATE OPERATIONS FOR
*              ALL RETAILCORE MODULES
* LIBRARY: RETAILCORE
* CREATED: 1998-04-20  R. PETERSON
* MODIFIED: 2003-09-15 - ADDED FISCAL YEAR CALCULATION
* MODIFIED: 2008-12-01 - ADDED BUSINESS DAY CHECK
* MODIFIED: 2014-06-20 - ADDED DATE RANGE VALIDATION
* MODIFIED: 2019-11-10 - ADDED ISO WEEK NUMBER
* MODIFIED: 2023-03-15 - FIXED LEAP YEAR CALCULATION
* -------------------------------------------------------
* OPERATION CODES:
*   FMT  - FORMAT DATE TO STRING
*   DIFF - CALCULATE DIFFERENCE IN DAYS
*   ADD  - ADD DAYS TO DATE
*   SUB  - SUBTRACT DAYS FROM DATE
*   VAL  - VALIDATE DATE
*   DOW  - GET DAY OF WEEK (1=MON 7=SUN)
*   BUS  - CHECK IF BUSINESS DAY
*   FIS  - GET FISCAL PERIOD
*   WK   - GET ISO WEEK NUMBER
*   RNG  - VALIDATE DATE RANGE
*   AGE  - CALCULATE AGE IN YEARS
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-OPERATION           (A4)    /* OPERATION CODE */
  1 P-DATE-1              (D)     /* INPUT DATE 1 */
  1 P-DATE-2              (D)     /* INPUT DATE 2 (FOR DIFF/RNG) */
  1 P-DAYS                (N5)    /* DAYS INPUT/OUTPUT */
  1 P-RESULT-DATE         (D)     /* RESULT DATE */
  1 P-RESULT-STRING       (A10)   /* FORMATTED STRING */
  1 P-RESULT-NUM          (N5)    /* NUMERIC RESULT */
  1 P-VALID-FLAG          (A1)    /* Y=VALID N=INVALID */
  1 P-ERROR-TEXT          (A60)   /* ERROR MESSAGE */
*
LOCAL
  1 #YEAR                 (N4)
  1 #MONTH                (N2)
  1 #DAY                  (N2)
  1 #DAY-OF-WEEK          (N1)
  1 #WORK-DATE            (D)
  1 #WORK-NUM             (N8)
  1 #DIFF-DAYS            (N5)
  1 #IS-LEAP              (A1)
  1 #YEAR-REMAINDER-4     (N4)
  1 #YEAR-REMAINDER-100   (N4)
  1 #YEAR-REMAINDER-400   (N4)
  1 #FISCAL-YEAR          (N4)
  1 #FISCAL-PERIOD        (N2)
  1 #FISCAL-START-MONTH   (N2) INIT <2>  /* FEB START */
  1 #AGE-YEARS            (N3)
  1 #WEEK-NUMBER          (N2)
  1 #TEMP-STRING          (A20)
*
* HOLIDAY TABLE - LEGACY FIXED HOLIDAYS
* TEMPORARY FIX - SHOULD BE MOVED TO DATABASE
*
  1 #HOLIDAYS (10)
    2 #HOL-MONTH           (N2)
    2 #HOL-DAY             (N2)
  1 #HOL-IDX              (N2)
  1 #IS-HOLIDAY           (A1)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-TEXT
RESET P-RESULT-STRING
RESET P-RESULT-NUM
*
* LOAD FIXED HOLIDAYS (US)
* MODIFIED FOR PROMOTION CHANGE - 2018
MOVE  1 TO #HOLIDAYS.#HOL-MONTH(1)  MOVE  1 TO #HOLIDAYS.#HOL-DAY(1)  /* NEW YEAR */
MOVE  7 TO #HOLIDAYS.#HOL-MONTH(2)  MOVE  4 TO #HOLIDAYS.#HOL-DAY(2)  /* JULY 4TH */
MOVE 12 TO #HOLIDAYS.#HOL-MONTH(3)  MOVE 25 TO #HOLIDAYS.#HOL-DAY(3)  /* CHRISTMAS */
MOVE 12 TO #HOLIDAYS.#HOL-MONTH(4)  MOVE 31 TO #HOLIDAYS.#HOL-DAY(4)  /* NEW YEAR EVE */
MOVE 11 TO #HOLIDAYS.#HOL-MONTH(5)  MOVE 11 TO #HOLIDAYS.#HOL-DAY(5)  /* VETERANS */
*
* -------------------------------------------------------
* ROUTE TO OPERATION
* -------------------------------------------------------
DECIDE ON FIRST VALUE OF P-OPERATION
  VALUE 'FMT'
    PERFORM FORMAT-DATE
  VALUE 'DIFF'
    PERFORM CALC-DIFFERENCE
  VALUE 'ADD'
    PERFORM ADD-DAYS
  VALUE 'SUB'
    PERFORM SUBTRACT-DAYS
  VALUE 'VAL'
    PERFORM VALIDATE-DATE
  VALUE 'DOW'
    PERFORM GET-DAY-OF-WEEK
  VALUE 'BUS'
    PERFORM CHECK-BUSINESS-DAY
  VALUE 'FIS'
    PERFORM GET-FISCAL-PERIOD
  VALUE 'WK'
    PERFORM GET-WEEK-NUMBER
  VALUE 'RNG'
    PERFORM VALIDATE-RANGE
  VALUE 'AGE'
    PERFORM CALC-AGE
  NONE VALUE
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: INVALID OPERATION CODE' TO P-ERROR-TEXT
END-DECIDE
*
* =======================================
* SUBROUTINES
* =======================================
*
* -------------------------------------------------------
* FORMAT DATE TO YYYY-MM-DD
* -------------------------------------------------------
DEFINE SUBROUTINE FORMAT-DATE
  IF P-DATE-1 = D'0000-00-00'
    MOVE '          ' TO P-RESULT-STRING
    ESCAPE ROUTINE
  END-IF
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  MOVE EDITED #WORK-NUM (EM=9999'-'99'-'99) TO P-RESULT-STRING
END-SUBROUTINE
*
* -------------------------------------------------------
* CALCULATE DIFFERENCE IN DAYS BETWEEN TWO DATES
* -------------------------------------------------------
DEFINE SUBROUTINE CALC-DIFFERENCE
  IF P-DATE-1 = D'0000-00-00' OR P-DATE-2 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: NULL DATE IN DIFFERENCE CALC' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  COMPUTE P-DAYS = (P-DATE-2 - P-DATE-1)
  MOVE P-DAYS TO P-RESULT-NUM
END-SUBROUTINE
*
* -------------------------------------------------------
* ADD DAYS TO A DATE
* -------------------------------------------------------
DEFINE SUBROUTINE ADD-DAYS
  IF P-DATE-1 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: NULL DATE IN ADD OPERATION' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  COMPUTE P-RESULT-DATE = P-DATE-1 + P-DAYS
END-SUBROUTINE
*
* -------------------------------------------------------
* SUBTRACT DAYS FROM A DATE
* -------------------------------------------------------
DEFINE SUBROUTINE SUBTRACT-DAYS
  IF P-DATE-1 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: NULL DATE IN SUB OPERATION' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  COMPUTE P-RESULT-DATE = P-DATE-1 - P-DAYS
END-SUBROUTINE
*
* -------------------------------------------------------
* VALIDATE DATE
* -------------------------------------------------------
DEFINE SUBROUTINE VALIDATE-DATE
  IF P-DATE-1 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: DATE IS NULL/ZERO' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #YEAR  = #WORK-NUM / 10000
  COMPUTE #MONTH = (#WORK-NUM / 100) - (#YEAR * 100)
  COMPUTE #DAY   = #WORK-NUM - ((#WORK-NUM / 100) * 100)
  IF #YEAR < 1900 OR #YEAR > 2099
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: YEAR OUT OF RANGE' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  IF #MONTH < 1 OR #MONTH > 12
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: INVALID MONTH' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  IF #DAY < 1 OR #DAY > 31
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: INVALID DAY' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  MOVE 'Y' TO P-VALID-FLAG
END-SUBROUTINE
*
* -------------------------------------------------------
* GET DAY OF WEEK (1=MON ... 7=SUN)
* MODIFIED 2023-03-15 - FIXED LEAP YEAR CALCULATION
* -------------------------------------------------------
DEFINE SUBROUTINE GET-DAY-OF-WEEK
  IF P-DATE-1 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    ESCAPE ROUTINE
  END-IF
  * USE NATURAL INTRINSIC IF AVAILABLE
  * LEGACY COMPATIBILITY LOGIC
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #DAY-OF-WEEK = #WORK-NUM - ((#WORK-NUM / 7) * 7)
  ADD 1 TO #DAY-OF-WEEK
  IF #DAY-OF-WEEK > 7
    MOVE 1 TO #DAY-OF-WEEK
  END-IF
  MOVE #DAY-OF-WEEK TO P-RESULT-NUM
END-SUBROUTINE
*
* -------------------------------------------------------
* CHECK IF DATE IS A BUSINESS DAY
* -------------------------------------------------------
DEFINE SUBROUTINE CHECK-BUSINESS-DAY
  PERFORM GET-DAY-OF-WEEK
  * CHECK WEEKEND
  IF P-RESULT-NUM = 6 OR P-RESULT-NUM = 7
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: WEEKEND' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  * CHECK HOLIDAYS
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #MONTH = (#WORK-NUM / 100) - ((#WORK-NUM / 10000) * 100)
  COMPUTE #DAY   = #WORK-NUM - ((#WORK-NUM / 100) * 100)
  MOVE 'N' TO #IS-HOLIDAY
  FOR #HOL-IDX = 1 TO 5
    IF #HOLIDAYS.#HOL-MONTH(#HOL-IDX) = #MONTH
        AND #HOLIDAYS.#HOL-DAY(#HOL-IDX) = #DAY
      MOVE 'Y' TO #IS-HOLIDAY
    END-IF
  END-FOR
  IF #IS-HOLIDAY = 'Y'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: HOLIDAY' TO P-ERROR-TEXT
  ELSE
    MOVE 'Y' TO P-VALID-FLAG
  END-IF
END-SUBROUTINE
*
* -------------------------------------------------------
* GET FISCAL PERIOD (FEB START)
* MODIFIED 2003-09-15
* -------------------------------------------------------
DEFINE SUBROUTINE GET-FISCAL-PERIOD
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #YEAR  = #WORK-NUM / 10000
  COMPUTE #MONTH = (#WORK-NUM / 100) - (#YEAR * 100)
*
  IF #MONTH >= #FISCAL-START-MONTH
    MOVE #YEAR TO #FISCAL-YEAR
    COMPUTE #FISCAL-PERIOD = #MONTH - #FISCAL-START-MONTH + 1
  ELSE
    COMPUTE #FISCAL-YEAR = #YEAR - 1
    COMPUTE #FISCAL-PERIOD = #MONTH + (12 - #FISCAL-START-MONTH + 1)
  END-IF
  MOVE #FISCAL-PERIOD TO P-RESULT-NUM
  MOVE #FISCAL-YEAR   TO P-DAYS  /* REUSE FIELD FOR FISCAL YEAR */
END-SUBROUTINE
*
* -------------------------------------------------------
* GET ISO WEEK NUMBER
* ADDED 2019-11-10
* -------------------------------------------------------
DEFINE SUBROUTINE GET-WEEK-NUMBER
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #DAY = #WORK-NUM - ((#WORK-NUM / 100) * 100)
  * SIMPLIFIED WEEK CALCULATION
  * TODO: IMPLEMENT FULL ISO 8601 ALGORITHM
  COMPUTE #WEEK-NUMBER = (#DAY / 7) + 1
  MOVE #WEEK-NUMBER TO P-RESULT-NUM
END-SUBROUTINE
*
* -------------------------------------------------------
* VALIDATE DATE RANGE
* -------------------------------------------------------
DEFINE SUBROUTINE VALIDATE-RANGE
  IF P-DATE-1 = D'0000-00-00' OR P-DATE-2 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: NULL DATE IN RANGE' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  IF P-DATE-1 > P-DATE-2
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'DATEU: FROM-DATE AFTER TO-DATE' TO P-ERROR-TEXT
    ESCAPE ROUTINE
  END-IF
  COMPUTE P-DAYS = (P-DATE-2 - P-DATE-1)
  MOVE 'Y' TO P-VALID-FLAG
END-SUBROUTINE
*
* -------------------------------------------------------
* CALCULATE AGE IN YEARS
* -------------------------------------------------------
DEFINE SUBROUTINE CALC-AGE
  IF P-DATE-1 = D'0000-00-00'
    MOVE 'N' TO P-VALID-FLAG
    ESCAPE ROUTINE
  END-IF
  MOVE *DATN(P-DATE-1) TO #WORK-NUM
  COMPUTE #YEAR  = #WORK-NUM / 10000
  COMPUTE #AGE-YEARS = *DATN(*DATX) / 10000 - #YEAR
  MOVE #AGE-YEARS TO P-RESULT-NUM
END-SUBROUTINE
*
END
