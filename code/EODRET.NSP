* >Natural Source Code: EODRET
* PROGRAM: EODRET - END OF DAY RETURN PROCESSING
* DESCRIPTION: BATCH PROGRAM FOR DAILY RETURN MAINTENANCE
*              AUTO-EXPIRES STALE RETURN REQUESTS
*              PROCESSES PENDING REFUNDS
*              GENERATES RETURN SUMMARY STATISTICS
* LIBRARY: RETAILCORE
* ADABAS FILES: 150 (RETURN), 151 (RETURN-LINE),
*               105 (INVENTORY), 111 (ORDER)
* CREATED: 2011-04-15  S. MARTINEZ
* MODIFIED: 2017-09-22 - ADDED AUTO-EXPIRY
* MODIFIED: 2023-06-10 - ADDED RESTOCK VERIFICATION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
  1 #EXPIRE-DAYS          (N4)    INIT <30>
  1 #EXPIRE-DATE          (D)
  1 #COMMIT-INTERVAL      (N4)    INIT <50>
  1 #COMMIT-COUNT         (N4)
*
* STEP 1: STALE RETURN EXPIRY
  1 #EXP-CHECKED          (N8)
  1 #EXP-EXPIRED          (N8)
*
* STEP 2: PENDING RESTOCK VERIFICATION
  1 #RST-CHECKED          (N8)
  1 #RST-VERIFIED         (N8)
  1 #RST-DISCREPANCY      (N8)
*
* STEP 3: AUTO-CLOSE COMPLETED RETURNS
  1 #CLS-CHECKED          (N8)
  1 #CLS-CLOSED           (N8)
*
* STEP 4: SUMMARY STATS
  1 #TOTAL-OPEN           (N8)
  1 #TOTAL-OPEN-AMT       (N13.2)
  1 #TOTAL-PENDING-REFUND (N8)
  1 #TOTAL-REFUND-AMT     (N13.2)
*
* STATUS COUNTERS
  1 #CNT-REQ              (N8)
  1 #CNT-APR              (N8)
  1 #CNT-RCV              (N8)
  1 #CNT-INS              (N8)
  1 #CNT-RST              (N8)
  1 #CNT-DMG              (N8)
  1 #CNT-REF              (N8)
  1 #CNT-CLS              (N8)
  1 #CNT-REJ              (N8)
*
  1 ERV-VIEW VIEW OF RETURN-FILE
    2 ERV-ID              (N10)
    2 ERV-ORDER-ID        (N10)
    2 ERV-CUST-ID         (N8)
    2 ERV-STATUS          (A3)
    2 ERV-REASON-CODE     (A4)
    2 ERV-REFUND-AMT      (N11.2)
    2 ERV-CREATED-DATE    (D)
    2 ERV-CLOSED-DATE     (D)
    2 ERV-UPDATED-DATE    (D)
*
  1 ERL-VIEW VIEW OF RETURN-LINE-FILE
    2 ERL-RETURN-ID       (N10)
    2 ERL-PROD-ID         (N8)
    2 ERL-QTY             (N6)
    2 ERL-CONDITION       (A1)
    2 ERL-STATUS          (A3)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE #TODAY TO #EXPIRE-DATE
SUBTRACT #EXPIRE-DAYS FROM #EXPIRE-DATE (D)
*
WRITE 'RETAILCORE - END OF DAY RETURN PROCESSING'
WRITE '=========================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* -------------------------------------------------------
* STEP 1: EXPIRE STALE RETURN REQUESTS
* Returns in REQ status for more than 30 days are auto-rejected
* -------------------------------------------------------
WRITE 'STEP 1: EXPIRING STALE RETURN REQUESTS...'
READ ERV-VIEW BY ERV-ID
  IF ERV-STATUS NE 'REQ'
    ESCAPE TOP
  END-IF
  ADD 1 TO #EXP-CHECKED
*
  IF ERV-CREATED-DATE < #EXPIRE-DATE
    GET ERV-VIEW *ISN (HOLD)
    MOVE 'REJ' TO ERV-STATUS
    MOVE #TODAY TO ERV-CLOSED-DATE
    MOVE #TODAY TO ERV-UPDATED-DATE
    UPDATE ERV-VIEW
    ADD 1 TO #EXP-EXPIRED
    WRITE '  EXPIRED RETURN:' ERV-ID 'ORDER:' ERV-ORDER-ID
      'DAYS OLD:' #EXPIRE-DAYS
*
    ADD 1 TO #COMMIT-COUNT
    IF #COMMIT-COUNT >= #COMMIT-INTERVAL
      END OF TRANSACTION
      RESET #COMMIT-COUNT
    END-IF
  END-IF
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
END OF TRANSACTION
RESET #COMMIT-COUNT
*
WRITE '  REQUESTS CHECKED :' #EXP-CHECKED
WRITE '  AUTO-EXPIRED     :' #EXP-EXPIRED
*
* -------------------------------------------------------
* STEP 2: VERIFY RESTOCKED ITEMS
* Check that restocked returns actually updated inventory
* -------------------------------------------------------
WRITE ' '
WRITE 'STEP 2: VERIFYING RESTOCKED RETURNS...'
READ ERV-VIEW BY ERV-ID
  IF ERV-STATUS NE 'RST'
    ESCAPE TOP
  END-IF
  ADD 1 TO #RST-CHECKED
*
  * CHECK LINE ITEMS ARE ALL RESTOCKED
  1 #ALL-RESTOCKED (L)
  MOVE TRUE TO #ALL-RESTOCKED
  FIND ERL-VIEW WITH ERL-RETURN-ID = ERV-ID
    IF ERL-STATUS NE 'RST' AND ERL-STATUS NE 'DMG'
      MOVE FALSE TO #ALL-RESTOCKED
    END-IF
  END-FIND
*
  IF #ALL-RESTOCKED
    ADD 1 TO #RST-VERIFIED
  ELSE
    ADD 1 TO #RST-DISCREPANCY
    WRITE '  ** RESTOCK DISCREPANCY: RETURN' ERV-ID
      'NOT ALL LINES RESTOCKED'
  END-IF
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
*
WRITE '  RESTOCKED CHECKED:' #RST-CHECKED
WRITE '  VERIFIED         :' #RST-VERIFIED
WRITE '  DISCREPANCIES    :' #RST-DISCREPANCY
*
* -------------------------------------------------------
* STEP 3: AUTO-CLOSE COMPLETED RETURNS
* Returns in REF (refunded) status can be auto-closed
* -------------------------------------------------------
WRITE ' '
WRITE 'STEP 3: AUTO-CLOSING REFUNDED RETURNS...'
READ ERV-VIEW BY ERV-ID
  IF ERV-STATUS NE 'REF'
    ESCAPE TOP
  END-IF
  ADD 1 TO #CLS-CHECKED
*
  * AUTO-CLOSE IF REFUND PROCESSED AND ALL LINES DONE
  1 #ALL-LINES-DONE (L)
  MOVE TRUE TO #ALL-LINES-DONE
  FIND ERL-VIEW WITH ERL-RETURN-ID = ERV-ID
    IF ERL-STATUS NE 'RST' AND ERL-STATUS NE 'DMG'
        AND ERL-STATUS NE 'REF'
      MOVE FALSE TO #ALL-LINES-DONE
    END-IF
  END-FIND
*
  IF #ALL-LINES-DONE
    GET ERV-VIEW *ISN (HOLD)
    MOVE 'CLS' TO ERV-STATUS
    MOVE #TODAY TO ERV-CLOSED-DATE
    MOVE #TODAY TO ERV-UPDATED-DATE
    UPDATE ERV-VIEW
    ADD 1 TO #CLS-CLOSED
*
    ADD 1 TO #COMMIT-COUNT
    IF #COMMIT-COUNT >= #COMMIT-INTERVAL
      END OF TRANSACTION
      RESET #COMMIT-COUNT
    END-IF
  END-IF
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
END OF TRANSACTION
RESET #COMMIT-COUNT
*
WRITE '  REFUNDED CHECKED :' #CLS-CHECKED
WRITE '  AUTO-CLOSED      :' #CLS-CLOSED
*
* -------------------------------------------------------
* STEP 4: GENERATE STATUS SUMMARY
* -------------------------------------------------------
WRITE ' '
WRITE 'STEP 4: GENERATING RETURN STATUS SUMMARY...'
READ ERV-VIEW BY ERV-ID
  DECIDE ON FIRST VALUE OF ERV-STATUS
    VALUE 'REQ'
      ADD 1 TO #CNT-REQ
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'APR'
      ADD 1 TO #CNT-APR
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'RCV'
      ADD 1 TO #CNT-RCV
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'INS'
      ADD 1 TO #CNT-INS
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'RST'
      ADD 1 TO #CNT-RST
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'DMG'
      ADD 1 TO #CNT-DMG
      ADD 1 TO #TOTAL-OPEN
      ADD ERV-REFUND-AMT TO #TOTAL-OPEN-AMT
    VALUE 'REF'
      ADD 1 TO #CNT-REF
      ADD 1 TO #TOTAL-PENDING-REFUND
      ADD ERV-REFUND-AMT TO #TOTAL-REFUND-AMT
    VALUE 'CLS'
      ADD 1 TO #CNT-CLS
    VALUE 'REJ'
      ADD 1 TO #CNT-REJ
    NONE VALUE
      IGNORE
  END-DECIDE
*
  IF *COUNTER > 200000
    ESCAPE BOTTOM
  END-IF
END-READ
*
* -------------------------------------------------------
* OUTPUT SUMMARY
* -------------------------------------------------------
WRITE ' '
WRITE 'RETURN STATUS SUMMARY'
WRITE '====================='
WRITE 'REQUESTED    (REQ):' #CNT-REQ
WRITE 'APPROVED     (APR):' #CNT-APR
WRITE 'RECEIVED     (RCV):' #CNT-RCV
WRITE 'INSPECTED    (INS):' #CNT-INS
WRITE 'RESTOCKED    (RST):' #CNT-RST
WRITE 'DAMAGED      (DMG):' #CNT-DMG
WRITE 'REFUNDED     (REF):' #CNT-REF
WRITE 'CLOSED       (CLS):' #CNT-CLS
WRITE 'REJECTED     (REJ):' #CNT-REJ
WRITE ' '
WRITE 'OPEN RETURNS       :' #TOTAL-OPEN
WRITE 'OPEN RETURN VALUE  :' #TOTAL-OPEN-AMT
WRITE 'PENDING REFUND CNT :' #TOTAL-PENDING-REFUND
WRITE 'PENDING REFUND AMT :' #TOTAL-REFUND-AMT
*
WRITE ' '
WRITE 'EOD RETURN PROCESSING COMPLETE'
*
CALLNAT 'AUDITN' 'RET' 'EODRET' 'U' 'BATCH'
  ' ' ' ' 'EOD RETURN PROCESSING COMPLETE'
*
END
