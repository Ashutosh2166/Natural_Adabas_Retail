* >Natural Source Code: RETREPORT
* PROGRAM: RETREPORT - RETURNS ANALYSIS REPORT
* DESCRIPTION: COMPREHENSIVE RETURNS ANALYSIS
*              BY REASON, CONDITION, STATUS, STORE
*              INCLUDES REFUND TRACKING AND ABUSE DETECTION
* LIBRARY: RETAILCORE
* ADABAS FILES: 150 (RETURN), 151 (RETURN-LINE),
*               111 (ORDER), 100 (CUSTOMER)
* CREATED: 2009-07-15  S. MARTINEZ
* MODIFIED: 2015-11-22 - ADDED REASON BREAKDOWN
* MODIFIED: 2021-05-10 - ADDED ABUSE DETECTION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #START-DATE           (D)
  1 #END-DATE             (D)
*
* RETURN COUNTERS BY STATUS
  1 #TOTAL-RETURNS        (N8)
  1 #STATUS-REQUESTED     (N8)
  1 #STATUS-APPROVED      (N8)
  1 #STATUS-RECEIVED      (N8)
  1 #STATUS-INSPECTED     (N8)
  1 #STATUS-RESTOCKED     (N8)
  1 #STATUS-DAMAGED       (N8)
  1 #STATUS-REFUNDED      (N8)
  1 #STATUS-CLOSED        (N8)
  1 #STATUS-REJECTED      (N8)
*
* REASON BREAKDOWN (6 REASONS)
  1 #REASON-CODES (1:6)
    2 #RC-CODE            (A4)
    2 #RC-DESC            (A20)
    2 #RC-COUNT           (N8)
    2 #RC-QTY             (N8)
    2 #RC-AMT             (N11.2)
*
* CONDITION BREAKDOWN
  1 #COND-NEW-COUNT       (N8)
  1 #COND-OPENED-COUNT    (N8)
  1 #COND-DAMAGED-COUNT   (N8)
*
* STORE BREAKDOWN - MAX 50 STORES
  1 #MAX-STORES           (N4)   INIT <50>
  1 #STORE-COUNT          (N4)
  1 #STORE-RET (1:50)
    2 #SR-STORE-ID        (N4)
    2 #SR-COUNT           (N8)
    2 #SR-ORDERS          (N8)
    2 #SR-QTY             (N8)
    2 #SR-AMT             (N11.2)
    2 #SR-RATE            (N5.2)
*
* ABUSE DETECTION - TOP RETURNERS
  1 #MAX-ABUSE            (N4)   INIT <20>
  1 #ABUSE-COUNT          (N4)
  1 #ABUSE-DATA (1:20)
    2 #AB-CUST-ID         (N8)
    2 #AB-CUST-NAME       (A40)
    2 #AB-RETURN-COUNT    (N6)
    2 #AB-RETURN-AMT      (N11.2)
    2 #AB-ORDER-COUNT     (N6)
    2 #AB-RETURN-RATE     (N5.2)
*
* FINANCIAL
  1 #TOTAL-REFUND-AMT     (N13.2)
  1 #TOTAL-QTY-RETURNED   (N10)
  1 #TOTAL-QTY-RESTOCKED  (N10)
  1 #TOTAL-QTY-DAMAGED    (N10)
  1 #AVG-DAYS-TO-CLOSE    (N5.1)
  1 #DAYS-SUM             (N10)
  1 #DAYS-COUNT           (N8)
*
  1 #IDX                  (N4)
  1 #FOUND                (L)
*
  1 RRP-VIEW VIEW OF RETURN-FILE
    2 RRP-ID              (N10)
    2 RRP-ORDER-ID        (N10)
    2 RRP-CUST-ID         (N8)
    2 RRP-STATUS          (A3)
    2 RRP-REASON-CODE     (A4)
    2 RRP-REFUND-AMT      (N11.2)
    2 RRP-CREATED-DATE    (D)
    2 RRP-CLOSED-DATE     (D)
*
  1 RRL-VIEW VIEW OF RETURN-LINE-FILE
    2 RRL-RETURN-ID       (N10)
    2 RRL-PROD-ID         (N8)
    2 RRL-QTY             (N6)
    2 RRL-CONDITION       (A1)
    2 RRL-REFUND-AMT      (N9.2)
    2 RRL-STATUS          (A3)
*
  1 ROV-VIEW VIEW OF ORDER-FILE
    2 ROV-ID              (N10)
    2 ROV-STORE-ID        (N4)
    2 ROV-CUST-ID         (N8)
*
  1 RCV-VIEW VIEW OF CUSTOMER-FILE
    2 RCV-ID              (N8)
    2 RCV-FIRST-NAME      (A30)
    2 RCV-LAST-NAME       (A30)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE *DATX TO #END-DATE
MOVE #END-DATE TO #START-DATE
SUBTRACT 30 FROM #START-DATE (D)
*
* INITIALIZE REASON CODES
MOVE 'DEFN' TO #RC-CODE(1)
MOVE 'DEFECTIVE/NONFUNC' TO #RC-DESC(1)
MOVE 'WRNG' TO #RC-CODE(2)
MOVE 'WRONG ITEM'        TO #RC-DESC(2)
MOVE 'DMGD' TO #RC-CODE(3)
MOVE 'DAMAGED IN SHIP'   TO #RC-DESC(3)
MOVE 'NOFI' TO #RC-CODE(4)
MOVE 'DOES NOT FIT'      TO #RC-DESC(4)
MOVE 'CHGD' TO #RC-CODE(5)
MOVE 'CHANGED MIND'      TO #RC-DESC(5)
MOVE 'OTHR' TO #RC-CODE(6)
MOVE 'OTHER'             TO #RC-DESC(6)
*
* -------------------------------------------------------
* STEP 1: PROCESS RETURNS
* -------------------------------------------------------
FIND RRP-VIEW WITH RRP-CREATED-DATE GE #START-DATE
    AND RRP-CREATED-DATE LE #END-DATE
  ADD 1 TO #TOTAL-RETURNS
  ADD RRP-REFUND-AMT TO #TOTAL-REFUND-AMT
*
  * STATUS COUNTS
  DECIDE ON FIRST VALUE OF RRP-STATUS
    VALUE 'REQ'
      ADD 1 TO #STATUS-REQUESTED
    VALUE 'APR'
      ADD 1 TO #STATUS-APPROVED
    VALUE 'RCV'
      ADD 1 TO #STATUS-RECEIVED
    VALUE 'INS'
      ADD 1 TO #STATUS-INSPECTED
    VALUE 'RST'
      ADD 1 TO #STATUS-RESTOCKED
    VALUE 'DMG'
      ADD 1 TO #STATUS-DAMAGED
    VALUE 'REF'
      ADD 1 TO #STATUS-REFUNDED
    VALUE 'CLS'
      ADD 1 TO #STATUS-CLOSED
    VALUE 'REJ'
      ADD 1 TO #STATUS-REJECTED
    NONE VALUE
      IGNORE
  END-DECIDE
*
  * REASON BREAKDOWN
  FOR #IDX = 1 TO 6
    IF #RC-CODE(#IDX) = RRP-REASON-CODE
      ADD 1 TO #RC-COUNT(#IDX)
      ADD RRP-REFUND-AMT TO #RC-AMT(#IDX)
      ESCAPE BOTTOM
    END-IF
  END-FOR
*
  * DAYS TO CLOSE
  IF RRP-STATUS = 'CLS' AND RRP-CLOSED-DATE > 0
    1 #DAYS-DIFF (N6)
    COMPUTE #DAYS-DIFF = RRP-CLOSED-DATE - RRP-CREATED-DATE
    ADD #DAYS-DIFF TO #DAYS-SUM
    ADD 1 TO #DAYS-COUNT
  END-IF
*
  * STORE BREAKDOWN
  1 #RET-STORE (N4)
  RESET #RET-STORE
  FIND ROV-VIEW WITH ROV-ID = RRP-ORDER-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    MOVE ROV-STORE-ID TO #RET-STORE
    ESCAPE BOTTOM
  END-FIND
*
  IF #RET-STORE > 0
    MOVE FALSE TO #FOUND
    FOR #IDX = 1 TO #STORE-COUNT
      IF #SR-STORE-ID(#IDX) = #RET-STORE
        MOVE TRUE TO #FOUND
        ESCAPE BOTTOM
      END-IF
    END-FOR
    IF NOT #FOUND AND #STORE-COUNT < #MAX-STORES
      ADD 1 TO #STORE-COUNT
      MOVE #RET-STORE TO #SR-STORE-ID(#STORE-COUNT)
      MOVE #STORE-COUNT TO #IDX
    END-IF
    IF #FOUND OR #STORE-COUNT <= #MAX-STORES
      ADD 1 TO #SR-COUNT(#IDX)
      ADD RRP-REFUND-AMT TO #SR-AMT(#IDX)
    END-IF
  END-IF
*
  * LINE-LEVEL DETAIL
  FIND RRL-VIEW WITH RRL-RETURN-ID = RRP-ID
    ADD RRL-QTY TO #TOTAL-QTY-RETURNED
*
    * REASON QTY
    FOR #IDX = 1 TO 6
      IF #RC-CODE(#IDX) = RRP-REASON-CODE
        ADD RRL-QTY TO #RC-QTY(#IDX)
        ESCAPE BOTTOM
      END-IF
    END-FOR
*
    * CONDITION COUNTS
    DECIDE ON FIRST VALUE OF RRL-CONDITION
      VALUE 'N'
        ADD RRL-QTY TO #COND-NEW-COUNT
      VALUE 'O'
        ADD RRL-QTY TO #COND-OPENED-COUNT
      VALUE 'D'
        ADD RRL-QTY TO #COND-DAMAGED-COUNT
      NONE VALUE
        ADD RRL-QTY TO #COND-OPENED-COUNT
    END-DECIDE
*
    * RESTOCK/DAMAGE TRACKING
    IF RRL-STATUS = 'RST'
      ADD RRL-QTY TO #TOTAL-QTY-RESTOCKED
    ELSE IF RRL-STATUS = 'DMG'
      ADD RRL-QTY TO #TOTAL-QTY-DAMAGED
    END-IF
    END-IF
  END-FIND
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-FIND
*
* -------------------------------------------------------
* STEP 2: ABUSE DETECTION - HIGH RETURN CUSTOMERS
* -------------------------------------------------------
* THIS IS A SIMPLIFIED APPROACH - COUNTS ALL RETURNS BY CUSTOMER
* IN THE PERIOD AND FLAGS THOSE WITH EXCESSIVE RETURNS
1 #ABUSE-THRESHOLD (N4) INIT <3>
*
* RE-SCAN RETURNS GROUPED BY CUSTOMER
* NOTE: INEFFICIENT - SHOULD USE HISTOGRAM IN PRODUCTION
* TODO: REFACTOR TO USE HISTOGRAM ON CUST-ID DESCRIPTOR
READ RRP-VIEW BY RRP-CUST-ID
  IF RRP-CREATED-DATE < #START-DATE OR RRP-CREATED-DATE > #END-DATE
    ESCAPE TOP
  END-IF
  IF RRP-STATUS = 'REJ'
    ESCAPE TOP
  END-IF
*
  * FIND OR ADD CUSTOMER IN ABUSE ARRAY
  MOVE FALSE TO #FOUND
  FOR #IDX = 1 TO #ABUSE-COUNT
    IF #AB-CUST-ID(#IDX) = RRP-CUST-ID
      MOVE TRUE TO #FOUND
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF NOT #FOUND
    IF #ABUSE-COUNT < #MAX-ABUSE
      ADD 1 TO #ABUSE-COUNT
      MOVE RRP-CUST-ID TO #AB-CUST-ID(#ABUSE-COUNT)
      MOVE #ABUSE-COUNT TO #IDX
*
      * GET CUSTOMER NAME
      FIND RCV-VIEW WITH RCV-ID = RRP-CUST-ID
        IF NO RECORDS FOUND
          IGNORE
        END-NOREC
        COMPRESS RCV-FIRST-NAME RCV-LAST-NAME
          INTO #AB-CUST-NAME(#IDX)
        ESCAPE BOTTOM
      END-FIND
    ELSE
      ESCAPE TOP
    END-IF
  END-IF
*
  ADD 1 TO #AB-RETURN-COUNT(#IDX)
  ADD RRP-REFUND-AMT TO #AB-RETURN-AMT(#IDX)
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
*
* -------------------------------------------------------
* OUTPUT REPORT
* -------------------------------------------------------
WRITE 'RETAILCORE - RETURNS ANALYSIS REPORT'
WRITE '====================================='
WRITE 'PERIOD:' #START-DATE 'TO' #END-DATE
WRITE 'RUN DATE:' *DATX
WRITE ' '
*
* STATUS BREAKDOWN
WRITE 'RETURN STATUS BREAKDOWN'
WRITE '======================='
WRITE 'REQUESTED    (REQ):' #STATUS-REQUESTED
WRITE 'APPROVED     (APR):' #STATUS-APPROVED
WRITE 'RECEIVED     (RCV):' #STATUS-RECEIVED
WRITE 'INSPECTED    (INS):' #STATUS-INSPECTED
WRITE 'RESTOCKED    (RST):' #STATUS-RESTOCKED
WRITE 'DAMAGED      (DMG):' #STATUS-DAMAGED
WRITE 'REFUNDED     (REF):' #STATUS-REFUNDED
WRITE 'CLOSED       (CLS):' #STATUS-CLOSED
WRITE 'REJECTED     (REJ):' #STATUS-REJECTED
WRITE 'TOTAL             :' #TOTAL-RETURNS
*
* REASON BREAKDOWN
WRITE ' '
WRITE 'RETURN REASONS'
WRITE '=============='
WRITE 'CODE REASON               COUNT   QTY      AMOUNT'
WRITE '---- --------------------  ------  ------  ----------'
FOR #IDX = 1 TO 6
  WRITE #RC-CODE(#IDX) #RC-DESC(#IDX) #RC-COUNT(#IDX)
    #RC-QTY(#IDX) #RC-AMT(#IDX)
END-FOR
*
* CONDITION BREAKDOWN
WRITE ' '
WRITE 'ITEM CONDITION AT RETURN'
WRITE '========================'
WRITE 'NEW (UNOPENED)    :' #COND-NEW-COUNT
WRITE 'OPENED/USED       :' #COND-OPENED-COUNT
WRITE 'DAMAGED            :' #COND-DAMAGED-COUNT
WRITE 'TOTAL ITEMS        :' #TOTAL-QTY-RETURNED
*
* STORE BREAKDOWN
WRITE ' '
WRITE 'RETURNS BY STORE'
WRITE '================'
WRITE 'STORE  COUNT    QTY     REFUND AMT'
WRITE '-----  ------  ------  ----------'
FOR #IDX = 1 TO #STORE-COUNT
  WRITE #SR-STORE-ID(#IDX) #SR-COUNT(#IDX)
    #SR-QTY(#IDX) #SR-AMT(#IDX)
END-FOR
*
* ABUSE DETECTION
WRITE ' '
WRITE 'HIGH-FREQUENCY RETURNERS (POTENTIAL ABUSE)'
WRITE '============================================'
WRITE 'CUST-ID  CUSTOMER NAME                     RETURNS  REFUND AMT'
WRITE '-------- --------------------------------  -------  ----------'
FOR #IDX = 1 TO #ABUSE-COUNT
  IF #AB-RETURN-COUNT(#IDX) >= #ABUSE-THRESHOLD
    WRITE #AB-CUST-ID(#IDX)
      #AB-CUST-NAME(#IDX) (EM=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
      #AB-RETURN-COUNT(#IDX)
      #AB-RETURN-AMT(#IDX)
  END-IF
END-FOR
*
* FINANCIAL SUMMARY
WRITE ' '
WRITE 'FINANCIAL SUMMARY'
WRITE '================='
WRITE 'TOTAL RETURNS       :' #TOTAL-RETURNS
WRITE 'TOTAL QTY RETURNED  :' #TOTAL-QTY-RETURNED
WRITE 'TOTAL REFUND AMOUNT :' #TOTAL-REFUND-AMT
WRITE 'QTY RESTOCKED       :' #TOTAL-QTY-RESTOCKED
WRITE 'QTY DAMAGED         :' #TOTAL-QTY-DAMAGED
IF #DAYS-COUNT > 0
  COMPUTE #AVG-DAYS-TO-CLOSE = #DAYS-SUM / #DAYS-COUNT
END-IF
WRITE 'AVG DAYS TO CLOSE   :' #AVG-DAYS-TO-CLOSE
*
WRITE ' '
WRITE 'END OF REPORT'
*
END
