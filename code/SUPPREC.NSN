* >Natural Source Code: SUPPREC
* SUBPROGRAM: SUPPREC - SUPPLIER RECORD/SCORECARD
* DESCRIPTION: GENERATES SUPPLIER PERFORMANCE SCORECARD
*              CALCULATES METRICS FROM PO HISTORY
* LIBRARY: RETAILCORE
* ADABAS FILES: 130 (SUPPLIER), 131 (PO-HEADER), 132 (PO-LINE)
* CREATED: 2006-04-15  S. MARTINEZ
* MODIFIED: 2013-10-22 - ADDED TREND ANALYSIS
* MODIFIED: 2020-03-10 - ADDED QUALITY METRICS
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SUPP-ID             (N8)
  1 P-FROM-DATE           (D)
  1 P-TO-DATE             (D)
  1 P-SCORECARD
    2 P-SC-SUPP-NAME      (A60)
    2 P-SC-STATUS         (A1)
    2 P-SC-TOTAL-POS      (N6)
    2 P-SC-TOTAL-AMT      (N11.2)
    2 P-SC-AVG-PO-AMT     (N11.2)
    2 P-SC-ON-TIME-COUNT  (N6)
    2 P-SC-LATE-COUNT     (N6)
    2 P-SC-ON-TIME-PCT    (N5.2)
    2 P-SC-TOTAL-ORD-QTY  (N8)
    2 P-SC-TOTAL-RCV-QTY  (N8)
    2 P-SC-FILL-RATE      (N5.2)
    2 P-SC-SHORT-LINES    (N6)
    2 P-SC-OVER-LINES     (N6)
    2 P-SC-AVG-LEAD-DAYS  (N4)
    2 P-SC-OVERALL-SCORE  (N3)
    2 P-SC-RATING-GRADE   (A1)    /* A/B/C/D/F */
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #PO-COUNT             (N6)
  1 #LEAD-TOTAL           (N6)
  1 #LEAD-DAYS            (N6)
  1 #SCORE                (N5.2)
*
  1 SRC-VIEW VIEW OF SUPPLIER-FILE
    2 SRC-ID               (N8)
    2 SRC-NAME             (A60)
    2 SRC-STATUS           (A1)
*
  1 PRC-VIEW VIEW OF PO-HEADER-FILE
    2 PRC-SUPP-ID          (N8)
    2 PRC-ID               (N10)
    2 PRC-STATUS           (A2)
    2 PRC-DATE             (D)
    2 PRC-EXPECTED-DATE    (D)
    2 PRC-TOTAL-AMT        (N11.2)
*
  1 LRC-VIEW VIEW OF PO-LINE-FILE
    2 LRC-PO-ID            (N10)
    2 LRC-QTY-ORDERED      (N6)
    2 LRC-QTY-RECEIVED     (N6)
    2 LRC-STATUS           (A2)
END-DEFINE
*
RESET P-RC
RESET P-RC-TEXT
RESET P-SCORECARD
*
* GET SUPPLIER
FIND SRC-VIEW WITH SRC-ID = P-SUPP-ID
  IF NO RECORDS FOUND
    MOVE 604 TO P-RC
    MOVE 'SUPPLIER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE SRC-NAME   TO P-SC-SUPP-NAME
  MOVE SRC-STATUS TO P-SC-STATUS
  ESCAPE BOTTOM
END-FIND
*
* DEFAULT DATE RANGE: LAST 12 MONTHS
IF P-FROM-DATE = 0
  MOVE *DATX TO P-FROM-DATE
  SUBTRACT 365 FROM P-FROM-DATE (D)
END-IF
IF P-TO-DATE = 0
  MOVE *DATX TO P-TO-DATE
END-IF
*
* ANALYZE POS
RESET #PO-COUNT
RESET #LEAD-TOTAL
FIND PRC-VIEW WITH PRC-SUPP-ID = P-SUPP-ID
  * DATE FILTER
  IF PRC-DATE < P-FROM-DATE OR PRC-DATE > P-TO-DATE
    ESCAPE TOP
  END-IF
  * SKIP CANCELLED
  IF PRC-STATUS = 'CA'
    ESCAPE TOP
  END-IF
*
  ADD 1 TO #PO-COUNT
  ADD PRC-TOTAL-AMT TO P-SC-TOTAL-AMT
*
  * ON-TIME ANALYSIS (FOR CLOSED/RECEIVED POS)
  IF PRC-STATUS = 'CL' OR PRC-STATUS = 'RC'
    IF PRC-EXPECTED-DATE > 0
      * SIMPLIFIED: COMPARE EXPECTED VS ACTUAL
      * ACTUAL = PO DATE + SOME ESTIMATED LEAD TIME
      * LEGACY: JUST CHECK IF CLOSED BEFORE EXPECTED + 3 DAYS
      1 #GRACE-DATE (D)
      MOVE PRC-EXPECTED-DATE TO #GRACE-DATE
      ADD 3 TO #GRACE-DATE (D)
      IF PRC-DATE <= #GRACE-DATE
        ADD 1 TO P-SC-ON-TIME-COUNT
      ELSE
        ADD 1 TO P-SC-LATE-COUNT
      END-IF
    END-IF
  END-IF
*
  * LINE-LEVEL ANALYSIS
  FIND LRC-VIEW WITH LRC-PO-ID = PRC-ID
    ADD LRC-QTY-ORDERED  TO P-SC-TOTAL-ORD-QTY
    ADD LRC-QTY-RECEIVED TO P-SC-TOTAL-RCV-QTY
    IF LRC-QTY-RECEIVED < LRC-QTY-ORDERED
      ADD 1 TO P-SC-SHORT-LINES
    ELSE IF LRC-QTY-RECEIVED > LRC-QTY-ORDERED
      ADD 1 TO P-SC-OVER-LINES
    END-IF
    END-IF
  END-FIND
*
END-FIND
*
MOVE #PO-COUNT TO P-SC-TOTAL-POS
*
* CALCULATE DERIVED METRICS
IF P-SC-TOTAL-POS > 0
  COMPUTE P-SC-AVG-PO-AMT = P-SC-TOTAL-AMT / P-SC-TOTAL-POS
END-IF
*
IF P-SC-ON-TIME-COUNT + P-SC-LATE-COUNT > 0
  COMPUTE P-SC-ON-TIME-PCT =
    (P-SC-ON-TIME-COUNT /
    (P-SC-ON-TIME-COUNT + P-SC-LATE-COUNT)) * 100
END-IF
*
IF P-SC-TOTAL-ORD-QTY > 0
  COMPUTE P-SC-FILL-RATE =
    (P-SC-TOTAL-RCV-QTY / P-SC-TOTAL-ORD-QTY) * 100
END-IF
*
* CALCULATE OVERALL SCORE (0-100)
* WEIGHTED: 40% ON-TIME + 35% FILL-RATE + 25% VOLUME
COMPUTE #SCORE = P-SC-ON-TIME-PCT * 0.40
  + P-SC-FILL-RATE * 0.35
IF P-SC-TOTAL-POS >= 50
  ADD 25 TO #SCORE
ELSE IF P-SC-TOTAL-POS >= 20
  ADD 20 TO #SCORE
ELSE IF P-SC-TOTAL-POS >= 10
  ADD 15 TO #SCORE
ELSE IF P-SC-TOTAL-POS >= 5
  ADD 10 TO #SCORE
ELSE
  ADD 5 TO #SCORE
END-IF
END-IF
END-IF
END-IF
MOVE #SCORE TO P-SC-OVERALL-SCORE
*
* ASSIGN GRADE
IF P-SC-OVERALL-SCORE >= 90
  MOVE 'A' TO P-SC-RATING-GRADE
ELSE IF P-SC-OVERALL-SCORE >= 80
  MOVE 'B' TO P-SC-RATING-GRADE
ELSE IF P-SC-OVERALL-SCORE >= 70
  MOVE 'C' TO P-SC-RATING-GRADE
ELSE IF P-SC-OVERALL-SCORE >= 60
  MOVE 'D' TO P-SC-RATING-GRADE
ELSE
  MOVE 'F' TO P-SC-RATING-GRADE
END-IF
END-IF
END-IF
END-IF
*
* UPDATE SUPPLIER RATING
CALLNAT 'SUPPUPD' P-SUPP-ID 'RATE' ' '
  0 P-SC-ON-TIME-PCT 0 *DATX 0 ' '
*
END
