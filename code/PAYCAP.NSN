* >Natural Source Code: PAYCAP
* SUBPROGRAM: PAYCAP - PAYMENT CAPTURE
* DESCRIPTION: CAPTURES PREVIOUSLY AUTHORIZED PAYMENT
*              TYPICALLY DONE AT SHIPMENT TIME
* LIBRARY: RETAILCORE
* ADABAS FILE: 140 (PAYMENT)
* CREATED: 2000-06-15  A. GARCIA
* MODIFIED: 2010-08-22 - ADDED PARTIAL CAPTURE
* MODIFIED: 2019-04-10 - ADDED SETTLEMENT RECORD
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PAY-ID              (N10)
  1 P-CAPTURE-AMT         (N11.2)  /* 0 = FULL CAPTURE */
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #AUTH-AMT             (N11.2)
  1 #ORDER-ID             (N10)
  1 #GW-RC                (N4)
  1 #GW-MSG               (A80)
  1 #ORD-STR              (A15)
*
  1 PCA-VIEW VIEW OF PAYMENT-FILE
    2 PCA-ID               (N10)
    2 PCA-ORDER-ID         (N10)
    2 PCA-METHOD           (A2)
    2 PCA-STATUS           (A2)
    2 PCA-AMOUNT           (N11.2)
    2 PCA-AUTH-CODE        (A20)
    2 PCA-CAPTURED-AMT     (N11.2)
    2 PCA-CAPTURED-DATE    (D)
    2 PCA-GATEWAY-ID       (A10)
*
  1 STL-VIEW VIEW OF SETTLEMENT-FILE
    2 STL-PAY-ID           (N10)
    2 STL-ORDER-ID         (N10)
    2 STL-AMOUNT           (N11.2)
    2 STL-TYPE             (A2)    /* CP=CAPTURE RF=REFUND */
    2 STL-STATUS           (A2)
    2 STL-DATE             (D)
    2 STL-BATCH-ID         (A20)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
* GET PAYMENT
FIND PCA-VIEW WITH PCA-ID = P-PAY-ID
  IF NO RECORDS FOUND
    MOVE 704 TO P-RC
    MOVE 'PAYMENT NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
*
  IF PCA-STATUS NE 'AU'
    MOVE 710 TO P-RC
    COMPRESS 'PAYMENT STATUS' PCA-STATUS
      'NOT CAPTURABLE' INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  MOVE PCA-AMOUNT TO #AUTH-AMT
  MOVE PCA-ORDER-ID TO #ORDER-ID
*
  * DEFAULT TO FULL CAPTURE
  IF P-CAPTURE-AMT = 0
    MOVE #AUTH-AMT TO P-CAPTURE-AMT
  END-IF
  IF P-CAPTURE-AMT > #AUTH-AMT
    MOVE 711 TO P-RC
    MOVE 'CAPTURE AMOUNT EXCEEDS AUTHORIZATION' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * GATEWAY CAPTURE CALL (SIMULATED)
  * IN PRODUCTION: CALLNAT 'GWCAPTURE' PCA-GATEWAY-ID ...
  RESET #GW-RC
*
  IF #GW-RC NE 0
    MOVE 720 TO P-RC
    COMPRESS 'CAPTURE FAILED:' #GW-MSG INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * UPDATE PAYMENT
  GET PCA-VIEW *ISN (HOLD)
  MOVE 'CA' TO PCA-STATUS
  MOVE P-CAPTURE-AMT TO PCA-CAPTURED-AMT
  MOVE *DATX TO PCA-CAPTURED-DATE
  UPDATE PCA-VIEW
*
  * CREATE SETTLEMENT RECORD
  STORE STL-VIEW
    STL-PAY-ID   := P-PAY-ID
    STL-ORDER-ID := #ORDER-ID
    STL-AMOUNT   := P-CAPTURE-AMT
    STL-TYPE     := 'CP'
    STL-STATUS   := 'PN'
    STL-DATE     := *DATX
  END-STORE
*
  END OF TRANSACTION
  ESCAPE BOTTOM
END-FIND
*
* AUDIT
MOVE #ORDER-ID TO #ORD-STR
1 #AMT-STR (A15)
MOVE P-CAPTURE-AMT TO #AMT-STR
CALLNAT 'AUDITN' 'PAY' #ORD-STR 'U' 'CAPTU'
  ' ' #AMT-STR 'PAYMENT CAPTURED'
*
END
