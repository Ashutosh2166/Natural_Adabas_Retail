* >Natural Source Code: WEBPRICE
* SUBPROGRAM: WEBPRICE - WEB CHANNEL PRICING
* DESCRIPTION: CALCULATES PRICING FOR WEB/ONLINE ORDERS
*              INCLUDES WEB-ONLY PROMOTIONS, SHIPPING CALC
*              ABANDONED CART DISCOUNTS
* LIBRARY: RETAILCORE
* CREATED: 2009-11-15  J. CHEN
* MODIFIED: 2014-07-22 - ADDED FLASH SALE SUPPORT
* MODIFIED: 2018-03-10 - ADDED MEMBER PRICING
* MODIFIED: 2022-09-15 - ADDED CART ABANDONMENT LOGIC
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-SKU                 (A15)
  1 P-CUST-ID             (N8)
  1 P-QTY                 (N6)
  1 P-SESSION-ID          (A20)
  1 P-BASE-PRICE          (N9.2)
  1 P-WEB-PRICE           (N9.2)
  1 P-SHIPPING-AMT        (N9.2)
  1 P-FREE-SHIP-FLAG      (A1)
  1 P-PROMO-CODE          (A20)
  1 P-DISCOUNT-AMT        (N9.2)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #TODAY                (D)
  1 #WEB-DISCOUNT-PCT     (N5.2)   INIT <5.00>
  1 #FREE-SHIP-THRESHOLD  (N9.2)   INIT <50.00>
  1 #FLASH-DISCOUNT       (N5.2)
  1 #MEMBER-DISCOUNT      (N5.2)
  1 #CART-DISCOUNT        (N5.2)   INIT <10.00>
  1 #WORK-PRICE           (N9.2)
  1 #TOTAL-DISCOUNT       (N9.2)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
  1 #CPN-DISCOUNT         (N9.2)
*
  1 PRW-VIEW VIEW OF PRODUCT-FILE
    2 PRW-ID               (N8)
    2 PRW-BASE-PRICE       (N9.2)
    2 PRW-WEB-PRICE        (N9.2)
    2 PRW-STATUS           (A1)
    2 PRW-WEB-ENABLED      (A1)
*
  1 CUW-VIEW VIEW OF CUSTOMER-FILE
    2 CUW-ID               (N8)
    2 CUW-TYPE             (A2)
    2 CUW-LOYALTY-TIER     (A1)
    2 CUW-WEB-REGISTERED   (A1)
END-DEFINE
*
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
RESET P-DISCOUNT-AMT
RESET P-SHIPPING-AMT
MOVE 'N' TO P-FREE-SHIP-FLAG
*
* GET PRODUCT
FIND PRW-VIEW WITH PRW-ID = P-PROD-ID
  IF NO RECORDS FOUND
    MOVE 404 TO P-RC
    MOVE 'PRODUCT NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  IF PRW-STATUS NE 'A'
    MOVE 410 TO P-RC
    MOVE 'PRODUCT NOT AVAILABLE' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  IF PRW-WEB-ENABLED NE 'Y'
    MOVE 411 TO P-RC
    MOVE 'PRODUCT NOT AVAILABLE FOR WEB SALE' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  MOVE PRW-BASE-PRICE TO P-BASE-PRICE
  * USE WEB PRICE IF SET, OTHERWISE BASE
  IF PRW-WEB-PRICE > 0
    MOVE PRW-WEB-PRICE TO #WORK-PRICE
  ELSE
    MOVE PRW-BASE-PRICE TO #WORK-PRICE
  END-IF
  ESCAPE BOTTOM
END-FIND
*
* APPLY WEB CHANNEL DISCOUNT
CALLNAT 'CONFIGN' 'WEB.CHANNEL.DISCOUNT.PCT'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #WEB-DISCOUNT-PCT
END-IF
COMPUTE #TOTAL-DISCOUNT = #WORK-PRICE * (#WEB-DISCOUNT-PCT / 100)
*
* CHECK MEMBER PRICING
IF P-CUST-ID > 0
  FIND CUW-VIEW WITH CUW-ID = P-CUST-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    * WEB MEMBER GETS EXTRA DISCOUNT
    IF CUW-WEB-REGISTERED = 'Y'
      DECIDE ON FIRST VALUE OF CUW-LOYALTY-TIER
        VALUE 'P'
          MOVE 8.00 TO #MEMBER-DISCOUNT
        VALUE 'G'
          MOVE 5.00 TO #MEMBER-DISCOUNT
        VALUE 'S'
          MOVE 3.00 TO #MEMBER-DISCOUNT
        VALUE 'B'
          MOVE 1.00 TO #MEMBER-DISCOUNT
        NONE VALUE
          IGNORE
      END-DECIDE
      IF #MEMBER-DISCOUNT > 0
        ADD #WORK-PRICE * (#MEMBER-DISCOUNT / 100)
          TO #TOTAL-DISCOUNT
      END-IF
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-IF
*
* CHECK FOR FLASH SALE
* (SIMPLIFIED - CHECKS CONFIG FLAG)
CALLNAT 'CONFIGN' 'FLASH.SALE.ACTIVE'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y' AND #CONFIG-FLAG = 'Y'
  CALLNAT 'CONFIGN' 'FLASH.SALE.DISCOUNT.PCT'
    #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
  IF #CONFIG-FOUND = 'Y'
    MOVE #CONFIG-NUM TO #FLASH-DISCOUNT
    ADD #WORK-PRICE * (#FLASH-DISCOUNT / 100) TO #TOTAL-DISCOUNT
  END-IF
END-IF
*
* APPLY COUPON IF PROVIDED
IF P-PROMO-CODE NE ' '
  CALLNAT 'CPNVAL' 'VALD' P-PROMO-CODE 0 P-CUST-ID
    (#WORK-PRICE * P-QTY) #CPN-DISCOUNT
    #VALID-FLAG #ERROR-MSG
  IF #VALID-FLAG = 'Y' AND #CPN-DISCOUNT > 0
    * CONVERT PER-ORDER TO PER-UNIT
    IF P-QTY > 0
      COMPUTE #CPN-DISCOUNT = #CPN-DISCOUNT / P-QTY
    END-IF
    ADD #CPN-DISCOUNT TO #TOTAL-DISCOUNT
  END-IF
END-IF
*
* CALCULATE FINAL WEB PRICE
COMPUTE P-WEB-PRICE = #WORK-PRICE - #TOTAL-DISCOUNT
IF P-WEB-PRICE < 0.01
  MOVE 0.01 TO P-WEB-PRICE
END-IF
MOVE #TOTAL-DISCOUNT TO P-DISCOUNT-AMT
*
* CALCULATE SHIPPING
CALLNAT 'CONFIGN' 'FREE.SHIP.THRESHOLD'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #FREE-SHIP-THRESHOLD
END-IF
*
1 #ORDER-TOTAL (N11.2)
COMPUTE #ORDER-TOTAL = P-WEB-PRICE * P-QTY
IF #ORDER-TOTAL >= #FREE-SHIP-THRESHOLD
  MOVE 'Y' TO P-FREE-SHIP-FLAG
  MOVE 0 TO P-SHIPPING-AMT
ELSE
  * FLAT RATE SHIPPING
  MOVE 7.99 TO P-SHIPPING-AMT
  IF P-QTY > 5
    * HEAVY ORDER SURCHARGE
    ADD 4.99 TO P-SHIPPING-AMT
  END-IF
END-IF
*
END
