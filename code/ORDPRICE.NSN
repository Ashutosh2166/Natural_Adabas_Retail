* >Natural Source Code: ORDPRICE
* SUBPROGRAM: ORDPRICE - ORDER LINE PRICING (LEGACY)
* DESCRIPTION: CALCULATES UNIT PRICE FOR ORDER LINE
*              *** REPLACED BY ORDPRICE2 ***
*              KEPT FOR BACKWARD COMPATIBILITY
*              SOME BATCH PROGRAMS STILL CALL THIS
* LIBRARY: RETAILCORE
* CREATED: 1999-02-15  A. GARCIA
* MODIFIED: 2004-11-20 - ADDED WHOLESALE PRICING
* MODIFIED: 2008-06-15 - ADDED TAX CALCULATION
* NOTE: DO NOT ADD NEW FEATURES HERE - USE ORDPRICE2
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-STORE-ID            (N4)
  1 P-CUST-ID             (N8)
  1 P-QTY                 (N6)
  1 P-UNIT-PRICE          (N9.2)
  1 P-DISCOUNT            (N9.2)
  1 P-TAX-AMT             (N9.2)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #BASE-PRICE            (N9.2)
  1 #STORE-PRICE           (N9.2)
  1 #CUST-TYPE             (A2)
  1 #TAX-RATE              (N5.4)  INIT <0.0825>
  1 #WHOLESALE-DISC        (N5.2)  INIT <15.00>
  1 #QTY-DISC-THRESHOLD    (N6)    INIT <100>
  1 #QTY-DISC-PCT          (N5.2)  INIT <5.00>
  1 #FOUND                 (A1)
*
  1 PR-VIEW VIEW OF PRODUCT-FILE
    2 PR-ID                (N8)
    2 PR-BASE-PRICE        (N9.2)
    2 PR-STATUS            (A1)
*
  1 SP-VIEW VIEW OF STORE-PRICE-FILE
    2 SP-PROD-ID           (N8)
    2 SP-STORE-ID          (N4)
    2 SP-PRICE             (N9.2)
    2 SP-EFF-FROM          (D)
    2 SP-EFF-TO            (D)
*
  1 CU-VIEW VIEW OF CUSTOMER-FILE
    2 CU-ID                (N8)
    2 CU-TYPE              (A2)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
RESET P-DISCOUNT
RESET P-TAX-AMT
*
* GET BASE PRICE
FIND PR-VIEW WITH PR-ID = P-PROD-ID
  IF NO RECORDS FOUND
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT NOT FOUND FOR PRICING' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
  IF PR-STATUS NE 'A'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PRODUCT NOT ACTIVE' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  MOVE PR-BASE-PRICE TO #BASE-PRICE
  ESCAPE BOTTOM
END-FIND
*
IF #BASE-PRICE = 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'NO BASE PRICE DEFINED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK STORE PRICE OVERRIDE
* NOTE: DOES NOT CHECK EFFECTIVE DATES - KNOWN ISSUE
MOVE #BASE-PRICE TO P-UNIT-PRICE
IF P-STORE-ID > 0
  MOVE 'N' TO #FOUND
  FIND SP-VIEW WITH SP-PROD-ID = P-PROD-ID
      AND SP-STORE-ID = P-STORE-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    IF SP-PRICE > 0
      MOVE SP-PRICE TO P-UNIT-PRICE
      MOVE 'Y' TO #FOUND
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-IF
*
* CHECK WHOLESALE CUSTOMER DISCOUNT
* LEGACY: ONLY CHECKS FOR WHOLESALE TYPE
IF P-CUST-ID > 0
  FIND CU-VIEW WITH CU-ID = P-CUST-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    MOVE CU-TYPE TO #CUST-TYPE
    ESCAPE BOTTOM
  END-FIND
  IF #CUST-TYPE = 'WH'
    COMPUTE P-DISCOUNT = P-UNIT-PRICE * P-QTY
      * (#WHOLESALE-DISC / 100)
  END-IF
END-IF
*
* QUANTITY DISCOUNT - HARDCODED
IF P-QTY >= #QTY-DISC-THRESHOLD
  COMPUTE P-DISCOUNT = P-DISCOUNT +
    (P-UNIT-PRICE * P-QTY * (#QTY-DISC-PCT / 100))
END-IF
*
* TAX - SIMPLE FLAT RATE
* NOTE: DOES NOT HANDLE TAX-EXEMPT OR STATE RATES
COMPUTE P-TAX-AMT = (P-UNIT-PRICE * P-QTY - P-DISCOUNT) * #TAX-RATE
*
END
