* >Natural Source Code: INVCHK
* SUBPROGRAM: INVCHK - INVENTORY AVAILABILITY CHECK
* DESCRIPTION: CHECKS INVENTORY AVAILABILITY FOR A
*              PRODUCT AT A SPECIFIC LOCATION
*              CALCULATES AVAILABLE STOCK
* LIBRARY: RETAILCORE
* ADABAS FILE: 105 (INVENTORY)
* CREATED: 1998-09-01  K. PATEL
* MODIFIED: 2003-05-20 - ADDED MULTI-LOCATION CHECK
* MODIFIED: 2010-11-15 - ADDED DAMAGED INVENTORY
* MODIFIED: 2017-03-22 - ADDED SAFETY STOCK WARNING
* MODIFIED: 2021-06-10 - ADDED IN-TRANSIT INVENTORY
* -------------------------------------------------------
* AVAILABLE STOCK FORMULA:
*   AVAILABLE = ON-HAND - RESERVED - ALLOCATED - DAMAGED
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROD-ID             (N8)
  1 P-SKU                 (A15)
  1 P-LOC-TYPE            (A1)    /* S=STORE W=WAREHOUSE A=ALL */
  1 P-LOC-ID              (N4)    /* 0=ALL LOCATIONS OF TYPE */
  1 P-REQUESTED-QTY       (N8)
  1 P-INVENTORY-RESULT
    2 P-IR-ON-HAND        (N8)
    2 P-IR-RESERVED       (N8)
    2 P-IR-ALLOCATED      (N8)
    2 P-IR-DAMAGED        (N8)
    2 P-IR-IN-TRANSIT     (N8)
    2 P-IR-AVAILABLE      (N8)
    2 P-IR-SAFETY-STOCK   (N8)
    2 P-IR-REORDER-LEVEL  (N8)
    2 P-IR-BELOW-SAFETY   (A1)
    2 P-IR-BELOW-REORDER  (A1)
    2 P-IR-SUFFICIENT     (A1)    /* Y=CAN FULFILL N=CANNOT */
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL USING INV-COPY
LOCAL USING ERROR-COPY
*
LOCAL
  1 #TOTAL-ON-HAND        (N10)
  1 #TOTAL-RESERVED       (N10)
  1 #TOTAL-ALLOCATED      (N10)
  1 #TOTAL-DAMAGED        (N10)
  1 #TOTAL-IN-TRANSIT     (N10)
  1 #TOTAL-AVAILABLE      (N10)
  1 #LOC-COUNT            (N4)
  1 #PROD-ID-WORK         (N8)
*
  1 INV-VIEW VIEW OF INVENTORY-FILE
    2 IV-PROD-ID           (N8)
    2 IV-SKU               (A15)
    2 IV-LOC-TYPE          (A1)
    2 IV-LOC-ID            (N4)
    2 IV-ON-HAND           (N8)
    2 IV-RESERVED          (N8)
    2 IV-ALLOCATED         (N8)
    2 IV-DAMAGED           (N8)
    2 IV-IN-TRANSIT        (N8)
    2 IV-SAFETY-STOCK      (N8)
    2 IV-REORDER-LEVEL     (N8)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
RESET P-RC
RESET P-RC-TEXT
RESET P-INVENTORY-RESULT
RESET #TOTAL-ON-HAND
RESET #TOTAL-RESERVED
RESET #TOTAL-ALLOCATED
RESET #TOTAL-DAMAGED
RESET #TOTAL-IN-TRANSIT
RESET #LOC-COUNT
*
* RESOLVE PRODUCT ID FROM SKU IF NEEDED
MOVE P-PROD-ID TO #PROD-ID-WORK
IF #PROD-ID-WORK = 0 AND P-SKU NE ' '
  CALLNAT 'SKUVAL' P-SKU ' ' #PROD-ID-WORK
    ' ' ' ' 0 ' ' ' ' ' '
  IF #PROD-ID-WORK = 0
    MOVE ERR-PROD-NOT-FOUND TO P-RC
    MOVE 'PRODUCT NOT FOUND FOR SKU' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
END-IF
*
IF #PROD-ID-WORK = 0
  MOVE ERR-PROD-NOT-FOUND TO P-RC
  MOVE 'PRODUCT ID OR SKU REQUIRED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* -------------------------------------------------------
* READ INVENTORY BASED ON LOCATION CRITERIA
* -------------------------------------------------------
IF P-LOC-TYPE = 'A' OR P-LOC-ID = 0
  * CHECK ALL LOCATIONS
  * MODIFIED 2003-05-20 - MULTI LOCATION
  READ INV-VIEW BY IV-PROD-ID = #PROD-ID-WORK
    IF IV-PROD-ID NE #PROD-ID-WORK
      ESCAPE BOTTOM
    END-IF
    IF P-LOC-TYPE NE 'A' AND IV-LOC-TYPE NE P-LOC-TYPE
      ESCAPE TOP
    END-IF
    PERFORM ACCUMULATE-INVENTORY
  END-READ
ELSE
  * CHECK SPECIFIC LOCATION
  FIND INV-VIEW WITH IV-PROD-ID = #PROD-ID-WORK
      AND IV-LOC-TYPE = P-LOC-TYPE
      AND IV-LOC-ID = P-LOC-ID
    IF NO RECORDS FOUND
      MOVE ERR-INV-NOT-FOUND TO P-RC
      COMPRESS 'NO INVENTORY RECORD FOR PRODUCT' #PROD-ID-WORK
        'AT LOCATION' P-LOC-TYPE P-LOC-ID INTO P-RC-TEXT
      MOVE 'N' TO P-IR-SUFFICIENT
      ESCAPE ROUTINE
    END-NOREC
    PERFORM ACCUMULATE-INVENTORY
    ESCAPE BOTTOM
  END-FIND
END-IF
*
ON ERROR
  MOVE 300 TO P-RC
  COMPRESS 'DATABASE ERROR IN INVCHK:' *ERROR-NR INTO P-RC-TEXT
  CALLNAT 'LOGERR' 300 P-RC-TEXT 'E' 'INVCHK' *USER
  ESCAPE ROUTINE
END-ERROR
*
* -------------------------------------------------------
* CALCULATE AVAILABLE STOCK
* AVAILABLE = ON-HAND - RESERVED - ALLOCATED - DAMAGED
* -------------------------------------------------------
COMPUTE #TOTAL-AVAILABLE = #TOTAL-ON-HAND
  - #TOTAL-RESERVED - #TOTAL-ALLOCATED - #TOTAL-DAMAGED
*
IF #TOTAL-AVAILABLE < 0
  MOVE 0 TO #TOTAL-AVAILABLE
END-IF
*
* POPULATE RESULT
MOVE #TOTAL-ON-HAND    TO P-IR-ON-HAND
MOVE #TOTAL-RESERVED   TO P-IR-RESERVED
MOVE #TOTAL-ALLOCATED  TO P-IR-ALLOCATED
MOVE #TOTAL-DAMAGED    TO P-IR-DAMAGED
MOVE #TOTAL-IN-TRANSIT TO P-IR-IN-TRANSIT
MOVE #TOTAL-AVAILABLE  TO P-IR-AVAILABLE
*
* CHECK AGAINST REQUESTED QUANTITY
IF P-REQUESTED-QTY > 0
  IF #TOTAL-AVAILABLE >= P-REQUESTED-QTY
    MOVE 'Y' TO P-IR-SUFFICIENT
  ELSE
    MOVE 'N' TO P-IR-SUFFICIENT
    MOVE ERR-INV-INSUFFICIENT TO P-RC
    COMPRESS 'INSUFFICIENT INVENTORY - AVAILABLE:'
      #TOTAL-AVAILABLE 'REQUESTED:' P-REQUESTED-QTY
      INTO P-RC-TEXT
  END-IF
ELSE
  MOVE 'Y' TO P-IR-SUFFICIENT
END-IF
*
* CHECK SAFETY STOCK AND REORDER LEVEL
* MODIFIED 2017-03-22
IF P-IR-SAFETY-STOCK > 0
  IF #TOTAL-AVAILABLE <= P-IR-SAFETY-STOCK
    MOVE 'Y' TO P-IR-BELOW-SAFETY
  ELSE
    MOVE 'N' TO P-IR-BELOW-SAFETY
  END-IF
END-IF
*
IF P-IR-REORDER-LEVEL > 0
  IF #TOTAL-ON-HAND <= P-IR-REORDER-LEVEL
    MOVE 'Y' TO P-IR-BELOW-REORDER
  ELSE
    MOVE 'N' TO P-IR-BELOW-REORDER
  END-IF
END-IF
*
* -------------------------------------------------------
* ACCUMULATE INVENTORY FROM LOCATION
* -------------------------------------------------------
DEFINE SUBROUTINE ACCUMULATE-INVENTORY
  ADD 1 TO #LOC-COUNT
  ADD IV-ON-HAND    TO #TOTAL-ON-HAND
  ADD IV-RESERVED   TO #TOTAL-RESERVED
  ADD IV-ALLOCATED  TO #TOTAL-ALLOCATED
  ADD IV-DAMAGED    TO #TOTAL-DAMAGED
  ADD IV-IN-TRANSIT TO #TOTAL-IN-TRANSIT
  * USE FIRST LOCATION'S THRESHOLDS
  IF #LOC-COUNT = 1
    MOVE IV-SAFETY-STOCK  TO P-IR-SAFETY-STOCK
    MOVE IV-REORDER-LEVEL TO P-IR-REORDER-LEVEL
  END-IF
END-SUBROUTINE
*
END
