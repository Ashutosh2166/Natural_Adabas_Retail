* >Natural Source Code: SEQNON
* SUBPROGRAM: SEQNON - SEQUENCE NUMBER GENERATOR
* DESCRIPTION: GENERATES UNIQUE SEQUENCE NUMBERS FOR
*              ALL ENTITY TYPES IN THE SYSTEM
* LIBRARY: RETAILCORE
* ADABAS FILE: 220 (SEQUENCE-CONTROL)
* CREATED: 1998-04-15  R. PETERSON
* MODIFIED: 2004-01-22 - ADDED RETRY ON LOCK CONFLICT
* MODIFIED: 2011-06-30 - ADDED BATCH RANGE ALLOCATION
* MODIFIED: 2018-05-14 - INCREASED SEQUENCE CAPACITY
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ENTITY-TYPE         (A4)    /* ENTITY TYPE CODE */
  1 P-NEXT-SEQ            (N10)   /* RETURNED SEQUENCE NUMBER */
*
LOCAL
  1 #RETRY-COUNT          (N2)
  1 #MAX-RETRIES          (N2)    INIT <5>
  1 #LOCK-OBTAINED        (A1)
  1 #VALID-ENTITY         (A1)
  1 #DB-RESPONSE          (N4)
  1 #CURRENT-SEQ          (N10)
  1 #INCREMENT            (N4)    INIT <1>
  1 #USER-ID              (A8)
*
* ADABAS FILE 220 - SEQUENCE CONTROL
*
  1 SEQ-CTRL-VIEW VIEW OF SEQ-CONTROL
    2 SC-ENTITY-TYPE       (A4)
    2 SC-CURRENT-SEQ       (N10)
    2 SC-INCREMENT         (N4)
    2 SC-LAST-USED-DATE    (D)
    2 SC-LAST-USED-BY      (A8)
    2 SC-DAILY-COUNT       (N8)
END-DEFINE
*
* -------------------------------------------------------
* INITIALIZE
* -------------------------------------------------------
MOVE *USER TO #USER-ID
RESET P-NEXT-SEQ
RESET #RETRY-COUNT
MOVE 'N' TO #LOCK-OBTAINED
*
* -------------------------------------------------------
* VALIDATE ENTITY TYPE
* -------------------------------------------------------
MOVE 'N' TO #VALID-ENTITY
DECIDE ON EVERY VALUE OF P-ENTITY-TYPE
  VALUE 'CUST' , 'PROD' , 'ORD'  , 'RET'
    MOVE 'Y' TO #VALID-ENTITY
  VALUE 'PAY'  , 'SHIP' , 'PO'   , 'TRN'
    MOVE 'Y' TO #VALID-ENTITY
  VALUE 'ADJ'  , 'ERRL' , 'AUDT' , 'REPL'
    MOVE 'Y' TO #VALID-ENTITY
  VALUE 'RCNL' , 'BO'   , 'PROM' , 'CPN'
    MOVE 'Y' TO #VALID-ENTITY
  NONE VALUE
    CALLNAT 'LOGERR' 550 'SEQNON: INVALID ENTITY TYPE'
      'E' 'SEQNON' #USER-ID
    ESCAPE ROUTINE
END-DECIDE
*
* -------------------------------------------------------
* READ AND UPDATE SEQUENCE WITH RETRY ON LOCK
* -------------------------------------------------------
REPEAT
  ADD 1 TO #RETRY-COUNT
*
  FIND SEQ-CTRL-VIEW WITH SC-ENTITY-TYPE = P-ENTITY-TYPE
    IF NO RECORDS FOUND
      * ENTITY TYPE NOT INITIALIZED - CREATE IT
      PERFORM CREATE-SEQUENCE
      ESCAPE BOTTOM
    END-NOREC
*
    * GET RECORD WITH HOLD FOR UPDATE
    GET SEQ-CTRL-VIEW *ISN (HOLD)
*
    ON ERROR
      IF *ERROR-NR = 145    /* RECORD IN HOLD BY ANOTHER USER */
        IF #RETRY-COUNT < #MAX-RETRIES
          BACKOUT TRANSACTION
          /* WAIT BEFORE RETRY - LEGACY APPROACH */
          ESCAPE TOP
        ELSE
          CALLNAT 'LOGERR' 551 'SEQNON: LOCK TIMEOUT'
            'E' 'SEQNON' #USER-ID
          ESCAPE ROUTINE
        END-IF
      ELSE
        CALLNAT 'LOGERR' 552 'SEQNON: DATABASE ERROR'
          'E' 'SEQNON' #USER-ID
        ESCAPE ROUTINE
      END-IF
    END-ERROR
*
    * INCREMENT SEQUENCE
    MOVE SC-INCREMENT TO #INCREMENT
    IF #INCREMENT = 0
      MOVE 1 TO #INCREMENT
    END-IF
*
    ADD #INCREMENT TO SC-CURRENT-SEQ
    MOVE SC-CURRENT-SEQ TO P-NEXT-SEQ
    MOVE *DATX            TO SC-LAST-USED-DATE
    MOVE #USER-ID         TO SC-LAST-USED-BY
    ADD 1 TO SC-DAILY-COUNT
*
    UPDATE SEQ-CTRL-VIEW
    END OF TRANSACTION
    MOVE 'Y' TO #LOCK-OBTAINED
    ESCAPE BOTTOM
*
  END-FIND
*
  WHEN #RETRY-COUNT >= #MAX-RETRIES
    ESCAPE BOTTOM
END-REPEAT
*
IF #LOCK-OBTAINED NE 'Y' AND P-NEXT-SEQ = 0
  CALLNAT 'LOGERR' 553 'SEQNON: FAILED TO GENERATE SEQUENCE'
    'E' 'SEQNON' #USER-ID
END-IF
*
* -------------------------------------------------------
* CREATE NEW SEQUENCE ENTRY
* -------------------------------------------------------
DEFINE SUBROUTINE CREATE-SEQUENCE
*
  STORE SEQ-CTRL-VIEW
    SC-ENTITY-TYPE    := P-ENTITY-TYPE
    SC-CURRENT-SEQ    := 1
    SC-INCREMENT      := 1
    SC-LAST-USED-DATE := *DATX
    SC-LAST-USED-BY   := #USER-ID
    SC-DAILY-COUNT    := 1
  END-STORE
*
  ON ERROR
    CALLNAT 'LOGERR' 554 'SEQNON: FAILED TO CREATE SEQUENCE'
      'E' 'SEQNON' #USER-ID
    ESCAPE ROUTINE
  END-ERROR
*
  MOVE 1 TO P-NEXT-SEQ
  END OF TRANSACTION
*
END-SUBROUTINE
*
END
