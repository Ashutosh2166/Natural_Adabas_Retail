* >Natural Source Code: SUPPGET
* SUBPROGRAM: SUPPGET - SUPPLIER RETRIEVAL
* DESCRIPTION: RETRIEVES SUPPLIER MASTER DATA
*              WITH TERMS AND PERFORMANCE METRICS
* LIBRARY: RETAILCORE
* ADABAS FILE: 130 (SUPPLIER)
* CREATED: 2001-06-15  A. GARCIA
* MODIFIED: 2008-03-10 - ADDED PERFORMANCE DATA
* MODIFIED: 2015-09-22 - ADDED TERMS RETRIEVAL
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SUPP-ID             (N8)
  1 P-SUPP-DATA
    2 P-SD-ID             (N8)
    2 P-SD-NAME           (A60)
    2 P-SD-STATUS         (A1)
    2 P-SD-TYPE           (A2)
    2 P-SD-CONTACT        (A40)
    2 P-SD-PHONE          (A15)
    2 P-SD-EMAIL          (A60)
  1 P-SUPP-ADDR
    2 P-SA-LINE1          (A40)
    2 P-SA-LINE2          (A40)
    2 P-SA-CITY           (A30)
    2 P-SA-STATE          (A2)
    2 P-SA-ZIP            (A10)
    2 P-SA-COUNTRY        (A3)
  1 P-SUPP-TERMS
    2 P-ST-PAY-TERMS      (A10)
    2 P-ST-PAY-DAYS       (N3)
    2 P-ST-DISC-PCT       (N5.2)
    2 P-ST-DISC-DAYS      (N3)
    2 P-ST-LEAD-DAYS      (N3)
    2 P-ST-MIN-ORDER      (N9.2)
    2 P-ST-FREIGHT-TERMS  (A3)
    2 P-ST-CURRENCY       (A3)
  1 P-SUPP-PERF
    2 P-SP-RATING         (N3)
    2 P-SP-ON-TIME-PCT    (N5.2)
    2 P-SP-QUALITY-PCT    (N5.2)
    2 P-SP-FILL-RATE      (N5.2)
    2 P-SP-TOTAL-POS      (N6)
    2 P-SP-TOTAL-AMT      (N11.2)
    2 P-SP-LAST-PO-DATE   (D)
  1 P-FOUND-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 SG-VIEW VIEW OF SUPPLIER-FILE
    2 SG-ID                (N8)
    2 SG-NAME              (A60)
    2 SG-STATUS            (A1)
    2 SG-TYPE              (A2)
    2 SG-CONTACT-NAME      (A40)
    2 SG-PHONE             (A15)
    2 SG-EMAIL             (A60)
    2 SG-ADDR-LINE1        (A40)
    2 SG-ADDR-LINE2        (A40)
    2 SG-CITY              (A30)
    2 SG-STATE             (A2)
    2 SG-ZIP               (A10)
    2 SG-COUNTRY           (A3)
    2 SG-PAY-TERMS         (A10)
    2 SG-PAY-DAYS          (N3)
    2 SG-DISCOUNT-PCT      (N5.2)
    2 SG-DISCOUNT-DAYS     (N3)
    2 SG-LEAD-TIME-DAYS    (N3)
    2 SG-MIN-ORDER-AMT     (N9.2)
    2 SG-FREIGHT-TERMS     (A3)
    2 SG-CURRENCY          (A3)
    2 SG-RATING            (N3)
    2 SG-ON-TIME-PCT       (N5.2)
    2 SG-QUALITY-PCT       (N5.2)
    2 SG-FILL-RATE         (N5.2)
    2 SG-TOTAL-POS         (N6)
    2 SG-TOTAL-AMT         (N11.2)
    2 SG-LAST-PO-DATE      (D)
END-DEFINE
*
MOVE 'N' TO P-FOUND-FLAG
RESET P-ERROR-MSG
*
IF P-SUPP-ID = 0
  MOVE 'SUPPLIER ID REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
FIND SG-VIEW WITH SG-ID = P-SUPP-ID
  IF NO RECORDS FOUND
    MOVE 'SUPPLIER NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
*
  * BASIC DATA
  MOVE SG-ID           TO P-SD-ID
  MOVE SG-NAME         TO P-SD-NAME
  MOVE SG-STATUS       TO P-SD-STATUS
  MOVE SG-TYPE         TO P-SD-TYPE
  MOVE SG-CONTACT-NAME TO P-SD-CONTACT
  MOVE SG-PHONE        TO P-SD-PHONE
  MOVE SG-EMAIL        TO P-SD-EMAIL
*
  * ADDRESS
  MOVE SG-ADDR-LINE1   TO P-SA-LINE1
  MOVE SG-ADDR-LINE2   TO P-SA-LINE2
  MOVE SG-CITY         TO P-SA-CITY
  MOVE SG-STATE        TO P-SA-STATE
  MOVE SG-ZIP          TO P-SA-ZIP
  MOVE SG-COUNTRY      TO P-SA-COUNTRY
*
  * TERMS
  MOVE SG-PAY-TERMS     TO P-ST-PAY-TERMS
  MOVE SG-PAY-DAYS      TO P-ST-PAY-DAYS
  MOVE SG-DISCOUNT-PCT  TO P-ST-DISC-PCT
  MOVE SG-DISCOUNT-DAYS TO P-ST-DISC-DAYS
  MOVE SG-LEAD-TIME-DAYS TO P-ST-LEAD-DAYS
  MOVE SG-MIN-ORDER-AMT TO P-ST-MIN-ORDER
  MOVE SG-FREIGHT-TERMS TO P-ST-FREIGHT-TERMS
  MOVE SG-CURRENCY      TO P-ST-CURRENCY
*
  * PERFORMANCE
  MOVE SG-RATING        TO P-SP-RATING
  MOVE SG-ON-TIME-PCT   TO P-SP-ON-TIME-PCT
  MOVE SG-QUALITY-PCT   TO P-SP-QUALITY-PCT
  MOVE SG-FILL-RATE     TO P-SP-FILL-RATE
  MOVE SG-TOTAL-POS     TO P-SP-TOTAL-POS
  MOVE SG-TOTAL-AMT     TO P-SP-TOTAL-AMT
  MOVE SG-LAST-PO-DATE  TO P-SP-LAST-PO-DATE
*
  MOVE 'Y' TO P-FOUND-FLAG
  ESCAPE BOTTOM
END-FIND
*
END
