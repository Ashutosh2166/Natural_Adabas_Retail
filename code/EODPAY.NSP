* >Natural Source Code: EODPAY
* PROGRAM: EODPAY - END OF DAY PAYMENT PROCESSING
* DESCRIPTION: BATCH PAYMENT SETTLEMENT AND RECONCILIATION
*              PROCESSES PENDING SETTLEMENTS, MATCHES GATEWAY
*              REPORTS DISCREPANCIES
* LIBRARY: RETAILCORE
* ADABAS FILES: 140 (PAYMENT), 143 (SETTLEMENT)
* CREATED: 2002-06-15  A. GARCIA
* MODIFIED: 2010-03-22 - ADDED GATEWAY RECONCILIATION
* MODIFIED: 2018-09-10 - ADDED MULTI-GATEWAY SUPPORT
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
  1 #YESTERDAY            (D)
*
* COUNTERS
  1 #PAYMENTS-PROCESSED   (N8)
  1 #CAPTURES-SETTLED     (N8)
  1 #REFUNDS-SETTLED      (N8)
  1 #CAPTURE-AMT          (N13.2)
  1 #REFUND-AMT           (N13.2)
  1 #NET-SETTLEMENT       (N13.2)
  1 #EXPIRED-AUTHS        (N8)
  1 #DISCREPANCIES        (N8)
*
* PAYMENT METHOD BREAKDOWN
  1 #CC-COUNT             (N8)
  1 #CC-AMT               (N13.2)
  1 #DC-COUNT             (N8)
  1 #DC-AMT               (N13.2)
  1 #GC-COUNT             (N8)
  1 #GC-AMT               (N13.2)
  1 #CA-COUNT             (N8)
  1 #CA-AMT               (N13.2)
  1 #OT-COUNT             (N8)
  1 #OT-AMT               (N13.2)
*
  1 EPY-VIEW VIEW OF PAYMENT-FILE
    2 EPY-ID               (N10)
    2 EPY-ORDER-ID         (N10)
    2 EPY-METHOD           (A2)
    2 EPY-STATUS           (A2)
    2 EPY-AMOUNT           (N11.2)
    2 EPY-CAPTURED-AMT     (N11.2)
    2 EPY-REFUNDED-AMT     (N11.2)
    2 EPY-AUTH-DATE        (D)
    2 EPY-GATEWAY-ID       (A10)
*
  1 ESL-VIEW VIEW OF SETTLEMENT-FILE
    2 ESL-PAY-ID           (N10)
    2 ESL-AMOUNT           (N11.2)
    2 ESL-TYPE             (A2)
    2 ESL-STATUS           (A2)
    2 ESL-DATE             (D)
    2 ESL-BATCH-ID         (A20)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE #TODAY TO #YESTERDAY
SUBTRACT 1 FROM #YESTERDAY (D)
*
WRITE 'RETAILCORE - END OF DAY PAYMENT PROCESSING'
WRITE '============================================'
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* STEP 1: SETTLE PENDING TRANSACTIONS
WRITE 'STEP 1: SETTLING PENDING TRANSACTIONS...'
1 #BATCH-ID (A20)
COMPRESS 'BATCH-' #TODAY INTO #BATCH-ID LEAVING NO SPACE
*
FIND ESL-VIEW WITH ESL-STATUS = 'PN'
  GET ESL-VIEW *ISN (HOLD)
  MOVE 'ST' TO ESL-STATUS
  MOVE #BATCH-ID TO ESL-BATCH-ID
  MOVE #TODAY TO ESL-DATE
  UPDATE ESL-VIEW
*
  IF ESL-TYPE = 'CP'
    ADD 1 TO #CAPTURES-SETTLED
    ADD ESL-AMOUNT TO #CAPTURE-AMT
  ELSE IF ESL-TYPE = 'RF'
    ADD 1 TO #REFUNDS-SETTLED
    ADD ESL-AMOUNT TO #REFUND-AMT
  END-IF
  END-IF
*
  IF *COUNTER = 100
    END OF TRANSACTION
  END-IF
END-FIND
END OF TRANSACTION
*
* STEP 2: EXPIRE OLD AUTHORIZATIONS (>7 DAYS)
WRITE ' '
WRITE 'STEP 2: EXPIRING OLD AUTHORIZATIONS...'
1 #AUTH-CUTOFF (D)
MOVE #TODAY TO #AUTH-CUTOFF
SUBTRACT 7 FROM #AUTH-CUTOFF (D)
*
FIND EPY-VIEW WITH EPY-STATUS = 'AU'
  IF EPY-AUTH-DATE < #AUTH-CUTOFF
    GET EPY-VIEW *ISN (HOLD)
    MOVE 'EX' TO EPY-STATUS
    UPDATE EPY-VIEW
    ADD 1 TO #EXPIRED-AUTHS
    IF *COUNTER = 50
      END OF TRANSACTION
    END-IF
  END-IF
END-FIND
END OF TRANSACTION
*
* STEP 3: PAYMENT METHOD ANALYSIS
WRITE ' '
WRITE 'STEP 3: ANALYZING PAYMENTS BY METHOD...'
FIND EPY-VIEW WITH EPY-AUTH-DATE = #YESTERDAY
  ADD 1 TO #PAYMENTS-PROCESSED
  DECIDE ON FIRST VALUE OF EPY-METHOD
    VALUE 'CC'
      ADD 1 TO #CC-COUNT
      ADD EPY-AMOUNT TO #CC-AMT
    VALUE 'DC'
      ADD 1 TO #DC-COUNT
      ADD EPY-AMOUNT TO #DC-AMT
    VALUE 'GC'
      ADD 1 TO #GC-COUNT
      ADD EPY-AMOUNT TO #GC-AMT
    VALUE 'CA'
      ADD 1 TO #CA-COUNT
      ADD EPY-AMOUNT TO #CA-AMT
    NONE VALUE
      ADD 1 TO #OT-COUNT
      ADD EPY-AMOUNT TO #OT-AMT
  END-DECIDE
END-FIND
*
COMPUTE #NET-SETTLEMENT = #CAPTURE-AMT - #REFUND-AMT
*
* PRINT REPORT
WRITE ' '
WRITE 'SETTLEMENT SUMMARY'
WRITE '=================='
WRITE 'CAPTURES SETTLED   :' #CAPTURES-SETTLED
WRITE 'CAPTURE AMOUNT     :' #CAPTURE-AMT
WRITE 'REFUNDS SETTLED    :' #REFUNDS-SETTLED
WRITE 'REFUND AMOUNT      :' #REFUND-AMT
WRITE 'NET SETTLEMENT     :' #NET-SETTLEMENT
WRITE 'EXPIRED AUTHS      :' #EXPIRED-AUTHS
WRITE 'BATCH ID           :' #BATCH-ID
WRITE ' '
WRITE 'PAYMENT METHOD BREAKDOWN (YESTERDAY)'
WRITE '====================================='
WRITE 'CREDIT CARD  - COUNT:' #CC-COUNT 'AMOUNT:' #CC-AMT
WRITE 'DEBIT CARD   - COUNT:' #DC-COUNT 'AMOUNT:' #DC-AMT
WRITE 'GIFT CARD    - COUNT:' #GC-COUNT 'AMOUNT:' #GC-AMT
WRITE 'CASH         - COUNT:' #CA-COUNT 'AMOUNT:' #CA-AMT
WRITE 'OTHER        - COUNT:' #OT-COUNT 'AMOUNT:' #OT-AMT
WRITE ' '
WRITE 'EOD PAYMENT PROCESSING COMPLETE'
*
CALLNAT 'AUDITN' 'PAY' 'EODPAY' 'U' 'BATCH'
  ' ' ' ' 'EOD PAYMENT PROCESSING COMPLETE'
*
END
