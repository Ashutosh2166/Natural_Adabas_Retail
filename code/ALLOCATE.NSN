* >Natural Source Code: ALLOCATE
* SUBPROGRAM: ALLOCATE - ORDER FULFILLMENT ALLOCATION
* DESCRIPTION: ALLOCATES INVENTORY TO ORDER FOR FULFILLMENT
*              SELECTS BEST LOCATION BASED ON PROXIMITY/STOCK
*              CONVERTS RESERVATIONS TO ALLOCATIONS
* LIBRARY: RETAILCORE
* ADABAS FILES: 111 (ORDER), 112 (ORDER-LINE), 105 (INVENTORY)
* CREATED: 2005-11-15  S. MARTINEZ
* MODIFIED: 2012-04-22 - ADDED MULTI-LOCATION ALLOCATION
* MODIFIED: 2018-08-10 - ADDED SHIP-FROM-STORE
* MODIFIED: 2023-05-15 - ADDED PRIORITY-BASED ALLOCATION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-ALLOC-MODE          (A4)    /* AUTO MANU SPLT */
  1 P-LOCATION-ID         (N6)    /* FOR MANUAL MODE */
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #STORE-ID             (N4)
  1 #ORDER-TYPE           (A2)
  1 #PRIORITY             (N1)
  1 #LINES-ALLOCATED      (N3)
  1 #LINES-FAILED         (N3)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A60)
  1 #ORD-STR              (A15)
*
  1 ALO-VIEW VIEW OF ORDER-FILE
    2 ALO-ID               (N10)
    2 ALO-STATUS           (A3)
    2 ALO-STORE-ID         (N4)
    2 ALO-TYPE             (A2)
    2 ALO-PRIORITY         (N1)
*
  1 ALL-VIEW VIEW OF ORDER-LINE-FILE
    2 ALL-ORDER-ID         (N10)
    2 ALL-LINE-NO          (N3)
    2 ALL-PROD-ID          (N8)
    2 ALL-SKU              (A15)
    2 ALL-QTY-ORDERED      (N6)
    2 ALL-STATUS           (A3)
*
  1 FA-VIEW VIEW OF FULFILLMENT-ALLOC-FILE
    2 FA-ORDER-ID          (N10)
    2 FA-LINE-NO           (N3)
    2 FA-LOCATION-ID       (N6)
    2 FA-LOCATION-TYPE     (A1)
    2 FA-QTY-ALLOCATED     (N6)
    2 FA-STATUS            (A2)    /* AL=ALLOCATED PK=PICKED PD=PACKED SH=SHIPPED */
    2 FA-ALLOC-DATE        (D)
    2 FA-ALLOC-BY          (A8)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
RESET #LINES-ALLOCATED
RESET #LINES-FAILED
*
* GET ORDER DETAILS
FIND ALO-VIEW WITH ALO-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 804 TO P-RC
    MOVE 'ORDER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  IF ALO-STATUS NE 'PAD' AND ALO-STATUS NE 'CON'
    MOVE 810 TO P-RC
    COMPRESS 'ORDER STATUS' ALO-STATUS 'NOT ALLOCATABLE'
      INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  MOVE ALO-STORE-ID TO #STORE-ID
  MOVE ALO-TYPE     TO #ORDER-TYPE
  MOVE ALO-PRIORITY TO #PRIORITY
  ESCAPE BOTTOM
END-FIND
*
* ALLOCATE EACH ORDER LINE
FIND ALL-VIEW WITH ALL-ORDER-ID = P-ORDER-ID
  IF ALL-STATUS = 'CAN'
    ESCAPE TOP
  END-IF
*
  * DETERMINE ALLOCATION LOCATION
  1 #ALLOC-LOC (N6)
  1 #ALLOC-TYPE (A1)
  IF P-ALLOC-MODE = 'MANU' AND P-LOCATION-ID > 0
    MOVE P-LOCATION-ID TO #ALLOC-LOC
    MOVE 'W' TO #ALLOC-TYPE
  ELSE
    * AUTO: USE STORE FOR STORE ORDERS, WAREHOUSE OTHERWISE
    IF #ORDER-TYPE = 'ST' AND #STORE-ID > 0
      MOVE #STORE-ID TO #ALLOC-LOC
      MOVE 'S' TO #ALLOC-TYPE
    ELSE
      * FIND BEST WAREHOUSE (MOST STOCK)
      * SIMPLIFIED: USE DEFAULT WAREHOUSE
      MOVE 1 TO #ALLOC-LOC
      MOVE 'W' TO #ALLOC-TYPE
    END-IF
  END-IF
*
  * CONVERT RESERVATION TO ALLOCATION
  CALLNAT 'INVUPD'
    ALL-PROD-ID ALL-SKU #ALLOC-LOC #ALLOC-TYPE
    ALL-QTY-ORDERED
    'ALLC' 'ORDER ALLOCATION' P-ORDER-ID ALL-LINE-NO
    #INV-RC #INV-MSG
*
  IF #INV-RC = 0
    * CREATE FULFILLMENT ALLOCATION RECORD
    STORE FA-VIEW
      FA-ORDER-ID      := P-ORDER-ID
      FA-LINE-NO       := ALL-LINE-NO
      FA-LOCATION-ID   := #ALLOC-LOC
      FA-LOCATION-TYPE := #ALLOC-TYPE
      FA-QTY-ALLOCATED := ALL-QTY-ORDERED
      FA-STATUS        := 'AL'
      FA-ALLOC-DATE    := #TODAY
      FA-ALLOC-BY      := #USER-ID
    END-STORE
    ADD 1 TO #LINES-ALLOCATED
  ELSE
    ADD 1 TO #LINES-FAILED
    CALLNAT 'LOGERR' 801 #INV-MSG 'W' 'ALLOCATE' #USER-ID
  END-IF
*
END-FIND
*
END OF TRANSACTION
*
* UPDATE ORDER STATUS IF ALL ALLOCATED
IF #LINES-FAILED = 0 AND #LINES-ALLOCATED > 0
  CALLNAT 'ORDPOST' P-ORDER-ID 'ALC' #POST-FLAG #POST-MSG
  IF #POST-FLAG NE 'Y'
    CALLNAT 'LOGERR' 802 #POST-MSG 'W' 'ALLOCATE' #USER-ID
  END-IF
ELSE IF #LINES-FAILED > 0
  MOVE 801 TO P-RC
  COMPRESS #LINES-FAILED 'LINES FAILED ALLOCATION' INTO P-RC-TEXT
END-IF
END-IF
*
* AUDIT
MOVE P-ORDER-ID TO #ORD-STR
COMPRESS 'ALLOCATED:' #LINES-ALLOCATED 'FAILED:' #LINES-FAILED
  INTO P-RC-TEXT
CALLNAT 'AUDITN' 'ORD' #ORD-STR 'U' 'ALLOC'
  ' ' ' ' P-RC-TEXT
IF #LINES-FAILED = 0
  RESET P-RC-TEXT
END-IF
*
END
