* >Natural Source Code: PAY-COPY
* RETAILCORE - PAYMENT AND FULFILLMENT DATA DEFINITIONS
* SHARED BY PAYMENT AND FULFILLMENT PROGRAMS
* CREATED: 1999-03-01
* MODIFIED: 2010-07-15 - ADDED PAYMENT GATEWAY FIELDS
* MODIFIED: 2016-12-01 - ADDED SHIPMENT TRACKING
* MODIFIED: 2020-09-20 - ADDED GIFT CARD PAYMENT
* MODIFIED: 2023-02-28 - ADDED DIGITAL WALLET
* -------------------------------------------------------
*
* PAYMENT RECORD
*
1 PAYMENT-DATA
  2 PAY-ID                (N10)   /* PAYMENT IDENTIFIER */
  2 PAY-ORDER-ID          (N10)   /* ORDER REFERENCE */
  2 PAY-CUST-ID           (N8)    /* CUSTOMER */
  2 PAY-METHOD            (A3)    /* CC=CREDIT DC=DEBIT GC=GIFT CH=CHECK */
                                   /* CA=CASH WL=WALLET PP=PAYPAL */
  2 PAY-STATUS            (A2)    /* IN=INITIATED AU=AUTHORIZED CA=CAPTURED */
                                   /* FL=FAILED RV=REVERSED RF=REFUNDED ST=SETTLED */
  2 PAY-AMOUNT            (N11.2) /* PAYMENT AMOUNT */
  2 PAY-CURRENCY          (A3)    /* CURRENCY */
  2 PAY-DATE              (D)     /* PAYMENT DATE */
  2 PAY-TIME              (T)     /* PAYMENT TIMESTAMP */
*
* PAYMENT CARD INFO (MASKED)
*
1 PAYMENT-CARD
  2 PAY-CARD-TYPE         (A2)    /* VI=VISA MC=MASTER AX=AMEX DI=DISCOVER */
  2 PAY-CARD-LAST4        (A4)    /* LAST 4 DIGITS */
  2 PAY-CARD-EXPIRY       (A5)    /* MM/YY */
  2 PAY-CARD-NAME         (A40)   /* CARDHOLDER NAME */
*
* PAYMENT GATEWAY
*
1 PAYMENT-GATEWAY
  2 PAY-GW-REF            (A30)   /* GATEWAY REFERENCE */
  2 PAY-GW-AUTH-CODE      (A10)   /* AUTHORIZATION CODE */
  2 PAY-GW-RESPONSE       (A4)    /* APRV DECL PEND ERR */
  2 PAY-GW-REASON-CODE    (A4)    /* DECLINE REASON */
  2 PAY-GW-REASON-TEXT    (A60)
  2 PAY-GW-ATTEMPTS       (N2)    /* NUMBER OF ATTEMPTS */
  2 PAY-GW-LAST-ATTEMPT   (T)     /* LAST ATTEMPT TIME */
*
* PAYMENT SETTLEMENT
*
1 PAYMENT-SETTLEMENT
  2 PAY-SETTLE-DATE       (D)     /* SETTLEMENT DATE */
  2 PAY-SETTLE-BATCH      (A12)   /* SETTLEMENT BATCH ID */
  2 PAY-SETTLE-STATUS     (A1)    /* P=PENDING S=SETTLED F=FAILED */
  2 PAY-SETTLE-AMT        (N11.2) /* SETTLED AMOUNT */
*
* REFUND RECORD
*
1 REFUND-DATA
  2 REF-ID                (N10)   /* REFUND IDENTIFIER */
  2 REF-PAY-ID            (N10)   /* ORIGINAL PAYMENT */
  2 REF-ORDER-ID          (N10)   /* ORIGINAL ORDER */
  2 REF-RETURN-ID         (N10)   /* RETURN REFERENCE */
  2 REF-AMOUNT            (N11.2) /* REFUND AMOUNT */
  2 REF-METHOD            (A3)    /* SAME AS PAY-METHOD OR SC=STORE CREDIT */
  2 REF-STATUS            (A2)    /* PE=PENDING AP=APPROVED PR=PROCESSED FL=FAILED */
  2 REF-REASON            (A4)    /* RETN CANC DMGD WRNG OTHR */
  2 REF-DATE              (D)
  2 REF-PROCESSED-DATE    (D)
  2 REF-PROCESSED-BY      (A8)
*
* SHIPMENT RECORD
*
1 SHIPMENT-DATA
  2 SHIP-ID               (N10)   /* SHIPMENT IDENTIFIER */
  2 SHIP-ORDER-ID         (N10)   /* ORDER REFERENCE */
  2 SHIP-TYPE             (A2)    /* ST=STORE WH=WAREHOUSE DR=DROP SHIP */
  2 SHIP-FROM-LOC-TYPE    (A1)    /* S W */
  2 SHIP-FROM-LOC-ID      (N4)
  2 SHIP-STATUS           (A2)    /* CR=CREATED PK=PACKED SH=SHIPPED IT=IN-TRANSIT */
                                   /* DL=DELIVERED FL=FAILED RT=RETURNED */
  2 SHIP-CARRIER          (A4)    /* UPS FDX USPS DHL */
  2 SHIP-SERVICE          (A4)    /* GND 2DA OVN */
  2 SHIP-TRACKING-NO      (A30)
  2 SHIP-WEIGHT           (N7.3)  /* TOTAL WEIGHT */
  2 SHIP-COST             (N7.2)  /* SHIPPING COST */
  2 SHIP-CREATE-DATE      (D)
  2 SHIP-SHIP-DATE        (D)     /* ACTUAL SHIP DATE */
  2 SHIP-EST-DELIVERY     (D)     /* ESTIMATED DELIVERY */
  2 SHIP-ACT-DELIVERY     (D)     /* ACTUAL DELIVERY */
  2 SHIP-NUM-ITEMS        (N4)
*
* SHIPMENT ADDRESS
*
1 SHIPMENT-ADDRESS
  2 SA-NAME               (A60)
  2 SA-ADDR-LINE1         (A40)
  2 SA-ADDR-LINE2         (A40)
  2 SA-CITY               (A30)
  2 SA-STATE              (A2)
  2 SA-ZIP                (A10)
  2 SA-COUNTRY            (A3)
*
* FULFILLMENT ALLOCATION
*
1 FULFILLMENT-DATA
  2 FUL-ORDER-ID          (N10)   /* ORDER */
  2 FUL-LINE-NO           (N3)    /* ORDER LINE */
  2 FUL-PROD-ID           (N8)    /* PRODUCT */
  2 FUL-SKU               (A15)   /* SKU */
  2 FUL-QTY               (N6)    /* FULFILLMENT QTY */
  2 FUL-LOC-TYPE          (A1)    /* S W */
  2 FUL-LOC-ID            (N4)    /* FULFILLMENT LOCATION */
  2 FUL-STATUS            (A2)    /* AL=ALLOCATED PK=PICKING PD=PACKED SH=SHIPPED */
  2 FUL-SHIP-ID           (N10)   /* SHIPMENT REFERENCE */
  2 FUL-PRIORITY          (N1)    /* 1=URGENT */
  2 FUL-ALLOC-DATE        (D)
  2 FUL-PICK-DATE         (D)
  2 FUL-SHIP-DATE         (D)
*
END-DEFINE
