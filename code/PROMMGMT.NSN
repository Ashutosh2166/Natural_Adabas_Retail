* >Natural Source Code: PROMMGMT
* SUBPROGRAM: PROMMGMT - PROMOTION MANAGEMENT
* DESCRIPTION: CREATE, UPDATE, ACTIVATE, DEACTIVATE PROMOTIONS
* LIBRARY: RETAILCORE
* ADABAS FILE: 121 (PROMOTION), 122 (PROMOTION-ITEM)
* CREATED: 2007-06-10  S. MARTINEZ
* MODIFIED: 2013-04-15 - ADDED ITEM MANAGEMENT
* MODIFIED: 2019-11-22 - ADDED CLONE FUNCTION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-OPERATION           (A4)    /* CREA UPD ACT DEAC CLON ITEM */
  1 P-PROMO-ID            (N8)
  1 P-PROMO-DATA
    2 P-PD-NAME           (A40)
    2 P-PD-TYPE           (A2)
    2 P-PD-VALUE          (N9.2)
    2 P-PD-MIN-QTY        (N6)
    2 P-PD-MIN-AMT        (N9.2)
    2 P-PD-START-DATE     (D)
    2 P-PD-END-DATE       (D)
    2 P-PD-STORE-ID       (N4)
    2 P-PD-STACKABLE      (A1)
    2 P-PD-PRIORITY       (N2)
    2 P-PD-MAX-USES       (N6)
  1 P-ITEM-DATA
    2 P-IT-PROD-ID        (N8)
    2 P-IT-SKU            (A15)
    2 P-IT-CATEGORY       (A10)
    2 P-IT-INCLUDE        (A1)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #NEW-PROMO-ID         (N10)
  1 #VALID-FLAG           (A1)
  1 #ERROR-MSG            (A60)
  1 #ORD-STR              (A15)
*
  1 PMG-VIEW VIEW OF PROMOTION-FILE
    2 PMG-ID               (N8)
    2 PMG-NAME             (A40)
    2 PMG-TYPE             (A2)
    2 PMG-VALUE            (N9.2)
    2 PMG-MIN-QTY          (N6)
    2 PMG-MIN-ORDER-AMT    (N9.2)
    2 PMG-START-DATE       (D)
    2 PMG-END-DATE         (D)
    2 PMG-STATUS           (A1)
    2 PMG-STACKABLE        (A1)
    2 PMG-PRIORITY         (N2)
    2 PMG-STORE-ID         (N4)
    2 PMG-MAX-USES         (N6)
    2 PMG-CURRENT-USES     (N6)
    2 PMG-CREATED-BY       (A8)
    2 PMG-CREATED-DATE     (D)
    2 PMG-MODIFIED-BY      (A8)
    2 PMG-MODIFIED-DATE    (D)
*
  1 PIG-VIEW VIEW OF PROMO-ITEM-FILE
    2 PIG-PROMO-ID         (N8)
    2 PIG-PROD-ID          (N8)
    2 PIG-SKU              (A15)
    2 PIG-CATEGORY         (A10)
    2 PIG-INCLUDE-FLAG     (A1)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
*
DECIDE ON FIRST VALUE OF P-OPERATION
  VALUE 'CREA'
    PERFORM CREATE-PROMO
  VALUE 'UPD'
    PERFORM UPDATE-PROMO
  VALUE 'ACT'
    PERFORM ACTIVATE-PROMO
  VALUE 'DEAC'
    PERFORM DEACTIVATE-PROMO
  VALUE 'CLON'
    PERFORM CLONE-PROMO
  VALUE 'ITEM'
    PERFORM ADD-PROMO-ITEM
  NONE VALUE
    MOVE 405 TO P-RC
    MOVE 'INVALID PROMOTION OPERATION' TO P-RC-TEXT
END-DECIDE
*
* -------------------------------------------------------
DEFINE SUBROUTINE CREATE-PROMO
  * VALIDATE
  CALLNAT 'PROMVAL'
    0 P-PD-NAME P-PD-TYPE P-PD-VALUE
    P-PD-START-DATE P-PD-END-DATE P-PD-STORE-ID
    P-PD-MAX-USES P-PD-STACKABLE
    #VALID-FLAG #ERROR-MSG
  IF #VALID-FLAG = 'N'
    MOVE 501 TO P-RC
    MOVE #ERROR-MSG TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * GENERATE ID
  CALLNAT 'SEQNON' 'PROM' #NEW-PROMO-ID
  MOVE #NEW-PROMO-ID TO P-PROMO-ID
*
  STORE PMG-VIEW
    PMG-ID             := P-PROMO-ID
    PMG-NAME           := P-PD-NAME
    PMG-TYPE           := P-PD-TYPE
    PMG-VALUE          := P-PD-VALUE
    PMG-MIN-QTY        := P-PD-MIN-QTY
    PMG-MIN-ORDER-AMT  := P-PD-MIN-AMT
    PMG-START-DATE     := P-PD-START-DATE
    PMG-END-DATE       := P-PD-END-DATE
    PMG-STATUS         := 'I'
    PMG-STACKABLE      := P-PD-STACKABLE
    PMG-PRIORITY       := P-PD-PRIORITY
    PMG-STORE-ID       := P-PD-STORE-ID
    PMG-MAX-USES       := P-PD-MAX-USES
    PMG-CURRENT-USES   := 0
    PMG-CREATED-BY     := #USER-ID
    PMG-CREATED-DATE   := #TODAY
    PMG-MODIFIED-BY    := #USER-ID
    PMG-MODIFIED-DATE  := #TODAY
  END-STORE
  END OF TRANSACTION
*
  MOVE P-PROMO-ID TO #ORD-STR
  CALLNAT 'AUDITN' 'PROM' #ORD-STR 'C' 'PROMO'
    ' ' P-PD-NAME 'PROMOTION CREATED'
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE UPDATE-PROMO
  FIND PMG-VIEW WITH PMG-ID = P-PROMO-ID
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'PROMOTION NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    IF PMG-STATUS = 'A'
      * CANNOT UPDATE ACTIVE PROMO (MUST DEACTIVATE FIRST)
      MOVE 410 TO P-RC
      MOVE 'CANNOT UPDATE ACTIVE PROMOTION' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
    GET PMG-VIEW *ISN (HOLD)
    IF P-PD-NAME NE ' '
      MOVE P-PD-NAME TO PMG-NAME
    END-IF
    IF P-PD-VALUE > 0
      MOVE P-PD-VALUE TO PMG-VALUE
    END-IF
    IF P-PD-START-DATE > 0
      MOVE P-PD-START-DATE TO PMG-START-DATE
    END-IF
    IF P-PD-END-DATE > 0
      MOVE P-PD-END-DATE TO PMG-END-DATE
    END-IF
    IF P-PD-MIN-QTY > 0
      MOVE P-PD-MIN-QTY TO PMG-MIN-QTY
    END-IF
    MOVE #USER-ID TO PMG-MODIFIED-BY
    MOVE #TODAY TO PMG-MODIFIED-DATE
    UPDATE PMG-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE ACTIVATE-PROMO
  FIND PMG-VIEW WITH PMG-ID = P-PROMO-ID
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'PROMOTION NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    IF PMG-STATUS = 'A'
      MOVE 410 TO P-RC
      MOVE 'PROMOTION ALREADY ACTIVE' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
    * RE-VALIDATE BEFORE ACTIVATION
    CALLNAT 'PROMVAL'
      PMG-ID PMG-NAME PMG-TYPE PMG-VALUE
      PMG-START-DATE PMG-END-DATE PMG-STORE-ID
      PMG-MAX-USES PMG-STACKABLE
      #VALID-FLAG #ERROR-MSG
    IF #VALID-FLAG = 'N'
      MOVE 501 TO P-RC
      MOVE #ERROR-MSG TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
    GET PMG-VIEW *ISN (HOLD)
    MOVE 'A' TO PMG-STATUS
    MOVE #USER-ID TO PMG-MODIFIED-BY
    MOVE #TODAY TO PMG-MODIFIED-DATE
    UPDATE PMG-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
*
  MOVE P-PROMO-ID TO #ORD-STR
  CALLNAT 'AUDITN' 'PROM' #ORD-STR 'U' 'ACTIV'
    'I' 'A' 'PROMOTION ACTIVATED'
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE DEACTIVATE-PROMO
  FIND PMG-VIEW WITH PMG-ID = P-PROMO-ID
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'PROMOTION NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    GET PMG-VIEW *ISN (HOLD)
    MOVE 'I' TO PMG-STATUS
    MOVE #USER-ID TO PMG-MODIFIED-BY
    MOVE #TODAY TO PMG-MODIFIED-DATE
    UPDATE PMG-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE CLONE-PROMO
  * GET SOURCE PROMOTION
  FIND PMG-VIEW WITH PMG-ID = P-PROMO-ID
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'SOURCE PROMOTION NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
*
    CALLNAT 'SEQNON' 'PROM' #NEW-PROMO-ID
*
    1 #CLONE-NAME (A40)
    COMPRESS 'COPY-' PMG-NAME INTO #CLONE-NAME
*
    STORE PMG-VIEW
      PMG-ID             := #NEW-PROMO-ID
      PMG-NAME           := #CLONE-NAME
      PMG-TYPE           := PMG-TYPE
      PMG-VALUE          := PMG-VALUE
      PMG-MIN-QTY        := PMG-MIN-QTY
      PMG-MIN-ORDER-AMT  := PMG-MIN-ORDER-AMT
      PMG-START-DATE     := P-PD-START-DATE
      PMG-END-DATE       := P-PD-END-DATE
      PMG-STATUS         := 'I'
      PMG-STACKABLE      := PMG-STACKABLE
      PMG-PRIORITY       := PMG-PRIORITY
      PMG-STORE-ID       := PMG-STORE-ID
      PMG-MAX-USES       := PMG-MAX-USES
      PMG-CURRENT-USES   := 0
      PMG-CREATED-BY     := #USER-ID
      PMG-CREATED-DATE   := #TODAY
      PMG-MODIFIED-BY    := #USER-ID
      PMG-MODIFIED-DATE  := #TODAY
    END-STORE
*
    * CLONE ITEMS
    FIND PIG-VIEW WITH PIG-PROMO-ID = P-PROMO-ID
      STORE PIG-VIEW
        PIG-PROMO-ID     := #NEW-PROMO-ID
        PIG-PROD-ID      := PIG-PROD-ID
        PIG-SKU          := PIG-SKU
        PIG-CATEGORY     := PIG-CATEGORY
        PIG-INCLUDE-FLAG := PIG-INCLUDE-FLAG
      END-STORE
    END-FIND
*
    END OF TRANSACTION
    MOVE #NEW-PROMO-ID TO P-PROMO-ID
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE ADD-PROMO-ITEM
  IF P-PROMO-ID = 0
    MOVE 405 TO P-RC
    MOVE 'PROMOTION ID REQUIRED' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  * VERIFY PROMO EXISTS
  FIND PMG-VIEW WITH PMG-ID = P-PROMO-ID
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'PROMOTION NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    ESCAPE BOTTOM
  END-FIND
*
  IF P-IT-INCLUDE NE 'Y' AND P-IT-INCLUDE NE 'N'
    MOVE 'Y' TO P-IT-INCLUDE
  END-IF
*
  STORE PIG-VIEW
    PIG-PROMO-ID     := P-PROMO-ID
    PIG-PROD-ID      := P-IT-PROD-ID
    PIG-SKU          := P-IT-SKU
    PIG-CATEGORY     := P-IT-CATEGORY
    PIG-INCLUDE-FLAG := P-IT-INCLUDE
  END-STORE
  END OF TRANSACTION
END-SUBROUTINE
*
END
