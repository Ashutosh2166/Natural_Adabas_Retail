* >Natural diffance file: COMMON-COPY
* RETAILCORE - COMMON DATA DEFINITIONS
* SHARED ACROSS ALL MODULES
* CREATED: 1998-03-15
* MODIFIED: 2019-06-22 - ADDED BATCH-CONTROL FIELDS
* MODIFIED: 2023-01-10 - ADDED AUDIT TRAIL FIELDS
* -------------------------------------------------------
*
* SYSTEM-WIDE RETURN CODES
*
1 COMMON-RETURN-DATA
  2 RC                    (N4)   /* RETURN CODE
  2 RC-TEXT               (A80)  /* RETURN CODE TEXT
  2 RC-SEVERITY           (A1)   /* I=INFO W=WARN E=ERROR F=FATAL
  2 RC-MODULE             (A8)   /* MODULE THAT SET THE CODE
  2 RC-TIMESTAMP          (T)    /* WHEN ERROR OCCURRED
*
* SYSTEM CONTROL FLAGS
*
1 SYSTEM-CONTROL
  2 ONLINE-FLAG           (A1)   /* Y=ONLINE N=BATCH
  2 DEBUG-FLAG            (A1)   /* Y=DEBUG MODE
  2 TRACE-FLAG            (A1)   /* Y=TRACE CALLS
  2 BATCH-RUN-ID          (A12)  /* BATCH RUN IDENTIFIER
  2 BATCH-DATE            (D)    /* BATCH PROCESSING DATE
  2 SYSTEM-DATE           (D)    /* CURRENT SYSTEM DATE
  2 SYSTEM-TIME           (T)    /* CURRENT SYSTEM TIMESTAMP
  2 SYSTEM-USER           (A8)   /* CURRENT USER ID
  2 SYSTEM-TERMINAL       (A8)   /* TERMINAL ID
*
* AUDIT TRAIL FIELDS
*
1 AUDIT-DATA
  2 AUDIT-USER            (A8)   /* USER WHO MADE CHANGE
  2 AUDIT-DATE            (D)    /* DATE OF CHANGE
  2 AUDIT-TIME            (T)    /* TIME OF CHANGE
  2 AUDIT-ACTION          (A1)   /* C=CREATE U=UPDATE D=DELETE
  2 AUDIT-PROGRAM         (A8)   /* PROGRAM NAME
  2 AUDIT-BEFORE-IMAGE    (A250) /* BEFORE VALUE
  2 AUDIT-AFTER-IMAGE     (A250) /* AFTER VALUE
*
* PAGINATION CONTROL
*
1 PAGE-CONTROL
  2 PAGE-NUMBER           (N5)
  2 PAGE-SIZE             (N3)
  2 TOTAL-RECORDS         (N8)
  2 TOTAL-PAGES           (N5)
  2 MORE-RECORDS-FLAG     (A1)   /* Y=MORE N=NO MORE
*
* STANDARD STATUS CODES
*
1 STATUS-CODES
  2 ACTIVE-STATUS         (A1)   INIT <'A'>
  2 INACTIVE-STATUS       (A1)   INIT <'I'>
  2 DELETED-STATUS        (A1)   INIT <'D'>
  2 SUSPENDED-STATUS      (A1)   INIT <'S'>
  2 PENDING-STATUS        (A1)   INIT <'P'>
*
* CONFIRMATION FLAGS
*
1 CONFIRM-FLAGS
  2 YES-FLAG              (A1)   INIT <'Y'>
  2 NO-FLAG               (A1)   INIT <'N'>
*
END-DEFINE
