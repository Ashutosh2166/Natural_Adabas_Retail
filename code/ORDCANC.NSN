* >Natural Source Code: ORDCANC
* SUBPROGRAM: ORDCANC - ORDER CANCELLATION
* DESCRIPTION: HANDLES FULL OR PARTIAL ORDER CANCELLATION
*              RELEASES INVENTORY, REVERSES PAYMENTS,
*              UPDATES CUSTOMER SPEND
* LIBRARY: RETAILCORE
* ADABAS FILES: 111 (ORDER), 112 (ORDER-LINE)
* CREATED: 1999-06-20  A. GARCIA
* MODIFIED: 2005-04-15 - ADDED PARTIAL CANCELLATION
* MODIFIED: 2012-09-10 - ADDED PAYMENT REVERSAL
* MODIFIED: 2018-03-22 - ADDED REFUND TRIGGER
* MODIFIED: 2023-01-15 - ADDED CANCELLATION REASON
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-CANCEL-TYPE         (A1)     /* F=FULL, P=PARTIAL */
  1 P-LINE-NO             (N3)     /* FOR PARTIAL ONLY */
  1 P-REASON-CODE         (A4)
  1 P-REASON-TEXT         (A60)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #CURRENT-STATUS       (A3)
  1 #ORDER-TOTAL          (N11.2)
  1 #CANCEL-AMT           (N11.2)
  1 #LINE-TOTAL           (N11.2)
  1 #PAID-AMT             (N11.2)
  1 #REFUND-AMT           (N11.2)
  1 #ORD-STR              (A15)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #PAY-RC               (N4)
  1 #PAY-MSG              (A80)
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A60)
  1 #LINE-COUNT           (N3)
  1 #CANC-COUNT           (N3)
  1 #VALID-REASONS (8)
    2 #VR-CODE             (A4)
*
  1 OC-VIEW VIEW OF ORDER-FILE
    2 OC-ID                (N10)
    2 OC-STATUS            (A3)
    2 OC-CUST-ID           (N8)
    2 OC-TOTAL-AMT         (N11.2)
    2 OC-PAID-AMT          (N11.2)
    2 OC-NUM-LINES         (N3)
*
  1 LC-VIEW VIEW OF ORDER-LINE-FILE
    2 LC-ORDER-ID          (N10)
    2 LC-LINE-NO           (N3)
    2 LC-PROD-ID           (N8)
    2 LC-SKU               (A15)
    2 LC-QTY-ORDERED       (N6)
    2 LC-QTY-CANCELLED     (N6)
    2 LC-LINE-TOTAL        (N11.2)
    2 LC-STATUS            (A3)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET P-RC-TEXT
*
* VALID CANCELLATION REASONS
MOVE 'CUST' TO #VALID-REASONS.#VR-CODE(1)
MOVE 'DUPE' TO #VALID-REASONS.#VR-CODE(2)
MOVE 'FRAU' TO #VALID-REASONS.#VR-CODE(3)
MOVE 'OOST' TO #VALID-REASONS.#VR-CODE(4)
MOVE 'PRCE' TO #VALID-REASONS.#VR-CODE(5)
MOVE 'SHIP' TO #VALID-REASONS.#VR-CODE(6)
MOVE 'OTHR' TO #VALID-REASONS.#VR-CODE(7)
MOVE 'ADMN' TO #VALID-REASONS.#VR-CODE(8)
*
* VALIDATE REASON CODE
1 #RV (N2)
1 #REASON-VALID (A1)
MOVE 'N' TO #REASON-VALID
FOR #RV = 1 TO 8
  IF P-REASON-CODE = #VALID-REASONS.#VR-CODE(#RV)
    MOVE 'Y' TO #REASON-VALID
  END-IF
END-FOR
IF #REASON-VALID NE 'Y'
  MOVE 401 TO P-RC
  MOVE 'INVALID CANCELLATION REASON CODE' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* GET ORDER
FIND OC-VIEW WITH OC-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 404 TO P-RC
    MOVE 'ORDER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE OC-STATUS    TO #CURRENT-STATUS
  MOVE OC-TOTAL-AMT TO #ORDER-TOTAL
  MOVE OC-PAID-AMT  TO #PAID-AMT
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE CANCELLABLE STATUS
IF #CURRENT-STATUS = 'CAN'
  MOVE 410 TO P-RC
  MOVE 'ORDER ALREADY CANCELLED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
IF #CURRENT-STATUS = 'CMP'
  MOVE 411 TO P-RC
  MOVE 'COMPLETED ORDER CANNOT BE CANCELLED - USE RETURN' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
IF #CURRENT-STATUS = 'SHP'
  MOVE 412 TO P-RC
  MOVE 'SHIPPED ORDER CANNOT BE CANCELLED - USE RETURN' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST VALUE OF P-CANCEL-TYPE
  VALUE 'F'
    PERFORM FULL-CANCEL
  VALUE 'P'
    PERFORM PARTIAL-CANCEL
  NONE VALUE
    MOVE 405 TO P-RC
    MOVE 'INVALID CANCEL TYPE (F=FULL P=PARTIAL)' TO P-RC-TEXT
END-DECIDE
*
* -------------------------------------------------------
DEFINE SUBROUTINE FULL-CANCEL
*
  RESET #CANCEL-AMT
*
  * CANCEL ALL LINES
  FIND LC-VIEW WITH LC-ORDER-ID = P-ORDER-ID
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    IF LC-STATUS NE 'CAN'
      GET LC-VIEW *ISN (HOLD)
      MOVE 'CAN' TO LC-STATUS
      MOVE LC-QTY-ORDERED TO LC-QTY-CANCELLED
      ADD LC-LINE-TOTAL TO #CANCEL-AMT
      UPDATE LC-VIEW
*
      * RELEASE INVENTORY FOR EACH LINE
      CALLNAT 'INVREL' 0 P-ORDER-ID LC-QTY-ORDERED
        ' ' #INV-RC #INV-MSG
      IF #INV-RC NE 0
        CALLNAT 'LOGERR' 301 #INV-MSG 'W' 'ORDCANC' #USER-ID
      END-IF
    END-IF
  END-FIND
*
  * UPDATE ORDER STATUS
  CALLNAT 'ORDPOST' P-ORDER-ID 'CAN' #POST-FLAG #POST-MSG
  IF #POST-FLAG NE 'Y'
    MOVE 420 TO P-RC
    MOVE #POST-MSG TO P-RC-TEXT
    BACKOUT TRANSACTION
    ESCAPE ROUTINE
  END-IF
*
  END OF TRANSACTION
*
  * REVERSE PAYMENT IF ANY
  IF #PAID-AMT > 0
    PERFORM REVERSE-PAYMENT
  END-IF
*
  * UPDATE CUSTOMER SPEND (SUBTRACT)
  FIND OC-VIEW WITH OC-ID = P-ORDER-ID
    CALLNAT 'CUSTUPD' OC-CUST-ID 'SPND' ' ' 0 ' '
      (0 - #CANCEL-AMT) *DATX 0 ' '
    ESCAPE BOTTOM
  END-FIND
*
  * AUDIT
  MOVE P-ORDER-ID TO #ORD-STR
  CALLNAT 'AUDITN' 'ORD' #ORD-STR 'U' 'CANCEL'
    #CURRENT-STATUS 'CAN' P-REASON-TEXT
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE PARTIAL-CANCEL
*
  IF P-LINE-NO = 0
    MOVE 405 TO P-RC
    MOVE 'LINE NUMBER REQUIRED FOR PARTIAL CANCEL' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  FIND LC-VIEW WITH LC-ORDER-ID = P-ORDER-ID
      AND LC-LINE-NO = P-LINE-NO
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'ORDER LINE NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    IF LC-STATUS = 'CAN'
      MOVE 410 TO P-RC
      MOVE 'LINE ALREADY CANCELLED' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-IF
    GET LC-VIEW *ISN (HOLD)
    MOVE 'CAN' TO LC-STATUS
    MOVE LC-QTY-ORDERED TO LC-QTY-CANCELLED
    MOVE LC-LINE-TOTAL TO #LINE-TOTAL
    UPDATE LC-VIEW
*
    * RELEASE INVENTORY FOR THIS LINE
    CALLNAT 'INVREL' 0 P-ORDER-ID LC-QTY-ORDERED
      ' ' #INV-RC #INV-MSG
    ESCAPE BOTTOM
  END-FIND
*
  * CHECK IF ALL LINES NOW CANCELLED
  RESET #LINE-COUNT
  RESET #CANC-COUNT
  FIND LC-VIEW WITH LC-ORDER-ID = P-ORDER-ID
    ADD 1 TO #LINE-COUNT
    IF LC-STATUS = 'CAN'
      ADD 1 TO #CANC-COUNT
    END-IF
  END-FIND
*
  IF #LINE-COUNT = #CANC-COUNT
    * ALL LINES CANCELLED - CANCEL WHOLE ORDER
    CALLNAT 'ORDPOST' P-ORDER-ID 'CAN' #POST-FLAG #POST-MSG
  ELSE
    * UPDATE ORDER TOTALS
    FIND OC-VIEW WITH OC-ID = P-ORDER-ID
      GET OC-VIEW *ISN (HOLD)
      SUBTRACT #LINE-TOTAL FROM OC-TOTAL-AMT
      UPDATE OC-VIEW
      ESCAPE BOTTOM
    END-FIND
  END-IF
*
  END OF TRANSACTION
*
  * AUDIT
  MOVE P-ORDER-ID TO #ORD-STR
  COMPRESS 'LINE' P-LINE-NO 'CANCELLED:' P-REASON-TEXT
    INTO P-RC-TEXT
  CALLNAT 'AUDITN' 'ORDL' #ORD-STR 'U' 'LCANC'
    ' ' ' ' P-RC-TEXT
  RESET P-RC-TEXT
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE REVERSE-PAYMENT
* MODIFIED 2012-09-10
*
  MOVE #PAID-AMT TO #REFUND-AMT
  CALLNAT 'PAYREV'
    P-ORDER-ID #REFUND-AMT 'CANC' P-REASON-CODE
    #PAY-RC #PAY-MSG
  IF #PAY-RC NE 0
    * LOG ERROR BUT DON'T FAIL CANCELLATION
    CALLNAT 'LOGERR' 700 #PAY-MSG 'W' 'ORDCANC' #USER-ID
  END-IF
*
END-SUBROUTINE
*
END
