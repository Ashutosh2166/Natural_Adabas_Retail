* >Natural Source Code: ORDDUP
* SUBPROGRAM: ORDDUP - DUPLICATE ORDER DETECTION
* DESCRIPTION: CHECKS IF CUSTOMER HAS RECENT SIMILAR ORDERS
*              WARNS BUT DOES NOT BLOCK
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER)
* CREATED: 2017-08-22  J. CHEN
* MODIFIED: 2021-02-10 - ADDED TIME WINDOW CONFIG
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-CUST-ID             (N8)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #TODAY                 (D)
  1 #CUTOFF-DATE          (D)
  1 #DUP-WINDOW           (N4)     INIT <30>
  1 #RECENT-COUNT         (N4)
  1 #MAX-RECENT           (N4)     INIT <5>
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 OD-VIEW VIEW OF ORDER-FILE
    2 OD-CUST-ID           (N8)
    2 OD-DATE              (D)
    2 OD-STATUS            (A3)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
MOVE *DATX TO #TODAY
*
* GET DUPLICATE WINDOW FROM CONFIG
CALLNAT 'CONFIGN' 'DUP.ORDER.WINDOW.DAYS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #DUP-WINDOW
END-IF
*
* CALCULATE CUTOFF DATE
MOVE #TODAY TO #CUTOFF-DATE
SUBTRACT #DUP-WINDOW FROM #CUTOFF-DATE (D)
*
* COUNT RECENT NON-CANCELLED ORDERS
RESET #RECENT-COUNT
FIND OD-VIEW WITH OD-CUST-ID = P-CUST-ID
  IF OD-STATUS = 'CAN'
    ESCAPE TOP
  END-IF
  IF OD-DATE >= #CUTOFF-DATE
    ADD 1 TO #RECENT-COUNT
  END-IF
END-FIND
*
* GET MAX RECENT ORDERS THRESHOLD
CALLNAT 'CONFIGN' 'MAX.RECENT.ORDERS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #MAX-RECENT
END-IF
*
IF #RECENT-COUNT >= #MAX-RECENT
  MOVE 'W' TO P-VALID-FLAG
  COMPRESS 'WARNING: CUSTOMER HAS' #RECENT-COUNT
    'ORDERS IN LAST' #DUP-WINDOW 'DAYS'
    INTO P-ERROR-MSG
END-IF
*
END
