* >Natural Source Code: WHVAL
* SUBPROGRAM: WHVAL - WAREHOUSE VALIDATION
* DESCRIPTION: VALIDATES WAREHOUSE AND CAPACITY
* LIBRARY: RETAILCORE
* ADABAS FILE: 104 (WAREHOUSE)
* CREATED: 1999-01-20  D. CHEN
* MODIFIED: 2011-03-15 - ADDED CAPACITY CHECK
* MODIFIED: 2019-10-22 - ADDED MAINTENANCE MODE
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-WH-ID               (N4)
  1 P-CHECK-ACTIVE         (A1)
  1 P-CHECK-CAPACITY       (A1)
  1 P-REQUIRED-CAPACITY    (N10)
  1 P-WH-STATUS            (A1)
  1 P-WH-NAME              (A40)
  1 P-AVAIL-CAPACITY       (N10)
  1 P-VALID-FLAG           (A1)
  1 P-ERROR-MSG            (A60)
*
LOCAL
  1 WH-VAL-VIEW VIEW OF WAREHOUSE-FILE
    2 WV-ID                (N4)
    2 WV-NAME              (A40)
    2 WV-STATUS            (A1)
    2 WV-AVAIL-CAPACITY    (N10)
END-DEFINE
*
MOVE 'N' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
IF P-WH-ID = 0
  MOVE 'WAREHOUSE ID REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
FIND WH-VAL-VIEW WITH WV-ID = P-WH-ID
  IF NO RECORDS FOUND
    MOVE 'WAREHOUSE NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
*
  MOVE WV-STATUS         TO P-WH-STATUS
  MOVE WV-NAME           TO P-WH-NAME
  MOVE WV-AVAIL-CAPACITY TO P-AVAIL-CAPACITY
*
  IF P-CHECK-ACTIVE = 'Y'
    IF WV-STATUS NE 'A'
      COMPRESS 'WAREHOUSE' P-WH-ID 'NOT ACTIVE (STATUS='
        WV-STATUS ')' INTO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  IF P-CHECK-CAPACITY = 'Y'
    IF WV-AVAIL-CAPACITY < P-REQUIRED-CAPACITY
      COMPRESS 'WAREHOUSE' P-WH-ID 'INSUFFICIENT CAPACITY'
        INTO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  MOVE 'Y' TO P-VALID-FLAG
  ESCAPE BOTTOM
END-FIND
*
ON ERROR
  COMPRESS 'DB ERROR:' *ERROR-NR INTO P-ERROR-MSG
END-ERROR
*
END
