* >Natural Source Code: INVREPL
* SUBPROGRAM: INVREPL - INVENTORY REPLENISHMENT
* DESCRIPTION: GENERATES REPLENISHMENT REQUESTS WHEN
*              INVENTORY FALLS BELOW REORDER LEVEL
*              CREATES PURCHASE ORDERS VIA PROCUREMENT
* LIBRARY: RETAILCORE
* ADABAS FILES: 105 (INVENTORY), 110 (REPLENISHMENT)
* CREATED: 2001-06-20  K. PATEL
* MODIFIED: 2008-02-15 - ADDED AUTO-PO CREATION
* MODIFIED: 2016-07-22 - ADDED PRIORITY CALCULATION
* MODIFIED: 2022-11-10 - ADDED MULTI-SUPPLIER FALLBACK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-OPERATION           (A4)    /* CHCK AUTO CREA LINK */
  1 P-PROD-ID             (N8)
  1 P-LOC-TYPE            (A1)
  1 P-LOC-ID              (N4)
  1 P-REPLENISH-ID        (N10)
  1 P-PO-ID               (N10)   /* LINKED PO */
  1 P-ITEMS-PROCESSED     (N6)    /* FOR AUTO MODE */
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #RPL-SEQ              (N10)
  1 #AVAILABLE            (N8)
  1 #REORDER-LEVEL        (N8)
  1 #REORDER-QTY          (N8)
  1 #SAFETY-STOCK         (N8)
  1 #PRIORITY             (N1)
  1 #SUPP-ID              (N6)
  1 #LEAD-TIME            (N3)
  1 #EXPECTED-DATE        (D)
  1 #RPL-STR              (A15)
  1 #ITEMS-COUNT          (N6)
  1 #PO-RC                (N4)
  1 #PO-MSG               (A80)
  1 #INV-RESULT
    2 #IR-ON-HAND         (N8)
    2 #IR-RESERVED        (N8)
    2 #IR-ALLOCATED       (N8)
    2 #IR-DAMAGED         (N8)
    2 #IR-IN-TRANSIT      (N8)
    2 #IR-AVAILABLE       (N8)
    2 #IR-SAFETY-STOCK    (N8)
    2 #IR-REORDER-LEVEL   (N8)
    2 #IR-BELOW-SAFETY    (A1)
    2 #IR-BELOW-REORDER   (A1)
    2 #IR-SUFFICIENT      (A1)
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
*
  1 INV-RPL-VIEW VIEW OF INVENTORY-FILE
    2 IP-PROD-ID           (N8)
    2 IP-LOC-TYPE          (A1)
    2 IP-LOC-ID            (N4)
    2 IP-ON-HAND           (N8)
    2 IP-RESERVED          (N8)
    2 IP-ALLOCATED         (N8)
    2 IP-DAMAGED           (N8)
    2 IP-AVAILABLE         (N8)
    2 IP-SAFETY-STOCK      (N8)
    2 IP-REORDER-LEVEL     (N8)
    2 IP-REORDER-QTY       (N8)
*
  1 PROD-SUPP-VIEW VIEW OF PRODUCT-FILE
    2 PS-ID                (N8)
    2 PS-PRIMARY-SUPP      (N6)
    2 PS-SECONDARY-SUPP    (N6)
    2 PS-LEAD-TIME         (N3)
    2 PS-REORDER-QTY       (N6)
*
  1 RPL-VIEW VIEW OF REPLENISH-FILE
    2 RP-ID                (N10)
    2 RP-PROD-ID           (N8)
    2 RP-SKU               (A15)
    2 RP-LOC-TYPE          (A1)
    2 RP-LOC-ID            (N4)
    2 RP-QTY               (N8)
    2 RP-STATUS            (A2)
    2 RP-PO-ID             (N10)
    2 RP-PRIORITY          (N1)
    2 RP-REQUEST-DATE      (D)
    2 RP-EXPECTED-DATE     (D)
    2 RP-CREATED-BY        (A8)
END-DEFINE
*
MOVE *USER TO #USER-ID
RESET P-RC
RESET #ITEMS-COUNT
*
DECIDE ON FIRST VALUE OF P-OPERATION
  VALUE 'CHCK'
    * CHECK SINGLE PRODUCT
    PERFORM CHECK-REPLENISHMENT
  VALUE 'AUTO'
    * AUTO-CHECK ALL PRODUCTS AT LOCATION
    PERFORM AUTO-REPLENISHMENT
  VALUE 'LINK'
    * LINK REPLENISHMENT TO PO
    PERFORM LINK-TO-PO
  NONE VALUE
    MOVE 307 TO P-RC
    MOVE 'INVALID REPLENISHMENT OPERATION' TO P-RC-TEXT
END-DECIDE
*
* -------------------------------------------------------
* CHECK SINGLE PRODUCT REPLENISHMENT
* -------------------------------------------------------
DEFINE SUBROUTINE CHECK-REPLENISHMENT
  * GET INVENTORY LEVELS
  CALLNAT 'INVCHK'
    P-PROD-ID ' ' P-LOC-TYPE P-LOC-ID 0
    #INV-RESULT #INV-RC #INV-MSG
*
  IF #IR-BELOW-REORDER NE 'Y'
    * NO REPLENISHMENT NEEDED
    ESCAPE ROUTINE
  END-IF
*
  * GET SUPPLIER AND REORDER INFO
  FIND PROD-SUPP-VIEW WITH PS-ID = P-PROD-ID
    MOVE PS-PRIMARY-SUPP  TO #SUPP-ID
    MOVE PS-LEAD-TIME     TO #LEAD-TIME
    MOVE PS-REORDER-QTY   TO #REORDER-QTY
    ESCAPE BOTTOM
  END-FIND
*
  IF #SUPP-ID = 0
    MOVE 307 TO P-RC
    MOVE 'NO SUPPLIER ASSIGNED TO PRODUCT' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * CALCULATE PRIORITY
  * 1=URGENT (BELOW SAFETY STOCK), 2=HIGH, 3=NORMAL, 4=LOW
  IF #IR-BELOW-SAFETY = 'Y'
    MOVE 1 TO #PRIORITY
  ELSE IF #IR-AVAILABLE < (#IR-REORDER-LEVEL / 2)
    MOVE 2 TO #PRIORITY
  ELSE
    MOVE 3 TO #PRIORITY
  END-IF
  END-IF
*
  * CALCULATE EXPECTED DATE
  COMPUTE #EXPECTED-DATE = *DATX + #LEAD-TIME
*
  * CREATE REPLENISHMENT REQUEST
  CALLNAT 'SEQNON' 'REPL' #RPL-SEQ
  STORE RPL-VIEW
    RP-ID            := #RPL-SEQ
    RP-PROD-ID       := P-PROD-ID
    RP-LOC-TYPE      := P-LOC-TYPE
    RP-LOC-ID        := P-LOC-ID
    RP-QTY           := #REORDER-QTY
    RP-STATUS        := 'PE'
    RP-PRIORITY      := #PRIORITY
    RP-REQUEST-DATE  := *DATX
    RP-EXPECTED-DATE := #EXPECTED-DATE
    RP-CREATED-BY    := #USER-ID
  END-STORE
*
  END OF TRANSACTION
  MOVE #RPL-SEQ TO P-REPLENISH-ID
  ADD 1 TO #ITEMS-COUNT
END-SUBROUTINE
*
* -------------------------------------------------------
* AUTO-REPLENISHMENT FOR ALL PRODUCTS AT LOCATION
* MODIFIED 2008-02-15
* -------------------------------------------------------
DEFINE SUBROUTINE AUTO-REPLENISHMENT
  READ INV-RPL-VIEW BY IP-LOC-TYPE = P-LOC-TYPE
    IF IP-LOC-TYPE NE P-LOC-TYPE
      ESCAPE BOTTOM
    END-IF
    IF P-LOC-ID > 0 AND IP-LOC-ID NE P-LOC-ID
      ESCAPE TOP
    END-IF
*
    * CHECK IF BELOW REORDER
    COMPUTE #AVAILABLE = IP-ON-HAND - IP-RESERVED
      - IP-ALLOCATED - IP-DAMAGED
    IF #AVAILABLE <= IP-REORDER-LEVEL AND IP-REORDER-LEVEL > 0
      MOVE IP-PROD-ID  TO P-PROD-ID
      MOVE IP-LOC-TYPE TO P-LOC-TYPE
      MOVE IP-LOC-ID   TO P-LOC-ID
      PERFORM CHECK-REPLENISHMENT
    END-IF
  END-READ
*
  MOVE #ITEMS-COUNT TO P-ITEMS-PROCESSED
END-SUBROUTINE
*
* -------------------------------------------------------
* LINK REPLENISHMENT TO PURCHASE ORDER
* -------------------------------------------------------
DEFINE SUBROUTINE LINK-TO-PO
  FIND RPL-VIEW WITH RP-ID = P-REPLENISH-ID
    IF NO RECORDS FOUND
      MOVE 307 TO P-RC
      MOVE 'REPLENISHMENT REQUEST NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    GET RPL-VIEW *ISN (HOLD)
    MOVE P-PO-ID TO RP-PO-ID
    MOVE 'OR' TO RP-STATUS   /* ORDERED */
    UPDATE RPL-VIEW
    END OF TRANSACTION
    ESCAPE BOTTOM
  END-FIND
END-SUBROUTINE
*
END
