* >Natural Source Code: PROMVAL
* SUBPROGRAM: PROMVAL - PROMOTION VALIDATION
* DESCRIPTION: VALIDATES PROMOTION DEFINITIONS
*              CHECKS DATES, TYPES, VALUES, CONFLICTS
* LIBRARY: RETAILCORE
* ADABAS FILE: 121 (PROMOTION)
* CREATED: 2007-05-20  S. MARTINEZ
* MODIFIED: 2016-04-10 - ADDED OVERLAP DETECTION
* MODIFIED: 2022-08-15 - ADDED BUDGET CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-PROMO-ID            (N8)
  1 P-PROMO-NAME          (A40)
  1 P-PROMO-TYPE          (A2)
  1 P-PROMO-VALUE         (N9.2)
  1 P-START-DATE          (D)
  1 P-END-DATE            (D)
  1 P-STORE-ID            (N4)
  1 P-MAX-USES            (N6)
  1 P-STACKABLE           (A1)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #TODAY                (D)
  1 #OVERLAP-COUNT        (N4)
  1 #MAX-CONCURRENT       (N4)    INIT <20>
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 PV-VIEW VIEW OF PROMOTION-FILE
    2 PV-ID                (N8)
    2 PV-NAME              (A40)
    2 PV-TYPE              (A2)
    2 PV-START-DATE        (D)
    2 PV-END-DATE          (D)
    2 PV-STATUS            (A1)
    2 PV-STORE-ID          (N4)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
* VALIDATE PROMO NAME
IF P-PROMO-NAME = ' '
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'PROMOTION NAME IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE PROMO TYPE
IF P-PROMO-TYPE NE 'PC' AND P-PROMO-TYPE NE 'AM'
    AND P-PROMO-TYPE NE 'BG' AND P-PROMO-TYPE NE 'FX'
    AND P-PROMO-TYPE NE 'QD'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'INVALID PROMOTION TYPE (PC/AM/BG/FX/QD)' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE VALUE
IF P-PROMO-VALUE <= 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'PROMOTION VALUE MUST BE > 0' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* TYPE-SPECIFIC VALIDATION
IF P-PROMO-TYPE = 'PC'
  IF P-PROMO-VALUE > 100
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'PERCENTAGE DISCOUNT CANNOT EXCEED 100%' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  IF P-PROMO-VALUE > 50
    * WARN BUT ALLOW
    MOVE 'W' TO P-VALID-FLAG
    MOVE 'WARNING: DISCOUNT EXCEEDS 50%' TO P-ERROR-MSG
  END-IF
END-IF
*
* VALIDATE DATES
IF P-START-DATE = 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'START DATE IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-END-DATE = 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'END DATE IS REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-START-DATE > P-END-DATE
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'START DATE MUST BE BEFORE END DATE' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
IF P-END-DATE < #TODAY
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'PROMOTION END DATE IS IN THE PAST' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK MAX PROMOTION DURATION (90 DAYS DEFAULT)
1 #DURATION (N6)
CALLNAT 'DATEU' 'DIFF' P-START-DATE P-END-DATE
  0 ' ' ' ' 0 0 ' ' #DURATION ' '
IF #DURATION > 90
  IF P-VALID-FLAG = 'Y'
    MOVE 'W' TO P-VALID-FLAG
  END-IF
  MOVE 'WARNING: PROMOTION EXCEEDS 90 DAYS' TO P-ERROR-MSG
END-IF
*
* VALIDATE STACKABLE FLAG
IF P-STACKABLE NE 'Y' AND P-STACKABLE NE 'N'
  MOVE 'N' TO P-STACKABLE
END-IF
*
* CHECK FOR DUPLICATE NAME
IF P-PROMO-ID = 0
  * NEW PROMOTION - CHECK NAME UNIQUENESS
  FIND PV-VIEW WITH PV-NAME = P-PROMO-NAME
    IF NO RECORDS FOUND
      IGNORE
    END-NOREC
    IF PV-STATUS = 'A'
      MOVE 'N' TO P-VALID-FLAG
      MOVE 'ACTIVE PROMOTION WITH SAME NAME EXISTS' TO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
    ESCAPE BOTTOM
  END-FIND
END-IF
*
* CHECK CONCURRENT PROMOTION LIMIT
CALLNAT 'CONFIGN' 'MAX.CONCURRENT.PROMOS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #MAX-CONCURRENT
END-IF
*
RESET #OVERLAP-COUNT
FIND PV-VIEW WITH PV-STATUS = 'A'
  IF PV-ID = P-PROMO-ID
    ESCAPE TOP
  END-IF
  * CHECK DATE OVERLAP
  IF PV-START-DATE <= P-END-DATE AND PV-END-DATE >= P-START-DATE
    * CHECK STORE OVERLAP
    IF P-STORE-ID = 0 OR PV-STORE-ID = 0
        OR PV-STORE-ID = P-STORE-ID
      ADD 1 TO #OVERLAP-COUNT
    END-IF
  END-IF
END-FIND
*
IF #OVERLAP-COUNT >= #MAX-CONCURRENT
  MOVE 'N' TO P-VALID-FLAG
  COMPRESS 'MAX CONCURRENT PROMOTIONS REACHED:' #MAX-CONCURRENT
    INTO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
END
