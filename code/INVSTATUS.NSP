* >Natural Source Code: INVSTATUS
* PROGRAM: INVSTATUS - INVENTORY STATUS REPORT
* DESCRIPTION: COMPREHENSIVE INVENTORY STATUS BY LOCATION
*              SHOWS ON-HAND, RESERVED, ALLOCATED, AVAILABLE
*              HIGHLIGHTS LOW STOCK AND OVERSTOCK
* LIBRARY: RETAILCORE
* ADABAS FILE: 105 (INVENTORY)
* CREATED: 2001-03-15  A. GARCIA
* MODIFIED: 2008-09-22 - ADDED LOCATION BREAKDOWN
* MODIFIED: 2015-06-10 - ADDED THRESHOLD INDICATORS
* MODIFIED: 2022-11-15 - ADDED VALUE CALCULATION
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TOTAL-RECORDS        (N8)
  1 #TOTAL-ON-HAND        (N10)
  1 #TOTAL-RESERVED       (N10)
  1 #TOTAL-ALLOCATED      (N10)
  1 #TOTAL-DAMAGED        (N10)
  1 #TOTAL-AVAILABLE      (N10)
  1 #BELOW-SAFETY-COUNT   (N8)
  1 #BELOW-REORDER-COUNT  (N8)
  1 #ZERO-STOCK-COUNT     (N8)
  1 #AVAILABLE            (N8)
  1 #INDICATOR            (A3)
*
  1 ISR-VIEW VIEW OF INVENTORY-FILE
    2 ISR-PROD-ID          (N8)
    2 ISR-SKU              (A15)
    2 ISR-LOCATION-ID      (N6)
    2 ISR-LOCATION-TYPE    (A1)
    2 ISR-ON-HAND          (N8)
    2 ISR-RESERVED         (N8)
    2 ISR-ALLOCATED        (N8)
    2 ISR-DAMAGED          (N8)
    2 ISR-IN-TRANSIT       (N8)
    2 ISR-SAFETY-STOCK     (N8)
    2 ISR-REORDER-LEVEL    (N8)
    2 ISR-STATUS           (A1)
END-DEFINE
*
WRITE 'RETAILCORE - INVENTORY STATUS REPORT'
WRITE '====================================='
WRITE 'RUN DATE:' *DATX
WRITE ' '
WRITE 'PRODUCT  SKU             LOC   TY ON-HAND  RSRVD   ALLOC'
  '   DMGD    AVAIL   SAFETY  REORDER IND'
WRITE '-------- --------------- ----- -- -------- -------'
  ' ------- ------- -------- -------- ------- ---'
*
READ ISR-VIEW BY ISR-PROD-ID
  IF ISR-STATUS NE 'A'
    ESCAPE TOP
  END-IF
  ADD 1 TO #TOTAL-RECORDS
*
  COMPUTE #AVAILABLE = ISR-ON-HAND - ISR-RESERVED
    - ISR-ALLOCATED - ISR-DAMAGED
  IF #AVAILABLE < 0
    MOVE 0 TO #AVAILABLE
  END-IF
*
  ADD ISR-ON-HAND    TO #TOTAL-ON-HAND
  ADD ISR-RESERVED   TO #TOTAL-RESERVED
  ADD ISR-ALLOCATED  TO #TOTAL-ALLOCATED
  ADD ISR-DAMAGED    TO #TOTAL-DAMAGED
  ADD #AVAILABLE     TO #TOTAL-AVAILABLE
*
  * DETERMINE INDICATOR
  MOVE '   ' TO #INDICATOR
  IF ISR-ON-HAND = 0
    MOVE 'OOS' TO #INDICATOR
    ADD 1 TO #ZERO-STOCK-COUNT
  ELSE IF #AVAILABLE < ISR-SAFETY-STOCK
    MOVE '!!!' TO #INDICATOR
    ADD 1 TO #BELOW-SAFETY-COUNT
  ELSE IF #AVAILABLE < ISR-REORDER-LEVEL
    MOVE '!! ' TO #INDICATOR
    ADD 1 TO #BELOW-REORDER-COUNT
  END-IF
  END-IF
  END-IF
*
  WRITE ISR-PROD-ID ISR-SKU ISR-LOCATION-ID ISR-LOCATION-TYPE
    ISR-ON-HAND ISR-RESERVED ISR-ALLOCATED ISR-DAMAGED
    #AVAILABLE ISR-SAFETY-STOCK ISR-REORDER-LEVEL #INDICATOR
*
END-READ
*
WRITE ' '
WRITE '-------- --------------- ----- -- -------- -------'
  ' ------- ------- -------- -------- ------- ---'
WRITE 'TOTALS                         ' #TOTAL-ON-HAND
  #TOTAL-RESERVED #TOTAL-ALLOCATED #TOTAL-DAMAGED #TOTAL-AVAILABLE
WRITE ' '
WRITE 'SUMMARY'
WRITE '======='
WRITE 'TOTAL INVENTORY RECORDS:' #TOTAL-RECORDS
WRITE 'ZERO STOCK (OOS)       :' #ZERO-STOCK-COUNT
WRITE 'BELOW SAFETY STOCK(!!),:' #BELOW-SAFETY-COUNT
WRITE 'BELOW REORDER LEVEL(!) :' #BELOW-REORDER-COUNT
WRITE ' '
WRITE 'LEGEND: OOS=OUT OF STOCK  !!!=BELOW SAFETY  !!=BELOW REORDER'
WRITE ' '
WRITE 'END OF REPORT'
*
END
