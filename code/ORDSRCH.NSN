* >Natural Source Code: ORDSRCH
* SUBPROGRAM: ORDSRCH - ORDER SEARCH
* DESCRIPTION: SEARCHES ORDERS BY VARIOUS CRITERIA
*              CUSTOMER, DATE RANGE, STATUS, STORE
*              RETURNS PAGINATED RESULTS
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER)
* CREATED: 2002-08-10  A. GARCIA
* MODIFIED: 2009-03-15 - ADDED STATUS FILTER
* MODIFIED: 2016-11-22 - ADDED PAGINATION
* MODIFIED: 2022-05-10 - ADDED AMOUNT RANGE
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-SEARCH-PARAMS
    2 P-SP-CUST-ID        (N8)
    2 P-SP-STORE-ID       (N4)
    2 P-SP-STATUS         (A3)
    2 P-SP-TYPE           (A2)
    2 P-SP-FROM-DATE      (D)
    2 P-SP-TO-DATE        (D)
    2 P-SP-MIN-AMT        (N11.2)
    2 P-SP-MAX-AMT        (N11.2)
    2 P-SP-ORDER-NUMBER   (A12)
  1 P-PAGE-NO             (N4)
  1 P-PAGE-SIZE           (N4)
  1 P-TOTAL-FOUND         (N6)
  1 P-RESULTS (25)
    2 P-RS-ID             (N10)
    2 P-RS-NUMBER         (A12)
    2 P-RS-CUST-ID        (N8)
    2 P-RS-STORE-ID       (N4)
    2 P-RS-STATUS         (A3)
    2 P-RS-DATE           (D)
    2 P-RS-TOTAL          (N11.2)
    2 P-RS-PAID           (N11.2)
    2 P-RS-NUM-LINES      (N3)
  1 P-RESULT-COUNT        (N4)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #IDX                  (N4)
  1 #SKIP-COUNT          (N6)
  1 #MATCH-COUNT         (N6)
  1 #MATCH               (A1)
*
  1 OS-VIEW VIEW OF ORDER-FILE
    2 OS-ID                (N10)
    2 OS-NUMBER            (A12)
    2 OS-CUST-ID           (N8)
    2 OS-STORE-ID          (N4)
    2 OS-STATUS            (A3)
    2 OS-TYPE              (A2)
    2 OS-DATE              (D)
    2 OS-TOTAL-AMT         (N11.2)
    2 OS-PAID-AMT          (N11.2)
    2 OS-NUM-LINES         (N3)
END-DEFINE
*
RESET P-RC
RESET P-RC-TEXT
RESET P-RESULT-COUNT
RESET P-TOTAL-FOUND
RESET #IDX
*
IF P-PAGE-SIZE = 0
  MOVE 25 TO P-PAGE-SIZE
END-IF
IF P-PAGE-SIZE > 25
  MOVE 25 TO P-PAGE-SIZE
END-IF
*
* CALCULATE SKIP FOR PAGINATION
IF P-PAGE-NO > 1
  COMPUTE #SKIP-COUNT = (P-PAGE-NO - 1) * P-PAGE-SIZE
ELSE
  MOVE 1 TO P-PAGE-NO
  RESET #SKIP-COUNT
END-IF
*
* SEARCH BY ORDER NUMBER (EXACT MATCH)
IF P-SP-ORDER-NUMBER NE ' '
  FIND OS-VIEW WITH OS-NUMBER = P-SP-ORDER-NUMBER
    IF NO RECORDS FOUND
      MOVE 404 TO P-RC
      MOVE 'ORDER NOT FOUND' TO P-RC-TEXT
      ESCAPE ROUTINE
    END-NOREC
    MOVE 1 TO P-TOTAL-FOUND
    MOVE 1 TO P-RESULT-COUNT
    MOVE OS-ID        TO P-RESULTS.P-RS-ID(1)
    MOVE OS-NUMBER    TO P-RESULTS.P-RS-NUMBER(1)
    MOVE OS-CUST-ID   TO P-RESULTS.P-RS-CUST-ID(1)
    MOVE OS-STORE-ID  TO P-RESULTS.P-RS-STORE-ID(1)
    MOVE OS-STATUS    TO P-RESULTS.P-RS-STATUS(1)
    MOVE OS-DATE      TO P-RESULTS.P-RS-DATE(1)
    MOVE OS-TOTAL-AMT TO P-RESULTS.P-RS-TOTAL(1)
    MOVE OS-PAID-AMT  TO P-RESULTS.P-RS-PAID(1)
    MOVE OS-NUM-LINES TO P-RESULTS.P-RS-NUM-LINES(1)
    ESCAPE BOTTOM
  END-FIND
  ESCAPE ROUTINE
END-IF
*
* SEARCH BY CUSTOMER (PRIMARY PATH)
IF P-SP-CUST-ID > 0
  FIND OS-VIEW WITH OS-CUST-ID = P-SP-CUST-ID
    PERFORM APPLY-FILTERS
    IF #MATCH = 'Y'
      ADD 1 TO #MATCH-COUNT
      IF #SKIP-COUNT > 0
        SUBTRACT 1 FROM #SKIP-COUNT
        ESCAPE TOP
      END-IF
      ADD 1 TO #IDX
      IF #IDX > P-PAGE-SIZE
        ESCAPE BOTTOM
      END-IF
      PERFORM COPY-RESULT
    END-IF
  END-FIND
ELSE IF P-SP-STORE-ID > 0
  * SEARCH BY STORE
  FIND OS-VIEW WITH OS-STORE-ID = P-SP-STORE-ID
    PERFORM APPLY-FILTERS
    IF #MATCH = 'Y'
      ADD 1 TO #MATCH-COUNT
      IF #SKIP-COUNT > 0
        SUBTRACT 1 FROM #SKIP-COUNT
        ESCAPE TOP
      END-IF
      ADD 1 TO #IDX
      IF #IDX > P-PAGE-SIZE
        ESCAPE BOTTOM
      END-IF
      PERFORM COPY-RESULT
    END-IF
  END-FIND
ELSE IF P-SP-STATUS NE ' '
  * SEARCH BY STATUS
  FIND OS-VIEW WITH OS-STATUS = P-SP-STATUS
    PERFORM APPLY-FILTERS
    IF #MATCH = 'Y'
      ADD 1 TO #MATCH-COUNT
      IF #SKIP-COUNT > 0
        SUBTRACT 1 FROM #SKIP-COUNT
        ESCAPE TOP
      END-IF
      ADD 1 TO #IDX
      IF #IDX > P-PAGE-SIZE
        ESCAPE BOTTOM
      END-IF
      PERFORM COPY-RESULT
    END-IF
  END-FIND
ELSE
  * NO SEARCH CRITERIA - SCAN ALL (INEFFICIENT)
  * LEGACY: SHOULD REQUIRE AT LEAST ONE FILTER
  READ OS-VIEW BY OS-DATE
    PERFORM APPLY-FILTERS
    IF #MATCH = 'Y'
      ADD 1 TO #MATCH-COUNT
      IF #SKIP-COUNT > 0
        SUBTRACT 1 FROM #SKIP-COUNT
        ESCAPE TOP
      END-IF
      ADD 1 TO #IDX
      IF #IDX > P-PAGE-SIZE
        ESCAPE BOTTOM
      END-IF
      PERFORM COPY-RESULT
    END-IF
    * SAFETY LIMIT - DON'T SCAN MORE THAN 10000
    IF *COUNTER > 10000
      ESCAPE BOTTOM
    END-IF
  END-READ
END-IF
END-IF
END-IF
*
MOVE #IDX TO P-RESULT-COUNT
MOVE #MATCH-COUNT TO P-TOTAL-FOUND
*
IF P-RESULT-COUNT = 0
  MOVE 404 TO P-RC
  MOVE 'NO ORDERS MATCH SEARCH CRITERIA' TO P-RC-TEXT
END-IF
*
* -------------------------------------------------------
DEFINE SUBROUTINE APPLY-FILTERS
  MOVE 'Y' TO #MATCH
*
  * STATUS FILTER
  IF P-SP-STATUS NE ' '
    IF OS-STATUS NE P-SP-STATUS
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * TYPE FILTER
  IF P-SP-TYPE NE ' '
    IF OS-TYPE NE P-SP-TYPE
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * DATE RANGE
  IF P-SP-FROM-DATE > 0
    IF OS-DATE < P-SP-FROM-DATE
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
  IF P-SP-TO-DATE > 0
    IF OS-DATE > P-SP-TO-DATE
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * AMOUNT RANGE
  IF P-SP-MIN-AMT > 0
    IF OS-TOTAL-AMT < P-SP-MIN-AMT
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
  IF P-SP-MAX-AMT > 0
    IF OS-TOTAL-AMT > P-SP-MAX-AMT
      MOVE 'N' TO #MATCH
      ESCAPE ROUTINE
    END-IF
  END-IF
*
END-SUBROUTINE
*
* -------------------------------------------------------
DEFINE SUBROUTINE COPY-RESULT
  MOVE OS-ID        TO P-RESULTS.P-RS-ID(#IDX)
  MOVE OS-NUMBER    TO P-RESULTS.P-RS-NUMBER(#IDX)
  MOVE OS-CUST-ID   TO P-RESULTS.P-RS-CUST-ID(#IDX)
  MOVE OS-STORE-ID  TO P-RESULTS.P-RS-STORE-ID(#IDX)
  MOVE OS-STATUS    TO P-RESULTS.P-RS-STATUS(#IDX)
  MOVE OS-DATE      TO P-RESULTS.P-RS-DATE(#IDX)
  MOVE OS-TOTAL-AMT TO P-RESULTS.P-RS-TOTAL(#IDX)
  MOVE OS-PAID-AMT  TO P-RESULTS.P-RS-PAID(#IDX)
  MOVE OS-NUM-LINES TO P-RESULTS.P-RS-NUM-LINES(#IDX)
END-SUBROUTINE
*
END
