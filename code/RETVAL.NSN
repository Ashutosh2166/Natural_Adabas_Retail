* >Natural Source Code: RETVAL
* SUBPROGRAM: RETVAL - RETURN VALIDATION
* DESCRIPTION: VALIDATES RETURN REQUEST DATA
*              CHECKS QUANTITIES, REASONS, ELIGIBILITY
* LIBRARY: RETAILCORE
* CREATED: 2003-05-10  A. GARCIA
* MODIFIED: 2015-06-22 - ADDED REASON CODE VALIDATION
* MODIFIED: 2022-01-10 - ADDED NON-RETURNABLE CHECK
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-RETURN-LINE
    2 P-RL-ORDER-LINE-NO  (N3)
    2 P-RL-QTY            (N6)
    2 P-RL-REASON         (A4)
    2 P-RL-CONDITION      (A1)
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #ORDER-QTY            (N6)
  1 #ALREADY-RETURNED     (N6)
  1 #RETURNABLE-QTY       (N6)
  1 #PROD-ID              (N8)
  1 #PROD-RETURNABLE      (A1)
*
  1 VLN-VIEW VIEW OF ORDER-LINE-FILE
    2 VLN-ORDER-ID         (N10)
    2 VLN-LINE-NO          (N3)
    2 VLN-PROD-ID          (N8)
    2 VLN-QTY-ORDERED      (N6)
    2 VLN-STATUS           (A3)
*
  1 VRL-VIEW VIEW OF RETURN-LINE-FILE
    2 VRL-RETURN-ID        (N10)
    2 VRL-ORDER-LINE-NO    (N3)
    2 VRL-QTY-RETURNED     (N6)
    2 VRL-STATUS           (A3)
*
  1 VRH-VIEW VIEW OF RETURN-FILE
    2 VRH-ID               (N10)
    2 VRH-ORDER-ID         (N10)
    2 VRH-STATUS           (A3)
*
* NON-RETURNABLE CATEGORIES (HARDCODED - LEGACY)
  1 #NON-RETURN-CATS (5)
    2 #NR-CAT              (A10)
END-DEFINE
*
MOVE 'Y' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
* VALIDATE REASON CODE
IF P-RL-REASON NE 'DEFN' AND P-RL-REASON NE 'WRNG'
    AND P-RL-REASON NE 'DMGD' AND P-RL-REASON NE 'NOFI'
    AND P-RL-REASON NE 'CHGD' AND P-RL-REASON NE 'OTHR'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'INVALID RETURN REASON CODE' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE CONDITION
IF P-RL-CONDITION NE 'N' AND P-RL-CONDITION NE 'O'
    AND P-RL-CONDITION NE 'D'
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'INVALID RETURN CONDITION (N/O/D)' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* VALIDATE QTY
IF P-RL-QTY <= 0
  MOVE 'N' TO P-VALID-FLAG
  MOVE 'RETURN QUANTITY MUST BE > 0' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* GET ORDER LINE
FIND VLN-VIEW WITH VLN-ORDER-ID = P-ORDER-ID
    AND VLN-LINE-NO = P-RL-ORDER-LINE-NO
  IF NO RECORDS FOUND
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'ORDER LINE NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
  IF VLN-STATUS = 'CAN'
    MOVE 'N' TO P-VALID-FLAG
    MOVE 'CANNOT RETURN CANCELLED LINE' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-IF
  MOVE VLN-QTY-ORDERED TO #ORDER-QTY
  MOVE VLN-PROD-ID TO #PROD-ID
  ESCAPE BOTTOM
END-FIND
*
* CHECK ALREADY RETURNED QTY
RESET #ALREADY-RETURNED
FIND VRH-VIEW WITH VRH-ORDER-ID = P-ORDER-ID
  IF VRH-STATUS = 'REJ' OR VRH-STATUS = 'CLS'
    ESCAPE TOP
  END-IF
  FIND VRL-VIEW WITH VRL-RETURN-ID = VRH-ID
    IF VRL-ORDER-LINE-NO = P-RL-ORDER-LINE-NO
      ADD VRL-QTY-RETURNED TO #ALREADY-RETURNED
    END-IF
  END-FIND
END-FIND
*
COMPUTE #RETURNABLE-QTY = #ORDER-QTY - #ALREADY-RETURNED
IF P-RL-QTY > #RETURNABLE-QTY
  MOVE 'N' TO P-VALID-FLAG
  COMPRESS 'RETURN QTY EXCEEDS RETURNABLE:' #RETURNABLE-QTY
    INTO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
* CHECK NON-RETURNABLE (SIMPLIFIED)
* LEGACY: HARDCODED CATEGORIES
MOVE 'UNDERWEAR' TO #NON-RETURN-CATS.#NR-CAT(1)
MOVE 'SWIMWEAR'  TO #NON-RETURN-CATS.#NR-CAT(2)
MOVE 'EARRINGS'  TO #NON-RETURN-CATS.#NR-CAT(3)
MOVE 'CLEARANCE' TO #NON-RETURN-CATS.#NR-CAT(4)
MOVE 'CUSTOM'    TO #NON-RETURN-CATS.#NR-CAT(5)
* NOTE: SHOULD LOOK UP PRODUCT CATEGORY - NOT IMPLEMENTED
* TODO: ADD PRODUCT CATEGORY CHECK
*
END
