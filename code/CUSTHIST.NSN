* >Natural Source Code: CUSTHIST
* SUBPROGRAM: CUSTHIST - CUSTOMER HISTORY DISPLAY
* DESCRIPTION: DISPLAYS CUSTOMER ORDER HISTORY AND
*              ACTIVITY LOG
* LIBRARY: RETAILCORE
* ADABAS FILES: 100 (CUSTOMER), 110 (ORDER), 210 (AUDIT)
* CREATED: 2000-03-15  M. JOHNSON
* MODIFIED: 2008-05-12 - ADDED RETURN HISTORY
* MODIFIED: 2015-09-20 - ADDED PAGINATION
* MODIFIED: 2021-04-10 - ADDED SPEND SUMMARY
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-CUST-ID             (N8)
*
LOCAL
  1 #PAGE-NUM             (N3)    INIT <1>
  1 #PAGE-SIZE            (N2)    INIT <15>
  1 #TOTAL-RECORDS        (N6)
  1 #SKIP-COUNT           (N6)
  1 #DISPLAY-COUNT        (N2)
  1 #MORE-FLAG            (A1)
  1 #USER-ACTION          (A1)
  1 #SCREEN-MSG           (A78)
  1 #IDX                  (N3)
*
* ORDER HISTORY DISPLAY ARRAY
  1 #ORD-HIST (15)
    2 #OH-ORDER-ID         (N10)
    2 #OH-DATE             (A10)
    2 #OH-STATUS           (A3)
    2 #OH-TOTAL            (N11.2)
    2 #OH-ITEMS            (N3)
    2 #OH-TYPE             (A4)
*
* SUMMARY DATA
  1 #SUMMARY
    2 #SUM-TOTAL-ORDERS    (N6)
    2 #SUM-TOTAL-SPEND     (N11.2)
    2 #SUM-AVG-ORDER       (N9.2)
    2 #SUM-LAST-ORDER      (A10)
    2 #SUM-TOTAL-RETURNS   (N4)
    2 #SUM-RETURN-AMT      (N9.2)
*
* ORDER VIEW
  1 ORD-HIST-VIEW VIEW OF ORDER-FILE
    2 OH-ID                (N10)
    2 OH-CUST-ID           (N8)
    2 OH-DATE              (D)
    2 OH-STATUS            (A3)
    2 OH-TOTAL-AMT         (N11.2)
    2 OH-NUM-LINES         (N3)
    2 OH-SOURCE            (A4)
*
* RETURN VIEW
  1 RET-HIST-VIEW VIEW OF RETURN-FILE
    2 RH-CUST-ID           (N8)
    2 RH-RETURN-AMT        (N11.2)
END-DEFINE
*
* -------------------------------------------------------
* CALCULATE SUMMARY
* -------------------------------------------------------
RESET #SUMMARY
*
* COUNT ORDERS AND TOTAL SPEND
READ ORD-HIST-VIEW BY OH-CUST-ID = P-CUST-ID
  IF OH-CUST-ID NE P-CUST-ID
    ESCAPE BOTTOM
  END-IF
  ADD 1 TO #SUM-TOTAL-ORDERS
  ADD OH-TOTAL-AMT TO #SUM-TOTAL-SPEND
END-READ
*
IF #SUM-TOTAL-ORDERS > 0
  COMPUTE #SUM-AVG-ORDER = #SUM-TOTAL-SPEND / #SUM-TOTAL-ORDERS
END-IF
*
* COUNT RETURNS
* MODIFIED 2008-05-12
FIND NUMBER RET-HIST-VIEW WITH RH-CUST-ID = P-CUST-ID
  MOVE *NUMBER TO #SUM-TOTAL-RETURNS
END-FIND
*
* -------------------------------------------------------
* PAGINATION LOOP
* -------------------------------------------------------
REPEAT
  * CLEAR DISPLAY ARRAY
  FOR #IDX = 1 TO #PAGE-SIZE
    RESET #ORD-HIST(#IDX)
  END-FOR
*
  * CALCULATE SKIP COUNT
  COMPUTE #SKIP-COUNT = (#PAGE-NUM - 1) * #PAGE-SIZE
  RESET #DISPLAY-COUNT
  RESET #TOTAL-RECORDS
  MOVE 'N' TO #MORE-FLAG
*
  * READ ORDERS FOR THIS PAGE
  READ ORD-HIST-VIEW BY OH-CUST-ID = P-CUST-ID
    IF OH-CUST-ID NE P-CUST-ID
      ESCAPE BOTTOM
    END-IF
    ADD 1 TO #TOTAL-RECORDS
*
    * SKIP RECORDS FOR PREVIOUS PAGES
    IF #TOTAL-RECORDS <= #SKIP-COUNT
      ESCAPE TOP
    END-IF
*
    * CHECK IF BEYOND CURRENT PAGE
    IF #DISPLAY-COUNT >= #PAGE-SIZE
      MOVE 'Y' TO #MORE-FLAG
      ESCAPE BOTTOM
    END-IF
*
    ADD 1 TO #DISPLAY-COUNT
    MOVE OH-ID         TO #ORD-HIST.#OH-ORDER-ID(#DISPLAY-COUNT)
    MOVE *DATN(OH-DATE) TO #ORD-HIST.#OH-DATE(#DISPLAY-COUNT)
    MOVE OH-STATUS     TO #ORD-HIST.#OH-STATUS(#DISPLAY-COUNT)
    MOVE OH-TOTAL-AMT  TO #ORD-HIST.#OH-TOTAL(#DISPLAY-COUNT)
    MOVE OH-NUM-LINES  TO #ORD-HIST.#OH-ITEMS(#DISPLAY-COUNT)
    MOVE OH-SOURCE     TO #ORD-HIST.#OH-TYPE(#DISPLAY-COUNT)
*
  END-READ
*
  * DISPLAY HISTORY SCREEN
  INPUT (IP=ON) WITH TEXT #SCREEN-MSG
    / 'RETAILCORE - CUSTOMER ORDER HISTORY' (I)
    / '====================================' (I)
    / 'CUSTOMER:' P-CUST-ID (AD=OI) 'PAGE:' #PAGE-NUM (AD=OI)
    /
    / '--- SUMMARY ---'
    / 'TOTAL ORDERS :' #SUM-TOTAL-ORDERS (AD=OI)
    / 'TOTAL SPEND  :' #SUM-TOTAL-SPEND (AD=OI)
    / 'AVG ORDER    :' #SUM-AVG-ORDER (AD=OI)
    / 'RETURNS      :' #SUM-TOTAL-RETURNS (AD=OI)
    /
    / '--- ORDER HISTORY ---'
    / 'ORDER ID   DATE       STS  TOTAL        ITEMS TYPE'
    / '---------- ---------- --- ------------- ----- ----'
*
  * DISPLAY ORDER LINES
  FOR #IDX = 1 TO #DISPLAY-COUNT
    WRITE
      #ORD-HIST.#OH-ORDER-ID(#IDX)
      #ORD-HIST.#OH-DATE(#IDX)
      #ORD-HIST.#OH-STATUS(#IDX)
      #ORD-HIST.#OH-TOTAL(#IDX)
      #ORD-HIST.#OH-ITEMS(#IDX)
      #ORD-HIST.#OH-TYPE(#IDX)
  END-FOR
*
  IF #DISPLAY-COUNT = 0
    WRITE 'NO ORDERS FOUND'
  END-IF
*
  WRITE / 'PF3=RETURN  PF7=PREV  PF8=NEXT'
*
  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF
  IF *PF-KEY = 'PF7' AND #PAGE-NUM > 1
    SUBTRACT 1 FROM #PAGE-NUM
  END-IF
  IF *PF-KEY = 'PF8' AND #MORE-FLAG = 'Y'
    ADD 1 TO #PAGE-NUM
  END-IF
*
END-REPEAT
*
END
