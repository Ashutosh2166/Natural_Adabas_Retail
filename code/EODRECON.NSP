* >Natural Source Code: EODRECON
* PROGRAM: EODRECON - END OF DAY RECONCILIATION
* DESCRIPTION: MASTER RECONCILIATION BATCH JOB
*              VALIDATES DATA INTEGRITY ACROSS DOMAINS
*              CHECKS ORDER-PAYMENT-INVENTORY CONSISTENCY
* LIBRARY: RETAILCORE
* ADABAS FILES: MULTIPLE
* CREATED: 2004-09-15  A. GARCIA
* MODIFIED: 2011-04-22 - ADDED INVENTORY RECONCILIATION
* MODIFIED: 2018-01-10 - ADDED PAYMENT RECONCILIATION
* MODIFIED: 2024-03-15 - ADDED CROSS-DOMAIN CHECKS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
*
* RECONCILIATION COUNTERS
  1 #TOTAL-CHECKS         (N8)
  1 #PASSED-CHECKS        (N8)
  1 #FAILED-CHECKS        (N8)
  1 #WARNING-CHECKS       (N8)
*
* ORDER-PAYMENT RECONCILIATION
  1 #OP-ORDERS-CHECKED    (N8)
  1 #OP-AMOUNT-MISMATCH   (N8)
  1 #OP-MISSING-PAYMENT   (N8)
  1 #OP-ORPHAN-PAYMENT    (N8)
*
* ORDER-LINE RECONCILIATION
  1 #OL-ORDERS-CHECKED    (N8)
  1 #OL-LINE-COUNT-DIFF   (N8)
  1 #OL-TOTAL-DIFF        (N8)
*
* INVENTORY RECONCILIATION
  1 #IV-RECORDS-CHECKED   (N8)
  1 #IV-NEGATIVE-STOCK    (N8)
  1 #IV-NEGATIVE-AVAIL    (N8)
  1 #IV-ORPHAN-RESERV     (N8)
*
  1 RO-VIEW VIEW OF ORDER-FILE
    2 RO-ID                (N10)
    2 RO-STATUS            (A3)
    2 RO-NUM-LINES         (N3)
    2 RO-TOTAL-AMT         (N11.2)
    2 RO-PAID-AMT          (N11.2)
*
  1 RL-VIEW VIEW OF ORDER-LINE-FILE
    2 RL-ORDER-ID          (N10)
    2 RL-LINE-TOTAL        (N11.2)
    2 RL-STATUS            (A3)
*
  1 RP-VIEW VIEW OF PAYMENT-FILE
    2 RP-ORDER-ID          (N10)
    2 RP-STATUS            (A2)
    2 RP-AMOUNT            (N11.2)
    2 RP-CAPTURED-AMT      (N11.2)
*
  1 RI-VIEW VIEW OF INVENTORY-FILE
    2 RI-PROD-ID           (N8)
    2 RI-LOCATION-ID       (N6)
    2 RI-ON-HAND           (N8)
    2 RI-RESERVED          (N8)
    2 RI-ALLOCATED         (N8)
    2 RI-DAMAGED           (N8)
    2 RI-STATUS            (A1)
*
  1 RR-VIEW VIEW OF RESERVATION-FILE
    2 RR-PROD-ID           (N8)
    2 RR-LOCATION-ID       (N6)
    2 RR-ORDER-ID          (N10)
    2 RR-STATUS            (A1)
    2 RR-QTY               (N6)
END-DEFINE
*
MOVE *DATX TO #TODAY
*
WRITE 'RETAILCORE - END OF DAY RECONCILIATION'
WRITE '======================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* -------------------------------------------------------
* CHECK 1: ORDER-PAYMENT AMOUNT CONSISTENCY
* -------------------------------------------------------
WRITE 'CHECK 1: ORDER-PAYMENT CONSISTENCY...'
READ RO-VIEW BY RO-ID
  IF RO-STATUS = 'CAN' OR RO-STATUS = 'NEW'
    ESCAPE TOP
  END-IF
  ADD 1 TO #OP-ORDERS-CHECKED
  ADD 1 TO #TOTAL-CHECKS
*
  * SUM PAYMENTS FOR THIS ORDER
  1 #PAY-TOTAL (N11.2)
  RESET #PAY-TOTAL
  1 #PAY-FOUND (A1)
  MOVE 'N' TO #PAY-FOUND
  FIND RP-VIEW WITH RP-ORDER-ID = RO-ID
    IF RP-STATUS NE 'RV' AND RP-STATUS NE 'EX'
      ADD RP-AMOUNT TO #PAY-TOTAL
      MOVE 'Y' TO #PAY-FOUND
    END-IF
  END-FIND
*
  * CHECK FOR PAID ORDERS WITHOUT PAYMENTS
  IF RO-STATUS = 'PAD' OR RO-STATUS = 'ALC'
      OR RO-STATUS = 'SHP' OR RO-STATUS = 'CMP'
    IF #PAY-FOUND NE 'Y'
      ADD 1 TO #OP-MISSING-PAYMENT
      ADD 1 TO #FAILED-CHECKS
      WRITE '  ** MISSING PAYMENT FOR ORDER:' RO-ID
    ELSE
      ADD 1 TO #PASSED-CHECKS
    END-IF
  ELSE
    ADD 1 TO #PASSED-CHECKS
  END-IF
*
  * SAFETY: LIMIT SCAN
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
WRITE '  ORDERS CHECKED    :' #OP-ORDERS-CHECKED
WRITE '  MISSING PAYMENTS  :' #OP-MISSING-PAYMENT
*
* -------------------------------------------------------
* CHECK 2: ORDER-LINE TOTAL CONSISTENCY
* -------------------------------------------------------
WRITE ' '
WRITE 'CHECK 2: ORDER-LINE TOTAL CONSISTENCY...'
READ RO-VIEW BY RO-ID
  IF RO-STATUS = 'CAN'
    ESCAPE TOP
  END-IF
  ADD 1 TO #OL-ORDERS-CHECKED
  ADD 1 TO #TOTAL-CHECKS
*
  * COUNT AND SUM LINES
  1 #LINE-COUNT (N3)
  1 #LINE-TOTAL (N11.2)
  RESET #LINE-COUNT
  RESET #LINE-TOTAL
  FIND RL-VIEW WITH RL-ORDER-ID = RO-ID
    IF RL-STATUS NE 'CAN'
      ADD 1 TO #LINE-COUNT
      ADD RL-LINE-TOTAL TO #LINE-TOTAL
    END-IF
  END-FIND
*
  IF #LINE-COUNT NE RO-NUM-LINES
    ADD 1 TO #OL-LINE-COUNT-DIFF
    ADD 1 TO #WARNING-CHECKS
  ELSE
    ADD 1 TO #PASSED-CHECKS
  END-IF
*
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
WRITE '  ORDERS CHECKED    :' #OL-ORDERS-CHECKED
WRITE '  LINE COUNT DIFFS  :' #OL-LINE-COUNT-DIFF
*
* -------------------------------------------------------
* CHECK 3: INVENTORY INTEGRITY
* -------------------------------------------------------
WRITE ' '
WRITE 'CHECK 3: INVENTORY INTEGRITY...'
READ RI-VIEW BY RI-PROD-ID
  IF RI-STATUS NE 'A'
    ESCAPE TOP
  END-IF
  ADD 1 TO #IV-RECORDS-CHECKED
  ADD 1 TO #TOTAL-CHECKS
*
  * CHECK NEGATIVE ON-HAND
  IF RI-ON-HAND < 0
    ADD 1 TO #IV-NEGATIVE-STOCK
    ADD 1 TO #FAILED-CHECKS
    WRITE '  ** NEGATIVE STOCK: PROD' RI-PROD-ID
      'LOC' RI-LOCATION-ID 'OH:' RI-ON-HAND
  ELSE
    * CHECK NEGATIVE AVAILABLE
    1 #AVAIL (N8)
    COMPUTE #AVAIL = RI-ON-HAND - RI-RESERVED
      - RI-ALLOCATED - RI-DAMAGED
    IF #AVAIL < 0
      ADD 1 TO #IV-NEGATIVE-AVAIL
      ADD 1 TO #WARNING-CHECKS
    ELSE
      ADD 1 TO #PASSED-CHECKS
    END-IF
  END-IF
*
  IF *COUNTER > 100000
    ESCAPE BOTTOM
  END-IF
END-READ
*
* CHECK ORPHAN RESERVATIONS
READ RR-VIEW BY RR-PROD-ID
  IF RR-STATUS = 'A'
    * CHECK IF ORDER STILL EXISTS AND IS ACTIVE
    1 #ORD-EXISTS (A1)
    MOVE 'N' TO #ORD-EXISTS
    FIND RO-VIEW WITH RO-ID = RR-ORDER-ID
      IF NO RECORDS FOUND
        IGNORE
      END-NOREC
      IF RO-STATUS NE 'CAN'
        MOVE 'Y' TO #ORD-EXISTS
      END-IF
      ESCAPE BOTTOM
    END-FIND
    IF #ORD-EXISTS NE 'Y'
      ADD 1 TO #IV-ORPHAN-RESERV
    END-IF
  END-IF
  IF *COUNTER > 50000
    ESCAPE BOTTOM
  END-IF
END-READ
*
WRITE '  INVENTORY CHECKED  :' #IV-RECORDS-CHECKED
WRITE '  NEGATIVE STOCK     :' #IV-NEGATIVE-STOCK
WRITE '  NEGATIVE AVAILABLE :' #IV-NEGATIVE-AVAIL
WRITE '  ORPHAN RESERVATIONS:' #IV-ORPHAN-RESERV
*
* PRINT SUMMARY
WRITE ' '
WRITE 'RECONCILIATION SUMMARY'
WRITE '======================'
WRITE 'TOTAL CHECKS   :' #TOTAL-CHECKS
WRITE 'PASSED         :' #PASSED-CHECKS
WRITE 'WARNINGS       :' #WARNING-CHECKS
WRITE 'FAILED         :' #FAILED-CHECKS
WRITE ' '
IF #FAILED-CHECKS > 0
  WRITE '*** RECONCILIATION COMPLETED WITH ERRORS ***'
ELSE IF #WARNING-CHECKS > 0
  WRITE '*** RECONCILIATION COMPLETED WITH WARNINGS ***'
ELSE
  WRITE 'RECONCILIATION COMPLETED SUCCESSFULLY'
END-IF
END-IF
*
CALLNAT 'AUDITN' 'ORD' 'EODRECON' 'U' 'BATCH'
  ' ' ' ' 'EOD RECONCILIATION COMPLETE'
*
END
