* >Natural Source Code: LOCVAL
* SUBPROGRAM: LOCVAL - LOCATION VALIDATION
* DESCRIPTION: VALIDATES STORE OR WAREHOUSE LOCATION
*              UNIFIES LOCATION CHECKING FOR ALL MODULES
* LIBRARY: RETAILCORE
* CREATED: 2002-04-15  D. CHEN
* MODIFIED: 2011-08-22 - ADDED FULFILLMENT CHECK
* MODIFIED: 2019-12-10 - ADDED PRIORITY LOGIC
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-LOC-TYPE            (A1)    /* S=STORE W=WAREHOUSE */
  1 P-LOC-ID              (N4)
  1 P-CHECK-ACTIVE        (A1)    /* Y/N */
  1 P-CHECK-FULFILL       (A1)    /* Y/N */
  1 P-LOC-NAME            (A40)   /* RETURNED */
  1 P-LOC-STATUS          (A1)    /* RETURNED */
  1 P-LOC-PRIORITY        (N2)    /* RETURNED */
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 #STORE-FOUND          (A1)
  1 #STORE-NAME           (A40)
  1 #STORE-STATUS         (A1)
  1 #STORE-TAX            (N5.4)
  1 #WH-FOUND             (A1)
  1 #WH-NAME              (A40)
  1 #WH-STATUS            (A1)
  1 #WH-AVAIL             (N10)
  1 #WH-MSG               (A60)
END-DEFINE
*
MOVE 'N' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
IF P-LOC-TYPE NE 'S' AND P-LOC-TYPE NE 'W'
  MOVE 'INVALID LOCATION TYPE (S/W)' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
IF P-LOC-ID = 0
  MOVE 'LOCATION ID REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
DECIDE ON FIRST VALUE OF P-LOC-TYPE
  VALUE 'S'
    CALLNAT 'STOREVAL'
      P-LOC-ID P-CHECK-ACTIVE P-CHECK-FULFILL
      #STORE-STATUS #STORE-NAME #STORE-TAX
      #STORE-FOUND #WH-MSG
    IF #STORE-FOUND = 'Y'
      MOVE #STORE-NAME   TO P-LOC-NAME
      MOVE #STORE-STATUS TO P-LOC-STATUS
      MOVE 1             TO P-LOC-PRIORITY  /* STORES DEFAULT PRIORITY 1 */
      MOVE 'Y' TO P-VALID-FLAG
    ELSE
      MOVE #WH-MSG TO P-ERROR-MSG
    END-IF
  VALUE 'W'
    CALLNAT 'WHVAL'
      P-LOC-ID P-CHECK-ACTIVE 'N' 0
      #WH-STATUS #WH-NAME #WH-AVAIL
      #WH-FOUND #WH-MSG
    IF #WH-FOUND = 'Y'
      MOVE #WH-NAME   TO P-LOC-NAME
      MOVE #WH-STATUS TO P-LOC-STATUS
      MOVE 2          TO P-LOC-PRIORITY  /* WAREHOUSES DEFAULT PRIORITY 2 */
      MOVE 'Y' TO P-VALID-FLAG
    ELSE
      MOVE #WH-MSG TO P-ERROR-MSG
    END-IF
  NONE VALUE
    MOVE 'INVALID LOCATION TYPE' TO P-ERROR-MSG
END-DECIDE
*
END
