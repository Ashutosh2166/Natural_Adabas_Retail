* >Natural Source Code: PAYAUTH
* SUBPROGRAM: PAYAUTH - PAYMENT AUTHORIZATION
* DESCRIPTION: AUTHORIZES PAYMENT FOR ORDER
*              SUPPORTS CC, DC, GC, CHECK, CASH, WALLET, PAYPAL
*              INTERFACES WITH PAYMENT GATEWAY
* LIBRARY: RETAILCORE
* ADABAS FILE: 140 (PAYMENT)
* CREATED: 2000-05-15  A. GARCIA
* MODIFIED: 2006-09-22 - ADDED GIFT CARD SUPPORT
* MODIFIED: 2012-03-10 - ADDED FRAUD SCORING
* MODIFIED: 2018-07-15 - ADDED WALLET/PAYPAL
* MODIFIED: 2023-02-10 - ADDED SPLIT PAYMENT
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-PAY-METHOD          (A2)    /* CC DC GC CH CA WL PP */
  1 P-AMOUNT              (N11.2)
  1 P-CARD-NUMBER         (A19)
  1 P-CARD-EXPIRY         (A5)    /* MM/YY */
  1 P-CARD-CVV            (A4)
  1 P-AUTH-CODE           (A20)
  1 P-PAY-ID              (N10)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #NEW-PAY-ID           (N10)
  1 #MASKED-CARD          (A19)
  1 #CARD-LAST4           (A4)
  1 #GW-AUTH-CODE         (A20)
  1 #GW-REF-NO            (A30)
  1 #GW-RC                (N4)
  1 #GW-MSG               (A80)
  1 #FRAUD-SCORE          (N3)
  1 #FRAUD-THRESHOLD      (N3)    INIT <80>
  1 #ORD-STR              (A15)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 PAY-VIEW VIEW OF PAYMENT-FILE
    2 PY-ID                (N10)
    2 PY-ORDER-ID          (N10)
    2 PY-METHOD            (A2)
    2 PY-STATUS            (A2)
    2 PY-AMOUNT            (N11.2)
    2 PY-AUTH-CODE         (A20)
    2 PY-REF-NUMBER        (A30)
    2 PY-CARD-LAST4        (A4)
    2 PY-CARD-TYPE         (A4)
    2 PY-CARD-EXPIRY       (A5)
    2 PY-FRAUD-SCORE       (N3)
    2 PY-AUTH-DATE         (D)
    2 PY-AUTH-TIME         (T)
    2 PY-CREATED-BY        (A8)
    2 PY-GATEWAY-ID        (A10)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
RESET P-AUTH-CODE
*
* VALIDATE PAYMENT METHOD
IF P-PAY-METHOD NE 'CC' AND P-PAY-METHOD NE 'DC'
    AND P-PAY-METHOD NE 'GC' AND P-PAY-METHOD NE 'CH'
    AND P-PAY-METHOD NE 'CA' AND P-PAY-METHOD NE 'WL'
    AND P-PAY-METHOD NE 'PP'
  MOVE 701 TO P-RC
  MOVE 'INVALID PAYMENT METHOD' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* VALIDATE AMOUNT
IF P-AMOUNT <= 0
  MOVE 702 TO P-RC
  MOVE 'PAYMENT AMOUNT MUST BE > 0' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* CARD VALIDATION (FOR CC/DC)
IF P-PAY-METHOD = 'CC' OR P-PAY-METHOD = 'DC'
  IF P-CARD-NUMBER = ' '
    MOVE 703 TO P-RC
    MOVE 'CARD NUMBER IS REQUIRED' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
  IF P-CARD-EXPIRY = ' '
    MOVE 704 TO P-RC
    MOVE 'CARD EXPIRY IS REQUIRED' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
*
  * MASK CARD NUMBER
  MOVE P-CARD-NUMBER TO #MASKED-CARD
  * KEEP LAST 4 DIGITS
  MOVE SUBSTRING(P-CARD-NUMBER, 16, 4) TO #CARD-LAST4
  MOVE '***************' TO #MASKED-CARD
  MOVE #CARD-LAST4 TO SUBSTRING(#MASKED-CARD, 16, 4)
*
  * BASIC CARD FORMAT CHECK
  * LUHN ALGORITHM NOT IMPLEMENTED - LEGACY LIMITATION
  * TODO: ADD LUHN VALIDATION
END-IF
*
* FRAUD CHECK FOR HIGH-VALUE TRANSACTIONS
IF P-AMOUNT > 500
  RESET #FRAUD-SCORE
  * SIMPLIFIED FRAUD SCORING
  IF P-PAY-METHOD = 'CC'
    ADD 10 TO #FRAUD-SCORE
  END-IF
  IF P-AMOUNT > 1000
    ADD 15 TO #FRAUD-SCORE
  END-IF
  IF P-AMOUNT > 5000
    ADD 25 TO #FRAUD-SCORE
  END-IF
*
  CALLNAT 'CONFIGN' 'PAY.FRAUD.THRESHOLD'
    #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
  IF #CONFIG-FOUND = 'Y'
    MOVE #CONFIG-NUM TO #FRAUD-THRESHOLD
  END-IF
*
  IF #FRAUD-SCORE >= #FRAUD-THRESHOLD
    MOVE 710 TO P-RC
    COMPRESS 'PAYMENT FLAGGED FOR FRAUD REVIEW SCORE:'
      #FRAUD-SCORE INTO P-RC-TEXT
    ESCAPE ROUTINE
  END-IF
END-IF
*
* GATEWAY AUTHORIZATION
* SIMULATED - IN PRODUCTION CALLS EXTERNAL GATEWAY
DECIDE ON FIRST VALUE OF P-PAY-METHOD
  VALUE 'CC' VALUE 'DC'
    * CREDIT/DEBIT CARD GATEWAY CALL
    * SIMULATED: ALWAYS APPROVE
    COMPRESS 'AUTH-' P-ORDER-ID '-' *TIMESTMP INTO #GW-AUTH-CODE
      LEAVING NO SPACE
    COMPRESS 'REF-' P-ORDER-ID INTO #GW-REF-NO LEAVING NO SPACE
    RESET #GW-RC
  VALUE 'GC'
    * GIFT CARD - CHECK BALANCE
    * SIMPLIFIED: ASSUME SUFFICIENT BALANCE
    COMPRESS 'GC-' P-ORDER-ID INTO #GW-AUTH-CODE LEAVING NO SPACE
    RESET #GW-RC
  VALUE 'CA'
    * CASH - NO AUTHORIZATION NEEDED
    COMPRESS 'CASH-' P-ORDER-ID INTO #GW-AUTH-CODE LEAVING NO SPACE
    RESET #GW-RC
  VALUE 'CH'
    * CHECK - PENDING CLEARANCE
    COMPRESS 'CHK-' P-ORDER-ID INTO #GW-AUTH-CODE LEAVING NO SPACE
    RESET #GW-RC
  VALUE 'WL' VALUE 'PP'
    * WALLET/PAYPAL
    COMPRESS 'WL-' P-ORDER-ID INTO #GW-AUTH-CODE LEAVING NO SPACE
    RESET #GW-RC
  NONE VALUE
    MOVE 705 TO P-RC
    MOVE 'UNSUPPORTED PAYMENT METHOD' TO P-RC-TEXT
    ESCAPE ROUTINE
END-DECIDE
*
IF #GW-RC NE 0
  MOVE 720 TO P-RC
  COMPRESS 'GATEWAY DECLINED:' #GW-MSG INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* CREATE PAYMENT RECORD
CALLNAT 'SEQNON' 'PAY' #NEW-PAY-ID
*
STORE PAY-VIEW
  PY-ID          := #NEW-PAY-ID
  PY-ORDER-ID    := P-ORDER-ID
  PY-METHOD      := P-PAY-METHOD
  PY-STATUS      := 'AU'
  PY-AMOUNT      := P-AMOUNT
  PY-AUTH-CODE   := #GW-AUTH-CODE
  PY-REF-NUMBER  := #GW-REF-NO
  PY-CARD-LAST4  := #CARD-LAST4
  PY-CARD-EXPIRY := P-CARD-EXPIRY
  PY-FRAUD-SCORE := #FRAUD-SCORE
  PY-AUTH-DATE   := #TODAY
  PY-AUTH-TIME   := *TIMESTMP
  PY-CREATED-BY  := #USER-ID
  PY-GATEWAY-ID  := 'GW01'
END-STORE
*
END OF TRANSACTION
*
MOVE #GW-AUTH-CODE TO P-AUTH-CODE
MOVE #NEW-PAY-ID TO P-PAY-ID
*
* UPDATE ORDER PAID AMOUNT
CALLNAT 'ORDUPD' P-ORDER-ID 'PAID' ' ' P-AMOUNT ' '
  *DATX 0 ' '
*
* AUDIT
MOVE P-ORDER-ID TO #ORD-STR
CALLNAT 'AUDITN' 'PAY' #ORD-STR 'C' P-PAY-METHOD
  ' ' #GW-AUTH-CODE 'PAYMENT AUTHORIZED'
*
END
