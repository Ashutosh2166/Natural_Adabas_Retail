* >Natural Source Code: ORDPOST
* SUBPROGRAM: ORDPOST - ORDER STATUS UPDATE
* DESCRIPTION: MANAGES ORDER STATUS TRANSITIONS
*              VALIDATES AND APPLIES STATE CHANGES
* LIBRARY: RETAILCORE
* ADABAS FILE: 111 (ORDER), 113 (ORDER-HISTORY)
* CREATED: 1998-10-20  A. GARCIA
* MODIFIED: 2005-03-15 - ADDED STATUS HISTORY
* MODIFIED: 2012-07-22 - ADDED PAYMENT STATUS SYNC
* MODIFIED: 2019-09-10 - ADDED FRAUD CHECK INTEGRATION
* MODIFIED: 2023-08-05 - ADDED SHIP STATUS LOGIC
* -------------------------------------------------------
* ORDER STATUS FLOW:
*   NEW -> VAL -> RES -> CON -> PAD -> ALC -> SHP -> CMP
*   ANY -> CAN (WITH RULES)
*   SHP -> RET (VIA RETURNS MODULE)
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-ORDER-ID            (N10)
  1 P-NEW-STATUS          (A3)
  1 P-RC-FLAG             (A1)
  1 P-RC-TEXT             (A60)
*
LOCAL
  1 #USER-ID              (A8)
  1 #CURRENT-STATUS       (A3)
  1 #VALID-TRANSITION     (A1)
  1 #ORD-STR              (A15)
  1 #HIST-SEQ             (N4)
*
  1 ORD-POST-VIEW VIEW OF ORDER-FILE
    2 OP-ID                (N10)
    2 OP-STATUS            (A3)
    2 OP-CUST-ID           (N8)
    2 OP-TOTAL-AMT         (N11.2)
*
  1 HIST-VIEW VIEW OF ORDER-HIST-FILE
    2 HV-ORDER-ID          (N10)
    2 HV-SEQ-NO            (N4)
    2 HV-OLD-STATUS        (A3)
    2 HV-NEW-STATUS        (A3)
    2 HV-CHANGE-DATE       (D)
    2 HV-CHANGE-TIME       (T)
    2 HV-CHANGE-USER       (A8)
    2 HV-CHANGE-PROGRAM    (A8)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE 'Y' TO P-RC-FLAG
RESET P-RC-TEXT
*
* GET CURRENT STATUS
FIND ORD-POST-VIEW WITH OP-ID = P-ORDER-ID
  IF NO RECORDS FOUND
    MOVE 'N' TO P-RC-FLAG
    MOVE 'ORDER NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE OP-STATUS TO #CURRENT-STATUS
  ESCAPE BOTTOM
END-FIND
*
* VALIDATE STATUS TRANSITION
MOVE 'N' TO #VALID-TRANSITION
DECIDE ON FIRST VALUE OF #CURRENT-STATUS
  VALUE 'NEW'
    IF P-NEW-STATUS = 'VAL' OR P-NEW-STATUS = 'CAN'
        OR P-NEW-STATUS = 'RES'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'VAL'
    IF P-NEW-STATUS = 'RES' OR P-NEW-STATUS = 'CAN'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'RES'
    IF P-NEW-STATUS = 'CON' OR P-NEW-STATUS = 'CAN'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'CON'
    IF P-NEW-STATUS = 'PAD' OR P-NEW-STATUS = 'CAN'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'PAD'
    IF P-NEW-STATUS = 'ALC' OR P-NEW-STATUS = 'CAN'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'ALC'
    IF P-NEW-STATUS = 'SHP'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'SHP'
    IF P-NEW-STATUS = 'CMP' OR P-NEW-STATUS = 'RET'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'CMP'
    IF P-NEW-STATUS = 'RET'
      MOVE 'Y' TO #VALID-TRANSITION
    END-IF
  VALUE 'CAN'
    * CANCELLED IS FINAL
    MOVE 'N' TO #VALID-TRANSITION
  NONE VALUE
    MOVE 'N' TO #VALID-TRANSITION
END-DECIDE
*
IF #VALID-TRANSITION NE 'Y'
  MOVE 'N' TO P-RC-FLAG
  COMPRESS 'INVALID STATUS TRANSITION' #CURRENT-STATUS
    '->' P-NEW-STATUS INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* APPLY STATUS CHANGE
FIND ORD-POST-VIEW WITH OP-ID = P-ORDER-ID
  GET ORD-POST-VIEW *ISN (HOLD)
  MOVE P-NEW-STATUS TO OP-STATUS
  UPDATE ORD-POST-VIEW
  ESCAPE BOTTOM
END-FIND
*
* WRITE STATUS HISTORY
* MODIFIED 2005-03-15
RESET #HIST-SEQ
FIND NUMBER HIST-VIEW WITH HV-ORDER-ID = P-ORDER-ID
  MOVE *NUMBER TO #HIST-SEQ
END-FIND
ADD 1 TO #HIST-SEQ
*
STORE HIST-VIEW
  HV-ORDER-ID       := P-ORDER-ID
  HV-SEQ-NO         := #HIST-SEQ
  HV-OLD-STATUS     := #CURRENT-STATUS
  HV-NEW-STATUS     := P-NEW-STATUS
  HV-CHANGE-DATE    := *DATX
  HV-CHANGE-TIME    := *TIMESTMP
  HV-CHANGE-USER    := #USER-ID
  HV-CHANGE-PROGRAM := *PROGRAM
END-STORE
*
END OF TRANSACTION
*
* HANDLE CANCELLATION SIDE EFFECTS
IF P-NEW-STATUS = 'CAN'
  * RELEASE ALL RESERVATIONS
  CALLNAT 'INVREL' 0 P-ORDER-ID 0 ' ' 0 ' '
END-IF
*
* AUDIT
MOVE P-ORDER-ID TO #ORD-STR
CALLNAT 'AUDITN' 'ORD' #ORD-STR 'U' 'STATUS'
  #CURRENT-STATUS P-NEW-STATUS 'ORDER STATUS CHANGE'
*
END
