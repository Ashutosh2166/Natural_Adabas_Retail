* >Natural Source Code: STOREVAL
* SUBPROGRAM: STOREVAL - STORE VALIDATION
* DESCRIPTION: VALIDATES STORE DATA AND STATUS
* LIBRARY: RETAILCORE
* ADABAS FILE: 103 (STORE)
* CREATED: 1998-08-05  D. CHEN
* MODIFIED: 2010-03-15 - ADDED CLOSED STORE CHECK
* MODIFIED: 2019-07-20 - ADDED FULFILLMENT VALIDATION
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-STORE-ID            (N4)
  1 P-CHECK-ACTIVE        (A1)    /* Y=MUST BE ACTIVE */
  1 P-CHECK-FULFILL       (A1)    /* Y=MUST HAVE FULFILLMENT */
  1 P-STORE-STATUS        (A1)    /* RETURNED STATUS */
  1 P-STORE-NAME          (A40)   /* RETURNED NAME */
  1 P-TAX-RATE            (N5.4)  /* RETURNED TAX RATE */
  1 P-VALID-FLAG          (A1)
  1 P-ERROR-MSG           (A60)
*
LOCAL
  1 STORE-VAL-VIEW VIEW OF STORE-FILE
    2 SV-ID                (N4)
    2 SV-NAME              (A40)
    2 SV-STATUS            (A1)
    2 SV-TAX-RATE          (N5.4)
    2 SV-FULFILLMENT-CAP   (A1)
    2 SV-SHIP-FROM-STORE   (A1)
END-DEFINE
*
MOVE 'N' TO P-VALID-FLAG
RESET P-ERROR-MSG
*
IF P-STORE-ID = 0
  MOVE 'STORE ID REQUIRED' TO P-ERROR-MSG
  ESCAPE ROUTINE
END-IF
*
FIND STORE-VAL-VIEW WITH SV-ID = P-STORE-ID
  IF NO RECORDS FOUND
    MOVE 'STORE NOT FOUND' TO P-ERROR-MSG
    ESCAPE ROUTINE
  END-NOREC
*
  MOVE SV-STATUS   TO P-STORE-STATUS
  MOVE SV-NAME     TO P-STORE-NAME
  MOVE SV-TAX-RATE TO P-TAX-RATE
*
  * CHECK ACTIVE STATUS IF REQUIRED
  IF P-CHECK-ACTIVE = 'Y'
    IF SV-STATUS NE 'A'
      COMPRESS 'STORE' P-STORE-ID 'IS NOT ACTIVE (STATUS='
        SV-STATUS ')' INTO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  * CHECK FULFILLMENT CAPABILITY
  * MODIFIED 2019-07-20
  IF P-CHECK-FULFILL = 'Y'
    IF SV-FULFILLMENT-CAP NE 'Y'
      COMPRESS 'STORE' P-STORE-ID 'DOES NOT SUPPORT FULFILLMENT'
        INTO P-ERROR-MSG
      ESCAPE ROUTINE
    END-IF
  END-IF
*
  MOVE 'Y' TO P-VALID-FLAG
  ESCAPE BOTTOM
END-FIND
*
ON ERROR
  COMPRESS 'DATABASE ERROR:' *ERROR-NR INTO P-ERROR-MSG
  CALLNAT 'LOGERR' 202 P-ERROR-MSG 'E' 'STOREVAL' *USER
END-ERROR
*
END
