* >Natural Source Code: SUPP-COPY
* RETAILCORE - SUPPLIER AND PROCUREMENT DATA DEFINITIONS
* SHARED BY ALL PROCUREMENT-RELATED PROGRAMS
* CREATED: 1999-02-15
* MODIFIED: 2011-05-20 - ADDED SUPPLIER RATING
* MODIFIED: 2018-08-10 - ADDED PAYMENT TERMS
* MODIFIED: 2022-04-15 - ADDED COMPLIANCE FIELDS
* -------------------------------------------------------
*
* SUPPLIER MASTER RECORD
*
1 SUPPLIER-DATA
  2 SUPP-ID               (N6)    /* SUPPLIER IDENTIFIER */
  2 SUPP-CODE             (A10)   /* SUPPLIER CODE */
  2 SUPP-NAME             (A60)
  2 SUPP-STATUS           (A1)    /* A=ACTIVE I=INACTIVE S=SUSPENDED B=BLOCKED */
  2 SUPP-TYPE             (A2)    /* MF=MANUFACTURER DS=DISTRIBUTOR WH=WHOLESALER IM=IMPORTER */
  2 SUPP-CONTACT-NAME     (A40)
  2 SUPP-CONTACT-PHONE    (A20)
  2 SUPP-CONTACT-EMAIL    (A60)
  2 SUPP-FAX              (A20)   /* LEGACY - SOME SUPPLIERS STILL USE FAX */
*
* SUPPLIER ADDRESS
*
1 SUPPLIER-ADDRESS
  2 SUPP-ADDR-LINE1       (A40)
  2 SUPP-ADDR-LINE2       (A40)
  2 SUPP-CITY             (A30)
  2 SUPP-STATE            (A2)
  2 SUPP-ZIP              (A10)
  2 SUPP-COUNTRY          (A3)
*
* SUPPLIER TERMS
*
1 SUPPLIER-TERMS
  2 SUPP-PAYMENT-TERMS    (A3)    /* N30 N60 N90 COD */
  2 SUPP-DISCOUNT-PCT     (N5.2)  /* EARLY PAYMENT DISCOUNT */
  2 SUPP-DISCOUNT-DAYS    (N3)    /* DAYS FOR EARLY PAYMENT */
  2 SUPP-LEAD-TIME        (N3)    /* STANDARD LEAD TIME DAYS */
  2 SUPP-MIN-ORDER        (N9.2)  /* MINIMUM ORDER AMOUNT */
  2 SUPP-MIN-ORDER-QTY    (N6)    /* MINIMUM ORDER QUANTITY */
  2 SUPP-FREIGHT-TERMS    (A3)    /* FOB CIF DDP */
  2 SUPP-CURRENCY         (A3)    /* SUPPLIER CURRENCY */
*
* SUPPLIER PERFORMANCE
*
1 SUPPLIER-PERFORMANCE
  2 SUPP-RATING           (N3)    /* 0-100 PERFORMANCE RATING */
  2 SUPP-ON-TIME-PCT      (N5.2)  /* ON-TIME DELIVERY % */
  2 SUPP-QUALITY-PCT      (N5.2)  /* QUALITY ACCEPTANCE % */
  2 SUPP-TOTAL-POS        (N6)    /* TOTAL PURCHASE ORDERS */
  2 SUPP-YTD-ORDERS       (N9.2)  /* YTD ORDER VALUE */
  2 SUPP-LAST-ORDER-DATE  (D)
  2 SUPP-LAST-RECEIPT-DATE (D)
*
* SUPPLIER AUDIT
*
1 SUPPLIER-AUDIT
  2 SUPP-CREATED-DATE     (D)
  2 SUPP-CREATED-BY       (A8)
  2 SUPP-MODIFIED-DATE    (D)
  2 SUPP-MODIFIED-BY      (A8)
*
* PURCHASE ORDER HEADER
*
1 PO-HEADER
  2 PO-ID                 (N10)   /* PO IDENTIFIER */
  2 PO-NUMBER             (A12)   /* DISPLAY PO NUMBER */
  2 PO-SUPP-ID            (N6)    /* SUPPLIER */
  2 PO-STATUS             (A2)    /* DR=DRAFT SB=SUBMITTED AP=APPROVED SH=SHIPPED */
                                   /* PR=PARTIAL RC=RECEIVED CL=CLOSED CA=CANCELLED */
  2 PO-TYPE               (A2)    /* ST=STANDARD RP=REPLENISH EM=EMERGENCY SP=SPECIAL */
  2 PO-DATE               (D)     /* ORDER DATE */
  2 PO-EXPECTED-DATE      (D)     /* EXPECTED DELIVERY */
  2 PO-RECV-DATE          (D)     /* ACTUAL RECEIPT DATE */
  2 PO-STORE-ID           (N4)    /* DELIVER TO STORE */
  2 PO-WH-ID              (N4)    /* DELIVER TO WAREHOUSE */
  2 PO-NUM-LINES          (N3)
  2 PO-TOTAL-QTY          (N8)
  2 PO-TOTAL-AMT          (N11.2)
  2 PO-CURRENCY           (A3)
  2 PO-FREIGHT-AMT        (N9.2)
  2 PO-TAX-AMT            (N9.2)
  2 PO-CREATED-BY         (A8)
  2 PO-APPROVED-BY        (A8)
  2 PO-APPROVED-DATE      (D)
*
* PURCHASE ORDER LINE
*
1 PO-LINE-DATA
  2 POL-PO-ID             (N10)   /* PO REFERENCE */
  2 POL-LINE-NO           (N3)    /* LINE NUMBER */
  2 POL-PROD-ID           (N8)    /* PRODUCT */
  2 POL-SKU               (A15)   /* SKU */
  2 POL-QTY-ORDERED       (N8)    /* QUANTITY ORDERED */
  2 POL-QTY-RECEIVED      (N8)    /* QUANTITY RECEIVED */
  2 POL-QTY-REJECTED      (N8)    /* QUANTITY REJECTED */
  2 POL-UNIT-COST         (N9.2)  /* UNIT COST */
  2 POL-LINE-TOTAL        (N11.2) /* LINE TOTAL */
  2 POL-STATUS            (A2)    /* OP=OPEN PR=PARTIAL RC=RECEIVED CL=CLOSED */
  2 POL-RECV-DATE         (D)     /* LINE RECEIPT DATE */
*
END-DEFINE
