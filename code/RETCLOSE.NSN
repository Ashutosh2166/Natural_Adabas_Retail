* >Natural Source Code: RETCLOSE
* SUBPROGRAM: RETCLOSE - RETURN CLOSURE
* DESCRIPTION: CLOSES COMPLETED RETURNS
*              VERIFIES ALL LINES PROCESSED, REFUND ISSUED
*              UPDATES CUSTOMER METRICS
* LIBRARY: RETAILCORE
* ADABAS FILE: 150 (RETURN)
* CREATED: 2003-06-15  A. GARCIA
* MODIFIED: 2014-09-22 - ADDED CUSTOMER METRIC UPDATE
* MODIFIED: 2021-04-10 - ADDED RETURN REASON TRACKING
* -------------------------------------------------------
DEFINE DATA
PARAMETER
  1 P-RETURN-ID           (N10)
  1 P-FORCE-CLOSE         (A1)
  1 P-CLOSURE-SUMMARY
    2 P-CS-TOTAL-QTY      (N6)
    2 P-CS-RESTOCKED-QTY  (N6)
    2 P-CS-DAMAGED-QTY    (N6)
    2 P-CS-REFUND-AMT     (N11.2)
    2 P-CS-DAYS-TO-CLOSE  (N4)
  1 P-RC                  (N4)
  1 P-RC-TEXT             (A80)
*
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #ORDER-ID             (N10)
  1 #CUST-ID              (N8)
  1 #RETURN-DATE          (D)
  1 #CURRENT-STATUS       (A3)
  1 #POST-FLAG            (A1)
  1 #POST-MSG             (A80)
  1 #ORD-STR              (A15)
*
  1 RCL-VIEW VIEW OF RETURN-FILE
    2 RCL-ID               (N10)
    2 RCL-ORDER-ID         (N10)
    2 RCL-CUST-ID          (N8)
    2 RCL-STATUS           (A3)
    2 RCL-TOTAL-AMT        (N11.2)
    2 RCL-DATE             (D)
*
  1 RLL-VIEW VIEW OF RETURN-LINE-FILE
    2 RLL-RETURN-ID        (N10)
    2 RLL-QTY-RETURNED     (N6)
    2 RLL-CONDITION        (A1)
    2 RLL-REFUND-AMT       (N11.2)
    2 RLL-STATUS           (A3)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
RESET P-RC
RESET P-RC-TEXT
RESET P-CLOSURE-SUMMARY
*
* GET RETURN
FIND RCL-VIEW WITH RCL-ID = P-RETURN-ID
  IF NO RECORDS FOUND
    MOVE 904 TO P-RC
    MOVE 'RETURN NOT FOUND' TO P-RC-TEXT
    ESCAPE ROUTINE
  END-NOREC
  MOVE RCL-STATUS    TO #CURRENT-STATUS
  MOVE RCL-ORDER-ID  TO #ORDER-ID
  MOVE RCL-CUST-ID   TO #CUST-ID
  MOVE RCL-TOTAL-AMT TO P-CS-REFUND-AMT
  MOVE RCL-DATE      TO #RETURN-DATE
  ESCAPE BOTTOM
END-FIND
*
* CHECK STATUS
IF #CURRENT-STATUS = 'CLS'
  MOVE 910 TO P-RC
  MOVE 'RETURN ALREADY CLOSED' TO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
IF #CURRENT-STATUS NE 'REF' AND P-FORCE-CLOSE NE 'Y'
  MOVE 911 TO P-RC
  COMPRESS 'RETURN STATUS' #CURRENT-STATUS
    'NOT CLOSEABLE (USE FORCE)' INTO P-RC-TEXT
  ESCAPE ROUTINE
END-IF
*
* CALCULATE CLOSURE SUMMARY
FIND RLL-VIEW WITH RLL-RETURN-ID = P-RETURN-ID
  ADD RLL-QTY-RETURNED TO P-CS-TOTAL-QTY
  IF RLL-CONDITION = 'N' OR RLL-CONDITION = 'O'
    ADD RLL-QTY-RETURNED TO P-CS-RESTOCKED-QTY
  ELSE
    ADD RLL-QTY-RETURNED TO P-CS-DAMAGED-QTY
  END-IF
END-FIND
*
* DAYS TO CLOSE
CALLNAT 'DATEU' 'DIFF' #RETURN-DATE #TODAY
  0 ' ' ' ' 0 0 ' ' P-CS-DAYS-TO-CLOSE ' '
*
* CLOSE RETURN
CALLNAT 'RETPOST' P-RETURN-ID 'CLS' 'RETURN CLOSED'
  P-RC P-RC-TEXT
IF P-RC NE 0
  * TRY FORCE PATH: REF -> CLS
  IF #CURRENT-STATUS NE 'REF'
    CALLNAT 'RETPOST' P-RETURN-ID 'REF' 'AUTO-REFUND'
      P-RC P-RC-TEXT
    IF P-RC = 0
      CALLNAT 'RETPOST' P-RETURN-ID 'CLS' 'RETURN CLOSED'
        P-RC P-RC-TEXT
    END-IF
  END-IF
END-IF
*
IF P-RC NE 0
  ESCAPE ROUTINE
END-IF
*
* UPDATE CUSTOMER METRICS
* SUBTRACT SPEND FOR RETURNED ITEMS
CALLNAT 'CUSTUPD' #CUST-ID 'SPND' ' ' 0 ' '
  (0 - P-CS-REFUND-AMT) *DATX 0 ' '
*
* AUDIT
MOVE P-RETURN-ID TO #ORD-STR
COMPRESS 'QTY:' P-CS-TOTAL-QTY 'RESTOCK:' P-CS-RESTOCKED-QTY
  'DAMAGED:' P-CS-DAMAGED-QTY INTO P-RC-TEXT
CALLNAT 'AUDITN' 'RET' #ORD-STR 'U' 'CLOSE'
  ' ' ' ' P-RC-TEXT
RESET P-RC-TEXT
*
END
