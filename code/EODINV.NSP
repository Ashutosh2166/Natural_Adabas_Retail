* >Natural Source Code: EODINV
* PROGRAM: EODINV - END OF DAY INVENTORY PROCESSING
* DESCRIPTION: BATCH PROGRAM FOR DAILY INVENTORY MAINTENANCE
*              EXPIRES RESERVATIONS, TRIGGERS REPLENISHMENT,
*              GENERATES LOW STOCK ALERTS, CLEANS LOCKS
* LIBRARY: RETAILCORE
* ADABAS FILES: 105 (INVENTORY), 106 (RESERVATION)
* CREATED: 1999-05-15  A. GARCIA
* MODIFIED: 2006-02-22 - ADDED RESERVATION EXPIRY
* MODIFIED: 2012-09-10 - ADDED AUTO-REPLENISHMENT
* MODIFIED: 2019-04-15 - ADDED SAFETY STOCK ALERTS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #USER-ID              (A8)
  1 #TODAY                (D)
  1 #EXPIRY-DATE          (D)
  1 #EXPIRY-DAYS          (N4)    INIT <3>
*
* COUNTERS
  1 #INV-RECORDS          (N8)
  1 #LOW-STOCK-COUNT      (N8)
  1 #BELOW-SAFETY         (N8)
  1 #BELOW-REORDER        (N8)
  1 #EXPIRED-RESERVATIONS (N8)
  1 #REPLENISHMENTS       (N8)
  1 #LOCKS-CLEANED        (N8)
*
  1 #INV-RC               (N4)
  1 #INV-MSG              (A80)
  1 #CONFIG-VALUE         (A80)
  1 #CONFIG-NUM           (N11.2)
  1 #CONFIG-DATE          (D)
  1 #CONFIG-FLAG          (A1)
  1 #CONFIG-FOUND         (A1)
*
  1 EIV-VIEW VIEW OF INVENTORY-FILE
    2 EIV-PROD-ID          (N8)
    2 EIV-SKU              (A15)
    2 EIV-LOCATION-ID      (N6)
    2 EIV-LOCATION-TYPE    (A1)
    2 EIV-ON-HAND          (N8)
    2 EIV-RESERVED         (N8)
    2 EIV-ALLOCATED        (N8)
    2 EIV-DAMAGED          (N8)
    2 EIV-IN-TRANSIT       (N8)
    2 EIV-SAFETY-STOCK     (N8)
    2 EIV-REORDER-LEVEL    (N8)
    2 EIV-STATUS           (A1)
*
  1 ERV-VIEW VIEW OF RESERVATION-FILE
    2 ERV-ID               (N10)
    2 ERV-PROD-ID          (N8)
    2 ERV-LOCATION-ID      (N6)
    2 ERV-QTY              (N6)
    2 ERV-STATUS           (A1)
    2 ERV-EXPIRY-DATE      (D)
    2 ERV-ORDER-ID         (N10)
END-DEFINE
*
MOVE *USER TO #USER-ID
MOVE *DATX TO #TODAY
*
WRITE 'RETAILCORE - END OF DAY INVENTORY PROCESSING'
WRITE '============================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* GET RESERVATION EXPIRY CONFIG
CALLNAT 'CONFIGN' 'RESERVATION.EXPIRY.DAYS'
  #CONFIG-VALUE #CONFIG-NUM #CONFIG-DATE #CONFIG-FLAG #CONFIG-FOUND
IF #CONFIG-FOUND = 'Y'
  MOVE #CONFIG-NUM TO #EXPIRY-DAYS
END-IF
MOVE #TODAY TO #EXPIRY-DATE
SUBTRACT #EXPIRY-DAYS FROM #EXPIRY-DATE (D)
*
* STEP 1: EXPIRE OLD RESERVATIONS
WRITE 'STEP 1: EXPIRING OLD RESERVATIONS...'
READ ERV-VIEW BY ERV-EXPIRY-DATE
  IF ERV-EXPIRY-DATE > #TODAY
    ESCAPE BOTTOM
  END-IF
  IF ERV-STATUS = 'A'
    GET ERV-VIEW *ISN (HOLD)
    MOVE 'X' TO ERV-STATUS
    UPDATE ERV-VIEW
*
    * RELEASE INVENTORY
    CALLNAT 'INVREL' ERV-ID 0 0 ' ' #INV-RC #INV-MSG
    ADD 1 TO #EXPIRED-RESERVATIONS
*
    IF *COUNTER = 50
      END OF TRANSACTION
    END-IF
  END-IF
END-READ
END OF TRANSACTION
WRITE '  EXPIRED:' #EXPIRED-RESERVATIONS
*
* STEP 2: CHECK INVENTORY LEVELS
WRITE ' '
WRITE 'STEP 2: CHECKING INVENTORY LEVELS...'
READ EIV-VIEW BY EIV-PROD-ID
  IF EIV-STATUS NE 'A'
    ESCAPE TOP
  END-IF
  ADD 1 TO #INV-RECORDS
*
  1 #AVAILABLE (N8)
  COMPUTE #AVAILABLE = EIV-ON-HAND - EIV-RESERVED
    - EIV-ALLOCATED - EIV-DAMAGED
*
  IF #AVAILABLE < EIV-SAFETY-STOCK
    ADD 1 TO #BELOW-SAFETY
    ADD 1 TO #LOW-STOCK-COUNT
  ELSE IF #AVAILABLE < EIV-REORDER-LEVEL
    ADD 1 TO #BELOW-REORDER
    ADD 1 TO #LOW-STOCK-COUNT
  END-IF
  END-IF
*
  * AUTO-TRIGGER REPLENISHMENT
  IF #AVAILABLE < EIV-REORDER-LEVEL AND EIV-REORDER-LEVEL > 0
    CALLNAT 'INVREPL' 'CHCK' EIV-PROD-ID EIV-SKU
      EIV-LOCATION-ID EIV-LOCATION-TYPE
      0 0 0 0 0 ' ' ' '
      #INV-RC #INV-MSG
    IF #INV-RC = 0
      ADD 1 TO #REPLENISHMENTS
    END-IF
  END-IF
END-READ
*
* STEP 3: CLEAN EXPIRED LOCKS
WRITE ' '
WRITE 'STEP 3: CLEANING EXPIRED LOCKS...'
* CALL LOCK CLEANUP UTILITY
1 #LOCK-RC (N4)
1 #LOCK-MSG (A80)
CALLNAT 'LOCKN' 'C' ' ' ' ' 0 ' ' #LOCK-RC #LOCK-MSG
*
* PRINT SUMMARY
WRITE ' '
WRITE 'INVENTORY SUMMARY'
WRITE '================='
WRITE 'TOTAL INVENTORY RECORDS:' #INV-RECORDS
WRITE 'BELOW SAFETY STOCK     :' #BELOW-SAFETY
WRITE 'BELOW REORDER LEVEL    :' #BELOW-REORDER
WRITE 'TOTAL LOW STOCK        :' #LOW-STOCK-COUNT
WRITE 'EXPIRED RESERVATIONS   :' #EXPIRED-RESERVATIONS
WRITE 'REPLENISHMENTS TRIGGERED:' #REPLENISHMENTS
WRITE ' '
WRITE 'EOD INVENTORY PROCESSING COMPLETE'
*
CALLNAT 'AUDITN' 'INV' 'EODINV' 'U' 'BATCH'
  ' ' ' ' 'EOD INVENTORY PROCESSING COMPLETE'
*
END
