* >Natural Source Code: EODSUPP
* PROGRAM: EODSUPP - END OF DAY SUPPLIER PROCESSING
* DESCRIPTION: BATCH PROGRAM FOR DAILY SUPPLIER MAINTENANCE
*              AUTO-UPDATES SUPPLIER PERFORMANCE METRICS
*              FLAGS UNDERPERFORMING SUPPLIERS
*              CHECKS OVERDUE PURCHASE ORDERS
* LIBRARY: RETAILCORE
* ADABAS FILES: 130 (SUPPLIER), 131 (PO-HEADER), 132 (PO-LINE)
* CREATED: 2012-07-15  J. THOMPSON
* MODIFIED: 2018-11-22 - ADDED PERFORMANCE RECALC
* MODIFIED: 2024-02-10 - ADDED OVERDUE PO ALERTS
* -------------------------------------------------------
DEFINE DATA
LOCAL
  1 #TODAY                (D)
  1 #COMMIT-INTERVAL      (N4)    INIT <25>
  1 #COMMIT-COUNT         (N4)
*
* STEP 1: OVERDUE PO CHECK
  1 #PO-CHECKED           (N8)
  1 #PO-OVERDUE           (N8)
  1 #PO-OVERDUE-AMT       (N13.2)
  1 #PO-CRITICAL-LATE     (N8)
*
* STEP 2: SUPPLIER PERFORMANCE RECALC
  1 #SUPP-CHECKED         (N8)
  1 #SUPP-UPDATED         (N8)
  1 #SUPP-DOWNGRADED      (N8)
  1 #SUPP-UPGRADED        (N8)
*
* STEP 3: AUTO-PROBATION
  1 #SUPP-PROBATION       (N8)
*
* PERIOD FOR PERFORMANCE CALC (LAST 12 MONTHS)
  1 #PERF-START           (D)
*
* WORK FIELDS
  1 #TOTAL-POS            (N8)
  1 #RECEIVED-POS         (N8)
  1 #LATE-POS             (N8)
  1 #QTY-ORDERED          (N10)
  1 #QTY-RECEIVED         (N10)
  1 #QTY-DAMAGED          (N10)
  1 #ON-TIME-PCT          (N5.1)
  1 #FILL-RATE            (N5.1)
  1 #QUALITY-PCT          (N5.1)
  1 #NEW-SCORE            (N5.1)
  1 #OLD-RATING           (N3.1)
*
  1 ESV-VIEW VIEW OF SUPPLIER-FILE
    2 ESV-ID              (N8)
    2 ESV-NAME            (A40)
    2 ESV-STATUS          (A1)
    2 ESV-RATING          (N3.1)
    2 ESV-ON-TIME-PCT     (N5.1)
    2 ESV-QUALITY-PCT     (N5.1)
    2 ESV-FILL-RATE       (N5.1)
    2 ESV-LAST-EVAL-DATE  (D)
*
  1 EPV-VIEW VIEW OF PO-HEADER-FILE
    2 EPV-ID              (N10)
    2 EPV-SUPP-ID         (N8)
    2 EPV-STATUS          (A2)
    2 EPV-TOTAL-AMT       (N11.2)
    2 EPV-ORDER-DATE      (D)
    2 EPV-EXPECTED-DATE   (D)
    2 EPV-RECEIVED-DATE   (D)
*
  1 ELV-VIEW VIEW OF PO-LINE-FILE
    2 ELV-PO-ID           (N10)
    2 ELV-QTY-ORDERED     (N6)
    2 ELV-QTY-RECEIVED    (N6)
    2 ELV-QTY-DAMAGED     (N6)
    2 ELV-STATUS          (A2)
END-DEFINE
*
MOVE *DATX TO #TODAY
MOVE #TODAY TO #PERF-START
SUBTRACT 365 FROM #PERF-START (D)
*
WRITE 'RETAILCORE - END OF DAY SUPPLIER PROCESSING'
WRITE '============================================='
WRITE 'RUN DATE:' #TODAY
WRITE ' '
*
* -------------------------------------------------------
* STEP 1: CHECK OVERDUE PURCHASE ORDERS
* -------------------------------------------------------
WRITE 'STEP 1: CHECKING OVERDUE PURCHASE ORDERS...'
READ EPV-VIEW BY EPV-ID
  * ONLY CHECK OPEN POS (APPROVED OR SHIPPED)
  IF EPV-STATUS NE 'AP' AND EPV-STATUS NE 'SH'
    ESCAPE TOP
  END-IF
  ADD 1 TO #PO-CHECKED
*
  * CHECK IF PAST EXPECTED DATE
  IF EPV-EXPECTED-DATE > 0 AND EPV-EXPECTED-DATE < #TODAY
    ADD 1 TO #PO-OVERDUE
    ADD EPV-TOTAL-AMT TO #PO-OVERDUE-AMT
*
    1 #DAYS-LATE (N6)
    COMPUTE #DAYS-LATE = #TODAY - EPV-EXPECTED-DATE
*
    IF #DAYS-LATE > 14
      ADD 1 TO #PO-CRITICAL-LATE
      WRITE '  ** CRITICAL: PO' EPV-ID
        'SUPP:' EPV-SUPP-ID
        'DAYS LATE:' #DAYS-LATE
        'AMT:' EPV-TOTAL-AMT
    ELSE IF #DAYS-LATE > 3
      WRITE '  OVERDUE: PO' EPV-ID
        'SUPP:' EPV-SUPP-ID
        'DAYS LATE:' #DAYS-LATE
    END-IF
    END-IF
  END-IF
*
  IF *COUNTER > 100000
    ESCAPE BOTTOM
  END-IF
END-READ
*
WRITE '  POS CHECKED         :' #PO-CHECKED
WRITE '  OVERDUE POS         :' #PO-OVERDUE
WRITE '  CRITICAL (>14 DAYS) :' #PO-CRITICAL-LATE
WRITE '  OVERDUE AMOUNT      :' #PO-OVERDUE-AMT
*
* -------------------------------------------------------
* STEP 2: RECALCULATE SUPPLIER PERFORMANCE METRICS
* -------------------------------------------------------
WRITE ' '
WRITE 'STEP 2: RECALCULATING SUPPLIER PERFORMANCE...'
READ ESV-VIEW BY ESV-ID
  IF ESV-STATUS = 'I'
    ESCAPE TOP
  END-IF
  ADD 1 TO #SUPP-CHECKED
*
  * RESET WORK FIELDS
  RESET #TOTAL-POS #RECEIVED-POS #LATE-POS
  RESET #QTY-ORDERED #QTY-RECEIVED #QTY-DAMAGED
  RESET #ON-TIME-PCT #FILL-RATE #QUALITY-PCT #NEW-SCORE
*
  * AGGREGATE PO DATA FOR THIS SUPPLIER
  FIND EPV-VIEW WITH EPV-SUPP-ID = ESV-ID
    IF EPV-STATUS = 'CA'
      ESCAPE TOP
    END-IF
    IF EPV-ORDER-DATE < #PERF-START
      ESCAPE TOP
    END-IF
*
    ADD 1 TO #TOTAL-POS
*
    * CHECK IF RECEIVED
    IF EPV-STATUS = 'RC' OR EPV-STATUS = 'PR' OR EPV-STATUS = 'CL'
      ADD 1 TO #RECEIVED-POS
*
      * ON-TIME CHECK (3-DAY GRACE)
      IF EPV-RECEIVED-DATE > 0 AND EPV-EXPECTED-DATE > 0
        1 #GRACE (D)
        MOVE EPV-EXPECTED-DATE TO #GRACE
        ADD 3 TO #GRACE (D)
        IF EPV-RECEIVED-DATE > #GRACE
          ADD 1 TO #LATE-POS
        END-IF
      END-IF
    END-IF
*
    * LINE QUANTITIES
    FIND ELV-VIEW WITH ELV-PO-ID = EPV-ID
      IF ELV-STATUS NE 'CA'
        ADD ELV-QTY-ORDERED  TO #QTY-ORDERED
        ADD ELV-QTY-RECEIVED TO #QTY-RECEIVED
        ADD ELV-QTY-DAMAGED  TO #QTY-DAMAGED
      END-IF
    END-FIND
  END-FIND
*
  * SKIP IF NO POS IN PERIOD
  IF #TOTAL-POS = 0
    ESCAPE TOP
  END-IF
*
  * CALCULATE METRICS
  IF #RECEIVED-POS > 0
    COMPUTE #ON-TIME-PCT =
      (#RECEIVED-POS - #LATE-POS) / #RECEIVED-POS * 100
  ELSE
    MOVE 100 TO #ON-TIME-PCT
  END-IF
*
  IF #QTY-ORDERED > 0
    COMPUTE #FILL-RATE =
      #QTY-RECEIVED / #QTY-ORDERED * 100
    IF #FILL-RATE > 100
      MOVE 100 TO #FILL-RATE
    END-IF
  END-IF
*
  IF #QTY-RECEIVED > 0
    COMPUTE #QUALITY-PCT =
      (#QTY-RECEIVED - #QTY-DAMAGED) / #QTY-RECEIVED * 100
  ELSE
    MOVE 100 TO #QUALITY-PCT
  END-IF
*
  * OVERALL SCORE
  COMPUTE #NEW-SCORE =
    #ON-TIME-PCT * 0.40 +
    #QUALITY-PCT * 0.30 +
    #FILL-RATE * 0.30
*
  * UPDATE SUPPLIER IF METRICS CHANGED SIGNIFICANTLY
  MOVE ESV-RATING TO #OLD-RATING
  1 #SCORE-DIFF (N5.1)
  COMPUTE #SCORE-DIFF = #NEW-SCORE - #OLD-RATING * 10
  * NOTE: RATING IS 0-10 SCALE, SCORE IS 0-100
  * CONVERT SCORE TO RATING SCALE
  1 #NEW-RATING (N3.1)
  COMPUTE #NEW-RATING = #NEW-SCORE / 10
*
  * UPDATE IF DIFFERENCE > 0.5 POINTS
  IF #NEW-RATING - #OLD-RATING > 0.5
      OR #OLD-RATING - #NEW-RATING > 0.5
    GET ESV-VIEW *ISN (HOLD)
    MOVE #NEW-RATING   TO ESV-RATING
    MOVE #ON-TIME-PCT  TO ESV-ON-TIME-PCT
    MOVE #QUALITY-PCT  TO ESV-QUALITY-PCT
    MOVE #FILL-RATE    TO ESV-FILL-RATE
    MOVE #TODAY         TO ESV-LAST-EVAL-DATE
    UPDATE ESV-VIEW
    ADD 1 TO #SUPP-UPDATED
*
    IF #NEW-RATING < #OLD-RATING
      ADD 1 TO #SUPP-DOWNGRADED
      IF #NEW-RATING < 6.0 AND #OLD-RATING >= 6.0
        WRITE '  ** DOWNGRADED BELOW THRESHOLD: SUPP' ESV-ID
          ESV-NAME 'RATING:' #NEW-RATING
      END-IF
    ELSE
      ADD 1 TO #SUPP-UPGRADED
    END-IF
*
    ADD 1 TO #COMMIT-COUNT
    IF #COMMIT-COUNT >= #COMMIT-INTERVAL
      END OF TRANSACTION
      RESET #COMMIT-COUNT
    END-IF
  END-IF
*
  IF *COUNTER > 10000
    ESCAPE BOTTOM
  END-IF
END-READ
END OF TRANSACTION
RESET #COMMIT-COUNT
*
WRITE '  SUPPLIERS CHECKED   :' #SUPP-CHECKED
WRITE '  RATINGS UPDATED     :' #SUPP-UPDATED
WRITE '  UPGRADED            :' #SUPP-UPGRADED
WRITE '  DOWNGRADED          :' #SUPP-DOWNGRADED
*
* -------------------------------------------------------
* STEP 3: AUTO-PROBATION FOR POOR PERFORMERS
* -------------------------------------------------------
WRITE ' '
WRITE 'STEP 3: CHECKING FOR AUTO-PROBATION...'
1 #PROBATION-THRESHOLD (N3.1) INIT <5.0>
*
READ ESV-VIEW BY ESV-ID
  IF ESV-STATUS NE 'A'
    ESCAPE TOP
  END-IF
*
  IF ESV-RATING > 0 AND ESV-RATING < #PROBATION-THRESHOLD
    GET ESV-VIEW *ISN (HOLD)
    MOVE 'P' TO ESV-STATUS
    UPDATE ESV-VIEW
    ADD 1 TO #SUPP-PROBATION
    WRITE '  ** AUTO-PROBATION: SUPP' ESV-ID
      ESV-NAME 'RATING:' ESV-RATING
*
    ADD 1 TO #COMMIT-COUNT
    IF #COMMIT-COUNT >= #COMMIT-INTERVAL
      END OF TRANSACTION
      RESET #COMMIT-COUNT
    END-IF
  END-IF
*
  IF *COUNTER > 10000
    ESCAPE BOTTOM
  END-IF
END-READ
END OF TRANSACTION
*
WRITE '  AUTO-PROBATION      :' #SUPP-PROBATION
*
* -------------------------------------------------------
* SUMMARY
* -------------------------------------------------------
WRITE ' '
WRITE 'EOD SUPPLIER PROCESSING SUMMARY'
WRITE '================================'
WRITE 'OVERDUE POS          :' #PO-OVERDUE
WRITE 'CRITICAL LATE (>14D) :' #PO-CRITICAL-LATE
WRITE 'SUPPLIERS EVALUATED  :' #SUPP-CHECKED
WRITE 'RATINGS UPDATED      :' #SUPP-UPDATED
WRITE 'PUT ON PROBATION     :' #SUPP-PROBATION
*
WRITE ' '
WRITE 'EOD SUPPLIER PROCESSING COMPLETE'
*
CALLNAT 'AUDITN' 'SUPP' 'EODSUPP' 'U' 'BATCH'
  ' ' ' ' 'EOD SUPPLIER PROCESSING COMPLETE'
*
END
